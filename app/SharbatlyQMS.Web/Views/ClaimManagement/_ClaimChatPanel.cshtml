@using SharbatlyQMS.Web.Models
@model QualityOrder
@{
    var claim = ViewBag.Claim as QualityClaim;
    var notes = (ViewBag.ClaimNotes as IReadOnlyList<ClaimNote>) ?? new List<ClaimNote>();
    var role  = User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value;

    var isQm        = role == UserRoles.Manager      || role == UserRoles.SiteAdmin;
    var isCm        = role == UserRoles.ClaimManager || role == UserRoles.SiteAdmin;
    var canComment  = isQm || isCm;

    // QM can only set/flip status while CM has not yet decided.
    var qmCanAct = isQm && (claim == null || claim.DecidedAt == null);
    // CM can act when claim exists AND (status = ClaimRequest OR already decided).
    // i.e. CM cannot act on PassedQC -- QM has already cleared it.
    var cmCanAct = isCm && claim != null
                   && (claim.ClaimStatus == ClaimStatus.ClaimRequest
                       || claim.DecidedAt != null);

    // Per-button gates: hide each action button when it would be a no-op
    // (current status already matches). Saves the user from "clicking
    // Approve while already Approved" or "Hold while already Held".
    var current               = claim?.ClaimStatus;
    var canMarkClaimRequest   = qmCanAct && current != ClaimStatus.ClaimRequest;
    var canMarkPassedQc       = qmCanAct && current != ClaimStatus.PassedQC;
    var canApprove            = cmCanAct && current != ClaimStatus.ClaimRequestApproved;
    var canHold               = cmCanAct && current != ClaimStatus.HoldClaim;

    var currentLabel = ClaimStatus.Label(claim?.ClaimStatus);
    var currentBadge = ClaimStatus.BadgeCss(claim?.ClaimStatus);
}

<style>
    .claim-panel .chat-stream {
        max-height: 480px; overflow-y: auto;
        padding: 1rem; background: var(--bs-tertiary-bg, #f8f9fa);
        border-radius: .5rem;
    }
    .claim-bubble {
        display: flex; margin-bottom: .75rem; gap: .5rem; align-items: flex-start;
    }
    .claim-bubble.role-mgr  { justify-content: flex-start; }
    .claim-bubble.role-cm   { justify-content: flex-end; }
    .claim-bubble.role-admin{ justify-content: center; }
    .claim-bubble .bubble-body {
        max-width: 75%;
        padding: .55rem .75rem;
        border-radius: .65rem;
        box-shadow: 0 1px 2px rgba(0,0,0,.05);
        font-size: .92rem;
    }
    .claim-bubble.role-mgr   .bubble-body { background: #cfe2ff; color: #052c65; border-bottom-left-radius: 0; }
    .claim-bubble.role-cm    .bubble-body { background: #f8d7da; color: #58151c; border-bottom-right-radius: 0; }
    .claim-bubble.role-admin .bubble-body { background: #e2e3e5; color: #2b2f32; border: 1px dashed #adb5bd; }
    .claim-bubble .bubble-meta {
        font-size: .75rem; color: #6c757d; margin-bottom: .15rem;
    }
    .claim-bubble .bubble-status-pill {
        display: inline-block; padding: .1rem .5rem; border-radius: 1rem;
        font-size: .7rem; font-weight: 600; margin-bottom: .25rem;
    }
    .claim-bubble .note-text { white-space: pre-wrap; word-wrap: break-word; }
    .claim-action-bar .btn { min-width: 9rem; }
</style>

<div class="card mb-3 claim-panel border-danger-subtle">
    <div class="card-header bg-danger-subtle d-flex justify-content-between align-items-center">
        <div>
            <i class="bi bi-shield-exclamation me-1 text-danger"></i>
            <strong>Claim review</strong>
            <span class="badge @currentBadge ms-2 fs-6">@currentLabel</span>
            @if (claim?.DecidedAt != null)
            {
                <span class="text-muted small ms-2">
                    Decided by <strong>@claim.DecidedBy</strong> on @claim.DecidedAt.Value.ToLocalTime().ToString("yyyy-MM-dd HH:mm")
                </span>
            }
            else if (claim != null)
            {
                <span class="text-muted small ms-2">
                    Awaiting Claim Manager decision
                </span>
            }
        </div>
        @if (canComment)
        {
            <button type="button" class="btn btn-sm btn-outline-secondary"
                    data-bs-toggle="modal" data-bs-target="#claimNoteModal-Comment"
                    @(claim == null ? "disabled" : "")
                    title="@(claim == null ? "Available after the Quality Manager starts the claim review" : "Add a note without changing status")">
                <i class="bi bi-chat-left-dots me-1"></i>Add note
            </button>
        }
    </div>
    <div class="card-body">

        @* ---- Action bar ---- *@
        <div class="claim-action-bar d-flex flex-wrap gap-2 mb-3">
            @if (canMarkClaimRequest)
            {
                <button type="button" class="btn btn-danger"
                        data-bs-toggle="modal" data-bs-target="#claimNoteModal-MarkClaimRequest">
                    <i class="bi bi-exclamation-octagon me-1"></i>Mark as Claim Request
                </button>
            }
            @if (canMarkPassedQc)
            {
                <button type="button" class="btn btn-success"
                        data-bs-toggle="modal" data-bs-target="#claimNoteModal-MarkPassedQc">
                    <i class="bi bi-check2-circle me-1"></i>Mark as Passed QC
                </button>
            }
            @if (canApprove)
            {
                <button type="button" class="btn btn-dark"
                        data-bs-toggle="modal" data-bs-target="#claimNoteModal-Approve">
                    <i class="bi bi-shield-check me-1"></i>Approve Claim
                </button>
            }
            @if (canHold)
            {
                <button type="button" class="btn btn-warning"
                        data-bs-toggle="modal" data-bs-target="#claimNoteModal-Hold">
                    <i class="bi bi-pause-circle me-1"></i>Hold Claim
                </button>
            }
            @* "Send report to supplier" is available only after the claim is
               approved. The modal markup + JS live in QualityOrders/Details.cshtml
               (this panel is rendered inside that view in claim context, so the
               modal is in scope). *@
            @if ((bool?)ViewBag.SendMailEnabled == true
                 && claim != null
                 && claim.ClaimStatus == ClaimStatus.ClaimRequestApproved)
            {
                <button type="button" class="btn btn-info"
                        data-bs-toggle="modal" data-bs-target="#sendReportModal">
                    <i class="bi bi-envelope-paper me-1"></i>Send report to supplier
                </button>
            }
            @if (claim != null && !qmCanAct && !cmCanAct && canComment)
            {
                <span class="text-muted small align-self-center">
                    <i class="bi bi-info-circle me-1"></i>
                    @if (isQm && claim.DecidedAt != null)
                    {
                        <text>Claim Manager has decided. You can still post a note.</text>
                    }
                    else if (isCm && claim.ClaimStatus == ClaimStatus.PassedQC)
                    {
                        <text>Quality Manager cleared this QO. Nothing for Claim Manager to decide.</text>
                    }
                </span>
            }
            @if (!canComment)
            {
                <span class="text-muted small align-self-center">
                    <i class="bi bi-info-circle me-1"></i>Read-only — your role cannot change claim status.
                </span>
            }
        </div>

        @* ---- Chat history ---- *@
        @if (notes.Count == 0)
        {
            <div class="text-center text-muted py-4 chat-stream">
                <em>No claim activity yet. Mark this QO as Claim Request or Passed QC to start the conversation.</em>
            </div>
        }
        else
        {
            <div class="chat-stream">
                @foreach (var n in notes)
                {
                    var bubbleClass = n.AuthorRole switch
                    {
                        UserRoles.Manager      => "role-mgr",
                        UserRoles.ClaimManager => "role-cm",
                        _                      => "role-admin"
                    };
                    var roleLabel = n.AuthorRole switch
                    {
                        UserRoles.Manager      => "Quality Manager",
                        UserRoles.ClaimManager => "Claim Manager",
                        UserRoles.SiteAdmin    => "Site Admin",
                        _                      => n.AuthorRole
                    };
                    var statusPillCss = ClaimStatus.BadgeCss(n.StatusAtPost);
                    <div class="claim-bubble @bubbleClass">
                        <div class="bubble-body">
                            <div class="bubble-meta">
                                <strong>@n.CreatedBy</strong>
                                <span class="text-muted">— @roleLabel — @n.CreatedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</span>
                            </div>
                            @if (n.NoteKind == ClaimNoteKind.StatusChange && !string.IsNullOrEmpty(n.StatusAtPost))
                            {
                                <div>
                                    <span class="bubble-status-pill @statusPillCss">
                                        Status → @ClaimStatus.Label(n.StatusAtPost)
                                    </span>
                                </div>
                            }
                            <div class="note-text">@n.NoteText</div>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</div>

@* ---- Modals: one per action. Inlined (not in @functions helper) because
       tag helpers like asp-action only run in top-level Razor markup. ---- *@

@if (canMarkClaimRequest)
{
    <div class="modal fade" id="claimNoteModal-MarkClaimRequest" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog">
            <form method="post" asp-controller="ClaimManagement" asp-action="MarkClaimRequest" asp-route-id="@Model.QualityOrderId">
                @Html.AntiForgeryToken()
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title"><i class="bi bi-exclamation-octagon me-1"></i>Mark as Claim Request</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body">
                        <label class="form-label">Justification note <span class="text-danger">*</span></label>
                        <textarea name="note" class="form-control" rows="4" required minlength="3"
                                  placeholder="Why is this QO a claim against the supplier?"></textarea>
                        <div class="form-text">Visible to both Quality Manager and Claim Manager.</div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-danger"><i class="bi bi-exclamation-octagon me-1"></i>Mark as Claim Request</button>
                    </div>
                </div>
            </form>
        </div>
    </div>
}

@if (canMarkPassedQc)
{
    <div class="modal fade" id="claimNoteModal-MarkPassedQc" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog">
            <form method="post" asp-controller="ClaimManagement" asp-action="MarkPassedQc" asp-route-id="@Model.QualityOrderId">
                @Html.AntiForgeryToken()
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title"><i class="bi bi-check2-circle me-1"></i>Mark as Passed QC</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body">
                        <label class="form-label">Note <span class="text-danger">*</span></label>
                        <textarea name="note" class="form-control" rows="4" required minlength="3"
                                  placeholder="Why does this QO not require a claim?"></textarea>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-success"><i class="bi bi-check2-circle me-1"></i>Mark as Passed QC</button>
                    </div>
                </div>
            </form>
        </div>
    </div>
}

@if (canApprove)
{
    <div class="modal fade" id="claimNoteModal-Approve" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog">
            <form method="post" asp-controller="ClaimManagement" asp-action="Approve" asp-route-id="@Model.QualityOrderId">
                @Html.AntiForgeryToken()
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title"><i class="bi bi-shield-check me-1"></i>Approve Claim</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body">
                        <label class="form-label">Approval note <span class="text-danger">*</span></label>
                        <textarea name="note" class="form-control" rows="4" required minlength="3"
                                  placeholder="Confirm the commercial reasoning for approving this claim."></textarea>
                        <div class="form-text">Approval is final unless flipped back to Hold.</div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-dark"><i class="bi bi-shield-check me-1"></i>Approve Claim</button>
                    </div>
                </div>
            </form>
        </div>
    </div>
}

@if (canHold)
{
    <div class="modal fade" id="claimNoteModal-Hold" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog">
            <form method="post" asp-controller="ClaimManagement" asp-action="Hold" asp-route-id="@Model.QualityOrderId">
                @Html.AntiForgeryToken()
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title"><i class="bi bi-pause-circle me-1"></i>Hold Claim</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body">
                        <label class="form-label">Reason to hold <span class="text-danger">*</span></label>
                        <textarea name="note" class="form-control" rows="4" required minlength="3"
                                  placeholder="Why is the claim being held?"></textarea>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-warning"><i class="bi bi-pause-circle me-1"></i>Hold Claim</button>
                    </div>
                </div>
            </form>
        </div>
    </div>
}

@if (canComment && claim != null)
{
    <div class="modal fade" id="claimNoteModal-Comment" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog">
            <form method="post" asp-controller="ClaimManagement" asp-action="AddNote" asp-route-id="@Model.QualityOrderId">
                @Html.AntiForgeryToken()
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title"><i class="bi bi-chat-left-dots me-1"></i>Add Note</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body">
                        <label class="form-label">Note <span class="text-danger">*</span></label>
                        <textarea name="note" class="form-control" rows="4" required minlength="3"
                                  placeholder="Add a note without changing claim status..."></textarea>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-primary"><i class="bi bi-chat-left-dots me-1"></i>Add Note</button>
                    </div>
                </div>
            </form>
        </div>
    </div>
}
