@using SharbatlyQMS.Web.Models
@model QualityOrder
@{
    var claim = ViewBag.Claim as QualityClaim;
    var notes = (ViewBag.ClaimNotes as IReadOnlyList<ClaimNote>) ?? new List<ClaimNote>();
    var role  = User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value;

    // Archived orders are a closed book: every action below folds this in, so
    // adding a new one cannot accidentally stay live on an archived order.
    var isArchived  = Model.IsArchived;

    var isQm        = Perms.Can(Perm.Claims.MarkClaimRequest);
    var isCm        = Perms.Can(Perm.Claims.Approve);
    var canComment  = !isArchived && (isQm || isCm);

    // QM can only set/flip status while CM has not yet decided.
    var qmCanAct = !isArchived && isQm && (claim == null || claim.DecidedAt == null);
    // CM can act when claim exists AND (status = ClaimRequest OR already decided).
    // i.e. CM cannot act on PassedQC -- QM has already cleared it.
    var cmCanAct = !isArchived && isCm && claim != null
                   && (claim.ClaimStatus == ClaimStatus.ClaimRequest
                       || claim.DecidedAt != null);

    // Per-button gates: hide each action button when it would be a no-op
    // (current status already matches). Saves the user from "clicking
    // Approve while already Approved" or "Hold while already Held".
    var current               = claim?.ClaimStatus;
    var canMarkClaimRequest   = qmCanAct && current != ClaimStatus.ClaimRequest;
    var canMarkPassedQc       = qmCanAct && current != ClaimStatus.PassedQC;
    var canApprove            = cmCanAct && current != ClaimStatus.ClaimRequestApproved;
    var canHold               = cmCanAct && current != ClaimStatus.HoldClaim;

    var currentLabel = ClaimStatus.Label(claim?.ClaimStatus);
    var currentBadge = ClaimStatus.BadgeCss(claim?.ClaimStatus);
}

<style>
    .claim-panel .chat-stream {
        max-height: 480px; overflow-y: auto;
        padding: 1rem; background: var(--bs-tertiary-bg, #f8f9fa);
        border-radius: .5rem;
    }
    .claim-bubble {
        display: flex; margin-bottom: .75rem; gap: .5rem; align-items: flex-start;
    }
    .claim-bubble.role-mgr  { justify-content: flex-start; }
    .claim-bubble.role-cm   { justify-content: flex-end; }
    .claim-bubble.role-admin{ justify-content: center; }
    .claim-bubble .bubble-body {
        max-width: 75%;
        padding: .55rem .75rem;
        border-radius: .65rem;
        box-shadow: 0 1px 2px rgba(0,0,0,.05);
        font-size: .92rem;
    }
    .claim-bubble.role-mgr   .bubble-body { background: #cfe2ff; color: #052c65; border-bottom-left-radius: 0; }
    .claim-bubble.role-cm    .bubble-body { background: #f8d7da; color: #58151c; border-bottom-right-radius: 0; }
    .claim-bubble.role-admin .bubble-body { background: #e2e3e5; color: #2b2f32; border: 1px dashed #adb5bd; }
    .claim-bubble .bubble-meta {
        font-size: .75rem; color: #6c757d; margin-bottom: .15rem;
    }
    .claim-bubble .bubble-status-pill {
        display: inline-block; padding: .1rem .5rem; border-radius: 1rem;
        font-size: .7rem; font-weight: 600; margin-bottom: .25rem;
    }
    .claim-bubble .note-text { white-space: pre-wrap; word-wrap: break-word; }
    .claim-action-bar .btn { min-width: 9rem; }
</style>

<div class="card mb-3 claim-panel border-danger-subtle">
    <div class="card-header bg-danger-subtle d-flex justify-content-between align-items-center">
        <div>
            <i class="bi bi-shield-exclamation me-1 text-danger"></i>
            <strong>@Loc["Claim review"]</strong>
            <span class="badge @currentBadge ms-2 fs-6">@currentLabel</span>
            @if (claim?.DecidedAt != null)
            {
                <span class="text-muted small ms-2">
                    Decided by <strong>@claim.DecidedBy</strong> on @claim.DecidedAt.Value.ToLocalTime().ToString("yyyy-MM-dd HH:mm")
                </span>
            }
            else if (claim != null)
            {
                <span class="text-muted small ms-2">
                    @Loc["Awaiting Claim Manager decision"]
                </span>
            }
        </div>
        @if (canComment)
        {
            <button type="button" class="btn btn-sm btn-outline-secondary"
                    data-bs-toggle="modal" data-bs-target="#claimNoteModal-Comment"
                    @(claim == null ? "disabled" : "")
                    title="@(claim == null ? "Available after the Quality Manager starts the claim review" : "Add a note without changing status")">
                <i class="bi bi-chat-left-dots me-1"></i>@Loc["Add note"]
            </button>
        }
    </div>
    <div class="card-body">

        @* ---- Action bar ---- *@
        <div class="claim-action-bar d-flex flex-wrap gap-2 mb-3">
            @if (canMarkClaimRequest)
            {
                <button type="button" class="btn btn-danger"
                        data-bs-toggle="modal" data-bs-target="#claimNoteModal-MarkClaimRequest">
                    <i class="bi bi-exclamation-octagon me-1"></i>@Loc["Mark as Claim Notification Request"]
                </button>
            }
            @if (canMarkPassedQc)
            {
                <button type="button" class="btn btn-success"
                        data-bs-toggle="modal" data-bs-target="#claimNoteModal-MarkPassedQc">
                    <i class="bi bi-check2-circle me-1"></i>@Loc["Mark as Passed QC"]
                </button>
            }
            @if (canApprove)
            {
                <button type="button" class="btn btn-dark"
                        data-bs-toggle="modal" data-bs-target="#claimNoteModal-Approve">
                    <i class="bi bi-shield-check me-1"></i>@Loc["Mark as Reviewed"]
                </button>
            }
            @if (canHold)
            {
                <button type="button" class="btn btn-warning"
                        data-bs-toggle="modal" data-bs-target="#claimNoteModal-Hold">
                    <i class="bi bi-pause-circle me-1"></i>@Loc["Hold Notification"]
                </button>
            }
            @* "Send report to supplier" is available on every closed order in
               the Claims list, not just approved claims -- gating it on
               ClaimRequestApproved hid it on all but a handful of orders. The
               server re-checks Closed in SendQualityReport, and the Claims list
               only ever contains Closed orders, so the two agree. The modal
               markup + JS live in QualityOrders/Details.cshtml (this panel is
               rendered inside that view in claim context, so the modal is in
               scope). *@
            @if (Model.StatusCode == QualityOrderStatus.Closed && !isArchived)
            {
                <button type="button" class="btn btn-info"
                        data-bs-toggle="modal" data-bs-target="#sendReportModal">
                    <i class="bi bi-envelope-paper me-1"></i>@Loc["Send report to supplier"]
                </button>
            }
            @if (isArchived)
            {
                <span class="text-muted small align-self-center">
                    <i class="bi bi-archive me-1"></i>
                    Archived &mdash; this order is kept as a historical record and can no longer be changed.
                </span>
            }
            @if (claim != null && !qmCanAct && !cmCanAct && canComment)
            {
                <span class="text-muted small align-self-center">
                    <i class="bi bi-info-circle me-1"></i>
                    @if (isQm && claim.DecidedAt != null)
                    {
                        <text>Claim Manager has decided. You can still post a note.</text>
                    }
                    else if (isCm && claim.ClaimStatus == ClaimStatus.PassedQC)
                    {
                        <text>Quality Manager cleared this QO. Nothing for Claim Manager to decide.</text>
                    }
                </span>
            }
            @if (!canComment)
            {
                <span class="text-muted small align-self-center">
                    <i class="bi bi-info-circle me-1"></i>@Loc["Read-only — your role cannot change claim status."]
                </span>
            }
        </div>

        @* ---- Chat history ---- *@
        @if (notes.Count == 0)
        {
            <div class="text-center text-muted py-4 chat-stream">
                <em>No claim activity yet. Mark this QO as Claim Notification Request or Passed QC to start the conversation.</em>
            </div>
        }
        else
        {
            <div class="chat-stream">
                @foreach (var n in notes)
                {
                    @* author_role stores the role CODE the note was written
                       under ("QcManager"), but this matched against the
                       pre-overhaul display names ("Manager"), so every bubble
                       fell through to the admin colour and printed the raw code
                       as its label. Comparing on the bare name handles both the
                       codes written today and the legacy values on older
                       notes. *@
                    var bare = RoleCodes.BareRoleName(n.AuthorRole);
                    var bubbleClass = bare switch
                    {
                        "Manager"      => "role-mgr",
                        "ClaimManager" => "role-cm",
                        _              => "role-admin"
                    };
                    var roleLabel = bare switch
                    {
                        "Manager"      => "Quality Manager",
                        "ClaimManager" => "Claim Manager",
                        "Admin"        => "Site Admin",
                        "SiteAdmin"    => "Site Admin",
                        "Supervisor"   => "Supervisor",
                        "Operator"     => "Operator",
                        _              => n.AuthorRole
                    };
                    var statusPillCss = ClaimStatus.BadgeCss(n.StatusAtPost);
                    <div class="claim-bubble @bubbleClass">
                        <div class="bubble-body">
                            <div class="bubble-meta">
                                <strong>@n.CreatedBy</strong>
                                <span class="text-muted">— @roleLabel — @n.CreatedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</span>
                            </div>
                            @if (n.NoteKind == ClaimNoteKind.StatusChange && !string.IsNullOrEmpty(n.StatusAtPost))
                            {
                                <div>
                                    <span class="bubble-status-pill @statusPillCss">
                                        Status → @ClaimStatus.Label(n.StatusAtPost)
                                    </span>
                                </div>
                            }
                            <div class="note-text">@n.NoteText</div>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</div>

@* ---- Modals: one per action. Inlined (not in @functions helper) because
       tag helpers like asp-action only run in top-level Razor markup. ---- *@

@if (canMarkClaimRequest)
{
    <div class="modal fade" id="claimNoteModal-MarkClaimRequest" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog">
            <form method="post" asp-controller="ClaimManagement" asp-action="MarkClaimRequest" asp-route-id="@Model.QualityOrderId">
                @Html.AntiForgeryToken()
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title"><i class="bi bi-exclamation-octagon me-1"></i>@Loc["Mark as Claim Notification Request"]</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label='@Loc["Close"]'></button>
                    </div>
                    <div class="modal-body">
                        <label class="form-label">@Loc["Justification note"] <span class="text-danger">*</span></label>
                        <textarea name="note" class="form-control" rows="4" required minlength="3"
                                  placeholder='@Loc["Why does this QO need a claim notification to the supplier?"]'></textarea>
                        <div class="form-text">@Loc["Visible to both Quality Manager and Claim Manager."]</div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">@Loc["Cancel"]</button>
                        <button type="submit" class="btn btn-danger"><i class="bi bi-exclamation-octagon me-1"></i>@Loc["Mark as Claim Notification Request"]</button>
                    </div>
                </div>
            </form>
        </div>
    </div>
}

@if (canMarkPassedQc)
{
    <div class="modal fade" id="claimNoteModal-MarkPassedQc" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog">
            <form method="post" asp-controller="ClaimManagement" asp-action="MarkPassedQc" asp-route-id="@Model.QualityOrderId">
                @Html.AntiForgeryToken()
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title"><i class="bi bi-check2-circle me-1"></i>@Loc["Mark as Passed QC"]</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label='@Loc["Close"]'></button>
                    </div>
                    <div class="modal-body">
                        <label class="form-label">@Loc["Note"] <span class="text-danger">*</span></label>
                        <textarea name="note" class="form-control" rows="4" required minlength="3"
                                  placeholder='@Loc["Why does this QO not require a claim?"]'></textarea>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">@Loc["Cancel"]</button>
                        <button type="submit" class="btn btn-success"><i class="bi bi-check2-circle me-1"></i>@Loc["Mark as Passed QC"]</button>
                    </div>
                </div>
            </form>
        </div>
    </div>
}

@if (canApprove)
{
    <div class="modal fade" id="claimNoteModal-Approve" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog">
            <form method="post" asp-controller="ClaimManagement" asp-action="Approve" asp-route-id="@Model.QualityOrderId">
                @Html.AntiForgeryToken()
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title"><i class="bi bi-shield-check me-1"></i>@Loc["Mark as Reviewed"]</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label='@Loc["Close"]'></button>
                    </div>
                    <div class="modal-body">
                        <label class="form-label">@Loc["Approval note"] <span class="text-danger">*</span></label>
                        <textarea name="note" class="form-control" rows="4" required minlength="3"
                                  placeholder='@Loc["Confirm the commercial reasoning for approving this claim."]'></textarea>
                        <div class="form-text">Marking the notification reviewed is final unless flipped back to Hold Notification.</div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">@Loc["Cancel"]</button>
                        <button type="submit" class="btn btn-dark"><i class="bi bi-shield-check me-1"></i>@Loc["Mark as Reviewed"]</button>
                    </div>
                </div>
            </form>
        </div>
    </div>
}

@if (canHold)
{
    <div class="modal fade" id="claimNoteModal-Hold" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog">
            <form method="post" asp-controller="ClaimManagement" asp-action="Hold" asp-route-id="@Model.QualityOrderId">
                @Html.AntiForgeryToken()
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title"><i class="bi bi-pause-circle me-1"></i>@Loc["Hold Notification"]</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label='@Loc["Close"]'></button>
                    </div>
                    <div class="modal-body">
                        <label class="form-label">@Loc["Reason to hold"] <span class="text-danger">*</span></label>
                        <textarea name="note" class="form-control" rows="4" required minlength="3"
                                  placeholder='@Loc["Why is the claim being held?"]'></textarea>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">@Loc["Cancel"]</button>
                        <button type="submit" class="btn btn-warning"><i class="bi bi-pause-circle me-1"></i>@Loc["Hold Notification"]</button>
                    </div>
                </div>
            </form>
        </div>
    </div>
}

@if (canComment && claim != null)
{
    <div class="modal fade" id="claimNoteModal-Comment" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog">
            <form method="post" asp-controller="ClaimManagement" asp-action="AddNote" asp-route-id="@Model.QualityOrderId">
                @Html.AntiForgeryToken()
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title"><i class="bi bi-chat-left-dots me-1"></i>@Loc["Add Note"]</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label='@Loc["Close"]'></button>
                    </div>
                    <div class="modal-body">
                        <label class="form-label">@Loc["Note"] <span class="text-danger">*</span></label>
                        <textarea name="note" class="form-control" rows="4" required minlength="3"
                                  placeholder='@Loc["Add a note without changing claim status..."]'></textarea>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">@Loc["Cancel"]</button>
                        <button type="submit" class="btn btn-primary"><i class="bi bi-chat-left-dots me-1"></i>@Loc["Add Note"]</button>
                    </div>
                </div>
            </form>
        </div>
    </div>
}
