@using SharbatlyQMS.Web.Models
@using SharbatlyQMS.Web.ViewModels
@model IReadOnlyList<ClaimListRow>
@{
    ViewData["Title"] = Loc["Claims"];
    var f      = ViewBag.Filter as ClaimListFilter ?? new ClaimListFilter();
    var opts   = ViewBag.FilterOptions as ClaimFilterOptions ?? new ClaimFilterOptions();
    var status = f.Status;
    var search = f.Search;
    var plantScopeLocked = ViewBag.PlantScopeLocked as string;
    // Panel starts collapsed, but opens itself when the URL already carries
    // panel filters -- otherwise a bookmarked link shows a short list with no
    // visible reason for it.
    var panelOpen = f.AnyPanelFilter;
    string D(DateTime? d) => d?.ToString("yyyy-MM-dd") ?? "";

    // Fast filter chips: All + Pending + the real claim statuses. Each button
    // is its own submit so picking a chip posts the form (preserving the
    // search text and every panel field) without an extra click.
    var chips = new (string Value, string Label, string OutlineCss)[]
    {
        ("",                                "All",                    "btn-outline-secondary"),
        (ClaimStatus.Pending,               "Pending",                "btn-outline-secondary"),
        @* Labels come from ClaimStatus.Label so the chips, the badges and the
           chat panel can never drift apart. *@
        (ClaimStatus.ClaimRequest,          ClaimStatus.Label(ClaimStatus.ClaimRequest),         "btn-outline-danger"),
        (ClaimStatus.ClaimRequestApproved,  ClaimStatus.Label(ClaimStatus.ClaimRequestApproved), "btn-outline-dark"),
        (ClaimStatus.HoldClaim,             ClaimStatus.Label(ClaimStatus.HoldClaim),            "btn-outline-warning"),
        (ClaimStatus.Reinspection,          ClaimStatus.ShortLabel(ClaimStatus.Reinspection),   "btn-outline-info"),
        (ClaimStatus.PassedQC,              ClaimStatus.Label(ClaimStatus.PassedQC),            "btn-outline-success"),
    };
    bool ChipOn(string v) => status.Contains(v, StringComparer.OrdinalIgnoreCase);

    // M24: QC's assessment at finish time. A second, independent chip row --
    // "what QC saw" ANDed with "what the claim team decided" is exactly the
    // question the claim desk asks ("show me Pending orders QC flagged").
    var potential = f.Potential;

    @* Both chip rows are real form controls now -- status a set of checkboxes,
       assessment a set of radios -- so picking one submits this form like any
       other field.

       They were LINKS for a while, because as buttons they shared a field name
       with a hidden "carry the other row" input and the browser submitted e.g.
       potential="" AND potential="Yes", which the binder joined to ",Yes" and
       silently matched no bucket. Deleting the hidden inputs removes that
       collision at the source, and costs nothing: a form control cannot
       double-submit with a field that no longer exists. It also fixes the
       link approach's own trade-off -- text typed into the search box but not
       yet submitted is now carried, because it is in the same form. *@
    var chipAction = f.Archived ? "Archived" : "Index";

    var pChips = new (string Value, string Label, string Icon, string OutlineCss)[]
    {
        (ClaimAssessment.Any,       "All",               "",                            "btn-outline-secondary"),
        (ClaimAssessment.Potential, "Potential Claim",   "bi-exclamation-octagon-fill", "btn-outline-danger"),
        (ClaimAssessment.NoClaim,   "No Potential Claim","bi-check-circle-fill",        "btn-outline-success"),
        (ClaimAssessment.Unset,     "Not classified",    "bi-dash-circle",              "btn-outline-secondary"),
    };

    string Dt(DateTime? d)  => d?.ToLocalTime().ToString("yyyy-MM-dd") ?? "—";
    // Shipment dates are date-only with no zone, so Dt() leaves them alone.
    // Anything written with SYSUTCDATETIME() — closed_at, last_changed_at,
    // opened_at, potential_claim_at — is real UTC, and Dapper hands it back with
    // Kind=Unspecified, which makes a bare .ToLocalTime() a no-op that silently
    // displays UTC (three hours early here). These two convert explicitly.
    string DtUtc(DateTime? d) => d.HasValue
        ? DateTime.SpecifyKind(d.Value, DateTimeKind.Utc).ToLocalTime().ToString("yyyy-MM-dd")
        : "—";
    string TsUtc(DateTime? d) => d.HasValue
        ? DateTime.SpecifyKind(d.Value, DateTimeKind.Utc).ToLocalTime().ToString("yyyy-MM-dd HH:mm")
        : "—";
    string Txt(string? v)   => string.IsNullOrWhiteSpace(v) ? "—" : v;
}

<style>
    /* Unread row: subtle left border + slightly heavier font so a row with
       new activity for THIS user pops out without screaming for attention. */
    tr.has-unread td { font-weight: 600; }
    tr.has-unread td:first-child { box-shadow: inset 3px 0 0 var(--bs-danger); }
    .unread-pill {
        background: var(--bs-danger); color: #fff;
        border-radius: 1rem; padding: .05rem .45rem;
        font-size: .72rem; font-weight: 700; margin-left: .25rem;
    }
    /* Product tooltip: one line per product, same look as the Pending
       Containers peek. */
    .tooltip-inner  { max-width: 460px; text-align: left; }
    .claim-tip      { margin: 0; padding: 0; list-style: none; font-size: .8rem; }
    .claim-tip li   { padding: 2px 0; border-bottom: 1px dashed rgba(255,255,255,.18); }
    .claim-tip li:last-child { border-bottom: 0; }
    /* Expandable shipment/inspection panel under each row. */
    .claim-detail > td { background: var(--bs-tertiary-bg); }
    .claim-detail dl { margin-bottom: 0; }
    .claim-detail dt { font-weight: 600; color: var(--bs-secondary-color); font-size: .78rem; }
    .claim-detail dd { margin-bottom: .35rem; font-size: .82rem; }
    .claim-toggle[aria-expanded="true"] .bi { transform: rotate(90deg); }
    .claim-toggle .bi { transition: transform .15s ease-in-out; }
</style>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">
        <i class="bi bi-shield-exclamation me-1 text-danger"></i>Claims
        @if (f.Archived)
        {
            <small class="text-muted fs-6 fw-normal ms-2">Archived &mdash; orders from before the 18 Aug go-live</small>
        }
    </h1>
</div>

@* Two lists, two URLs. The active tab is the day-to-day worklist; Archived
   holds the pre-go-live backlog, whatever each order's status. Filters are
   NOT carried across the tabs -- a supplier that narrows one list to three
   rows would silently narrow the other to none. *@
<ul class="nav nav-tabs mb-3">
    <li class="nav-item">
        <a class="nav-link @(f.Archived ? "" : "active")" asp-action="Index">
            <i class="bi bi-list-check me-1"></i>@Loc["Claims"]
        </a>
    </li>
    <li class="nav-item">
        <a class="nav-link @(f.Archived ? "active" : "")" asp-action="Archived">
            <i class="bi bi-archive me-1"></i>@Loc["Archived"]
        </a>
    </li>
</ul>

@* One form for everything: the always-visible quick bar and the collapsible
   panel below it. Collapsed inputs still submit (display:none is not disabled),
   which is exactly what we want -- the two sets AND together. Mirrors the
   Quality Orders page so there is only one filter UI to learn. *@
<form method="get" class="mb-3" data-filter-memory="@(f.Archived ? "claim-archived" : "claim")">
    @* Enter inside a panel field does this plain submit rather than the first
       status chip (which would change the status filter). *@
    <button type="submit" class="visually-hidden" tabindex="-1" aria-hidden="true"></button>
    <div class="row g-2 align-items-stretch">
        <div class="col-auto d-flex gap-2">
            <button class="btn btn-outline-secondary" type="button"
                    data-bs-toggle="collapse" data-bs-target="#claimFilters"
                    aria-expanded="@(panelOpen ? "true" : "false")" aria-controls="claimFilters">
                <i class="bi bi-funnel me-1"></i>Filters
                @if (f.PanelFilterCount > 0)
                {
                    <span class="badge bg-primary ms-1">@f.PanelFilterCount</span>
                }
            </button>
            @if (f.Any)
            {
                <a asp-action="@(f.Archived ? "Archived" : "Index")" class="btn btn-outline-secondary"
                   title="Clear every filter" data-filter-clear>@Loc["Clear"]</a>
            }
            <div class="dropdown" data-coltoggle-ui="claims-list">
                <button type="button" class="btn btn-outline-secondary dropdown-toggle"
                        data-bs-toggle="dropdown" data-bs-auto-close="outside" aria-expanded="false"
                        title="Choose which columns to show. Your choice is remembered on this device.">
                    <i class="bi bi-layout-three-columns me-1"></i>Columns<span class="badge bg-secondary ms-1 d-none"
                         data-coltoggle-count title="Columns currently hidden"></span>
                </button>
                <div class="dropdown-menu dropdown-menu-end p-2" data-coltoggle-menu style="min-width: 13rem;"></div>
            </div>
        </div>
        <div class="col-md-4">
            <input type="text" name="search" value="@search" class="form-control"
                   placeholder='@Loc["Search by QO #, container, BOL, PO, supplier, or closed by..."]' />
        </div>
        <div class="col-auto">
            <div class="btn-group btn-group-sm flex-wrap" role="group" aria-label='@Loc["Filter by claim status"]'>
                @foreach (var c in chips)
                {
                    if (c.Value.Length == 0)
                    {
                        @* "All" is the ABSENCE of any ticked status, not a value
                           of its own -- a value would have to be filtered back
                           out again in SQL. Unticking the rest is what it does,
                           so it is a button that clears them. *@
                        <button type="button"
                                class="btn @(status.Count == 0 ? "btn-secondary active" : "btn-outline-secondary")"
                                onclick="this.closest('form').querySelectorAll('input[name=status]').forEach(b =&gt; b.checked = false); this.closest('form').requestSubmit();">@c.Label</button>
                    }
                    else
                    {
                        <input type="checkbox" class="btn-check" name="status" value="@c.Value"
                               id="claim-status-@c.Value" autocomplete="off" checked="@ChipOn(c.Value)"
                               onchange="this.form.requestSubmit()" />
                        <label class="btn @c.OutlineCss" for="claim-status-@c.Value">@c.Label</label>
                    }
                }
            </div>
        </div>
    </div>
    <div class="row g-2 align-items-center mt-1">
        <div class="col-auto">
            <span class="text-muted small"><i class="bi bi-clipboard-check me-1"></i>@Loc["QC assessment"]</span>
        </div>
        <div class="col-auto">
            <div class="btn-group btn-group-sm flex-wrap" role="group" aria-label='@Loc["Filter by QC claim assessment"]'>
                @foreach (var c in pChips)
                {
                    @* Radios, not checkboxes: the assessment is one verdict QC
                       recorded at finish time, and "Potential Claim AND No
                       Potential Claim" is not a question anyone can ask. "All"
                       is the empty value, which the filter reads as unset. *@
                    <input type="radio" class="btn-check" name="potential" value="@c.Value"
                           id="claim-potential-@(string.IsNullOrEmpty(c.Value) ? "all" : c.Value)"
                           autocomplete="off" checked="@((potential ?? "") == c.Value)"
                           onchange="this.form.requestSubmit()" />
                    <label class="btn @c.OutlineCss"
                           for="claim-potential-@(string.IsNullOrEmpty(c.Value) ? "all" : c.Value)">
                        @if (!string.IsNullOrEmpty(c.Icon))
                        {
                            <i class="bi @c.Icon me-1"></i>
                        }
                        @c.Label
                    </label>
                }
            </div>
        </div>
    </div>

    <div class="collapse @(panelOpen ? "show" : "")" id="claimFilters">
        <div class="card card-body mt-2 bg-body-tertiary">
            <div class="row g-2">
                <div class="col-6 col-md-2">
                    <label class="form-label small mb-1">@Loc["Container"]</label>
                    <input type="text" name="container" value="@f.Container" class="form-control form-control-sm"
                           placeholder='@Loc["any part"]' autocomplete="off" />
                </div>
                <div class="col-6 col-md-2">
                    <label class="form-label small mb-1">@Loc["BOL"]</label>
                    <input type="text" name="bol" value="@f.Bol" class="form-control form-control-sm"
                           placeholder='@Loc["any part"]' autocomplete="off" />
                </div>
                <div class="col-6 col-md-2">
                    <label class="form-label small mb-1">@Loc["PO"]</label>
                    <input type="text" name="po" value="@f.Po" class="form-control form-control-sm"
                           placeholder='@Loc["EBELN"]' autocomplete="off" />
                </div>
                <div class="col-6 col-md-2">
                    <label class="form-label small mb-1">@Loc["Arrival no."]</label>
                    <input type="text" name="arrivalNo" value="@f.ArrivalNo" class="form-control form-control-sm"
                           placeholder='@Loc["ARR-…"]' autocomplete="off" />
                </div>
                <div class="col-12 col-md-4">
                    <label class="form-label small mb-1">@Loc["Material"]</label>
                    <input type="text" name="material" value="@f.Material" class="form-control form-control-sm"
                           placeholder='@Loc["code or description"]' autocomplete="off" />
                </div>

                <partial name="_MultiSelectFilter" model="@(new MultiSelectFilterVm {
                    Name = "supplier", Label = Loc["Supplier"], AllLabel = Loc["All suppliers"],
                    ColumnCss = "col-12 col-md-4", Selected = f.Supplier,
                    Options = opts.Suppliers.Select(x => new MultiSelectOption(x, x)).ToList() })" />

                @if (plantScopeLocked != null)
                {
                    @* Scoped operator: the server forces this plant anyway, so
                       show why instead of a control that cannot take effect. *@
                    <div class="col-6 col-md-3">
                        <label class="form-label small mb-1">@Loc["Plant"]</label>
                        <div class="form-control form-control-sm bg-light d-flex align-items-center"
                             title="Your account is restricted to this plant.">
                            <i class="bi bi-lock-fill text-muted me-1"></i>
                            <span class="small">@Codes.PlantLabel(plantScopeLocked)</span>
                        </div>
                        <input type="hidden" data-filter-ignore name="plant" value="@plantScopeLocked" />
                    </div>
                }
                else
                {
                    <partial name="_MultiSelectFilter" model="@(new MultiSelectFilterVm {
                        Name = "plant", Label = Loc["Plant"], AllLabel = Loc["All plants"],
                        ColumnCss = "col-6 col-md-3", Selected = f.Plant,
                        Options = opts.Plants.Select(x => new MultiSelectOption(x, Codes.PlantLabel(x))).ToList() })" />
                }
                @* Storage codes repeat across plants, so each option carries its
                   plant in the label. The old control narrowed this list to the
                   picked plant with JS; with both sides multi-select there is no
                   single plant to key on, and the labelled list is what keeps
                   the choice unambiguous. *@
                <partial name="_MultiSelectFilter" model="@(new MultiSelectFilterVm {
                    Name = "storageLoc", Label = Loc["Storage location"],
                    AllLabel = Loc["All storage locations"],
                    ColumnCss = "col-6 col-md-3", Selected = f.StorageLoc,
                    Options = opts.StorageLocations
                        .Select(sl => new MultiSelectOption(sl.Code, Codes.StorageLocationLabel(sl.Plant, sl.Code)))
                        .DistinctBy(o => o.Value).ToList() })" />
                <partial name="_MultiSelectFilter" model="@(new MultiSelectFilterVm {
                    Name = "closedBy", Label = Loc["Closed by"], AllLabel = Loc["Anyone"],
                    ColumnCss = "col-6 col-md-2", Selected = f.ClosedBy,
                    Options = opts.ClosedBy.Select(x => new MultiSelectOption(x, x)).ToList() })" />
                <partial name="_MultiSelectFilter" model="@(new MultiSelectFilterVm {
                    Name = "claimOwner", Label = Loc["Claim owner"], AllLabel = Loc["Anyone"],
                    ColumnCss = "col-6 col-md-2", Selected = f.ClaimOwner,
                    Options = opts.ClaimOwners.Select(x => new MultiSelectOption(x, x)).ToList() })" />
                @* Dates filter on the QO's closed_at -- when you are looking at a
                   claim, the date that matters is when the inspection finished. *@
                <div class="col-6 col-md-2">
                    <label class="form-label small mb-1">@Loc["Closed from"]</label>
                    <input type="date" name="from" value="@D(f.From)" class="form-control form-control-sm" />
                </div>
                <div class="col-6 col-md-2">
                    <label class="form-label small mb-1">@Loc["Closed to"]</label>
                    <input type="date" name="to" value="@D(f.To)" class="form-control form-control-sm" />
                </div>
            </div>
            <div class="mt-2 d-flex gap-2">
                <button type="submit" class="btn btn-primary btn-sm"><i class="bi bi-funnel me-1"></i>@Loc["Apply filters"]</button>
                @if (f.AnyPanelFilter)
                {
                    <a asp-action="@(f.Archived ? "Archived" : "Index")" asp-route-status="@status" asp-route-search="@search"
                       class="btn btn-outline-secondary btn-sm">@Loc["Reset these filters"]</a>
                }
            </div>
        </div>
    </div>
</form>

<div class="card">
    <div class="table-responsive">
        @* data-col-key drives the Columns menu (columntoggle.js). Keys are
           stable names, not positions, so the conditional Order Status column
           below cannot shift what somebody chose to hide. data-col-off marks a
           column hidden until the user asks for it -- a default, not a
           permanent removal: both stay in the menu.

           The expander, QO Number and Open are locked: one opens the row, one
           identifies it, and one is how you act on it. *@
        <table id="claims-list" class="table table-hover align-middle mb-0 qms-index-table" data-coltoggle>
            <thead class="table-light">
                <tr>
                    <th style="width:2rem" aria-label='@Loc["Shipment details"]' data-col-key="expand" data-col-lock></th>
                    <th data-col-key="qono" data-col-lock>@Loc["QO Number"]</th>
                    <th data-col-key="arrivalno" data-col-off>@Loc["Arrival No"]</th>
                    <th data-col-key="container">@Loc["Container"]</th>
                    <th data-col-key="bol">@Loc["BOL"]</th>
                    <th data-col-key="po">@Loc["PO"]</th>
                    <th data-col-key="supplier">@Loc["Supplier"]</th>
                    <th class="text-center" data-col-key="products" title="Number of distinct products on the order — hover the count to list them">@Loc["Products"]</th>
                    @if (f.Archived)
                    {
                        @* The archive also holds orders that were never finished,
                           so their state is worth a column of its own. *@
                        <th data-col-key="orderstatus">@Loc["Order Status"]</th>
                    }
                    <th data-col-key="closed">@Loc["Closed"]</th>
                    <th data-col-key="closedby">@Loc["Closed By"]</th>
                    <th data-col-key="assessment">@Loc["QC Assessment"]</th>
                    <th data-col-key="claimstatus">@Loc["Claim Status"]</th>
                    <th data-col-key="notes" data-col-off>@Loc["Notes"]</th>
                    <th data-col-key="lastactivity">@Loc["Last activity"]</th>
                    <th class="text-end" data-col-key="open" data-col-lock>@Loc["Open"]</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr><td colspan="@(f.Archived ? 16 : 15)" class="text-center text-muted py-4">
                        @(f.Archived
                            ? "No archived Quality Orders match the current filters."
                            : "No closed Quality Orders match the current filters.")
                    </td></tr>
                }
                else
                {
                    foreach (var r in Model)
                    {
                        var badge = ClaimStatus.BadgeCssFor(r.ClaimStatus, r.StatusCode);
                        var label = ClaimStatus.LabelFor(r.ClaimStatus, r.StatusCode);
                        var lastActivity = r.LastActivityAt ?? r.ClosedAt;
                        var rowCss = r.UnreadCount > 0 ? "has-unread" : "";
                        var detailId = $"claimDetail{r.QualityOrderId}";
                        // Products arrive newline-separated (descriptions contain
                        // commas, so a comma split would break one product in two).
                        var products = string.IsNullOrWhiteSpace(r.Products)
                            ? Array.Empty<string>()
                            : r.Products.Split('\n', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
                        // A handful of orders carry 100+ distinct products; an
                        // unbounded tooltip is unreadable, so show the first 15
                        // and say how many are left. The badge still counts all.
                        const int tipMax = 15;
                        var productTip = products.Length == 0
                            ? ""
                            : "<ul class='claim-tip'>" +
                              string.Concat(products.Take(tipMax)
                                  .Select(pn => "<li>" + System.Net.WebUtility.HtmlEncode(pn) + "</li>")) +
                              (products.Length > tipMax
                                  ? "<li><em>+" + (products.Length - tipMax) + " more — open the order to see them all</em></li>"
                                  : "") +
                              "</ul>";
                        <tr class="@rowCss">
                            <td class="pe-0">
                                <button class="btn btn-sm btn-link p-0 text-muted claim-toggle" type="button"
                                        data-bs-toggle="collapse" data-bs-target="#@detailId"
                                        aria-expanded="false" aria-controls="@detailId"
                                        title="Show shipment &amp; inspection details">
                                    <i class="bi bi-chevron-right" aria-hidden="true"></i>
                                </button>
                            </td>
                            <td><code>@r.QualityOrderNo</code></td>
                            <td>@Txt(r.ArrivalNo)</td>
                            <td><code>@r.ContainerNo</code></td>
                            <td>@r.BolNo</td>
                            <td>@r.Ebeln</td>
                            <td>@r.VendorName</td>
                            @* Product COUNT, not the list: the full names were the
                               widest column on the page and forced a horizontal
                               scroll. Hovering shows every product, same peek
                               pattern as Pending Containers. *@
                            <td class="text-center">
                                @if (products.Length == 0)
                                {
                                    <span class="text-muted">—</span>
                                }
                                else
                                {
                                    <span class="badge bg-primary-subtle text-primary-emphasis"
                                          data-bs-toggle="tooltip" data-bs-html="true"
                                          data-bs-placement="bottom" data-bs-title="@productTip"
                                          title="@productTip">@products.Length</span>
                                }
                            </td>
                            @if (f.Archived)
                            {
                                <td><span class="badge bg-secondary">@QualityOrderStatus.DisplayName(r.StatusCode)</span></td>
                            }
                            <td>@TsUtc(r.ClosedAt)</td>
                            <td>@r.ClosedBy</td>
                            <td>
                                <span class="badge @ClaimAssessment.BadgeCss(r.PotentialClaim)"
                                      title="@ClaimAssessment.Label(r.PotentialClaim)@(r.PotentialClaimBy is { Length: > 0 } pcBy ? $" — set by {pcBy}" : " — chosen by QC when the order was finished")">
                                    <i class="bi @ClaimAssessment.Icon(r.PotentialClaim) me-1"></i>@ClaimAssessment.ShortLabel(r.PotentialClaim)
                                </span>
                            </td>
                            <td><span class="badge @badge" title="@label">@ClaimStatus.ShortLabelFor(r.ClaimStatus, r.StatusCode)</span></td>
                            <td>
                                @if (r.NoteCount > 0)
                                {
                                    <span class="text-muted small"><i class="bi bi-chat-left-text me-1"></i>@r.NoteCount</span>
                                    if (r.UnreadCount > 0)
                                    {
                                        <span class="unread-pill" title="@r.UnreadCount new note(s) you haven't seen yet">
                                            @r.UnreadCount new
                                        </span>
                                    }
                                }
                                else
                                {
                                    <span class="text-muted small">—</span>
                                }
                            </td>
                            <td>@TsUtc(lastActivity)</td>
                            <td class="text-end">
                                <a asp-action="Details" asp-route-id="@r.QualityOrderId"
                                   class="btn btn-sm btn-outline-primary"
                                   aria-label='@Loc["View claim details"]' title="View claim details">
                                    <i class="bi bi-eye" aria-hidden="true"></i>
                                </a>
                            </td>
                        </tr>
                        @* Shipment + inspection detail, so a claim can be assessed
                           without leaving the list. Rendered with the row (no
                           extra request on expand) but deliberately LEAN: every
                           field already visible in the row above — arrival no,
                           container, BOL, PO, supplier, product, closed by/at,
                           both status badges — is left out. With ~500 claims on
                           the page, repeating them would roughly double the HTML
                           for no added information. *@
                        <tr class="claim-detail">
                            <td colspan="@(f.Archived ? 16 : 15)" class="p-0 border-0">
                                <div class="collapse" id="@detailId">
                                    <div class="p-3">
                                        <div class="row g-3">
                                            <div class="col-lg-4">
                                                <div class="fw-semibold small mb-1"><i class="bi bi-box-seam me-1"></i>@Loc["Shipment"]</div>
                                                <dl class="row mb-0">
                                                    <dt class="col-5">@Loc["Procurement type"]</dt><dd class="col-7">@Txt(Codes.PoTypeDisplay(r.PoType))</dd>
                                                    <dt class="col-5">@Loc["Plant"]</dt><dd class="col-7">@Txt(Codes.PlantDisplay(r.Plant))</dd>
                                                    <dt class="col-5">@Loc["Storage location"]</dt><dd class="col-7">@Txt(Codes.StorageLocationDisplay(r.Plant, r.StorageLocation))</dd>
                                                    <dt class="col-5">@Loc["Vessel / Voyage"]</dt><dd class="col-7">@Txt(r.VesselName) @(string.IsNullOrWhiteSpace(r.VoyageNumber) ? "" : "/ " + r.VoyageNumber)</dd>
                                                    <dt class="col-5">@Loc["Loading port"]</dt><dd class="col-7">@Txt(r.LoadingPort)@(string.IsNullOrWhiteSpace(r.LoadingCountry) ? "" : ", " + Countries.Display(r.LoadingCountry))</dd>
                                                    <dt class="col-5">@Loc["Port of arrival"]</dt><dd class="col-7">@Txt(r.ArrivalPlace)</dd>
                                                </dl>
                                            </div>
                                            <div class="col-lg-4">
                                                @* Timeline in event order — same sequence as the QC report. *@
                                                <div class="fw-semibold small mb-1"><i class="bi bi-calendar3 me-1"></i>@Loc["Timeline"]</div>
                                                <dl class="row mb-0">
                                                    <dt class="col-5">@Loc["Loading date"]</dt><dd class="col-7">@Dt(r.SailingDate)</dd>
                                                    <dt class="col-5">@Loc["Arrival date"]</dt><dd class="col-7">@Dt(r.ArrivalDate)</dd>
                                                    <dt class="col-5">@Loc["Discharge date"]</dt><dd class="col-7">@Dt(r.DischargeDate)</dd>
                                                    <dt class="col-5">@Loc["Inspection date"]</dt><dd class="col-7">@DtUtc(r.InspectionDate)</dd>
                                                </dl>
                                            </div>
                                            <div class="col-lg-4">
                                                <div class="fw-semibold small mb-1"><i class="bi bi-clipboard-check me-1"></i>@Loc["Inspection"]</div>
                                                <dl class="row mb-0">
                                                    <dt class="col-5">@Loc["Materials"]</dt><dd class="col-7">@r.MaterialCount</dd>
                                                    <dt class="col-5">@Loc["Samples"]</dt><dd class="col-7">@r.SampleCount</dd>
                                                    @if (r.PotentialClaimAt.HasValue)
                                                    {
                                                        <dt class="col-5">@Loc["Assessed by"]</dt>
                                                        <dd class="col-7">@r.PotentialClaimBy · @DtUtc(r.PotentialClaimAt)</dd>
                                                    }
                                                    <dt class="col-5">@Loc["Finish note"]</dt><dd class="col-7">@Txt(r.CloseReason)</dd>
                                                </dl>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>


@section Scripts {
    <script src="~/js/list-filter-memory.js" asp-append-version="true"></script>
}
