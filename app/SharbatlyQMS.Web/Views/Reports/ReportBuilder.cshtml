@using SharbatlyQMS.Web.Services
@using SharbatlyQMS.Web.Services.Reports
@{
    ViewData["Title"] = "Report Builder";
    var groups = ViewBag.MaterialGroups as IEnumerable<MaraGroup> ?? Enumerable.Empty<MaraGroup>();
    var canShare = (bool)(ViewBag.CanShare ?? false);
    var reportKey = (string)(ViewBag.ReportKey ?? "report_builder");
}

<form id="rbAfForm">@Html.AntiForgeryToken()</form>

<div id="reportBuilder"
     data-report="@reportKey"
     data-can-share="@canShare.ToString().ToLowerInvariant()">

    <div class="d-flex justify-content-between align-items-center mb-3">
        <h4 class="mb-0"><i class="bi bi-table me-2"></i>Report Builder</h4>
        <a asp-action="FlatDefects" class="btn btn-outline-secondary btn-sm">
            <i class="bi bi-bar-chart me-1"></i>Data Hub
        </a>
    </div>

    @* ---- Toolbar: material group + saved designs + save/delete ---- *@
    <div class="card mb-3">
        <div class="card-body">
            <div class="row g-2 align-items-end">
                <div class="col-md-3">
                    <label class="form-label small mb-1">Material group</label>
                    <select id="rbGroup" class="form-select form-select-sm">
                        <option value="">— pick a group —</option>
                        @foreach (var g in groups)
                        {
                            <option value="@g.Code">@g.Code@(string.IsNullOrWhiteSpace(g.Name) ? "" : " — " + g.Name)</option>
                        }
                    </select>
                </div>
                <div class="col-md-3">
                    <label class="form-label small mb-1">Saved designs</label>
                    <select id="rbSaved" class="form-select form-select-sm">
                        <option value="">— new report —</option>
                    </select>
                </div>
                <div class="col-md-3">
                    <label class="form-label small mb-1">Report name</label>
                    <input id="rbName" class="form-control form-control-sm" placeholder="e.g. Apple defects by container" />
                </div>
                <div class="col-md-3 text-end">
                    @if (canShare)
                    {
                        <div class="form-check form-check-inline">
                            <input class="form-check-input" type="checkbox" id="rbShared" />
                            <label class="form-check-label small" for="rbShared">Shared</label>
                        </div>
                    }
                    <button id="rbSave" class="btn btn-primary btn-sm"><i class="bi bi-save me-1"></i>Save</button>
                    <button id="rbSaveAs" class="btn btn-outline-primary btn-sm">Save as…</button>
                    <button id="rbDelete" class="btn btn-outline-danger btn-sm"><i class="bi bi-trash"></i></button>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-3">
        @* ---- Palette ---- *@
        <div class="col-lg-4">
            <div class="card h-100">
                <div class="card-header py-2 d-flex justify-content-between align-items-center">
                    <span class="fw-semibold small">Available fields</span>
                    <span>
                        <button id="rbAddCalc" class="btn btn-outline-success btn-sm py-0">+ Calculated</button>
                        <button id="rbAddTotal" class="btn btn-outline-primary btn-sm py-0">+ Total</button>
                        <button id="rbAddEmpty" class="btn btn-outline-secondary btn-sm py-0">+ Empty</button>
                    </span>
                </div>
                <div class="card-body p-2" id="rbPalette" style="max-height:70vh;overflow:auto;">
                    <div class="text-muted small">Loading…</div>
                </div>
            </div>
        </div>

        @* ---- Layout ---- *@
        <div class="col-lg-8">
            <div class="card h-100">
                <div class="card-header py-2 fw-semibold small">
                    Report layout <span class="text-muted">— drag fields here; order top-to-bottom = left-to-right in Excel</span>
                </div>
                <div class="card-body p-2">
                    <div id="rbLayout" class="rb-drop"></div>
                </div>
            </div>
        </div>
    </div>

    @* ---- Browse & export ---- *@
    <div class="card mt-3">
        <div class="card-header py-2 fw-semibold small"><i class="bi bi-funnel me-1"></i>Browse &amp; export</div>
        <div class="card-body">
            <div class="row g-2 align-items-end">
                <div class="col-md-3">
                    <label class="form-label small mb-1">Supplier</label>
                    <select id="rbVendor" class="form-select form-select-sm"><option value="">— all —</option></select>
                </div>
                <div class="col-md-3">
                    <label class="form-label small mb-1">Container</label>
                    <select id="rbContainer" class="form-select form-select-sm"><option value="">— all —</option></select>
                </div>
                <div class="col-md-2">
                    <label class="form-label small mb-1">BOL</label>
                    <input id="rbBol" class="form-control form-control-sm" />
                </div>
                <div class="col-md-2">
                    <label class="form-label small mb-1">PO</label>
                    <input id="rbPo" class="form-control form-control-sm" />
                </div>
                <div class="col-md-1">
                    <label class="form-label small mb-1">PO from</label>
                    <input id="rbPoFrom" type="date" class="form-control form-control-sm" />
                </div>
                <div class="col-md-1">
                    <label class="form-label small mb-1">PO to</label>
                    <input id="rbPoTo" type="date" class="form-control form-control-sm" />
                </div>
            </div>
            <div class="mt-3">
                <button id="rbPreview" class="btn btn-outline-secondary btn-sm"><i class="bi bi-eye me-1"></i>Preview</button>
                <button id="rbExport" class="btn btn-success btn-sm"><i class="bi bi-file-earmark-excel me-1"></i>Export to Excel</button>
                <span id="rbStatus" class="text-muted small ms-2"></span>
            </div>
            <div id="rbPreviewWrap" class="mt-3" style="display:none;">
                <div id="rbPreviewHeader" class="small mb-2"></div>
                <div class="table-responsive" style="max-height:45vh;overflow:auto;">
                    <table class="table table-sm table-bordered table-striped mb-0" id="rbPreviewTable"></table>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    #reportBuilder .rb-item { display:flex; align-items:center; gap:.35rem; padding:.25rem .5rem; margin:.15rem 0; border:1px solid #dee2e6; border-radius:.375rem; background:#fff; cursor:grab; font-size:.85rem; }
    #reportBuilder .rb-item:hover { background:#f1f5ff; border-color:#0d6efd; }
    #reportBuilder .rb-group-title { font-size:.72rem; text-transform:uppercase; letter-spacing:.03em; color:#6c757d; margin:.6rem 0 .2rem; }
    #reportBuilder .rb-drop { min-height:60vh; border:1px dashed #c9ced3; border-radius:.375rem; padding:.5rem; background:#fafbfc; }
    #reportBuilder .rb-drop.drag-over { background:#e7f1ff; border-color:#0d6efd; }
    #reportBuilder .rb-col { display:flex; flex-wrap:wrap; align-items:center; gap:.4rem; padding:.4rem .55rem; margin:.25rem 0; border:1px solid #dee2e6; border-left:4px solid #1f4e78; border-radius:.375rem; background:#fff; }
    #reportBuilder .rb-col.header { border-left-color:#b8860b; background:#fffdf5; }
    #reportBuilder .rb-col.dragging { opacity:.4; }
    #reportBuilder .rb-col .rb-handle { cursor:grab; color:#adb5bd; }
    #reportBuilder .rb-col .rb-label { font-weight:600; font-size:.85rem; min-width:6rem; border:none; background:transparent; }
    #reportBuilder .rb-col .rb-label:focus { outline:1px solid #0d6efd; border-radius:.2rem; background:#fff; }
    #reportBuilder .rb-col select, #reportBuilder .rb-col input { font-size:.75rem; padding:.1rem .3rem; }
    #reportBuilder .rb-col .rb-x { cursor:pointer; opacity:.5; color:#dc3545; margin-left:auto; }
    #reportBuilder .rb-col .rb-x:hover { opacity:1; }
    #reportBuilder .rb-kind { font-size:.65rem; padding:.05rem .3rem; border-radius:999px; background:#e9ecef; color:#495057; }
    #reportBuilder .rb-formula { font-family:monospace; font-size:.75rem; min-width:14rem; }
    #reportBuilder .rb-formula.invalid { border-color:#dc3545; background:#fff5f5; }
    /* Calc builder */
    #reportBuilder .rb-calc { flex:1 1 100%; margin-top:.25rem; }
    #reportBuilder .rb-calc-tools { display:flex; flex-wrap:wrap; align-items:center; gap:.25rem; margin-bottom:.25rem; }
    #reportBuilder .rb-calc-lbl { font-size:.7rem; color:#6c757d; text-transform:uppercase; letter-spacing:.03em; }
    #reportBuilder .rb-calc-tools .rb-op { font-size:.8rem; line-height:1; padding:.1rem .45rem; border:1px solid #ced4da; border-radius:.25rem; background:#f8f9fa; cursor:pointer; }
    #reportBuilder .rb-calc-tools .rb-op:hover { background:#e2e6ea; }
    #reportBuilder .rb-calc-tools .rb-numval { width:5.5rem; }
    #reportBuilder .rb-calc-tools .rb-addnum,
    #reportBuilder .rb-calc-tools .rb-clearf { font-size:.72rem; line-height:1; padding:.15rem .4rem; border:1px solid #ced4da; border-radius:.25rem; background:#fff; cursor:pointer; }
    #reportBuilder .rb-calc-hint { font-size:.68rem; color:#8a94a0; margin-top:.15rem; }
    #reportBuilder .rb-formula.rb-drop-hot { border-color:#0d6efd; background:#e7f1ff; }
    /* Total builder */
    #reportBuilder .rb-total-build { flex:1 1 100%; margin-top:.25rem; }
    #reportBuilder .rb-total-drop { min-height:2rem; display:flex; flex-wrap:wrap; align-items:center; gap:.3rem; padding:.3rem .4rem; border:1px dashed #c9ced3; border-radius:.375rem; background:#fafbfc; }
    #reportBuilder .rb-total-drop.rb-drop-hot { border-color:#0d6efd; background:#e7f1ff; }
    #reportBuilder .rb-total-empty { font-size:.72rem; color:#8a94a0; }
    #reportBuilder .rb-member { display:inline-flex; align-items:center; gap:.2rem; font-size:.75rem; padding:.1rem .4rem; border-radius:999px; background:#e7f1ff; border:1px solid #b6d4fe; color:#084298; }
    #reportBuilder .rb-member-x { cursor:pointer; opacity:.6; }
    #reportBuilder .rb-member-x:hover { opacity:1; color:#dc3545; }
    #reportBuilder .rb-total-sum { font-size:.72rem; color:#495057; margin-top:.2rem; font-family:monospace; }
</style>

<script src="~/js/report-builder.js" asp-append-version="true"></script>
