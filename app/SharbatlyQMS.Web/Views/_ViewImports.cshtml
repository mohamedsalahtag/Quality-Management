@using SharbatlyQMS.Web
@using SharbatlyQMS.Web.Models
@using SharbatlyQMS.Web.Models.Security
@using SharbatlyQMS.Web.Security
@using SharbatlyQMS.Web.Services
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@* What the signed-in user may do. Replaces the role-string comparisons the
   views used to compute for themselves, so a screen and its server-side gate
   can never disagree about who may press a button. *@
@inject IUserPermissions Perms
@* SAP code -> friendly name lookup (plants, storage locations, PO types).
   Injected globally because several list views resolve names per table cell;
   `Codes` is a singleton holding immutable dictionaries, so this is free. *@
@inject ICodeDescriptionDirectory Codes
@* Editable UI text. @Loc["Container"] prints "Container" until an administrator
   renames it on Admin -> Labels, and the English in the view stays the key, so
   the markup still says what it renders. *@
@inject ILabelService Loc
