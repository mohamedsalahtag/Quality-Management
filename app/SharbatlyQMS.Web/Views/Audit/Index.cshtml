@using SharbatlyQMS.Web.Models
@using SharbatlyQMS.Web.Services
@using SharbatlyQMS.Web.ViewModels
@model AuditListVm
@{
    ViewData["Title"] = "Activity log";
    var f    = Model.Filter;
    var opts = ViewBag.FilterOptions as AuditFilterOptions ?? new AuditFilterOptions();
    var canExport = Perms.Can(Perm.Admin.AuditExport);

    string DateStr(DateTime? d) => d?.ToString("yyyy-MM-dd") ?? "";

    bool TypeOn(string t) => f.EntityTypes != null && f.EntityTypes.Contains(t);
    bool ActOn (string a) => f.ActionCodes != null && f.ActionCodes.Contains(a);
    bool Sel(string? a, string? b) => string.Equals(a, b, StringComparison.OrdinalIgnoreCase);

    // Chips are grouped so administration types are reachable at all. Before,
    // the view rendered EntityTypes.All (operational only) and ActionCodes
    // .CrudOnly — so a Role or User row could only be found by hand-editing
    // ?entityTypes=Role into the URL, which is the opposite of discoverable.
    var workTypes  = EntityTypes.All;
    var adminTypes = EntityTypes.Admin;
    var allActions = ActionCodes.All;

    string BuildFilterQuery(bool withCursor)
    {
        var parts = new List<string>();
        if (f.Users != null) foreach (var u in f.Users) parts.Add("users=" + Uri.EscapeDataString(u));
        if (f.From.HasValue) parts.Add("from=" + f.From.Value.ToString("yyyy-MM-dd"));
        if (f.To.HasValue)   parts.Add("to="   + f.To.Value.ToString("yyyy-MM-dd"));
        if (!string.IsNullOrWhiteSpace(f.QoNo))      parts.Add("qoNo="      + Uri.EscapeDataString(f.QoNo));
        if (!string.IsNullOrWhiteSpace(f.Container)) parts.Add("container=" + Uri.EscapeDataString(f.Container));
        if (!string.IsNullOrWhiteSpace(f.Vendor))    parts.Add("vendor="    + Uri.EscapeDataString(f.Vendor));
        if (!string.IsNullOrWhiteSpace(f.Plant))     parts.Add("plant="     + Uri.EscapeDataString(f.Plant));
        if (f.EntityTypes != null) foreach (var e in f.EntityTypes) parts.Add("entityTypes=" + Uri.EscapeDataString(e));
        if (f.ActionCodes != null) foreach (var a in f.ActionCodes) parts.Add("actionCodes=" + Uri.EscapeDataString(a));
        if (f.ShowTechnical) parts.Add("showTechnical=true");
        if (f.PageSize != 25) parts.Add("pageSize=" + f.PageSize);
        if (withCursor && Model.NextCursorTime.HasValue)
        {
            parts.Add("cursorTime=" + Uri.EscapeDataString(Model.NextCursorTime.Value.ToString("o")));
            if (Model.NextCursorId.HasValue) parts.Add("cursorId=" + Model.NextCursorId.Value);
        }
        return parts.Count > 0 ? "?" + string.Join("&", parts) : "";
    }
}

<style>
    /* One row = one sentence. The detail table only exists once expanded, so a
       25-row page renders one table, not twenty-six nested ones. */
    .audit-sentence      { line-height: 1.35; }
    .audit-meta          { font-size: .78rem; }
    .audit-detail        { background: var(--bs-tertiary-bg); }
    .audit-detail td     { vertical-align: top; word-break: break-word; }
    .audit-json          { font-size: .72rem; white-space: pre-wrap; word-break: break-all;
                           max-height: 16rem; overflow: auto; margin: 0; }
    .audit-toggle        { cursor: pointer; }
</style>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">
        <i class="bi bi-journal-text me-1 text-primary"></i>Activity log
        <small class="text-muted fs-6 fw-normal ms-2">Who changed what, in plain words</small>
    </h1>
    @if (canExport)
    {
        <a class="btn btn-outline-success" href="@(Url.Action("Export") + BuildFilterQuery(false))">
            <i class="bi bi-file-earmark-excel me-1"></i>Export to Excel
        </a>
    }
</div>

<ul class="nav nav-tabs mb-3">
    <li class="nav-item"><a class="nav-link active" asp-action="Index"><i class="bi bi-journal-text me-1"></i>Activity log</a></li>
    <li class="nav-item"><a class="nav-link" asp-action="Security"><i class="bi bi-shield-lock me-1"></i>Users &amp; security</a></li>
</ul>

@* ---------------------------------------------------------------- filters *@
<div class="filter-panel mb-3" data-filter-panel data-key="audit-activity" data-has-filters="@(f.Any.ToString().ToLowerInvariant())">
    <div class="filter-summary">
        <button class="btn btn-sm btn-outline-secondary" type="button" data-filter-toggle
                data-bs-toggle="collapse" data-bs-target="#actFilters" aria-controls="actFilters">
            <i class="bi bi-funnel me-1"></i>Filters <i class="bi bi-chevron-down ms-1"></i>
        </button>
        @* Rendered server-side as well as by the script, so the count is right
           on first paint instead of flashing "No filters" and correcting itself. *@
        <span class="badge f-count @(f.ActiveCount > 0 ? "text-bg-primary" : "text-bg-secondary")" data-filter-count>
            @(f.ActiveCount == 0 ? "No filters" : $"{f.ActiveCount} filter{(f.ActiveCount == 1 ? "" : "s")}")
        </span>
        <span class="filter-chips" data-filter-chips></span>
        @if (f.Any)
        {
            <a asp-action="Index" class="btn btn-sm btn-link text-decoration-none">Clear all</a>
        }
    </div>

    <div class="collapse filter-body" id="actFilters" data-filter-body>
        <form method="get" class="p-3" data-filter-form>
            @* --- the record you are asking about ------------------------- *@
            <div class="small text-muted mb-1">Which records</div>
            <div class="row g-2 align-items-end">
                <div class="col-6 col-md-3">
                    <label class="form-label small mb-1">QC number</label>
                    <input name="qoNo" value="@f.QoNo" data-chip="QC number"
                           class="form-control form-control-sm"
                           placeholder="QO-2026-000353 or 000353" autocomplete="off" />
                </div>
                <div class="col-6 col-md-3">
                    <label class="form-label small mb-1">Container</label>
                    <input name="container" value="@f.Container" data-chip="Container"
                           class="form-control form-control-sm"
                           placeholder="part of the number is enough" autocomplete="off" />
                </div>
                <div class="col-6 col-md-4">
                    <label class="form-label small mb-1">Supplier</label>
                    <select name="vendor" class="form-select form-select-sm" data-chip="Supplier">
                        <option value="">Any supplier</option>
                        @foreach (var v in opts.Vendors)
                        {
                            <option value="@v" selected="@Sel(v, f.Vendor)">@v</option>
                        }
                    </select>
                </div>
                <div class="col-6 col-md-2">
                    <label class="form-label small mb-1">Plant</label>
                    <select name="plant" class="form-select form-select-sm" data-chip="Plant">
                        <option value="">Any plant</option>
                        @foreach (var pl in opts.Plants)
                        {
                            <option value="@pl" selected="@Sel(pl, f.Plant)">@pl</option>
                        }
                    </select>
                </div>
            </div>
            <div class="form-text mb-3">
                A QC number or container also matches its samples, readings, defects,
                material lines and claim &mdash; not just the order row itself.
            </div>

            @* --- who and when -------------------------------------------- *@
            <div class="small text-muted mb-1">Who and when</div>
            <div class="row g-2 align-items-end">
                <div class="col-12 col-md-4">
                    <label class="form-label small mb-1">Person</label>
                    <input name="users" data-chip="Person" class="form-control form-control-sm"
                           value="@(f.Users != null ? string.Join(", ", f.Users) : "")"
                           list="audit-actors"
                           placeholder="username, or several separated by commas" autocomplete="off" />
                    <datalist id="audit-actors">
                        @foreach (var a in opts.Actors) { <option value="@a"></option> }
                    </datalist>
                </div>
                @* Local dates. The old inputs were labelled "(UTC)" while the table
                   rendered local time, so rows near midnight looked like they fell
                   outside a range that visibly contained them. *@
                <div class="col-6 col-md-2">
                    <label class="form-label small mb-1">From</label>
                    <input name="from" type="date" data-chip="From" class="form-control form-control-sm" value="@DateStr(f.From)" />
                </div>
                <div class="col-6 col-md-2">
                    <label class="form-label small mb-1">To</label>
                    <input name="to" type="date" data-chip="To" class="form-control form-control-sm" value="@DateStr(f.To)" />
                </div>
                <div class="col-12 col-md-4">
                    <div class="form-check form-switch">
                        <input class="form-check-input" type="checkbox" name="showTechnical" id="a-tech"
                               value="true" checked="@f.ShowTechnical"
                               data-chip="Detail" data-chip-on="per-sample entries shown" />
                        <label class="form-check-label small" for="a-tech">
                            Include per-sample detail
                            <span class="text-muted">(readings, defects, sample edits &mdash; about 9 in every 10 entries)</span>
                        </label>
                    </div>
                </div>
            </div>

            @* --- what kind of thing ------------------------------------- *@
            <div class="row g-3 mt-1">
                <div class="col-12 col-lg-7">
                    <div class="small text-muted mb-1">What changed</div>
                    <div class="chip-group">
                        @foreach (var t in workTypes)
                        {
                            <input type="checkbox" class="btn-check" name="entityTypes" value="@t" id="et-@t"
                                   checked="@TypeOn(t)" autocomplete="off"
                                   data-chip="Record type" data-chip-value="@AuditNarrator.EntityLabel(t)" />
                            <label class="btn btn-sm btn-outline-secondary" for="et-@t">@AuditNarrator.EntityLabel(t)</label>
                        }
                    </div>
                    <div class="small text-muted mt-2 mb-1">Administration</div>
                    <div class="chip-group">
                        @foreach (var t in adminTypes)
                        {
                            <input type="checkbox" class="btn-check" name="entityTypes" value="@t" id="et-@t"
                                   checked="@TypeOn(t)" autocomplete="off"
                                   data-chip="Record type" data-chip-value="@AuditNarrator.EntityLabel(t)" />
                            <label class="btn btn-sm btn-outline-primary" for="et-@t">@AuditNarrator.EntityLabel(t)</label>
                        }
                    </div>
                </div>
                <div class="col-12 col-lg-5">
                    <div class="small text-muted mb-1">Kind of change</div>
                    <div class="chip-group">
                        @foreach (var a in allActions)
                        {
                            <input type="checkbox" class="btn-check" name="actionCodes" value="@a" id="ac-@a"
                                   checked="@ActOn(a)" autocomplete="off"
                                   data-chip="Change" data-chip-value="@AuditNarrator.ActionChip(a)" />
                            <label class="btn btn-sm btn-outline-dark" for="ac-@a">@AuditNarrator.ActionChip(a)</label>
                        }
                    </div>
                </div>
            </div>

            <div class="d-flex gap-2 mt-3 align-items-center">
                <button type="submit" class="btn btn-primary btn-sm" data-filter-apply>
                    <i class="bi bi-funnel me-1"></i>Apply filters
                </button>
                <a asp-action="Index" class="btn btn-outline-secondary btn-sm">Clear</a>
                @if (!f.ShowTechnical && (f.EntityTypes == null || f.EntityTypes.Length == 0))
                {
                    <span class="text-muted small">
                        <i class="bi bi-funnel-fill me-1"></i>Per-sample entries are hidden.
                    </span>
                }
            </div>
        </form>
    </div>
</div>

@* ---------------------------------------------------------------- results *@
<div class="card">
    <div class="card-header py-2"><small>@Model.Rows.Count entr@(Model.Rows.Count == 1 ? "y" : "ies") shown</small></div>
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th style="width:10rem">When</th>
                    <th>What happened</th>
                    <th style="width:3rem"></th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Rows.Count == 0)
                {
                    <tr><td colspan="3" class="text-center text-muted py-4">
                        No entries match these filters.
                        <a asp-action="Index" class="ms-1">Clear them</a>
                    </td></tr>
                }
                else
                {
                    foreach (var e in Model.Rows)
                    {
                        var local    = e.ChangedAt.ToLocalTime();
                        var detailId = $"ad-{e.AuditId}";
                        var changes  = AuditNarrator.Expand(e);
                        var hasDetail = changes.Count > 0
                                        || !string.IsNullOrWhiteSpace(e.OldValuesJson)
                                        || !string.IsNullOrWhiteSpace(e.NewValuesJson);
                        <tr>
                            <td class="small text-nowrap">
                                <div>@local.ToString("yyyy-MM-dd")</div>
                                <div class="text-muted">@local.ToString("HH:mm:ss")</div>
                            </td>
                            <td>
                                <div class="audit-sentence">@AuditNarrator.Sentence(e)</div>
                                <div class="audit-meta text-muted">
                                    @AuditNarrator.EntityLabel(e.EntityType)
                                    @if (e.EntityId > 0) { <text>#@e.EntityId</text> }
                                    @* The business keys the service resolved. These are
                                       what makes a row findable by someone who knows the
                                       container but not the sample id. *@
                                    @if (!string.IsNullOrWhiteSpace(e.QoNo))
                                    {
                                        <text> · </text><span class="badge text-bg-light border">@e.QoNo</span>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(e.ContainerNo))
                                    {
                                        <text> </text><span class="badge text-bg-light border">@e.ContainerNo</span>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(e.SourceDeviceName) || !string.IsNullOrWhiteSpace(e.SourceIp))
                                    {
                                        <text> · from @(e.SourceDeviceName ?? e.SourceIp)</text>
                                    }
                                </div>
                            </td>
                            <td class="text-end">
                                @if (hasDetail)
                                {
                                    <button class="btn btn-sm btn-outline-secondary audit-toggle" type="button"
                                            data-bs-toggle="collapse" data-bs-target="#@detailId"
                                            aria-expanded="false" aria-controls="@detailId"
                                            title="Show exactly what changed">
                                        <i class="bi bi-chevron-down"></i>
                                    </button>
                                }
                            </td>
                        </tr>
                        @if (hasDetail)
                        {
                            <tr class="collapse audit-detail" id="@detailId">
                                <td colspan="3">
                                    @if (changes.Count > 0)
                                    {
                                        <div class="mb-2">
                                            @foreach (var d in changes)
                                            {
                                                <partial name="_ValueChange" model="d" />
                                            }
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="small text-muted mb-2">No field-level differences were recorded.</div>
                                    }

                                    @* Full values are no longer trapped in a title tooltip you
                                       cannot copy from. *@
                                    <details>
                                        <summary class="small text-muted">Technical detail</summary>
                                        <div class="row g-2 mt-1">
                                            <div class="col-12 col-md-6">
                                                <div class="small text-muted">Before</div>
                                                <pre class="audit-json">@(e.OldValuesJson ?? "(none)")</pre>
                                            </div>
                                            <div class="col-12 col-md-6">
                                                <div class="small text-muted">After</div>
                                                <pre class="audit-json">@(e.NewValuesJson ?? "(none)")</pre>
                                            </div>
                                        </div>
                                        <div class="small text-muted mt-1">
                                            Action code <code>@e.ActionCode</code> ·
                                            record type <code>@e.EntityType</code> ·
                                            entry <code>#@e.AuditId</code>
                                            @if (!string.IsNullOrWhiteSpace(e.SourceUserAgent))
                                            {
                                                <text> · </text><span>@e.SourceUserAgent</span>
                                            }
                                        </div>
                                    </details>
                                </td>
                            </tr>
                        }
                    }
                }
            </tbody>
        </table>
    </div>
    @if (Model.HasMore)
    {
        <div class="card-footer text-center py-2">
            <a class="btn btn-sm btn-outline-primary"
               href="@(Url.Action("Index") + BuildFilterQuery(true))">
                Load more <i class="bi bi-chevron-down ms-1"></i>
            </a>
        </div>
    }
</div>

<partial name="_FilterPanelAssets" />
