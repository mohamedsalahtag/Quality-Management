@using SharbatlyQMS.Web.Models
@using SharbatlyQMS.Web.ViewModels
@model Sample
@{
    var qo            = ViewBag.QualityOrder    as QualityOrder ?? new QualityOrder();
    var qoMat         = ViewBag.QoMaterial      as QualityOrderMaterial;
    var readingTypes  = ViewBag.ReadingTypes    as IReadOnlyList<ReadingTypeEntry>   ?? new List<ReadingTypeEntry>();
    var defects       = ViewBag.Defects         as IReadOnlyList<DefectCatalogEntry> ?? new List<DefectCatalogEntry>();
    var sectionMap    = ViewBag.SectionMap      as IReadOnlyDictionary<string,string> ?? new Dictionary<string,string>();
    var existingReads = ViewBag.ExistingReadings as IReadOnlyList<SampleReading> ?? new List<SampleReading>();
    var existingDefs  = ViewBag.ExistingDefects  as IReadOnlyList<SampleDefect>  ?? new List<SampleDefect>();
    var headerFields  = ViewBag.HeaderFields     as IReadOnlyList<SampleHeaderField> ?? new List<SampleHeaderField>();
    var existingHdr   = ViewBag.ExistingHeader   as IReadOnlyList<SampleHeaderValue> ?? new List<SampleHeaderValue>();
    var matFields     = ViewBag.MaterialHeaderFields as IReadOnlyList<SampleHeaderField>  ?? new List<SampleHeaderField>();
    var matValues     = ViewBag.MaterialHeaderValues as IReadOnlyList<MaterialHeaderValue> ?? new List<MaterialHeaderValue>();
    var categories    = ViewBag.Categories as IReadOnlyList<DefectCategory> ?? new List<DefectCategory>();
    ViewData["Title"] = $"Sample #{Model.SampleNo}";
    var editable = qo.StatusCode == QualityOrderStatus.Open;

    var vm = new SampleFormVm
    {
        Qo = qo,
        Sample = Model,
        QoMaterial = qoMat,
        ReadingTypes = readingTypes,
        Defects = defects,
        SectionMap = sectionMap,
        ExistingReadings = existingReads,
        ExistingDefects = existingDefs,
        HeaderFields = headerFields,
        ExistingHeader = existingHdr,
        MaterialHeaderFields = matFields,
        MaterialHeaderValues = matValues,
        Categories = categories,
        Editable = editable
    };
}

<div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
    <div>
        <h1 class="h3 mb-1"><i class="bi bi-clipboard me-1"></i>Sample #@Model.SampleNo</h1>
        <div class="small text-muted">
            QO <a asp-action="Details" asp-route-id="@Model.QualityOrderId">@qo.QualityOrderNo</a>
            &mdash; Material <code>@qoMat?.MaterialNo</code> @qoMat?.MaterialDesc
        </div>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="Details" asp-route-id="@Model.QualityOrderId" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left me-1"></i>Back to QO
        </a>
        @if (editable)
        {
            <form asp-action="DeleteSample" method="post" data-confirm="Delete this sample?" data-confirm-danger data-confirm-ok="Delete">
                @Html.AntiForgeryToken()
                <input type="hidden" name="sampleId" value="@Model.SampleId" />
                <button type="submit" class="btn btn-outline-danger"><i class="bi bi-trash me-1"></i>Delete sample</button>
            </form>
        }
    </div>
</div>

<partial name="_SampleForm" model="vm" />

@section Scripts {
<script>
    // Standalone page: deep-link / no-JS-Details access. Wire the same
    // touch-friendly defect stepper + auto-net weight compute used inside
    // the QO Details drawer so direct visitors get the same experience.
    // Rule: SUM of all defect values on a sample <= sample size; each input
    // caps at (sampleSize - sumOfOtherDefects). Mirrored server-side.
    // Defensive: same fallback chain + multi-event listeners + dynamic max
    // as the drawer flow in Details.cshtml.
    function resolveSampleSize(form) {
        if (!form) return 0;
        const fromData = parseFloat(form.dataset.sampleSize);
        if (fromData > 0) return fromData;
        const sizeInput = form.querySelector('.sample-size-input');
        const fromInput = parseFloat(sizeInput?.value);
        return (fromInput > 0) ? fromInput : 0;
    }
    function sumOtherDefects(form, exceptInput) {
        let sum = 0;
        form.querySelectorAll('.defect-value').forEach(el => {
            if (el === exceptInput) return;
            const x = parseFloat(el.value);
            if (!isNaN(x) && x > 0) sum += x;
        });
        return sum;
    }
    function refreshDefectTotal(form, clampedTo) {
        if (!form) return;
        const size = resolveSampleSize(form);
        let total = 0;
        form.querySelectorAll('.defect-value').forEach(el => {
            const x = parseFloat(el.value);
            if (!isNaN(x) && x > 0) total += x;
        });
        const banner   = form.querySelector('.defect-total-banner');
        const curSpan  = form.querySelector('.defect-total-current');
        const sizeSpan = form.querySelector('.defect-total-size');
        const noteSpan = form.querySelector('.defect-total-note');
        if (curSpan)  curSpan.textContent  = (Math.round(total * 1000) / 1000).toString();
        if (sizeSpan) sizeSpan.textContent = (size > 0) ? size.toString() : '—';
        if (!banner) return;
        if (!(size > 0)) {
            banner.dataset.state = 'no-size';
            banner.classList.remove('text-danger', 'fw-bold');
            banner.classList.add('text-muted');
            banner.title = '';
            if (noteSpan) noteSpan.textContent = ' — sample size not set; use "Override size" on the material card.';
            return;
        }
        if (noteSpan) noteSpan.textContent = '';
        const atCap = (total >= size - 1e-9);
        const justClamped = (clampedTo === true) && atCap;
        if (justClamped) {
            banner.dataset.state = 'over';
            banner.classList.remove('text-muted');
            banner.classList.add('text-danger', 'fw-bold');
            banner.title = 'Sample size limit reached — extra values were capped';
        } else {
            banner.dataset.state = 'ok';
            banner.classList.remove('text-danger', 'fw-bold');
            banner.classList.add('text-muted');
            banner.title = '';
        }
    }
    (function wireDefectSteppers(scope) {
        scope.querySelectorAll('.defect-stepper').forEach(row => {
            const input = row.querySelector('.defect-value');
            const minus = row.querySelector('.defect-minus');
            const plus  = row.querySelector('.defect-plus');
            const clampToRemaining = (v) => {
                const form = row.closest('form');
                const size = resolveSampleSize(form);
                if (!(size > 0)) return v;
                const remaining = Math.max(0, size - sumOtherDefects(form, input));
                return (v > remaining) ? remaining : v;
            };
            const updatePct = () => {
                const form = row.closest('form');
                const size = resolveSampleSize(form);
                if (size > 0) {
                    input.max = Math.max(0, size - sumOtherDefects(form, input));
                } else {
                    input.removeAttribute('max');
                }
                let v = parseFloat(input.value);
                let clamped = false;
                if (!isNaN(v)) {
                    const capped = clampToRemaining(v);
                    if (capped !== v) { input.value = capped; v = capped; clamped = true; }
                }
                const pctInput = form.querySelector('input[name="defect_' + input.dataset.id + '_pct"]');
                const badge = row.querySelector('.defect-pct-badge');
                if (!isNaN(v) && size > 0) {
                    const pct = (v / size * 100);
                    if (pctInput) pctInput.value = pct.toFixed(2);
                    if (badge) {
                        badge.textContent = pct.toFixed(1) + '%';
                        badge.className = 'badge defect-pct-badge ' + (pct < 2 ? 'bg-success' : pct < 5 ? 'bg-warning text-dark' : 'bg-danger');
                    }
                } else if (badge) {
                    badge.textContent = '';
                    badge.className = 'badge defect-pct-badge bg-light text-muted';
                }
                refreshDefectTotal(form, clamped);
            };
            const bump = delta => {
                // parseFloat (not parseInt) so stepping a decimal value keeps its
                // fraction — matches the QO Details drawer stepper.
                const cur = parseFloat(input.value);
                let next = Math.max(0, (isNaN(cur) ? 0 : cur) + delta);
                next = clampToRemaining(next);
                input.value = next;
                updatePct();
            };
            minus?.addEventListener('click', () => bump(-1));
            plus?.addEventListener('click',  () => bump(+1));
            input?.addEventListener('input',  updatePct);
            input?.addEventListener('change', updatePct);
            input?.addEventListener('blur',   updatePct);
            updatePct();
        });
        // Live update when the operator edits the per-sample Sample Size
        // input -- same as the drawer flow in Details.cshtml.
        scope.querySelectorAll('form.sample-form').forEach(form => {
            const sizeInput = form.querySelector('.sample-size-input');
            if (sizeInput && sizeInput.dataset.banwired !== '1') {
                sizeInput.dataset.banwired = '1';
                sizeInput.addEventListener('input', () => {
                    const n = parseFloat(sizeInput.value);
                    form.dataset.sampleSize = (n > 0) ? n : '';
                    form.querySelectorAll('.defect-value').forEach(el => {
                        el.dispatchEvent(new Event('input', { bubbles: true }));
                    });
                    refreshDefectTotal(form, false);
                });
            }
            refreshDefectTotal(form, false);
        });
    })(document);

    // NET_WEIGHT = GROSS - TARA. The Net input is rendered read-only by the
    // partial; this script keeps it in sync as the operator types Gross or
    // Tara. The server also recomputes Net on save (authoritative).
    (function wireWeightCompute(scope) {
        scope.querySelectorAll('form.sample-form').forEach(form => {
            const gross = form.querySelector('[data-weight-role="gross"]');
            const tara  = form.querySelector('[data-weight-role="tara"]');
            const net   = form.querySelector('[data-weight-role="net"]');
            if (!net || (!gross && !tara)) return;
            const recompute = () => {
                const g = parseFloat(gross?.value);
                const t = parseFloat(tara?.value);
                if (!isNaN(g) && !isNaN(t)) {
                    net.value = (Math.round((g - t) * 100) / 100).toString();
                } else {
                    net.value = '';
                }
            };
            gross?.addEventListener('input', recompute);
            tara?.addEventListener('input', recompute);
        });
    })(document);
</script>
}
