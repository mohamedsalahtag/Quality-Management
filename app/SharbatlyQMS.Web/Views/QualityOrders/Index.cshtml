@using SharbatlyQMS.Web.Models
@using SharbatlyQMS.Web.ViewModels
@model IReadOnlyList<QualityOrder>
@{
    ViewData["Title"] = Loc["Quality Orders"];
    var f       = ViewBag.Filter as QoListFilter ?? new QoListFilter();
    var opts    = ViewBag.FilterOptions as QoFilterOptions ?? new QoFilterOptions();
    var status  = f.Status;
    var search  = f.Search;
    var plantScopeLocked = ViewBag.PlantScopeLocked as string;
    // Panel starts collapsed, but opens itself when the URL already carries
    // panel filters -- otherwise a bookmarked link shows a short list with no
    // visible reason for it.
    var panelOpen = f.AnyPanelFilter;
    string D(DateTime? d) => d?.ToString("yyyy-MM-dd") ?? "";

    // Server-side paging. The list is ~2,000 orders; rendering all of them so
    // the browser could page them was 6.6 MB of HTML per load.
    var totalCount = ViewBag.TotalCount as int? ?? Model.Count;
    var pageNo     = ViewBag.PageNo    as int? ?? 1;
    var pageSize   = ViewBag.PageSize  as int? ?? 50;
    var pageCount  = (int)Math.Ceiling(totalCount / (double)Math.Max(1, pageSize));
    var firstRow   = totalCount == 0 ? 0 : ((pageNo - 1) * pageSize) + 1;
    var lastRow    = Math.Min(pageNo * pageSize, totalCount);

    // A query STRING, not asp-all-route-data: that is a Dictionary and cannot
    // repeat a key, so the multi-select filters would collapse to one value
    // each on page 2 -- widening the list without anyone touching a control.
    string PageQuery(int pg, int size)
    {
        var q = new List<string>();
        void Add(string k, string? v)
        {
            if (!string.IsNullOrWhiteSpace(v))
                q.Add($"{Uri.EscapeDataString(k)}={Uri.EscapeDataString(v!)}");
        }
        void AddMany(string k, IEnumerable<string> vs) { foreach (var v in vs) Add(k, v); }

        AddMany("status", f.Status);      Add("search", f.Search);
        Add("qoNo", f.QoNo);              Add("container", f.Container);
        Add("bol", f.Bol);                Add("po", f.Po);
        Add("arrivalNo", f.ArrivalNo);    Add("material", f.Material);
        Add("matMajor", f.MatMajor);      Add("matSubMajor", f.MatSubMajor);
        AddMany("supplier", f.Supplier);  AddMany("plant", f.Plant);
        AddMany("storageLoc", f.StorageLoc);
        AddMany("openedBy", f.OpenedBy);
        Add("reinspection", f.Reinspection);
        Add("from", D(f.From));           Add("to", D(f.To));
        q.Add($"page={pg}");
        q.Add($"pageSize={size}");
        return "?" + string.Join("&", q);
    }

    // Orphan values -- a remembered supplier with no orders left in scope, a
    // storage location that no longer pairs with any plant -- are rendered by
    // _MultiSelectFilter as real, ticked entries flagged "(no matching
    // records)". Before that they vanished from their control while still
    // filtering on the server, so the page looked like it had filtered itself:
    // panel open, a badge, a short list, every control apparently empty.
}

<style>
    /* Materials "quick peek": first material inline + a "+N more" badge; the
       full list lives in a Bootstrap tooltip so the row stays on one line but
       the reviewer can hover to read every material. Mirrors the Pending
       Containers page. Tooltips are auto-initialised site-wide by site.js. */
    .qo-peek         { display: flex; align-items: center; gap: .35rem;
                       max-width: 320px; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }
    .qo-peek .qo-name{ text-overflow: ellipsis; overflow: hidden; }
    /* The tooltip body is HTML so we can lay the material list out cleanly. */
    .tooltip-inner   { max-width: 460px; text-align: left; }
    .qo-tip          { margin: 0; padding: 0; list-style: none; font-size: .8rem; }
    .qo-tip li       { padding: 2px 0; border-bottom: 1px dashed rgba(255,255,255,.18); }
    .qo-tip li:last-child { border-bottom: 0; }
    .qo-tip .qo-tip-qty { opacity: .8; margin-left: .35rem; }
    /* The table's own density now comes from .qms-index-table in site.css, so
       the Arrivals list renders at the same size. Only the peek width, which is
       specific to this page, stays here. */
    .qo-peek { max-width: 240px; }
    @@media (max-width: 575.98px) { .qo-peek { max-width: 150px; } }
</style>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0"><i class="bi bi-clipboard-data me-1"></i>@Loc["Quality Orders"]</h1>
</div>

@{
    // Status filter is a button group placed after the Filter submit. Each
    // toggle is its own submit, so picking a status posts the form (preserving
    // the search text) without an extra click.
    //
    // Cancelled is deliberately absent -- Quality Orders aren't cancelled in
    // practice. Labels come from QualityOrderStatus.DisplayName so this page
    // can't drift from the rest of the app again (Closed reads "Finished").
    var statuses = new (string Value, string OutlineCss)[]
    {
        ("",                            "btn-outline-secondary"),
        (QualityOrderStatus.Initial,    "btn-outline-secondary"),
        (QualityOrderStatus.Open,       "btn-outline-primary"),
        (QualityOrderStatus.Submitted,  "btn-outline-warning"),
        (QualityOrderStatus.Closed,     "btn-outline-success"),
    };
    string ChipLabel(string v) => v.Length == 0 ? "All" : QualityOrderStatus.DisplayName(v);
    // Chips are checkboxes now, so more than one status can be on at once --
    // "everything still in flight" is Initial + Open + Submitted, which a
    // single-value chip could never express. "All" is the ABSENCE of any ticked
    // status rather than a value of its own, so it stays a plain link: giving it
    // a value would mean filtering that value back out again in SQL.
    bool ChipOn(string v) => status.Contains(v, StringComparer.OrdinalIgnoreCase);
}
@{
    // Every filter actually in force, named. Whatever put a filter there — a
    // bookmark, the remembered-filter restore, a value that has dropped off its
    // own dropdown — it is spelled out here rather than being inferable only
    // from a badge and a short list.
    var activeFilters = new List<string>();
    void Active(string label, string? value) { if (!string.IsNullOrWhiteSpace(value)) activeFilters.Add($"{label}: {value}"); }
    // Multi-select values are joined rather than counted: "Plant: Jeddah,
    // Riyadh" is the sentence a reader needs, and "Plant: 2" would send them
    // back to the panel to find out which two.
    void ActiveMany(string label, IEnumerable<string> values, Func<string, string>? display = null)
    {
        var listed = values.Where(v => !string.IsNullOrWhiteSpace(v))
                           .Select(v => display == null ? v : display(v))
                           .ToList();
        if (listed.Count > 0) activeFilters.Add($"{label}: {string.Join(", ", listed)}");
    }
    ActiveMany("Status", f.Status, QualityOrderStatus.DisplayName);
    Active("Search",      f.Search);
    Active("QO number",   f.QoNo);
    Active("Container",   f.Container);
    Active("BOL",         f.Bol);
    Active("PO",          f.Po);
    Active("Arrival no",  f.ArrivalNo);
    Active("Material",    f.Material);
    ActiveMany("Supplier",  f.Supplier);
    ActiveMany("Plant",     f.Plant, Codes.PlantLabel);
    ActiveMany("Storage",   f.StorageLoc);
    ActiveMany("Opened by", f.OpenedBy);
    // The empty default is not announced: showing the inspection that stands is
    // the normal view, not a filter someone should be told they applied.
    Active("Reinspection", f.Reinspection switch
    {
        "originals"     => "reinspected originals (reference)",
        "reinspections" => "reinspections",
        "all"           => "all, including superseded",
        _               => null
    });
    Active("From",        D(f.From));
    Active("To",          D(f.To));
}
@if (activeFilters.Count > 0)
{
    <div class="alert alert-warning py-2 px-3 small d-flex flex-wrap align-items-center gap-2 mb-2">
        <i class="bi bi-funnel-fill"></i>
        <strong>@Loc["Showing a filtered list."]</strong>
        @foreach (var af in activeFilters)
        {
            <span class="badge bg-secondary">@af</span>
        }
        <a asp-action="Index" class="btn btn-sm btn-outline-dark py-0" data-filter-clear>@Loc["Show all records"]</a>
    </div>
}

@* One form for everything: the always-visible quick bar and the collapsible
   panel below it. Collapsed inputs still submit (display:none is not disabled),
   which is exactly what we want -- the two sets AND together. *@
<form method="get" class="mb-3" data-filter-memory="qo">
    @* Enter inside a panel field does this plain submit rather than the first
       status chip (which would change the status filter). *@
    <button type="submit" class="visually-hidden" tabindex="-1" aria-hidden="true"></button>
    <div class="row g-2 align-items-stretch">
        <div class="col-auto d-flex gap-2">
            @* Filters toggle on the left, styled like the Pending Containers
               page. The panel carries its own Apply/Reset buttons. *@
            <button class="btn btn-outline-secondary" type="button"
                    data-bs-toggle="collapse" data-bs-target="#qoFilters"
                    aria-expanded="@(panelOpen ? "true" : "false")" aria-controls="qoFilters">
                <i class="bi bi-funnel me-1"></i>Filters
                @if (f.PanelFilterCount > 0)
                {
                    <span class="badge bg-primary ms-1">@f.PanelFilterCount</span>
                }
            </button>
            @if (f.Any)
            {
                <a asp-action="Index" class="btn btn-outline-secondary" title="Clear every filter" data-filter-clear>@Loc["Clear"]</a>
            }
            <div class="dropdown" data-coltoggle-ui="quality-orders">
                <button type="button" class="btn btn-outline-secondary dropdown-toggle"
                        data-bs-toggle="dropdown" data-bs-auto-close="outside" aria-expanded="false"
                        title="Choose which columns to show. Your choice is remembered on this device.">
                    <i class="bi bi-layout-three-columns me-1"></i>Columns<span class="badge bg-secondary ms-1 d-none"
                         data-coltoggle-count title="Columns currently hidden"></span>
                </button>
                <div class="dropdown-menu dropdown-menu-end p-2" data-coltoggle-menu style="min-width: 13rem;"></div>
            </div>
        </div>
        <div class="col-auto">
            <div class="btn-group" role="group" aria-label='@Loc["Filter by status"]'>
                @foreach (var s in statuses)
                {
                    @if (s.Value.Length == 0)
                    {
                        @* Unticks the status boxes and resubmits, rather than
                           linking to a bare Index: "All" means every STATUS, not
                           every record, and a link would silently drop the
                           supplier, plant and dates the user had also set. *@
                        <button type="button"
                                class="btn btn-sm @(status.Count == 0 ? "btn-secondary active" : "btn-outline-secondary")"
                                style="min-width:6.5rem" title="Show every status"
                                onclick="this.closest('form').querySelectorAll('input[name=status]').forEach(b =&gt; b.checked = false); this.closest('form').requestSubmit();">@ChipLabel(s.Value)</button>
                    }
                    else
                    {
                        @* btn-check: a checkbox that renders as a chip, so the
                           whole label is the hit area and ticking a second
                           status ADDS it instead of replacing the first. *@
                        <input type="checkbox" class="btn-check" name="status" value="@s.Value"
                               id="status-@s.Value" autocomplete="off" checked="@ChipOn(s.Value)"
                               onchange="this.form.requestSubmit()" />
                        <label class="btn btn-sm @s.OutlineCss" for="status-@s.Value"
                               style="min-width:6.5rem">@ChipLabel(s.Value)</label>
                    }
                }
            </div>
        </div>
    </div>

    <div class="collapse @(panelOpen ? "show" : "")" id="qoFilters">
        <div class="card card-body mt-2 bg-body-tertiary">
            <div class="row g-2">
                <div class="col-6 col-md-2">
                    <label class="form-label small mb-1">@Loc["Container"]</label>
                    <input type="text" name="container" value="@f.Container" class="form-control form-control-sm"
                           placeholder='@Loc["any part"]' autocomplete="off" />
                </div>
                <div class="col-6 col-md-2">
                    <label class="form-label small mb-1">@Loc["BOL"]</label>
                    <input type="text" name="bol" value="@f.Bol" class="form-control form-control-sm"
                           placeholder='@Loc["any part"]' autocomplete="off" />
                </div>
                <div class="col-6 col-md-2">
                    <label class="form-label small mb-1">@Loc["PO"]</label>
                    <input type="text" name="po" value="@f.Po" class="form-control form-control-sm"
                           placeholder='@Loc["EBELN"]' autocomplete="off" />
                </div>
                <div class="col-6 col-md-2">
                    <label class="form-label small mb-1">@Loc["QC number"]</label>
                    <input type="text" name="qoNo" value="@f.QoNo" class="form-control form-control-sm"
                           placeholder='@Loc["QO-2026-000632 or 000632"]' autocomplete="off" />
                </div>
                <div class="col-6 col-md-2">
                    <label class="form-label small mb-1">@Loc["Arrival no."]</label>
                    <input type="text" name="arrivalNo" value="@f.ArrivalNo" class="form-control form-control-sm"
                           placeholder='@Loc["ARR-…"]' autocomplete="off" />
                </div>
                <div class="col-12 col-md-4">
                    <label class="form-label small mb-1">@Loc["Material"]</label>
                    <input type="text" name="material" value="@f.Material" class="form-control form-control-sm"
                           placeholder='@Loc["code or description"]' autocomplete="off" />
                </div>
                <partial name="_MaterialCategoryFilter" model="@((f.MatMajor, f.MatSubMajor))" />

                <partial name="_MultiSelectFilter" model="@(new MultiSelectFilterVm {
                    Name = "supplier", Label = Loc["Supplier"], AllLabel = Loc["All suppliers"],
                    ColumnCss = "col-12 col-md-4", Selected = f.Supplier,
                    Searchable = true, SearchPlaceholder = Loc["Search supplier name…"],
                    Options = opts.Suppliers.Select(x => new MultiSelectOption(x, x)).ToList() })" />

                @if (plantScopeLocked != null)
                {
                    @* Scoped operator: the server forces this plant anyway, so
                       show why instead of a control that cannot take effect. *@
                    <div class="col-6 col-md-3">
                        <label class="form-label small mb-1">@Loc["Plant"]</label>
                        <div class="form-control form-control-sm bg-light d-flex align-items-center"
                             title="Your account is restricted to this plant.">
                            <i class="bi bi-lock-fill text-muted me-1"></i>
                            <span class="small">@Codes.PlantLabel(plantScopeLocked)</span>
                        </div>
                        <input type="hidden" data-filter-ignore name="plant" value="@plantScopeLocked" />
                    </div>
                }
                else
                {
                    <partial name="_MultiSelectFilter" model="@(new MultiSelectFilterVm {
                        Name = "plant", Label = Loc["Plant"], AllLabel = Loc["All plants"],
                        ColumnCss = "col-6 col-md-3", Selected = f.Plant,
                        Options = opts.Plants.Select(x => new MultiSelectOption(x, Codes.PlantLabel(x))).ToList() })" />
                }
                @* Storage codes repeat across plants, so each option carries its
                   plant in the label. The old control narrowed this list to the
                   picked plant with JS; with both sides multi-select that
                   narrowing no longer has a single plant to key on, and the
                   labelled list is what keeps the choice unambiguous. *@
                <partial name="_MultiSelectFilter" model="@(new MultiSelectFilterVm {
                    Name = "storageLoc", Label = Loc["Storage location"],
                    AllLabel = Loc["All storage locations"],
                    ColumnCss = "col-6 col-md-3", Selected = f.StorageLoc,
                    Options = opts.StorageLocations
                        .Select(sl => new MultiSelectOption(sl.Code, Codes.StorageLocationLabel(sl.Plant, sl.Code)))
                        .DistinctBy(o => o.Value).ToList() })" />
                <partial name="_MultiSelectFilter" model="@(new MultiSelectFilterVm {
                    Name = "openedBy", Label = Loc["Opened by"], AllLabel = Loc["Anyone"],
                    ColumnCss = "col-6 col-md-2", Selected = f.OpenedBy,
                    Options = opts.OpenedBy.Select(x => new MultiSelectOption(x, x)).ToList() })" />
                <div class="col-6 col-md-2">
                    <label class="form-label small mb-1">@Loc["Created from"]</label>
                    <input type="date" name="from" value="@D(f.From)" class="form-control form-control-sm" />
                </div>
                <div class="col-6 col-md-2">
                    <label class="form-label small mb-1">@Loc["Created to"]</label>
                    <input type="date" name="to" value="@D(f.To)" class="form-control form-control-sm" />
                </div>
                @* The badges in the status cell mark these rows, but finding a
                   handful of them by eye in a list hundreds long is the whole
                   difficulty -- so they are filterable too. *@
                <div class="col-6 col-md-2">
                    <label class="form-label small mb-1">@Loc["Reinspection"]</label>
                    <select name="reinspection" class="form-select form-select-sm">
                        <option value="">@Loc["Current inspections"]</option>
                        <option value="reinspections" selected="@(f.Reinspection == "reinspections")">
                            @Loc["Reinspections"]
                        </option>
                        <option value="originals" selected="@(f.Reinspection == "originals")">
                            @Loc["Reinspected originals (reference)"]
                        </option>
                        <option value="all" selected="@(f.Reinspection == "all")">
                            @Loc["All, including superseded"]
                        </option>
                    </select>
                </div>
            </div>
            <div class="mt-2 d-flex gap-2">
                <button type="submit" class="btn btn-primary btn-sm"><i class="bi bi-funnel me-1"></i>@Loc["Apply filters"]</button>
                @if (f.AnyPanelFilter)
                {
                    <a asp-action="Index" asp-route-status="@status" asp-route-search="@search"
                       class="btn btn-outline-secondary btn-sm">@Loc["Reset these filters"]</a>
                }
            </div>
        </div>
    </div>
</form>

<div class="card">
    <div class="table-responsive">
        @* data-col-key drives the Columns menu (columntoggle.js). Keys are
           stable names, not positions, so adding a column later does not shift
           what somebody chose to hide. QO Number and Actions are locked: one
           identifies the row and the other is how you act on it. *@
        @* data-no-pager: tablekit still sorts the page you are on, but the
           pager below is the server's. Sorting one page rather than the whole
           list is the trade for not shipping the whole list. *@
        <table id="quality-orders" class="table table-hover align-middle mb-0 qms-index-table"
               data-tablekit data-no-pager data-coltoggle>
            <thead class="table-light">
                <tr>
                    <th data-sort data-col-key="qono" data-col-lock>@Loc["QO Number"]</th>
                    <th data-sort data-col-key="container">@Loc["Container"]</th>
                    <th data-sort data-col-key="bol">@Loc["BOL"]</th>
                    <th data-sort data-col-key="po">@Loc["PO"]</th>
                    <th data-sort data-col-key="plant">@Loc["Plant"]</th>
                    <th data-sort data-col-key="supplier">@Loc["Supplier"]</th>
                    <th data-sort data-col-key="arrival">@Loc["Arrival"]</th>
                    <th data-col-key="materials">@Loc["Materials"]</th>
                    <th data-sort data-col-key="status">@Loc["Status"]</th>
                    <th data-sort data-col-key="created">@Loc["Created"]</th>
                    @* Who opened the QO, not who created it -- the inspector who
                       took ownership is the useful name. Blank while Initial. *@
                    <th data-sort data-col-key="openedby">@Loc["Opened By"]</th>
                    <th class="text-end" data-col-key="actions" data-col-lock>@Loc["Actions"]</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr><td colspan="12" class="text-center text-muted py-4">
                        No Quality Orders yet. Complete an arrival, then click <em>@Loc["Create Quality Order"]</em>.
                    </td></tr>
                }
                else
                {
                    foreach (var q in Model)
                    {
                        // Colour only -- the wording is QualityOrderStatus.DisplayName's
                        // job, so an unmapped status still reads correctly.
                        var cls = q.StatusCode switch {
                            QualityOrderStatus.Initial   => "secondary",
                            QualityOrderStatus.Open      => "primary",
                            QualityOrderStatus.Submitted => "warning text-dark",
                            QualityOrderStatus.Closed    => "success",
                            QualityOrderStatus.Cancelled => "dark",
                            _                            => "secondary"
                        };
                        var label = QualityOrderStatus.DisplayName(q.StatusCode);
                        var firstMat = q.MaterialLines.FirstOrDefault();
                        var extraMat = q.MaterialLines.Count - 1;
                        // Full material list for the hover tooltip: one <li> per
                        // material with code, description and (if present) qty/UoM.
                        // Material NAME only (no code) + qty/UoM when present.
                        var matTip = "<ul class='qo-tip'>" +
                            string.Concat(q.MaterialLines.Select(ml =>
                                "<li>" +
                                    System.Net.WebUtility.HtmlEncode(ml.MaterialDesc ?? "(no description)") +
                                    (ml.Quantity.HasValue && ml.Quantity.Value > 0
                                        ? "<span class='qo-tip-qty'>" + Fmt.Dec2(ml.Quantity.Value) + " " + System.Net.WebUtility.HtmlEncode(ml.Uom ?? "") + "</span>"
                                        : "") +
                                "</li>")) +
                            "</ul>";
                        <tr>
                            <td><code>@q.QualityOrderNo</code></td>
                            <td><code>@q.ContainerNo</code></td>
                            <td>@q.BolNo</td>
                            <td>@q.Ebeln</td>
                            <td>
                                @if (!string.IsNullOrEmpty(q.Plant))
                                {
                                    <span class="badge bg-light text-dark border"
                                          data-bs-toggle="tooltip" title="@q.Plant">@Codes.PlantDisplay(q.Plant)</span>
                                }
                                else
                                {
                                    <span class="text-muted">—</span>
                                }
                            </td>
                            <td class="cell-clip-sm" title="@q.VendorName">@q.VendorName</td>
                            <td>
                                <a asp-controller="Arrivals" asp-action="Details" asp-route-id="@q.ArrivalId"
                                   title="@q.ArrivalNo">
                                    <i class="bi bi-box-arrow-in-down me-1"></i>@q.ArrivalNo
                                </a>
                            </td>
                            <td class="cell-clip-sm">
                                @if (firstMat == null)
                                {
                                    <span class="text-muted small fst-italic">@Loc["No materials"]</span>
                                }
                                else
                                {
                                    <div class="qo-peek"
                                         data-bs-toggle="tooltip"
                                         data-bs-html="true"
                                         data-bs-placement="bottom"
                                         data-bs-title="@matTip"
                                         title="@matTip">
                                        @* Material name only — no material code — to keep the preview short. *@
                                        <span class="qo-name">@(string.IsNullOrWhiteSpace(firstMat.MaterialDesc) ? "(no description)" : firstMat.MaterialDesc)</span>
                                        @if (extraMat > 0)
                                        {
                                            <span class="badge bg-primary-subtle text-primary-emphasis">+@extraMat more</span>
                                        }
                                    </div>
                                }
                            </td>
                            <td>
                            <span class="badge bg-@cls">@label</span>
                            @* Beside the status rather than in a column of its
                               own: it qualifies the status ("finished, but
                               redone"), and a new column would mean touching
                               the hardcoded colspan on the empty-state row. *@
                            @if (q.IsSuperseded)
                            {
                                <span class="badge bg-secondary ms-1"
                                      title="@Loc["This inspection was redone. The reinspection carries the verdict."]">
                                    @Loc["Reinspected"]
                                </span>
                            }
                            else if (q.IsReinspection)
                            {
                                <span class="badge bg-info text-dark ms-1"
                                      title="@Loc["A second inspection of a container whose first result was judged unsound."]">
                                    @Loc["Reinspection"]
                                </span>
                            }
                        </td>
                            <td>@q.CreatedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</td>
                            <td>@q.OpenedBy</td>
                            <td class="text-end text-nowrap">
                                <a asp-action="Details" asp-route-id="@q.QualityOrderId"
                                   class="btn btn-sm btn-outline-primary" title="Open Quality Order">
                                    <i class="bi bi-eye"></i>
                                </a>
                                <a asp-controller="Reports" asp-action="QualityOrderPdf" asp-route-id="@q.QualityOrderId"
                                   class="btn btn-sm btn-outline-danger ms-1" target="_blank"
                                   title="Download Quality Order PDF report">
                                    <i class="bi bi-file-earmark-pdf"></i>
                                </a>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>

    @* ---- Server-side pager ----
       The controller ships one page at a time. Links carry every active filter
       so paging never widens the view, and the page-size select posts the same
       way. Mirrors /Arrivals and /Arrivals/Pending. ---- *@
    @if (totalCount > 0)
    {
        <div class="tk-pager d-flex justify-content-between align-items-center flex-wrap gap-2 px-3 py-2 border-top">
            <div class="d-flex align-items-center gap-2 small text-muted">
                <label class="mb-0">@Loc["Show"]</label>
                <select class="form-select form-select-sm" style="width:auto" data-pagesize-select>
                    @foreach (var n in new[] { 25, 50, 100 })
                    {
                        <option value="@n" selected="@(n == pageSize)">@n</option>
                    }
                </select>
                <span>@Loc["per page"]</span>
            </div>

            <span class="text-muted small">Showing @firstRow&ndash;@lastRow of @totalCount</span>

            @if (pageCount > 1)
            {
                <nav aria-label='@Loc["Quality order pages"]'>
                    <ul class="pagination pagination-sm mb-0">
                        @{
                            var pFrom = Math.Max(1, pageNo - 2);
                            var pTo   = Math.Min(pageCount, pageNo + 2);
                        }
                        <li class="page-item @(pageNo == 1 ? "disabled" : "")">
                            <a class="page-link" href="@PageQuery(pageNo - 1, pageSize)" aria-label='@Loc["Previous"]'>&laquo;</a>
                        </li>
                        @if (pFrom > 1)
                        {
                            <li class="page-item"><a class="page-link" href="@PageQuery(1, pageSize)">1</a></li>
                            @if (pFrom > 2)
                            {
                                <li class="page-item disabled"><span class="page-link">&hellip;</span></li>
                            }
                        }
                        @for (var pp = pFrom; pp <= pTo; pp++)
                        {
                            <li class="page-item @(pp == pageNo ? "active" : "")">
                                <a class="page-link" href="@PageQuery(pp, pageSize)">@pp</a>
                            </li>
                        }
                        @if (pTo < pageCount)
                        {
                            @if (pTo < pageCount - 1)
                            {
                                <li class="page-item disabled"><span class="page-link">&hellip;</span></li>
                            }
                            <li class="page-item"><a class="page-link" href="@PageQuery(pageCount, pageSize)">@pageCount</a></li>
                        }
                        <li class="page-item @(pageNo == pageCount ? "disabled" : "")">
                            <a class="page-link" href="@PageQuery(pageNo + 1, pageSize)" aria-label='@Loc["Next"]'>&raquo;</a>
                        </li>
                    </ul>
                </nav>
            }
        </div>
    }
</div>

@section Scripts {
    <script src="~/js/list-filter-memory.js" asp-append-version="true"></script>
    @* Wires the "rows per page" select; page links are plain <a> reloads. *@
    <script src="~/js/list-pager.js" asp-append-version="true"></script>
}
