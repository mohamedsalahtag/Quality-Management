@using SharbatlyQMS.Web.Models
@using SharbatlyQMS.Web.ViewModels
@model IReadOnlyList<QualityOrder>
@{
    ViewData["Title"] = Loc["Quality Orders"];
    var f       = ViewBag.Filter as QoListFilter ?? new QoListFilter();
    var opts    = ViewBag.FilterOptions as QoFilterOptions ?? new QoFilterOptions();
    var status  = f.Status;
    var search  = f.Search;
    var plantScopeLocked = ViewBag.PlantScopeLocked as string;
    // Panel starts collapsed, but opens itself when the URL already carries
    // panel filters -- otherwise a bookmarked link shows a short list with no
    // visible reason for it.
    var panelOpen = f.AnyPanelFilter;
    string D(DateTime? d) => d?.ToString("yyyy-MM-dd") ?? "";

    // A dropdown filter whose value is no longer among its options rendered as
    // "All ..." — the filter still ran on the server and still counted toward
    // the badge, so the page looked like it had filtered itself: panel open, a
    // badge, a short list, and every control apparently empty. It happens
    // whenever the options move out from under a remembered or bookmarked
    // value: a supplier with no orders left in scope, a plant/storage pairing
    // that does not exist, a user who has opened nothing recently.
    //
    // Orphans are now rendered as a real, selected option so the value is
    // visible and can be cleared.
    bool Orphan(string? value, IEnumerable<string> options) =>
        !string.IsNullOrWhiteSpace(value)
        && !options.Any(o => string.Equals(o, value, StringComparison.OrdinalIgnoreCase));
    var orphanSupplier = Orphan(f.Supplier, opts.Suppliers);
    var orphanPlant    = plantScopeLocked == null && Orphan(f.Plant, opts.Plants);
    var orphanOpenedBy = Orphan(f.OpenedBy, opts.OpenedBy);
    // Storage is matched as a (plant, code) pair, so mirror the option's own
    // selected test rather than comparing the code alone.
    var orphanStorage  = !string.IsNullOrWhiteSpace(f.StorageLoc)
        && !opts.StorageLocations.Any(sl =>
               string.Equals(sl.Code, f.StorageLoc, StringComparison.OrdinalIgnoreCase)
               && (string.IsNullOrEmpty(f.Plant) || string.Equals(sl.Plant, f.Plant, StringComparison.OrdinalIgnoreCase)));
}

<style>
    /* Materials "quick peek": first material inline + a "+N more" badge; the
       full list lives in a Bootstrap tooltip so the row stays on one line but
       the reviewer can hover to read every material. Mirrors the Pending
       Containers page. Tooltips are auto-initialised site-wide by site.js. */
    .qo-peek         { display: flex; align-items: center; gap: .35rem;
                       max-width: 320px; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }
    .qo-peek .qo-name{ text-overflow: ellipsis; overflow: hidden; }
    /* The tooltip body is HTML so we can lay the material list out cleanly. */
    .tooltip-inner   { max-width: 460px; text-align: left; }
    .qo-tip          { margin: 0; padding: 0; list-style: none; font-size: .8rem; }
    .qo-tip li       { padding: 2px 0; border-bottom: 1px dashed rgba(255,255,255,.18); }
    .qo-tip li:last-child { border-bottom: 0; }
    .qo-tip .qo-tip-qty { opacity: .8; margin-left: .35rem; }
    /* The table's own density now comes from .qms-index-table in site.css, so
       the Arrivals list renders at the same size. Only the peek width, which is
       specific to this page, stays here. */
    .qo-peek { max-width: 240px; }
    @@media (max-width: 575.98px) { .qo-peek { max-width: 150px; } }
</style>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0"><i class="bi bi-clipboard-data me-1"></i>@Loc["Quality Orders"]</h1>
</div>

@{
    // Status filter is a button group placed after the Filter submit. Each
    // toggle is its own submit, so picking a status posts the form (preserving
    // the search text) without an extra click.
    //
    // Cancelled is deliberately absent -- Quality Orders aren't cancelled in
    // practice. Labels come from QualityOrderStatus.DisplayName so this page
    // can't drift from the rest of the app again (Closed reads "Finished").
    var statuses = new (string Value, string OutlineCss)[]
    {
        ("",                            "btn-outline-secondary"),
        (QualityOrderStatus.Initial,    "btn-outline-secondary"),
        (QualityOrderStatus.Open,       "btn-outline-primary"),
        (QualityOrderStatus.Submitted,  "btn-outline-warning"),
        (QualityOrderStatus.Closed,     "btn-outline-success"),
    };
    string ChipLabel(string v) => v.Length == 0 ? "All" : QualityOrderStatus.DisplayName(v);
    string ActiveClass(string v, string baseCss) =>
        (status ?? "") == v ? baseCss.Replace("btn-outline-", "btn-") + " active" : baseCss;
}
@{
    // Every filter actually in force, named. Whatever put a filter there — a
    // bookmark, the remembered-filter restore, a value that has dropped off its
    // own dropdown — it is spelled out here rather than being inferable only
    // from a badge and a short list.
    var activeFilters = new List<string>();
    void Active(string label, string? value) { if (!string.IsNullOrWhiteSpace(value)) activeFilters.Add($"{label}: {value}"); }
    Active("Status",      string.IsNullOrEmpty(f.Status) ? null : QualityOrderStatus.DisplayName(f.Status));
    Active("Search",      f.Search);
    Active("QO number",   f.QoNo);
    Active("Container",   f.Container);
    Active("BOL",         f.Bol);
    Active("PO",          f.Po);
    Active("Arrival no",  f.ArrivalNo);
    Active("Material",    f.Material);
    Active("Supplier",    f.Supplier);
    Active("Plant",       f.Plant);
    Active("Storage",     f.StorageLoc);
    Active("Opened by",   f.OpenedBy);
    Active("Reinspection", f.Reinspection switch
    {
        "originals"     => "reinspected originals",
        "reinspections" => "reinspections",
        _               => null
    });
    Active("From",        D(f.From));
    Active("To",          D(f.To));
}
@if (activeFilters.Count > 0)
{
    <div class="alert alert-warning py-2 px-3 small d-flex flex-wrap align-items-center gap-2 mb-2">
        <i class="bi bi-funnel-fill"></i>
        <strong>@Loc["Showing a filtered list."]</strong>
        @foreach (var af in activeFilters)
        {
            <span class="badge bg-secondary">@af</span>
        }
        <a asp-action="Index" class="btn btn-sm btn-outline-dark py-0" data-filter-clear>@Loc["Show all records"]</a>
    </div>
}

@* One form for everything: the always-visible quick bar and the collapsible
   panel below it. Collapsed inputs still submit (display:none is not disabled),
   which is exactly what we want -- the two sets AND together. *@
<form method="get" class="mb-3" data-filter-memory="qo">
    @* Enter inside a panel field does this plain submit rather than the first
       status chip (which would change the status filter). *@
    <button type="submit" class="visually-hidden" tabindex="-1" aria-hidden="true"></button>
    <div class="row g-2 align-items-stretch">
        <div class="col-auto d-flex gap-2">
            @* Filters toggle on the left, styled like the Pending Containers
               page. The panel carries its own Apply/Reset buttons. *@
            <button class="btn btn-outline-secondary" type="button"
                    data-bs-toggle="collapse" data-bs-target="#qoFilters"
                    aria-expanded="@(panelOpen ? "true" : "false")" aria-controls="qoFilters">
                <i class="bi bi-funnel me-1"></i>Filters
                @if (f.PanelFilterCount > 0)
                {
                    <span class="badge bg-primary ms-1">@f.PanelFilterCount</span>
                }
            </button>
            @if (f.Any)
            {
                <a asp-action="Index" class="btn btn-outline-secondary" title="Clear every filter" data-filter-clear>@Loc["Clear"]</a>
            }
        </div>
        <div class="col-auto">
            <div class="btn-group" role="group" aria-label='@Loc["Filter by status"]'>
                @foreach (var s in statuses)
                {
                    <button type="submit" name="status" value="@s.Value" class="btn btn-sm @ActiveClass(s.Value, s.OutlineCss)" style="min-width:6.5rem">@ChipLabel(s.Value)</button>
                }
            </div>
        </div>
    </div>

    <div class="collapse @(panelOpen ? "show" : "")" id="qoFilters">
        <div class="card card-body mt-2 bg-body-tertiary">
            <div class="row g-2">
                <div class="col-6 col-md-2">
                    <label class="form-label small mb-1">@Loc["Container"]</label>
                    <input type="text" name="container" value="@f.Container" class="form-control form-control-sm"
                           placeholder='@Loc["any part"]' autocomplete="off" />
                </div>
                <div class="col-6 col-md-2">
                    <label class="form-label small mb-1">@Loc["BOL"]</label>
                    <input type="text" name="bol" value="@f.Bol" class="form-control form-control-sm"
                           placeholder='@Loc["any part"]' autocomplete="off" />
                </div>
                <div class="col-6 col-md-2">
                    <label class="form-label small mb-1">@Loc["PO"]</label>
                    <input type="text" name="po" value="@f.Po" class="form-control form-control-sm"
                           placeholder='@Loc["EBELN"]' autocomplete="off" />
                </div>
                <div class="col-6 col-md-2">
                    <label class="form-label small mb-1">@Loc["QC number"]</label>
                    <input type="text" name="qoNo" value="@f.QoNo" class="form-control form-control-sm"
                           placeholder='@Loc["QO-2026-000632 or 000632"]' autocomplete="off" />
                </div>
                <div class="col-6 col-md-2">
                    <label class="form-label small mb-1">@Loc["Arrival no."]</label>
                    <input type="text" name="arrivalNo" value="@f.ArrivalNo" class="form-control form-control-sm"
                           placeholder='@Loc["ARR-…"]' autocomplete="off" />
                </div>
                <div class="col-12 col-md-4">
                    <label class="form-label small mb-1">@Loc["Material"]</label>
                    <input type="text" name="material" value="@f.Material" class="form-control form-control-sm"
                           placeholder='@Loc["code or description"]' autocomplete="off" />
                </div>
                <partial name="_MaterialCategoryFilter" model="@((f.MatMajor, f.MatSubMajor))" />

                <div class="col-12 col-md-4">
                    <label class="form-label small mb-1">@Loc["Supplier"]</label>
                    <select name="supplier" class="form-select form-select-sm">
                        <option value="">@Loc["All suppliers"]</option>
                        @if (orphanSupplier)
                        {
                            <option value="@f.Supplier" selected>@f.Supplier (no matching orders)</option>
                        }
                        @foreach (var sup in opts.Suppliers)
                        {
                            <option value="@sup" selected="@(string.Equals(sup, f.Supplier, StringComparison.OrdinalIgnoreCase))">@sup</option>
                        }
                    </select>
                </div>

                <div class="col-6 col-md-3">
                    <label class="form-label small mb-1">@Loc["Plant"]</label>
                    @if (plantScopeLocked != null)
                    {
                        @* Scoped operator: the server forces this plant anyway, so
                           show why instead of a dropdown that can't take effect. *@
                        <div class="form-control form-control-sm bg-light d-flex align-items-center"
                             title="Your account is restricted to this plant.">
                            <i class="bi bi-lock-fill text-muted me-1"></i>
                            <span class="small">@Codes.PlantLabel(plantScopeLocked)</span>
                        </div>
                        <input type="hidden" id="qo-plant-filter" data-plant-filter="qo" data-filter-ignore name="plant" value="@plantScopeLocked" />
                    }
                    else
                    {
                        <select name="plant" id="qo-plant-filter" data-plant-filter="qo" class="form-select form-select-sm">
                            <option value="">@Loc["All plants"]</option>
                            @if (orphanPlant)
                            {
                                <option value="@f.Plant" selected>@f.Plant (no matching orders)</option>
                            }
                            @foreach (var pl in opts.Plants)
                            {
                                <option value="@pl" selected="@(string.Equals(pl, f.Plant, StringComparison.OrdinalIgnoreCase))">@Codes.PlantLabel(pl)</option>
                            }
                        </select>
                    }
                </div>
                <div class="col-6 col-md-3">
                    <label class="form-label small mb-1">@Loc["Storage location"]</label>
                    <select name="storageLoc" id="qo-storage-filter" data-storage-filter="qo" class="form-select form-select-sm">
                        <option value="">@Loc["All storage locations"]</option>
                        @if (orphanStorage)
                        {
                            <option value="@f.StorageLoc" data-plant="@f.Plant" selected>@f.StorageLoc (no matching orders)</option>
                        }
                        @foreach (var sl in opts.StorageLocations)
                        {
                            <option value="@sl.Code" data-plant="@sl.Plant"
                                    selected="@(string.Equals(sl.Code, f.StorageLoc, StringComparison.OrdinalIgnoreCase)
                                                && (string.IsNullOrEmpty(f.Plant) || string.Equals(sl.Plant, f.Plant, StringComparison.OrdinalIgnoreCase)))">
                                @Codes.StorageLocationLabel(sl.Plant, sl.Code)
                            </option>
                        }
                    </select>
                </div>
                <div class="col-6 col-md-2">
                    <label class="form-label small mb-1">@Loc["Opened by"]</label>
                    <select name="openedBy" class="form-select form-select-sm">
                        <option value="">@Loc["Anyone"]</option>
                        @if (orphanOpenedBy)
                        {
                            <option value="@f.OpenedBy" selected>@f.OpenedBy (no matching orders)</option>
                        }
                        @foreach (var ob in opts.OpenedBy)
                        {
                            <option value="@ob" selected="@(string.Equals(ob, f.OpenedBy, StringComparison.OrdinalIgnoreCase))">@ob</option>
                        }
                    </select>
                </div>
                <div class="col-6 col-md-2">
                    <label class="form-label small mb-1">@Loc["Created from"]</label>
                    <input type="date" name="from" value="@D(f.From)" class="form-control form-control-sm" />
                </div>
                <div class="col-6 col-md-2">
                    <label class="form-label small mb-1">@Loc["Created to"]</label>
                    <input type="date" name="to" value="@D(f.To)" class="form-control form-control-sm" />
                </div>
                @* The badges in the status cell mark these rows, but finding a
                   handful of them by eye in a list hundreds long is the whole
                   difficulty -- so they are filterable too. *@
                <div class="col-6 col-md-2">
                    <label class="form-label small mb-1">@Loc["Reinspection"]</label>
                    <select name="reinspection" class="form-select form-select-sm">
                        <option value="">@Loc["All orders"]</option>
                        <option value="originals" selected="@(f.Reinspection == "originals")">
                            @Loc["Reinspected originals"]
                        </option>
                        <option value="reinspections" selected="@(f.Reinspection == "reinspections")">
                            @Loc["Reinspections"]
                        </option>
                    </select>
                </div>
            </div>
            <div class="mt-2 d-flex gap-2">
                <button type="submit" class="btn btn-primary btn-sm"><i class="bi bi-funnel me-1"></i>@Loc["Apply filters"]</button>
                @if (f.AnyPanelFilter)
                {
                    <a asp-action="Index" asp-route-status="@status" asp-route-search="@search"
                       class="btn btn-outline-secondary btn-sm">@Loc["Reset these filters"]</a>
                }
            </div>
        </div>
    </div>
</form>

<div class="card">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0 qms-index-table" data-tablekit data-page-size="50">
            <thead class="table-light">
                <tr>
                    <th data-sort>@Loc["QO Number"]</th>
                    <th data-sort>@Loc["Container"]</th>
                    <th data-sort>@Loc["BOL"]</th>
                    <th data-sort>@Loc["PO"]</th>
                    <th data-sort>@Loc["Plant"]</th>
                    <th data-sort>@Loc["Supplier"]</th>
                    <th data-sort>@Loc["Arrival"]</th>
                    <th>@Loc["Materials"]</th>
                    <th data-sort>@Loc["Status"]</th>
                    <th data-sort>@Loc["Created"]</th>
                    @* Who opened the QO, not who created it -- the inspector who
                       took ownership is the useful name. Blank while Initial. *@
                    <th data-sort>@Loc["Opened By"]</th>
                    <th class="text-end">@Loc["Actions"]</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr><td colspan="12" class="text-center text-muted py-4">
                        No Quality Orders yet. Complete an arrival, then click <em>@Loc["Create Quality Order"]</em>.
                    </td></tr>
                }
                else
                {
                    foreach (var q in Model)
                    {
                        // Colour only -- the wording is QualityOrderStatus.DisplayName's
                        // job, so an unmapped status still reads correctly.
                        var cls = q.StatusCode switch {
                            QualityOrderStatus.Initial   => "secondary",
                            QualityOrderStatus.Open      => "primary",
                            QualityOrderStatus.Submitted => "warning text-dark",
                            QualityOrderStatus.Closed    => "success",
                            QualityOrderStatus.Cancelled => "dark",
                            _                            => "secondary"
                        };
                        var label = QualityOrderStatus.DisplayName(q.StatusCode);
                        var firstMat = q.MaterialLines.FirstOrDefault();
                        var extraMat = q.MaterialLines.Count - 1;
                        // Full material list for the hover tooltip: one <li> per
                        // material with code, description and (if present) qty/UoM.
                        // Material NAME only (no code) + qty/UoM when present.
                        var matTip = "<ul class='qo-tip'>" +
                            string.Concat(q.MaterialLines.Select(ml =>
                                "<li>" +
                                    System.Net.WebUtility.HtmlEncode(ml.MaterialDesc ?? "(no description)") +
                                    (ml.Quantity.HasValue && ml.Quantity.Value > 0
                                        ? "<span class='qo-tip-qty'>" + Fmt.Dec2(ml.Quantity.Value) + " " + System.Net.WebUtility.HtmlEncode(ml.Uom ?? "") + "</span>"
                                        : "") +
                                "</li>")) +
                            "</ul>";
                        <tr>
                            <td><code>@q.QualityOrderNo</code></td>
                            <td><code>@q.ContainerNo</code></td>
                            <td>@q.BolNo</td>
                            <td>@q.Ebeln</td>
                            <td>
                                @if (!string.IsNullOrEmpty(q.Plant))
                                {
                                    <span class="badge bg-light text-dark border"
                                          data-bs-toggle="tooltip" title="@q.Plant">@Codes.PlantDisplay(q.Plant)</span>
                                }
                                else
                                {
                                    <span class="text-muted">—</span>
                                }
                            </td>
                            <td>@q.VendorName</td>
                            <td>
                                <a asp-controller="Arrivals" asp-action="Details" asp-route-id="@q.ArrivalId"
                                   title="@q.ArrivalNo">
                                    <i class="bi bi-box-arrow-in-down me-1"></i>@q.ArrivalNo
                                </a>
                            </td>
                            <td>
                                @if (firstMat == null)
                                {
                                    <span class="text-muted small fst-italic">@Loc["No materials"]</span>
                                }
                                else
                                {
                                    <div class="qo-peek"
                                         data-bs-toggle="tooltip"
                                         data-bs-html="true"
                                         data-bs-placement="bottom"
                                         data-bs-title="@matTip"
                                         title="@matTip">
                                        @* Material name only — no material code — to keep the preview short. *@
                                        <span class="qo-name">@(string.IsNullOrWhiteSpace(firstMat.MaterialDesc) ? "(no description)" : firstMat.MaterialDesc)</span>
                                        @if (extraMat > 0)
                                        {
                                            <span class="badge bg-primary-subtle text-primary-emphasis">+@extraMat more</span>
                                        }
                                    </div>
                                }
                            </td>
                            <td>
                            <span class="badge bg-@cls">@label</span>
                            @* Beside the status rather than in a column of its
                               own: it qualifies the status ("finished, but
                               redone"), and a new column would mean touching
                               the hardcoded colspan on the empty-state row. *@
                            @if (q.IsSuperseded)
                            {
                                <span class="badge bg-secondary ms-1"
                                      title="@Loc["This inspection was redone. The reinspection carries the verdict."]">
                                    @Loc["Reinspected"]
                                </span>
                            }
                            else if (q.IsReinspection)
                            {
                                <span class="badge bg-info text-dark ms-1"
                                      title="@Loc["A second inspection of a container whose first result was judged unsound."]">
                                    @Loc["Reinspection"]
                                </span>
                            }
                        </td>
                            <td>@q.CreatedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</td>
                            <td>@q.OpenedBy</td>
                            <td class="text-end text-nowrap">
                                <a asp-action="Details" asp-route-id="@q.QualityOrderId"
                                   class="btn btn-sm btn-outline-primary" title="Open Quality Order">
                                    <i class="bi bi-eye"></i>
                                </a>
                                <a asp-controller="Reports" asp-action="QualityOrderPdf" asp-route-id="@q.QualityOrderId"
                                   class="btn btn-sm btn-outline-danger ms-1" target="_blank"
                                   title="Download Quality Order PDF report">
                                    <i class="bi bi-file-earmark-pdf"></i>
                                </a>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
    <script src="~/js/list-filter-memory.js" asp-append-version="true"></script>
}
