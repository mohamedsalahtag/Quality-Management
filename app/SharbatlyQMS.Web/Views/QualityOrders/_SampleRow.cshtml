@using SharbatlyQMS.Web.ViewModels
@model SampleRowVm
@{
    var s = Model.Sample;
    // Resolve an attribute for the row by trying a set of candidate codes, in
    // this order: the sample's dynamic HEADER values (incl. Material-scoped
    // values copied down), then its READINGS (some material groups — e.g.
    // bananas — configure Grower / Date Code / Brix / Firmness as reading TYPES
    // rather than header fields, and their codes differ, e.g. "PALLET_NO" vs
    // "Pallet No."), then the frozen legacy column. First non-empty wins.
    string Val(string[] codes, string? fallback = null)
    {
        foreach (var code in codes)
        {
            var v = Model.HeaderValues.FirstOrDefault(h => string.Equals(h.FieldCode, code, StringComparison.OrdinalIgnoreCase));
            if (v != null)
            {
                var hv = v.ValueKind switch
                {
                    "Numeric" => v.NumericValue?.ToString("0.##"),
                    "Date"    => v.DateValue?.ToString("yyyy-MM-dd"),
                    _         => v.TextValue
                };
                if (!string.IsNullOrWhiteSpace(hv)) return hv!;
            }
        }
        foreach (var code in codes)
        {
            var r = Model.Readings.FirstOrDefault(x => string.Equals(x.ReadingTypeCode, code, StringComparison.OrdinalIgnoreCase));
            if (r != null)
            {
                var rv = !string.IsNullOrWhiteSpace(r.TextValue) ? r.TextValue : r.NumericValue?.ToString("0.##");
                if (!string.IsNullOrWhiteSpace(rv)) return rv!;
            }
        }
        return fallback ?? "";
    }
    // Candidate codes cover both the header-field code and the reading-type code
    // for the same concept (they diverge across material groups).
    var growerCodes   = new[] { "GROWER", "Grower" };
    var palletCodes   = new[] { "PALLET_NO", "Pallet No.", "Pallet No" };
    var lotCodes      = new[] { "LOT_NO", "Lot No.", "Lot No" };
    var dateCodeCodes = new[] { "DATE_CODE", "Date Code" };
    var firmnessCodes = new[] { "FIRMNESS", "Firmness" };
    var brixCodes     = new[] { "BRIX", "Brix" };
}
<tr data-sample-id="@s.SampleId" data-qo-material-id="@s.QoMaterialId">
    <td>
        <button type="button" class="btn btn-link p-0 fw-semibold sample-open"
                data-sample-id="@s.SampleId">
            #@s.SampleNo
        </button>
    </td>
    <td>@Val(growerCodes, s.Grower)</td>
    <td>@Val(palletCodes, s.PalletNo)</td>
    <td>@Val(lotCodes, s.LotNo)</td>
    <td>@Val(dateCodeCodes, s.DateCode)</td>
    <td class="text-end">@Val(firmnessCodes)</td>
    <td class="text-end">@Val(brixCodes)</td>
    <td class="text-end">
        @s.SampleSize
        @if (s.SizeOverridden)
        {
            <span class="badge bg-warning text-dark ms-1" title="Sample-level override">
                <i class="bi bi-pencil-square"></i>
            </span>
        }
    </td>
    <td class="text-end small text-muted">@s.CreatedAt.ToLocalTime().ToString("g")<br />@s.CreatedBy</td>
    <td class="text-end">
        <button type="button" class="btn btn-sm btn-outline-info sample-photos"
                data-sample-id="@s.SampleId" title="Photos">
            <i class="bi bi-camera"></i>
            @if (Model.PhotoCount > 0)
            {
                <span class="badge bg-primary ms-1">@Model.PhotoCount</span>
            }
        </button>
        <button type="button" class="btn btn-sm btn-outline-primary sample-open"
                data-sample-id="@s.SampleId" title="Open sample">
            <i class="bi bi-pencil-square"></i>
        </button>
        @if (Model.Editable)
        {
            <button type="button" class="btn btn-sm btn-outline-danger sample-delete"
                    data-sample-id="@s.SampleId" data-sample-no="@s.SampleNo" title="Delete sample">
                <i class="bi bi-trash"></i>
            </button>
        }
    </td>
</tr>
