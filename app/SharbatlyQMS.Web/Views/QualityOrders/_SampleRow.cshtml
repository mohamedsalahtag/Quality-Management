@using SharbatlyQMS.Web.ViewModels
@model SampleRowVm
@{
    var s = Model.Sample;
    // Show the live header value for a field code (incl. Material-scoped values
    // copied onto the sample); fall back to the frozen legacy column for very
    // old rows that predate the dynamic header system.
    string Hv(string code, string? fallback)
    {
        var v = Model.HeaderValues.FirstOrDefault(h => string.Equals(h.FieldCode, code, StringComparison.OrdinalIgnoreCase));
        var val = v == null ? null : v.ValueKind switch
        {
            "Numeric" => v.NumericValue?.ToString("0.##"),
            "Date"    => v.DateValue?.ToString("yyyy-MM-dd"),
            _         => v.TextValue
        };
        return string.IsNullOrWhiteSpace(val) ? (fallback ?? "") : val!;
    }
}
<tr data-sample-id="@s.SampleId" data-qo-material-id="@s.QoMaterialId">
    <td>
        <button type="button" class="btn btn-link p-0 fw-semibold sample-open"
                data-sample-id="@s.SampleId">
            #@s.SampleNo
        </button>
    </td>
    <td>@Hv("GROWER", s.Grower)</td>
    <td>@Hv("PALLET_NO", s.PalletNo)</td>
    <td>@Hv("LOT_NO", s.LotNo)</td>
    <td>@Hv("DATE_CODE", s.DateCode)</td>
    <td class="text-end">
        @s.SampleSize
        @if (s.SizeOverridden)
        {
            <span class="badge bg-warning text-dark ms-1" title="Sample-level override">
                <i class="bi bi-pencil-square"></i>
            </span>
        }
    </td>
    <td class="text-end small text-muted">@s.CreatedAt.ToLocalTime():g<br />@s.CreatedBy</td>
    <td class="text-end">
        <button type="button" class="btn btn-sm btn-outline-primary sample-open"
                data-sample-id="@s.SampleId" title="Open sample">
            <i class="bi bi-pencil-square"></i>
        </button>
        @if (Model.Editable)
        {
            <button type="button" class="btn btn-sm btn-outline-danger sample-delete"
                    data-sample-id="@s.SampleId" data-sample-no="@s.SampleNo" title="Delete sample">
                <i class="bi bi-trash"></i>
            </button>
        }
    </td>
</tr>
