@* ---- Delete confirmation. Deliberately a modal off the header button rather
       than a panel on the page: the warning has to be read at the moment of
       the click, not scrolled past. Typing the QO number is a per-record
       confirmation, so it can't become muscle memory or hit the wrong record.
       The Delete button stays disabled until what was typed matches. ---- *@
@if (!isClaimContext && Perms.Can(Perm.Qo.Delete)
     && (Model.StatusCode == QualityOrderStatus.Initial || Model.StatusCode == QualityOrderStatus.Open))
{
    <div class="modal fade" id="deleteQoModal" tabindex="-1" aria-labelledby="deleteQoModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <form asp-action="Delete" asp-route-id="@Model.QualityOrderId" method="post" class="modal-content border-danger">
                @Html.AntiForgeryToken()
                <div class="modal-header bg-danger-subtle text-danger-emphasis">
                    <h5 class="modal-title" id="deleteQoModalLabel">
                        <i class="bi bi-exclamation-octagon me-1"></i>Delete @Model.QualityOrderNo permanently?
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label='@Loc["Close"]'></button>
                </div>
                <div class="modal-body">
                    <p class="mb-2">
                        This removes the quality order and <strong>@Loc["everything under it"]</strong> — every sample,
                        reading, defect, photo and document.
                    </p>
                    <ul class="small mb-3">
                        <li><strong>@Loc["It cannot be undone."]</strong></li>
                        <li>@Loc["The quality order also disappears from Data Hub and the Perspective Analyzer."]</li>
                        <li>Arrival <strong>@Model.ArrivalNo</strong> is <em>@Loc["not"]</em> affected — you can create a fresh quality order for it afterwards.</li>
                    </ul>
                    <div class="alert alert-light border small py-2">
                        Only want to stop work on this inspection but keep the record? Close this and use
                        <strong>@Loc["Cancel"]</strong> instead.
                    </div>
                    <label class="form-label small mb-1" for="qo-delete-confirm">
                        @Loc["Type"] <code>@Model.QualityOrderNo</code> to confirm
                    </label>
                    <input type="text" name="confirm" id="qo-delete-confirm" class="form-control"
                           placeholder="@Model.QualityOrderNo" autocomplete="off" required />
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">@Loc["Cancel"]</button>
                    <button type="submit" class="btn btn-danger" id="qo-delete-submit" disabled>
                        <i class="bi bi-trash me-1"></i>@Loc["Delete permanently"]
                    </button>
                </div>
            </form>
        </div>
    </div>
}

@* ---- Toast host for inline success/error messages. ---- *@
<div id="qoToastHost"></div>

@* ---- Documents modal. Uses the shared _DocumentList partial (upload form +
       grid, AJAX). Available in every status; upload/delete are role- +
       plant-gated server-side in DocumentsController for "QualityOrder". ---- *@
<div class="modal fade" id="documentsModal" tabindex="-1" aria-labelledby="documentsModalLabel" aria-hidden="true">
    @* modal-xl, and full-screen on anything below a large display: the dialog
       now holds a file list AND a viewer side by side, which modal-lg could not
       fit. Reading an attachment used to mean downloading it first. *@
    <div class="modal-dialog modal-xl modal-fullscreen-lg-down">
        <div class="modal-content" data-preview-host>
            <div class="modal-header">
                <h5 class="modal-title" id="documentsModalLabel">
                    <i class="bi bi-paperclip me-1"></i>Documents — @Model.QualityOrderNo
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label='@Loc["Close"]'></button>
            </div>
            <div class="modal-body p-0">
              <div class="row g-0" style="min-height:70vh">
                <div class="col-lg-6 border-end overflow-auto p-3" style="max-height:78vh">
                @{
                    var qoDocsVm = new SharbatlyQMS.Web.ViewModels.DocumentListVm
                    {
                        OwnerType  = "QualityOrder",
                        OwnerId    = Model.QualityOrderId,
                        // Documents attach/remove in any status (per user request), so this
                        // is role-only (canEdit) rather than canAct. canEdit is already
                        // forced false in claim context, so the upload form stays hidden there.
                        Editable   = canEdit,
                        Ajax       = true,
                        Categories = new[] { "InspectionReport", "Certificate", "LabResult", "ClaimDocument", "Other" }
                    };
                }
                <partial name="_DocumentList" model="qoDocsVm" />

                @* Documents that live on the ARRIVAL, shown here read-only so
                   nobody has to navigate back to the arrival to read a packing
                   list or certificate. Read-only on purpose: they belong to the
                   arrival, and editing them from here would hide which record
                   they are actually attached to. *@
                @if (arrival != null)
                {
                    <hr class="my-4" />
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <h6 class="mb-0">
                            <i class="bi bi-box-arrow-in-down me-1"></i>From the arrival
                            <span class="text-muted fw-normal small ms-1">@arrival.ArrivalNo</span>
                        </h6>
                        <a class="small text-decoration-none" asp-controller="Arrivals"
                           asp-action="Details" asp-route-id="@arrival.ArrivalId">
                            Open arrival <i class="bi bi-box-arrow-up-right"></i>
                        </a>
                    </div>
                    var arrivalDocsVm = new SharbatlyQMS.Web.ViewModels.DocumentListVm
                    {
                        OwnerType  = "Arrival",
                        OwnerId    = arrival.ArrivalId,
                        Editable   = false,
                        Ajax       = true,
                        Categories = Array.Empty<string>()
                    };
                    <partial name="_DocumentList" model="arrivalDocsVm" />
                }
                </div>

                @* The viewer. Empty until a preview button is pressed, so the
                   list is what the dialog opens on. file-preview.js fills the
                   frame from a blob and reports its own progress and errors. *@
                <div class="col-lg-6 d-flex flex-column bg-body-tertiary" style="max-height:78vh">
                    <div class="px-3 py-2 border-bottom d-flex align-items-center gap-2 small">
                        <i class="bi bi-eye text-muted"></i>
                        <span class="fw-semibold text-truncate" data-preview-title>@Loc["Preview"]</span>
                    </div>
                    <div class="flex-grow-1 position-relative">
                        <div class="position-absolute top-0 start-0 w-100 h-100 d-flex
                                    align-items-center justify-content-center text-muted small px-4 text-center"
                             data-preview-status>
                            @Loc["Select a file to preview it here. PDF and text files open in place; anything else downloads."]
                        </div>
                        <iframe class="w-100 h-100 border-0 d-none"
                                title="@Loc["Document preview"]" data-preview-frame></iframe>
                    </div>
                </div>
              </div>
            </div>
        </div>
    </div>
</div>

@* ---- Close / Reopen / Override modals (override now POSTs to AJAX). ---- *@
<div class="modal fade" id="closeModal" tabindex="-1">
    <div class="modal-dialog">
        <form asp-action="Close" asp-route-id="@Model.QualityOrderId" method="post" class="modal-content"
              data-confirm-finish="true">
            @Html.AntiForgeryToken()
            <div class="modal-header"><h5 class="modal-title">@Loc["Finish Quality Order"]</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button></div>
            <div class="modal-body">
                <div class="alert alert-warning d-flex mb-2">
                    <i class="bi bi-exclamation-triangle-fill me-2 fs-5"></i>
                    <div>
                        Once finished, this Quality Order <strong>@Loc["cannot be modified"]</strong>.
                        No further samples can be added. Re-opening requires a Site Admin.
                    </div>
                </div>
                <div class="mb-2">
                    <label class="form-label" for="finishComment">@Loc["Comment"] <span class="text-muted">@Loc["(optional)"]</span></label>
                    <textarea class="form-control" id="finishComment" name="reason" rows="2" maxlength="1000"
                              placeholder='@Loc["Add a note about this order…"]'></textarea>
                    <div class="form-text">@Loc["If you add a comment, it appears as a message under your name on the claim page."]</div>
                </div>
                @* M24: QC's claim assessment. Required -- the Finish button
                   stays disabled until one is picked, and the server refuses a
                   post without it. It feeds the Claims window's QC assessment
                   column and filter; it does NOT decide the claim itself. *@
                <div class="mb-2">
                    <label class="form-label d-block mb-1">
                        @Loc["Claim assessment"] <span class="text-danger fw-bold">*</span>
                    </label>
                    <div class="d-flex flex-column gap-1">
                        <div class="form-check">
                            <input class="form-check-input" type="radio" name="potentialClaim"
                                   id="pcYes" value="Yes" required data-finish-claim />
                            <label class="form-check-label" for="pcYes">
                                <span class="badge bg-danger me-1">@Loc["Potential Claim"]</span>
                                this shipment may need claim processing.
                            </label>
                        </div>
                        <div class="form-check">
                            <input class="form-check-input" type="radio" name="potentialClaim"
                                   id="pcNo" value="No" required data-finish-claim />
                            <label class="form-check-label" for="pcNo">
                                <span class="badge bg-success me-1">@Loc["No Potential Claim"]</span>
                                nothing to claim on this shipment.
                            </label>
                        </div>
                    </div>
                    <div class="form-text">@Loc["Shown in the Claims window so claims can be picked up faster."]</div>
                </div>
                <div class="form-check mt-3">
                    <input class="form-check-input" type="checkbox" id="finishAckCheck">
                    <label class="form-check-label" for="finishAckCheck">
                        @Loc["I understand and want to finish this Quality Order."]
                    </label>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">@Loc["Cancel"]</button>
                <button type="submit" class="btn btn-success" id="finishBtn" disabled>
                    <i class="bi bi-check-circle me-1"></i>@Loc["Finish order"]
                </button>
            </div>
        </form>
    </div>
</div>
<script>
    (function () {
        var chk = document.getElementById('finishAckCheck');
        var btn = document.getElementById('finishBtn');
        if (!chk || !btn) return;
        // M24: finishing needs BOTH the acknowledgement and a claim assessment.
        // The server refuses a post without the assessment anyway; this just
        // stops the user hitting that error.
        var claims = Array.prototype.slice.call(document.querySelectorAll('[data-finish-claim]'));
        function claimPicked() { return claims.some(function (r) { return r.checked; }); }
        function sync() { btn.disabled = !(chk.checked && claimPicked()); }
        chk.addEventListener('change', sync);
        claims.forEach(function (r) { r.addEventListener('change', sync); });
        // Reset ack each time the modal opens so a previously-acknowledged
        // state doesn't carry across cancellations.
        var modal = document.getElementById('closeModal');
        modal.addEventListener('show.bs.modal', function () {
            chk.checked = false;
            claims.forEach(function (r) { r.checked = false; });
            btn.disabled = true;
        });
    })();
</script>

@* V38 (2026-07-08): bypassable "materials without samples" warning. When
   Submit/Close hits the precondition, the controller redirects back with
   TempData and this modal auto-opens, offering "Submit/Finish anyway". *@
@if (TempData["BypassWarning"] is string bypassMsg)
{
    var bypassAction = TempData["BypassAction"] as string == "Close" ? "Close" : "Submit";
    var bypassReason = TempData["BypassReason"] as string;
    var bypassClaim  = TempData["BypassClaim"] as string;
    var bypassVerb   = bypassAction == "Close" ? "Finish" : "Submit";
    <div class="modal fade" id="bypassWarnModal" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content shadow">
                <div class="modal-header py-2">
                    <h5 class="modal-title d-flex align-items-center gap-2 fs-6">
                        <i class="bi bi-exclamation-triangle-fill text-warning fs-4"></i>
                        @Loc["Materials without samples"]
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                @* Form wraps body + footer so the mandatory reason textarea's
                   HTML5 `required` validation fires from the submit button. Both
                   Submit and Close post the reason under `name="reason"`; the
                   server records it in the status history + audit trail and also
                   re-checks it, so a crafted post can't skip it. *@
                <form asp-action="@bypassAction" asp-route-id="@Model.QualityOrderId" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="bypassNoSamples" value="true" />
                    <div class="modal-body">
                        <p class="mb-2">@bypassMsg</p>
                        <p class="small text-muted mb-3">
                            You can @bypassVerb.ToLower() anyway if this is intended — the listed
                            material(s) will remain without samples on this Quality Order.
                        </p>
                        <label for="bypassReasonInput" class="form-label mb-1 fw-semibold">
                            @Loc["Reason"] <span class="text-danger">*</span>
                        </label>
                        <textarea id="bypassReasonInput" name="reason" class="form-control" rows="3"
                                  required maxlength="500"
                                  placeholder='@Loc["e.g. Supplier sample not available; proceeding with QM approval"]'>@bypassReason</textarea>
                        <div class="form-text">@Loc["Required. Recorded in this Quality Order's audit trail."]</div>
                        @if (bypassAction == "Close")
                        {
                            @* M24: this form is the other way into Close, so it has
                               to carry the claim assessment too -- the server
                               refuses a finish without one. Pre-selected from the
                               first attempt so the pick isn't made twice. *@
                            <hr class="my-3" />
                            <label class="form-label mb-1 fw-semibold">
                                @Loc["Claim assessment"] <span class="text-danger">*</span>
                            </label>
                            <div class="form-check">
                                <input class="form-check-input" type="radio" name="potentialClaim"
                                       id="pcBypassYes" value="Yes" required
                                       checked="@(bypassClaim == "Yes")" />
                                <label class="form-check-label" for="pcBypassYes">
                                    <span class="badge bg-danger me-1">@Loc["Potential Claim"]</span>
                                    this shipment may need claim processing.
                                </label>
                            </div>
                            <div class="form-check">
                                <input class="form-check-input" type="radio" name="potentialClaim"
                                       id="pcBypassNo" value="No" required
                                       checked="@(bypassClaim == "No")" />
                                <label class="form-check-label" for="pcBypassNo">
                                    <span class="badge bg-success me-1">@Loc["No Potential Claim"]</span>
                                    nothing to claim on this shipment.
                                </label>
                            </div>
                        }
                    </div>
                    <div class="modal-footer py-2">
                        <button type="button" class="btn btn-outline-secondary btn-sm" data-bs-dismiss="modal">
                            @Loc["Cancel — add samples first"]
                        </button>
                        <button type="submit" class="btn btn-warning btn-sm">
                            <i class="bi bi-exclamation-triangle me-1"></i>@bypassVerb anyway
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            bootstrap.Modal.getOrCreateInstance(document.getElementById('bypassWarnModal')).show();
        });
    </script>
}

<div class="modal fade" id="reopenModal" tabindex="-1">
    <div class="modal-dialog">
        <form asp-action="Reopen" asp-route-id="@Model.QualityOrderId" method="post" class="modal-content">
            @Html.AntiForgeryToken()
            <div class="modal-header"><h5 class="modal-title">@Loc["Reopen Quality Order"]</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button></div>
            <div class="modal-body">
                <p class="small text-muted">@Loc["Reopening creates an audit trail. Use only with proper justification."]</p>
                <label class="form-label">@Loc["Reason (required)"]</label>
                <textarea name="reason" class="form-control" rows="3" required></textarea>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">@Loc["Cancel"]</button>
                <button type="submit" class="btn btn-warning"><i class="bi bi-arrow-clockwise me-1"></i>@Loc["Reopen"]</button>
            </div>
        </form>
    </div>
</div>

@* Deliberately heavier wording than the Reopen dialog: reopening puts an
   order back in play, this one ends it and rewrites a claim standing. *@
<div class="modal fade" id="reinspectModal" tabindex="-1">
    <div class="modal-dialog">
        <form asp-action="Reinspect" asp-route-id="@Model.QualityOrderId" method="post" class="modal-content">
            @Html.AntiForgeryToken()
            <div class="modal-header">
                <h5 class="modal-title"><i class="bi bi-arrow-repeat me-1"></i>@Loc["Reinspect this container"]</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <p class="small">
                    @Loc["A new quality order is raised for the same container, starting empty. This order is kept in full and still prints, but it stops speaking for the container."]
                </p>
                <ul class="small text-muted ps-3">
                    <li>@Loc["The claim and its whole conversation move to the reinspection, which becomes the order that speaks for this container."]</li>
                    <li>@Loc["A container is reinspected once. This cannot be undone from the application."]</li>
                    <li>@Loc["This order is frozen: it stays readable and printable as a reference, but it cannot be reopened, changed, or sent to a supplier."]</li>
                    <li>@Loc["Dashboard and Inspection Time Bar figures follow the reinspection. The container returns to pending inspection until the reinspection is finished, and its inspection clock restarts."]</li>
                </ul>
