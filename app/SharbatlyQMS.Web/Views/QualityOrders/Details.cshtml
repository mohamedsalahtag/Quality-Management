@using SharbatlyQMS.Web.Models
@using SharbatlyQMS.Web.ViewModels
@using SharbatlyQMS.Web.Services.Pdf
@model QualityOrder
@{
    ViewData["Title"] = "QO " + Model.QualityOrderNo;
    var arrival     = ViewBag.Arrival     as Arrival;
    var shipment    = ViewBag.Shipment    as ShipmentSnapshot;
    var materials   = ViewBag.Materials   as IReadOnlyList<QualityOrderMaterial> ?? new List<QualityOrderMaterial>();
    var samples     = ViewBag.Samples     as IReadOnlyList<Sample>               ?? new List<Sample>();
    var photoCounts = ViewBag.PhotoCounts as IReadOnlyDictionary<long, int>      ?? new Dictionary<long, int>();
    var sampleHeaders = ViewBag.SampleHeaders as ILookup<long, SampleHeaderValue>;
    var sampleReadings = ViewBag.SampleReadings as ILookup<long, SampleReading>;
    var editable    = (bool?)ViewBag.Editable ?? (Model.StatusCode == QualityOrderStatus.Open);
    var role        = User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value;
    // V31 (2026-06-20): role hierarchy widened. Operator includes Supervisor for
    // edit-on-Open; new canSupervise flag controls Finish + Cancel submit;
    // canManage stays Manager/SiteAdmin (Reopen Finished QOs).
    var canEdit      = Perms.CanEdit(Screens.QoDetails);
    var canSupervise = Perms.Can(Perm.Qo.Finish);
    var canManage    = Perms.Can(Perm.Qo.Reopen);
    // When this view is rendered by ClaimManagementController.Details, every
    // QO mutation surface is suppressed -- the only interactive area is the
    // claim chat panel rendered at the bottom of the page. Forcing all four
    // gates false naturally collapses the @if(canEdit/canSupervise/canManage/canAct)
    // blocks throughout this view.
    var isClaimContext = (bool?)ViewBag.IsClaimContext ?? false;
    if (isClaimContext) { editable = false; canEdit = false; canSupervise = false; canManage = false; }
    // A superseded order is a reference copy: readable and printable, nothing
    // more. Collapsing the same four gates is what makes that true across the
    // whole page rather than button by button -- and QualityOrderService
    // .Transition refuses every one of them again anyway, because a hidden
    // button leaves its POST endpoint reachable.
    if (Model.IsFrozen) { editable = false; canEdit = false; canSupervise = false; canManage = false; }
    // Grouped summary (claim context only) — the exact rollup the QC report prints.
    var groupSummaries = ViewBag.GroupSummaries as IReadOnlyList<MaterialGroupSummary>
                         ?? new List<MaterialGroupSummary>();
    // Combined "user may interact with mutating buttons on this page".
    // editable carries the QO-status guard; role carries the per-user guard.
    var canAct       = editable && canEdit;
    var (cls, label) = Model.StatusCode switch
    {
        "Initial"   => ("secondary", "Initial"),
        "Open"      => ("primary",   "Open"),
        "Submitted" => ("info",      "Submitted"),
        "Closed"    => ("success",   "Finished"),       // UI label (DB stays 'Closed')
        "Cancelled" => ("dark",      "Cancelled"),
        _           => ("secondary", Model.StatusCode)
    };
}

@* ---- Hidden antiforgery form: one token for all AJAX calls on this page.
       JS reads it once into a const and sends as the RequestVerificationToken
       header (configured in Program.cs). ---- *@
<form id="qoAntiforgery" style="display:none">@Html.AntiForgeryToken()</form>

<style>
    /* Tighter card chrome so the QO page fits on one tablet viewport. */
    .mat-card .card-header { padding-top: .4rem; padding-bottom: .4rem; }
    .mat-card .card-body   { padding-top: .5rem; padding-bottom: .5rem; }
    .mat-card .chevron     { transition: transform .2s; display: inline-block; }
    .mat-card.collapsed-card .chevron { transform: rotate(-90deg); }
    /* Samples sublist: thin border on the left to show nesting, no background tint. */
    .samples-sublist {
        margin: .25rem 0 .25rem 1.5rem;
        padding: .25rem .5rem;
        border-left: 3px solid #cfe2ff;
        border-radius: 0 .25rem .25rem 0;
    }
    .samples-sublist .table { margin-bottom: 0; }
    /* Sample drawer: wide on desktop, scales down on tablet / phone. */
    .sample-offcanvas { --bs-offcanvas-width: 920px; }
    @@media (max-width: 1199.98px) { .sample-offcanvas { --bs-offcanvas-width: 92vw; } }
    @@media (max-width: 575.98px)  { .sample-offcanvas { --bs-offcanvas-width: 100vw; } }
    /* Inline clear-override X icon -- small, red, no chrome. */
    .clear-override-btn { line-height: 1; padding: 0 .15rem; vertical-align: middle; }
    .clear-override-btn i { font-size: 1rem; }
    /* Toast positioning */
    #qoToastHost { position: fixed; top: 1rem; right: 1rem; z-index: 1080; }
    /* Documents button — pale yellow so it stands out from the other header actions. */
    .qo-docs-btn { background-color: #fdf6c9; border-color: #ecdf9a; color: #5c4d00; }
    .qo-docs-btn:hover, .qo-docs-btn:focus { background-color: #f7ec9e; border-color: #e0cf7a; color: #5c4d00; }
    /* Claim-page Summary header — mirrors the QC report's page-1 grouped summary. */
    .qc-summary .qcs-f { display:flex; justify-content:space-between; gap:1rem; padding:.15rem 0; border-bottom:1px solid #f2f2f2; }
    .qc-summary .qcs-f > span:first-child { color:#6c757d; }
    .qc-summary .qcs-f > span:last-child  { font-weight:600; text-align:right; }
    .qc-summary .qcs-defects { font-size:.8rem; }
    .qc-summary .qcs-defects th { font-weight:600; border-bottom:1px solid #dee2e6; padding:.15rem .3rem; }
    .qc-summary .qcs-defects td { padding:.15rem .3rem; }
    .qc-summary .qcs-defects .qcs-total td { border-top:1px solid #dee2e6; }
</style>

<div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
    <div>
        <h1 class="h3 mb-1"><i class="bi bi-clipboard-data me-1"></i>@Model.QualityOrderNo</h1>
        <span class="badge bg-@cls fs-6">@label</span>
        <span class="text-muted small ms-2">created @Model.CreatedAt.ToLocalTime().ToString("g") by @Model.CreatedBy</span>
    </div>
    <div class="d-flex gap-2 flex-wrap">
        <a asp-action="Index" class="btn btn-outline-secondary"><i class="bi bi-arrow-left me-1"></i>@Loc["Back"]</a>
        @if (arrival != null)
        {
            <a asp-controller="Arrivals" asp-action="Details" asp-route-id="@arrival.ArrivalId" class="btn btn-outline-secondary">
                <i class="bi bi-box-arrow-in-down me-1"></i>@Loc["View arrival"]
            </a>
        }
        @* Documents live in a modal (opened from here) so they don't reserve
           space on the page. Available in every status; upload/delete inside
           the modal are still role- + plant-gated server-side. *@
        <button type="button" class="btn btn-outline-secondary qo-docs-btn" data-bs-toggle="modal" data-bs-target="#documentsModal">
            <i class="bi bi-paperclip me-1"></i>@Loc["Documents"]
        </button>
        @if (Model.StatusCode == QualityOrderStatus.Initial && canEdit)
        {
            <form asp-action="Open" asp-route-id="@Model.QualityOrderId" method="post"
                  data-confirm="Open this Quality Order? Samples can be added once opened."
                  data-confirm-title="Open Quality Order" data-confirm-ok="Open">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-primary"><i class="bi bi-unlock me-1"></i>@Loc["Open"]</button>
            </form>
        }
        @* V31 (2026-06-20): Submit (operator on Open) -> Submitted. After submit,
           Supervisor reviews and Finishes or cancel-submits. *@
        @if (canAct)
        {
            <form asp-action="Submit" asp-route-id="@Model.QualityOrderId" method="post"
                  data-confirm="Submit this Quality Order for supervisor review? No more changes will be allowed until the supervisor either finishes or cancel-submits."
                  data-confirm-title="Submit for review" data-confirm-ok="Submit">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-primary"><i class="bi bi-send-check me-1"></i>@Loc["Submit"]</button>
            </form>
        }
        @if (Model.StatusCode == QualityOrderStatus.Submitted && canSupervise)
        {
            <button type="button" class="btn btn-success" data-bs-toggle="modal" data-bs-target="#closeModal">
                <i class="bi bi-check-circle me-1"></i>@Loc["Finish order"]
            </button>
            <form asp-action="CancelSubmit" asp-route-id="@Model.QualityOrderId" method="post" class="d-inline"
                  data-confirm="Cancel the submit and return this QO to Open so the operator can fix it?"
                  data-confirm-title="Cancel submit" data-confirm-ok="Return to Open">
                @Html.AntiForgeryToken()
                <input type="hidden" name="reason" value="" />
                <button type="submit" class="btn btn-outline-warning"><i class="bi bi-arrow-counterclockwise me-1"></i>@Loc["Cancel submit"]</button>
            </form>
        }
        @* Not offered on a rejection order: there is no inspection to reopen,
           and the service refuses it anyway. *@
        @if (Model.StatusCode == QualityOrderStatus.Closed && canManage && !Model.ContainerRejected)
        {
            <button type="button" class="btn btn-warning" data-bs-toggle="modal" data-bs-target="#reopenModal">
                <i class="bi bi-arrow-clockwise me-1"></i>@Loc["Reopen"]
            </button>
        }
        @* Reinspection: a NEW order for the same container, superseding this
           one. Offered on the same conditions as Reopen plus the ones only a
           reinspection cares about -- all of them re-checked in the service,
           because hiding a button leaves its POST endpoint reachable. *@
        @if (Model.CanBeReinspected && Perms.Can(Perm.Qo.Reinspect))
        {
            <button type="button" class="btn btn-outline-danger" data-bs-toggle="modal" data-bs-target="#reinspectModal">
                <i class="bi bi-arrow-repeat me-1"></i>@Loc["Reinspect"]
            </button>
        }
        @if (!isClaimContext)
        {
            <button type="button" class="btn btn-outline-info" data-bs-toggle="modal" data-bs-target="#reportPreviewModal">
                <i class="bi bi-file-earmark-text me-1"></i>@Loc["Preview QC report"]
            </button>
        }
        <a asp-controller="Reports" asp-action="QualityOrderPdf" asp-route-id="@Model.QualityOrderId"
           class="btn btn-outline-danger" target="_blank">
            <i class="bi bi-file-earmark-pdf me-1"></i>@Loc["Download PDF report"]
        </a>
        @* Permanent delete. SiteAdmin only, and only while the QO is still
           Initial or Open -- past that it is a signed-off record. The server
           re-checks the role, the status and the typed number regardless of
           whether this button rendered. *@
        @if (!isClaimContext && Perms.Can(Perm.Qo.Delete)
             && (Model.StatusCode == QualityOrderStatus.Initial || Model.StatusCode == QualityOrderStatus.Open))
        {
            <button type="button" class="btn btn-danger" data-bs-toggle="modal" data-bs-target="#deleteQoModal">
                <i class="bi bi-trash me-1"></i>@Loc["Delete"]
            </button>
        }
        @* "Send report to supplier" moved to the Claim Management chat-panel
           action bar (_ClaimChatPanel.cshtml). It now appears only when a
           claim exists and has been approved. The modal markup and JS for
           the send flow live below in this file so both render paths
           (standalone QO and claim context) share the same wiring. *@
    </div>
</div>

@* ---- Reinspection: say which of the two orders this is before anything
       else on the page, because the reader's next question is always
       "is this the one that counts?" ---- *@
@if (Model.IsReinspection)
{
    <div class="alert alert-info d-flex align-items-start" role="alert">
        <i class="bi bi-arrow-repeat me-2 mt-1"></i>
        <div>
            <strong>@Loc["This is a reinspection"]</strong>
            <div class="small mt-1">
                @Loc["The container was inspected before and the result was judged unsound, so it is being inspected again. This order carries the verdict that counts."]
            </div>
            @if (ViewBag.OriginalQoNo is string origNo)
            {
                <div class="small mt-2">
                    <a asp-action="Details" asp-route-id="@ViewBag.OriginalQoId" class="alert-link">
                        @Loc["Open the original,"] @origNo
                    </a>
                </div>
            }
        </div>
    </div>
}
@if (Model.IsSuperseded)
{
    <div class="alert alert-secondary d-flex align-items-start" role="alert">
        <i class="bi bi-archive me-2 mt-1"></i>
        <div>
            <strong>@Loc["This inspection has been superseded"]</strong>
            <div class="small mt-1">
                @Loc["It was reinspected on"]
                @(Model.SupersededAt?.ToLocalTime().ToString("yyyy-MM-dd HH:mm"))
                @Loc["by"] @Model.SupersededBy.
                @Loc["It is kept in full and still prints, but the reinspection now speaks for this container."]
            </div>
            @if (ViewBag.ReinspectionQoNo is string reNo)
            {
                <div class="small mt-2">
                    <a asp-action="Details" asp-route-id="@ViewBag.ReinspectionQoId" class="alert-link">
                        @Loc["Open the reinspection,"] @reNo
                    </a>
                </div>
            }
        </div>
    </div>
}

@* ---- Container rejected: say so before anything else on the page, because
       every empty section below follows from it. ---- *@
@if (Model.ContainerRejected)
{
    <div class="alert alert-danger d-flex align-items-start" role="alert">
        <i class="bi bi-x-octagon-fill me-2 mt-1"></i>
        <div>
            <strong>@Loc["Container rejected on arrival"]</strong>
            <div class="small mt-1">
                @Loc["No inspection was carried out — the container was refused because of its condition. This order exists to carry the shipment details and the arrival photos to the supplier, and is finished with a potential claim."]
            </div>
            @if (arrival != null && !string.IsNullOrWhiteSpace(arrival.RejectReason))
            {
                <div class="mt-2">@arrival.RejectReason</div>
            }
            @if (arrival != null)
            {
                <div class="small mt-2">
                    <a asp-controller="Arrivals" asp-action="Details" asp-route-id="@arrival.ArrivalId"
                       class="alert-link">@Loc["Open the arrival"] @arrival.ArrivalNo</a>
                </div>
            }
        </div>
    </div>
}

@* ---- Summary (claim context) — the exact page-1 grouped summary the QC report
       prints, from the shared _QcSummary partial. On the QO page the same partial
       is loaded on demand by the "Generate Summary" popup. ---- *@
@if (isClaimContext && groupSummaries.Count > 0)
{
    <div class="card mb-3 qc-summary">
        <div class="card-header py-2 fw-semibold text-uppercase">
            <i class="bi bi-clipboard-check me-1"></i>@Loc["Summary"]
        </div>
        <div class="card-body">
            @await Html.PartialAsync("_QcSummary", groupSummaries)
        </div>
    </div>
}

@* ---- QC report preview popup (QO page). Renders the real report PDF — the
       same bytes the Download button produces, page-1 grouped summary included
       — so the report can be read before anyone commits to a download. It is
       built fresh on every open, so it always reflects the latest saved
       samples and is usable before the order is finished. ---- *@
@if (!isClaimContext)
{
    <div class="modal fade" id="reportPreviewModal" tabindex="-1">
        <div class="modal-dialog modal-xl modal-fullscreen-lg-down" id="reportPreviewDialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title"><i class="bi bi-file-earmark-text me-1"></i>QC Report — @Model.QualityOrderNo</h5>
                    @* Maximise / restore. The choice is remembered in this browser,
                       so whoever prefers the report full-screen gets it every time. *@
                    <button type="button" class="btn btn-sm btn-outline-secondary ms-auto me-2" id="reportPreviewMaxBtn"
                            title='@Loc["Maximize"]' aria-label='@Loc["Maximize"]' aria-pressed="false">
                        <i class="bi bi-arrows-fullscreen"></i>
                    </button>
                    <button type="button" class="btn-close ms-0" data-bs-dismiss="modal"></button>
                </div>
                @* Fixed-height body so the PDF viewer has somewhere to live; the
                   iframe scrolls the document, the modal itself does not. Taller
                   when maximised: header and footer are all that is left. *@
                <div class="modal-body p-0 position-relative" id="reportPreviewBody" style="height: 78vh;">
                    @* Progress panel. Building the report re-reads the order, its
                       samples and every photo, so on a big order it takes a few
                       seconds — long enough that a blank frame reads as broken.
                       The bar is deliberately indeterminate: the server renders in
                       one shot and has no percentage to report. *@
                    <div id="reportPreviewStatus"
                         class="position-absolute top-0 start-0 w-100 h-100 d-flex flex-column
                                justify-content-center align-items-center text-center px-4 gap-2">
                        <div class="spinner-border text-info" role="status" aria-hidden="true"></div>
                        <div id="reportPreviewMsg" class="fw-semibold">@Loc["Generating the QC report…"]</div>
                        <div class="progress w-50" style="height:.4rem;" role="progressbar" aria-label='@Loc["Report progress"]'>
                            <div class="progress-bar progress-bar-striped progress-bar-animated bg-info" style="width:100%"></div>
                        </div>
                        <div class="text-muted small"><span id="reportPreviewElapsed">@Loc["0s"]</span></div>
                    </div>
                    <iframe id="reportPreviewFrame" title="QC report preview"
                            class="w-100 h-100 border-0 d-none"></iframe>
                </div>
                <div class="modal-footer">
                    <span class="text-muted small me-auto">@Loc["Built fresh from the latest saved data."]</span>
                    <a asp-controller="Reports" asp-action="QualityOrderPdfPreview" asp-route-id="@Model.QualityOrderId"
                       class="btn btn-outline-secondary" target="_blank" rel="noopener">
                        <i class="bi bi-box-arrow-up-right me-1"></i>@Loc["Open in new tab"]
                    </a>
                    <a asp-controller="Reports" asp-action="QualityOrderPdf" asp-route-id="@Model.QualityOrderId"
                       class="btn btn-outline-danger" target="_blank" rel="noopener">
                        <i class="bi bi-download me-1"></i>@Loc["Download"]
                    </a>
                    <button type="button" class="btn btn-outline-secondary" id="reportPreviewRefreshBtn">
                        <i class="bi bi-arrow-repeat me-1"></i>@Loc["Refresh"]
                    </button>
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">@Loc["Close"]</button>
                </div>
            </div>
        </div>
    </div>
}

@if (arrival != null && shipment != null)
{
    <div class="card mb-3">
        <div class="card-header py-2"><i class="bi bi-truck me-1"></i>@Loc["Shipment"]</div>
        <div class="card-body small">
            <div class="row g-2">
                <div class="col-md-3"><strong>@Loc["Container:"]</strong> <code>@arrival.ContainerNo</code></div>
                <div class="col-md-3"><strong>@Loc["BOL:"]</strong> @arrival.BolNo</div>
                <div class="col-md-3"><strong>@Loc["Vendor:"]</strong> @arrival.VendorName</div>
                <div class="col-md-3"><strong>@Loc["PO:"]</strong> @arrival.Ebeln</div>
                @* SAP's purchase-order document type, the same "Procurement Type"
                   the QC report prints. Shown here so the claim page carries it
                   too -- this view serves both. *@
                <div class="col-md-3">
                    <strong>@Loc["Procurement Type:"]</strong>
                    <span title="@arrival.PoType">@Codes.PoTypeDisplay(arrival.PoType)</span>
                </div>
                <div class="col-md-3"><strong>@Loc["Vessel:"]</strong> @shipment.VesselName / @shipment.VoyageNumber</div>
                <div class="col-md-3"><strong>@Loc["Loading port:"]</strong> @shipment.LoadingPort, <span title="@shipment.LoadingCountry">@Countries.Display(shipment.LoadingCountry)</span></div>
                <div class="col-md-3"><strong>@Loc["Port of arrival:"]</strong> @shipment.ArrivalPlace</div>
            </div>
            @* Shipment timeline, in the order the events actually happen, so a
               gap or an out-of-order date is obvious. Same sequence as the QC
               report and the Claims list. A missing date shows as a dash rather
               than a blank, or the sequence would silently close up. *@
            @{
                string SD(DateTime? d) => d?.ToString("yyyy-MM-dd") ?? "—";
                // Labels share their keys with the arrival page, so a caption
                // renamed on Admin -> Labels ("Vessel Discharge Date", "Branch
                // Receive Date") reads the same here.
                var timeline = new (string Label, DateTime? Value)[]
                {
                    (Loc["Loading date"],        shipment.SailingDate),
                    (Loc["Vessel arrival date"], shipment.PortArrivalDate),
                    (Loc["Discharge date"],      shipment.DischargeDate),
                    (Loc["Pull-out date"],       shipment.PullOutDate),
                    (Loc["Receive date"],        shipment.ReceiveDate),
                    (Loc["Unloading date"],      shipment.UnloadingDate),
                    (Loc["Inspection date"],     shipment.InspectionDate),
                };
            }
            <hr class="my-2" />
            <div class="row g-2">
                @foreach (var ev in timeline)
                {
                    <div class="col-6 col-md-3 col-xl-2">
                        <strong>@ev.Label:</strong> @SD(ev.Value)
                    </div>
                }
                @if (shipment.EffectiveTransitDays.HasValue)
                {
                    <div class="col-6 col-md-3 col-xl-2" title='@Loc["Loading date to discharge date; SAP's estimate until the discharge date is entered"]'>
                        <strong>@Loc["Transit days:"]</strong> @shipment.EffectiveTransitDays
                    </div>
                }
            </div>
        </div>
    </div>
}

@* ---- One collapsible card per material. Header stays visible when
       collapsed so the user can still trigger Add sample / Override on a
       material whose body is hidden. Per-material Photos button was removed
       in V31 (2026-06-20) -- photos are now per-sample (see sample drawer). ---- *@
@{
    var headerComplete = ViewBag.HeaderComplete as IReadOnlyDictionary<long, bool>
                         ?? new Dictionary<long, bool>();
}
@foreach (var m in materials)
{
    var matSamples = samples.Where(s => s.QoMaterialId == m.QoMaterialId).OrderBy(s => s.SampleNo).ToList();
    var matHeaderOk = headerComplete.TryGetValue(m.QoMaterialId, out var hc) && hc;
    var bodyId     = $"matBody-{m.QoMaterialId}";

    <div class="card mb-3 mat-card collapsed-card" data-qo-material-id="@m.QoMaterialId">
        @* Whole header is the collapse target -- the chevron is purely
           visual. Clicks on action buttons inside the header are ignored
           by the JS handler so the buttons still work.
           Material panels are COLLAPSED by default; user expands the ones
           they want to work on. State persists per-material in
           sessionStorage so reloads don't lose the user's expansion. *@
        <div class="card-header card-header-toggle d-flex justify-content-between align-items-center flex-wrap gap-2"
             data-target-body="#@bodyId" style="cursor: pointer;">
            <div class="d-flex align-items-center gap-2 flex-wrap">
                <i class="bi bi-chevron-down chevron" title="Show / hide details"></i>
                <i class="bi bi-box"></i>
                <code>@m.MaterialNo</code>
                <span>@m.MaterialDesc</span>
                <span class="badge bg-info ms-1 sample-count-badge" data-qo-material-id="@m.QoMaterialId">
                    @matSamples.Count sample@(matSamples.Count == 1 ? "" : "s")
                </span>
                @* 2026-07-26: material details are no longer a hard stop for adding
                   samples — a soft reminder badge only. The real reminder is the
                   editable Material details card inside every sample form. *@
                @if (!matHeaderOk)
                {
                    <span class="badge bg-warning text-dark ms-1" title="Material details not filled in yet — you can fill them from any sample.">
                        <i class="bi bi-exclamation-triangle me-1"></i>@Loc["Details incomplete"]
                    </span>
                }
            </div>
            <div class="d-flex gap-2 flex-wrap">
                @if (canAct)
                {
                    @* Add sample is always available (2026-07-26). Missing material
                       details no longer block it — they can be filled from within
                       the sample. *@
                    <button type="button" class="btn btn-sm btn-success sample-add"
                            data-qo-id="@Model.QualityOrderId"
                            data-qo-material-id="@m.QoMaterialId">
                        <i class="bi bi-plus-circle me-1"></i>@Loc["Add sample"]
                    </button>
                }
                <button type="button" class="btn btn-sm btn-outline-info material-details-btn"
                        data-bs-toggle="modal" data-bs-target="#materialDetailsModal"
                        data-qo-material-id="@m.QoMaterialId">
                    <i class="bi bi-card-list me-1"></i>@Loc["Material details"]
                </button>
                @if (canAct)
                {
                    <button class="btn btn-sm btn-outline-warning"
                            data-bs-toggle="modal" data-bs-target="#overrideModal"
                            data-qo-material-id="@m.QoMaterialId"
                            data-quality-order-id="@Model.QualityOrderId"
                            data-current-size="@(m.MaterialSize ?? "")">
                        <i class="bi bi-pencil-square me-1"></i>@Loc["Override size"]
                    </button>
                }
            </div>
        </div>

        <div id="@bodyId" class="collapse">
            <div class="card-body small">
                <div class="row g-2 mb-0">
                    <div class="col-md-4 col-lg-3"><strong>@Loc["Material Group:"]</strong> @m.MaterialGroup @(string.IsNullOrWhiteSpace(m.MaterialGroupDesc) ? "" : "— " + m.MaterialGroupDesc)</div>
                    <div class="col-md-4 col-lg-3"><strong>@Loc["Major Category:"]</strong> @m.MajorCategory</div>
                    <div class="col-md-4 col-lg-3"><strong>@Loc["Sub-Major Category:"]</strong> @m.SubMajorCategory</div>
                    <div class="col-md-4 col-lg-3"><strong>@Loc["Variety:"]</strong> @m.Variety</div>
                    <div class="col-md-4 col-lg-3"><strong>@Loc["Class:"]</strong> @m.MaterialClass</div>
                    <div class="col-md-4 col-lg-3"><strong>@Loc["Origin:"]</strong> @m.Origin</div>
                    <div class="col-md-4 col-lg-3 size-cell" data-qo-material-id="@m.QoMaterialId">
                        <strong>@Loc["Size:"]</strong>
                        <span class="size-value">@(m.MaterialSize ?? "—")</span>
                        <span class="override-badge @(m.SizeOverridden ? "" : "d-none")">
                            <span class="badge bg-warning text-dark ms-1" title="@m.OverrideReason">@Loc["Override"]</span>
