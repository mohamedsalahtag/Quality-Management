                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">@Loc["Cancel"]</button>
                <button type="submit" class="btn btn-danger">
                    <i class="bi bi-arrow-repeat me-1"></i>@Loc["Raise reinspection"]
                </button>
            </div>
        </form>
    </div>
</div>

@* ---- Send report to supplier modal (visible only when enabled in
       Parameters → Mail Template). Body + subject load from server-side
       template via PrepareSendQualityReport AJAX. ---- *@
@* Rendered in claim context, where the chat panel's send button targets it.
   The old Parameters -> Mail Template "Enabled" switch that used to gate this
   was removed: it controlled a QO-page button that no longer exists. *@
@if ((bool?)ViewBag.IsClaimContext == true)
{
    <div class="modal fade" id="sendReportModal" tabindex="-1">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title"><i class="bi bi-envelope-paper me-1"></i>@Loc["Send report to supplier"]</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div id="srm-load" class="text-center py-4 text-muted">
                        <div class="spinner-border"></div>
                        <div class="small mt-2">@Loc["Preparing email…"]</div>
                    </div>
                    <form id="srm-form" class="d-none">
                        @* Three states, one banner slot: no address on file (warn),
                           address remembered in QMS (info), address from SAP (info). *@
                        <div id="srm-no-email" class="alert alert-warning small d-none">
                            <i class="bi bi-exclamation-triangle me-1"></i>
                            No e-mail address is on file for <strong id="srm-supplier-a">@Loc["this supplier"]</strong>.
                            SAP's vendor master does not carry supplier e-mail addresses, so QMS keeps its own.
                            Type the address below and tick <em>@Loc["Remember"]</em> to save it for next time.
                        </div>
                        <div id="srm-email-qms" class="alert alert-info small d-none">
                            <i class="bi bi-bookmark-check me-1"></i>
                            Using the address saved in QMS for <strong id="srm-supplier-b">@Loc["this supplier"]</strong>.
                            Editing it below and leaving <em>@Loc["Remember"]</em> ticked updates it.
                        </div>
                        <div id="srm-email-sap" class="alert alert-info small d-none">
                            <i class="bi bi-database-check me-1"></i>
                            @Loc["Address taken from the SAP vendor master."]
                        </div>
                        <div class="mb-2">
                            <label class="form-label">@Loc["To *"]</label>
                            <input id="srm-to" name="to" class="form-control" placeholder="supplier@example.com" required />
                            <div class="form-text">@Loc["Comma- or semicolon-separated for multiple recipients."]</div>
                            <div class="form-check mt-1">
                                <input class="form-check-input" type="checkbox" id="srm-remember" checked />
                                <label class="form-check-label small" for="srm-remember">
                                    @Loc["Remember the first address for this supplier"]
                                    <span class="text-muted">@Loc["(reused next time; CC is never saved)"]</span>
                                </label>
                            </div>
                        </div>
                        @* Read-only: the send path applies these whatever the box
                           below says, so showing them as editable would lie. *@
                        <div class="mb-2 d-none" id="srm-alwayscc-wrap">
                            <label class="form-label">@Loc["Always CC"]</label>
                            <div class="form-control bg-body-secondary" id="srm-alwayscc"></div>
                            <div class="form-text">Set in Parameters &rarr; Mail Template. Copied on every supplier report.</div>
                        </div>
                        <div class="mb-2">
                            <label class="form-label">@Loc["CC"]</label>
                            <input id="srm-cc" name="cc" class="form-control" placeholder='@Loc["optional, comma-separated"]' />
                        </div>
                        <div class="mb-2">
                            <label class="form-label">@Loc["Subject *"]</label>
                            <input id="srm-subject" name="subject" class="form-control" required />
                        </div>
                        <div class="mb-2">
                            <label class="form-label">@Loc["Body *"]</label>
                            <textarea id="srm-body" name="body" class="form-control" rows="8" required></textarea>
                            <div class="form-text">@Loc["Plain text. The PDF report is attached automatically."]</div>
                        </div>
                        <div class="small text-muted mb-2"><i class="bi bi-paperclip me-1"></i><span id="srm-filename">@Loc["report.pdf"]</span> (generated when you press Send)</div>

                        @* Documents already on the order or its arrival. Offered
                           here so a packing list or certificate can go with the
                           report without leaving the dialog to find it. *@
                        <div id="srm-docs-wrap" class="d-none">
                            <label class="form-label mb-1">@Loc["Also attach"]</label>
                            <div id="srm-docs" class="border rounded p-2" style="max-height:12rem;overflow:auto"></div>
                            <div class="form-text d-flex justify-content-between">
                                <span>@Loc["From this quality order and its arrival."]</span>
                                <span id="srm-docs-total" class="text-muted"></span>
                            </div>
                        </div>
                    </form>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">@Loc["Cancel"]</button>
                    <button type="button" class="btn btn-info" id="srm-send"><i class="bi bi-send me-1"></i>@Loc["Send"]</button>
                </div>
            </div>
        </div>
    </div>
}

<div class="modal fade" id="overrideModal" tabindex="-1">
    <div class="modal-dialog">
        <form id="overrideForm" class="modal-content">
            <input type="hidden" name="qoMaterialId" id="ov-qo-material-id" />
            <input type="hidden" name="qualityOrderId" id="ov-quality-order-id" />
            <div class="modal-header"><h5 class="modal-title">@Loc["Override sample size (inspected qty)"]</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button></div>
            <div class="modal-body">
                <p class="small text-muted">Current sample size: <code id="ov-current"></code>. The new value is applied to every sample on this material. The override is fully audited.</p>
                <label class="form-label">@Loc["New sample size *"]</label>
                <input name="newSize" type="number" min="1" step="1" inputmode="numeric" class="form-control" required />
                <label class="form-label mt-2">@Loc["Reason"] <span class="text-muted small">@Loc["(optional)"]</span></label>
                <textarea name="reason" class="form-control" rows="3"></textarea>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">@Loc["Cancel"]</button>
                <button type="submit" class="btn btn-warning">@Loc["Save override"]</button>
            </div>
        </form>
    </div>
</div>

@* Material details: per-material header fields + sample size, entered once
   and inherited by every sample. Body is loaded over AJAX from MaterialPanel. *@
<div class="modal fade" id="materialDetailsModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header"><h5 class="modal-title"><i class="bi bi-card-list me-1"></i>@Loc["Material details"]</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button></div>
            <div class="modal-body" id="materialDetailsBody">
                <div class="text-center text-muted py-4"><span class="spinner-border spinner-border-sm me-2"></span>Loading…</div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">@Loc["Cancel"]</button>
                <button type="button" class="btn btn-primary" id="mdm-save"><i class="bi bi-save me-1"></i>@Loc["Save material details"]</button>
            </div>
        </div>
    </div>
</div>

@* Per-entity audit panels removed 2026-06-13. Filter the master audit log
   at /Audit (Admin menu) by entity type + id to see this QO's history. *@

@* Claim chat panel -- only rendered when this view is invoked from
   ClaimManagementController.Details. In that context every other
   mutation surface has been suppressed (canEdit/canManage/canAct all
   forced to false) so this panel is the only interactive UI on the page. *@
@if (isClaimContext)
{
    @await Html.PartialAsync("~/Views/ClaimManagement/_ClaimChatPanel.cshtml", Model)
}

@section Scripts {
<script>
    // ---- QC report preview popup: build the report PDF fresh every time the
    //      modal opens (and on Refresh), so it always reflects the latest saved
    //      data — even before the order is finished.
    //
    //      The PDF is fetched into a blob rather than pointed at with an iframe
    //      src, for two reasons: an iframe gives no way to tell "still
    //      generating" from "generated but blank", and a non-200 (403, or a
    //      render that threw) would paint the raw error page inside the frame.
    //      With fetch we own the whole progress and error story, and the blob
    //      URL is revoked when the modal closes.
    (function () {
        var modal = document.getElementById('reportPreviewModal');
        if (!modal) return;
        var frame   = document.getElementById('reportPreviewFrame');
        var status  = document.getElementById('reportPreviewStatus');
        var msg     = document.getElementById('reportPreviewMsg');
        var elapsed = document.getElementById('reportPreviewElapsed');
        var url     = '@Url.Action("QualityOrderPdfPreview", "Reports", new { id = Model.QualityOrderId })';
        // Captured before the first failure can overwrite it, so Refresh and
        // every reopen restore the same progress panel the page rendered.
        var spinnerHtml = status.innerHTML;
        var blobUrl = null, timer = null, inFlight = null;

        function release() {
            if (blobUrl) { URL.revokeObjectURL(blobUrl); blobUrl = null; }
            frame.removeAttribute('src');
            frame.classList.add('d-none');
        }
        function stopTimer() { if (timer) { clearInterval(timer); timer = null; } }
        function fail(text) {
            status.classList.remove('d-none');
            status.innerHTML = '<div class="alert alert-danger mb-0">' + text + '</div>';
        }

        async function load() {
            // A second open while the first is still rendering would leave two
            // responses racing for the same frame — abort the older one.
            if (inFlight) inFlight.abort();
            inFlight = new AbortController();
            release();
            stopTimer();
            status.classList.remove('d-none');
            status.innerHTML = spinnerHtml;
            msg     = document.getElementById('reportPreviewMsg');
            elapsed = document.getElementById('reportPreviewElapsed');

            var started = Date.now();
            timer = setInterval(function () {
                var s = Math.round((Date.now() - started) / 1000);
                elapsed.textContent = s + 's';
                // Only once it is genuinely slow — saying it up front would make
                // every fast report look like a problem.
                if (s === 8) msg.textContent = 'Still working — orders with many samples and photos take longer…';
            }, 1000);

            try {
                var res = await fetch(url, { credentials: 'same-origin', signal: inFlight.signal });
                if (!res.ok) {
                    fail(res.status === 403
                        ? 'You do not have permission to view this report.'
                        : 'Could not generate the report (' + res.status + '). Try Refresh.');
                    return;
                }
                blobUrl = URL.createObjectURL(await res.blob());
                frame.src = blobUrl;
                frame.classList.remove('d-none');
                status.classList.add('d-none');
            } catch (e) {
                if (e && e.name === 'AbortError') return;   // superseded, not failed
                fail('Request failed: ' + (e && e.message ? e.message : e));
            } finally {
                stopTimer();
            }
        }

        modal.addEventListener('show.bs.modal', load);
        // Free the blob (a report runs to several MB) and drop the frame, so a
        // reopen always regenerates rather than showing a stale render.
        modal.addEventListener('hidden.bs.modal', function () {
            if (inFlight) { inFlight.abort(); inFlight = null; }
            stopTimer();
            release();
        });
        var rb = document.getElementById('reportPreviewRefreshBtn');
        if (rb) rb.addEventListener('click', load);

        // Maximise / restore. Toggles Bootstrap's own full-screen dialog class,
        // so the maximised view is the same one small screens already get.
        // Remembered per browser; storage can be blocked (private windows), in
        // which case it simply starts restored every time.
        var dialog = document.getElementById('reportPreviewDialog');
        var body   = document.getElementById('reportPreviewBody');
        var maxBtn = document.getElementById('reportPreviewMaxBtn');
        var KEY = 'qms.reportPreview.maximized';
        function setMax(on) {
            dialog.classList.toggle('modal-fullscreen', on);
            body.style.height = on ? 'calc(100vh - 8.5rem)' : '78vh';
            maxBtn.setAttribute('aria-pressed', on ? 'true' : 'false');
            maxBtn.title = on ? 'Restore' : 'Maximize';
            maxBtn.setAttribute('aria-label', maxBtn.title);
            maxBtn.innerHTML = on ? '<i class="bi bi-fullscreen-exit"></i>' : '<i class="bi bi-arrows-fullscreen"></i>';
            try { localStorage.setItem(KEY, on ? '1' : '0'); } catch (e) { }
        }
        var startMax = false;
        try { startMax = localStorage.getItem(KEY) === '1'; } catch (e) { }
        setMax(startMax);
        maxBtn.addEventListener('click', function () {
            setMax(!dialog.classList.contains('modal-fullscreen'));
        });
    })();

    // ---- Delete confirmation: arm the button only on an exact QO-number
    //      match, and clear the field each time the modal opens so a second
    //      visit never starts pre-armed. The server checks this again anyway.
    (function () {
        var modal = document.getElementById('deleteQoModal');
        if (!modal) return;                       // not a SiteAdmin, or wrong status
        var input  = document.getElementById('qo-delete-confirm');
        var submit = document.getElementById('qo-delete-submit');
        var expected = '@Model.QualityOrderNo';

        function sync() {
            submit.disabled = input.value.trim().toUpperCase() !== expected.toUpperCase();
        }
        input.addEventListener('input', sync);
        modal.addEventListener('shown.bs.modal', function () { input.value = ''; sync(); input.focus(); });
    })();

    // ---- AJAX helpers (used by every page-local interaction) -------------
    const AF_TOKEN = document.querySelector('#qoAntiforgery input[name="__RequestVerificationToken"]').value;
    const QO_ID    = @Model.QualityOrderId;

    function showToast(message, kind, opts) {
        opts = opts || {};
        const host = document.getElementById('qoToastHost');
        const div  = document.createElement('div');
        div.className = 'toast align-items-center text-bg-' + (kind || 'success') + ' border-0 show mb-2';
        div.setAttribute('role', 'status');
        // Sticky toasts (opts.sticky === true) ignore the auto-dismiss timer
        // and rely on the close button being clicked. Used for warnings the
        // operator must acknowledge (e.g., non-numeric material size).
        const closeBtn = '<button class="btn-close btn-close-white me-2 m-auto" type="button" aria-label="Close"></button>';
        div.innerHTML = '<div class="d-flex"><div class="toast-body">' + message + '</div>' + closeBtn + '</div>';
        host.appendChild(div);
        const dismiss = () => { div.classList.remove('show'); setTimeout(() => div.remove(), 300); };
        div.querySelector('.btn-close').addEventListener('click', dismiss);
        if (!opts.sticky) setTimeout(dismiss, 2800);
    }

    async function postForm(url, formData) {
        // Always inject the antiforgery field name that ValidateAntiForgeryToken
        // looks for by default. The header is sent too, as belt + braces.
        if (!formData.has('__RequestVerificationToken')) formData.append('__RequestVerificationToken', AF_TOKEN);
        const res = await fetch(url, {
            method: 'POST',
            headers: { 'X-CSRF-TOKEN': AF_TOKEN, 'Accept': 'application/json' },
            credentials: 'same-origin',
            body: formData
        });
        if (!res.ok) {
            // Try to surface a useful reason -- the antiforgery middleware
            // returns 400 with a plain message, and our own validation
            // errors come back via res.json() with {ok:false, error:...}.
            let detail = 'HTTP ' + res.status;
            try {
                const txt = await res.text();
                if (txt) detail += ' — ' + txt.slice(0, 240);
            } catch (_) { /* ignore */ }
            throw new Error(detail);
        }
        return await res.json();
    }

    async function postJson(url, params) {
        const fd = new FormData();
        for (const k of Object.keys(params)) if (params[k] != null) fd.append(k, params[k]);
        return postForm(url, fd);
    }

    // ---- Material card collapse: whole header is the toggle, with
    // sessionStorage persistence so the state survives reloads. Action
    // buttons inside the header are exempt so they still fire normally.
    // Default state is COLLAPSED; sessionStorage key is presence-only --
    // its existence means "user expanded this panel; keep it open across
    // reloads". Removing the key reverts to the collapsed default.
    document.querySelectorAll('.mat-card').forEach(card => {
        const mid = card.dataset.qoMaterialId;
        const key = 'qoExpanded:' + QO_ID + ':' + mid;
        const body = card.querySelector('.collapse');
        if (sessionStorage.getItem(key) === 'expanded') {
            body.classList.add('show');
            card.classList.remove('collapsed-card');
        }
        body.addEventListener('shown.bs.collapse',  () => { sessionStorage.setItem(key, 'expanded'); card.classList.remove('collapsed-card'); });
        body.addEventListener('hidden.bs.collapse', () => { sessionStorage.removeItem(key);          card.classList.add('collapsed-card');    });

        const header = card.querySelector('.card-header-toggle');
        header?.addEventListener('click', ev => {
            // Don't toggle when the user actually meant to press an
            // action button / link / form control inside the header.
            if (ev.target.closest('button, a, input, select, label, form')) return;
            bootstrap.Collapse.getOrCreateInstance(body).toggle();
        });
    });

    // ---- Sample drawer: lazy load via AJAX -------------------------------
    const drawerEl    = document.getElementById('sampleDrawer');
    const drawerBody  = document.getElementById('sampleDrawerBody');
    const drawerTitle = document.getElementById('sampleDrawerTitle');
    const drawer      = bootstrap.Offcanvas.getOrCreateInstance(drawerEl);
    let drawerToken = 0;     // ignore stale responses if user clicks fast
    let drawerContext = null;// { qoMaterialId, sampleId, isNew }

    async function loadDrawer(query, headerText, ctx) {
        drawerContext = ctx;
        drawerTitle.textContent = headerText;
        drawerBody.innerHTML = '<div class="text-center py-5 text-muted"><div class="spinner-border"></div><div class="small mt-2">Loading sample…</div></div>';
        drawer.show();
        const tok = ++drawerToken;
        const res = await fetch('@Url.Action("SamplePanel", "QualityOrders")?' + query, { headers: { 'Accept': 'text/html' } });
        if (tok !== drawerToken) return;            // newer request in flight
        if (!res.ok) { drawerBody.innerHTML = '<div class="alert alert-danger m-3">Could not load the sample form.</div>'; return; }
        drawerBody.innerHTML = await res.text();
        wireDrawerForm();
    }

    function wireDrawerForm() {
        const form = drawerBody.querySelector('form.sample-form');
        if (!form) return;

        // Sample size is inherited from the material (form.dataset.sampleSize)
        // and is no longer entered per sample, so there's nothing to auto-fill
        // here. If it's missing, the operator sets it on the Material details
        // panel; the defect-% stepper falls back to 0 until then.

        form.addEventListener('submit', async ev => {
            ev.preventDefault();
            const btn = form.querySelector('button[type="submit"]');
            if (btn) { btn.disabled = true; btn.dataset._t = btn.innerHTML; btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span>Saving…'; }
            try {
                const fd = new FormData(form);
                const data = await postForm('@Url.Action("SaveSampleAjax", "QualityOrders")', fd);
                if (!data.ok) { showToast(data.error || 'Save failed.', 'danger'); return; }
                applyRowUpdate(data);
                drawer.hide();
                showToast('Sample #' + data.sampleNo + ' saved.');
            } catch (e) {
                showToast('Save failed: ' + e.message, 'danger');
            } finally {
                if (btn) { btn.disabled = false; btn.innerHTML = btn.dataset._t; }
            }
        });
        wireDefectSteppers(drawerBody);
        wireWeightCompute(drawerBody);
    }

    function applyRowUpdate(data) {
        const tbody = document.querySelector('.samples-tbody[data-qo-material-id="' + data.qoMaterialId + '"]');
        if (!tbody) return;
        const empty = tbody.querySelector('.empty-samples-row'); if (empty) empty.remove();
        const tmp = document.createElement('tbody'); tmp.innerHTML = data.rowHtml.trim();
        const newRow = tmp.firstElementChild;
        const existing = tbody.querySelector('tr[data-sample-id="' + data.sampleId + '"]');
        if (existing) existing.replaceWith(newRow); else tbody.appendChild(newRow);
        // Update the badge.
        const badge = document.querySelector('.sample-count-badge[data-qo-material-id="' + data.qoMaterialId + '"]');
        if (badge) badge.textContent = data.newSampleCount + ' sample' + (data.newSampleCount === 1 ? '' : 's');
    }

    // Open / Add sample / Delete sample (event delegation on document so it works for AJAX-inserted rows).
    document.addEventListener('click', async ev => {
        const open = ev.target.closest('.sample-open');
        if (open) {
            const sid = open.dataset.sampleId;
            loadDrawer('sampleId=' + sid, 'Sample (loading…)', { sampleId: sid });
            return;
        }
        // V31 (2026-06-20): dedicated Photos drawer per sample row. Lazy
        // loads SamplePhotosPanel into #samplePhotosDrawerBody so only the
        // photo gallery renders -- no readings / defects / header.
        const photos = ev.target.closest('.sample-photos');
        if (photos) {
            const sid = photos.dataset.sampleId;
            const drawerEl = document.getElementById('samplePhotosDrawer');
            const body     = document.getElementById('samplePhotosDrawerBody');
            const title    = document.getElementById('samplePhotosDrawerTitle');
            if (title) title.textContent = 'Sample photos (loading…)';
            if (body)  body.innerHTML    = '<div class="text-center py-5 text-muted"><div class="spinner-border"></div><div class="small mt-2">Loading photos…</div></div>';
            const drawer = bootstrap.Offcanvas.getOrCreateInstance(drawerEl);
            drawer.show();
            try {
                const res = await fetch('@Url.Action("SamplePhotosPanel", "QualityOrders")?sampleId=' + sid,
                    { headers: { 'Accept': 'text/html' } });
                if (!res.ok) { body.innerHTML = '<div class="alert alert-danger m-2">Could not load photos.</div>'; return; }
                body.innerHTML = await res.text();
                if (title) title.textContent = 'Sample photos';
            } catch (e) {
                body.innerHTML = '<div class="alert alert-danger m-2">Could not load photos: ' + e.message + '</div>';
            }
            return;
        }
        const add = ev.target.closest('.sample-add');
        if (add) {
            const qoMatId = add.dataset.qoMaterialId;
            loadDrawer('qoId=' + QO_ID + '&qoMaterialId=' + qoMatId + '&isNew=true', 'New sample', { qoMaterialId: qoMatId, isNew: true });
            return;
        }
        const del = ev.target.closest('.sample-delete');
        if (del) {
            const sid = del.dataset.sampleId;
            const sno = del.dataset.sampleNo;
            if (!await appDialogs.confirm('Delete sample #' + sno + '?', { danger: true, okText: 'Delete' })) return;
            try {
                const data = await postJson('@Url.Action("DeleteSampleAjax", "QualityOrders")', { sampleId: sid });
                if (!data.ok) { showToast(data.error || 'Delete failed.', 'danger'); return; }
                const tr = document.querySelector('tr[data-sample-id="' + data.sampleId + '"]');
                if (tr) tr.remove();
                const badge = document.querySelector('.sample-count-badge[data-qo-material-id="' + data.qoMaterialId + '"]');
                if (badge) badge.textContent = data.newSampleCount + ' sample' + (data.newSampleCount === 1 ? '' : 's');
                // Restore the empty-row hint if all gone.
                const tbody = document.querySelector('.samples-tbody[data-qo-material-id="' + data.qoMaterialId + '"]');
                if (tbody && !tbody.querySelector('tr')) {
                    tbody.innerHTML = '<tr class="empty-samples-row"><td colspan="8" class="text-center text-muted small py-2">No samples recorded yet for this material.</td></tr>';
                }
                showToast('Sample #' + sno + ' deleted.');
            } catch (e) { showToast('Delete failed: ' + e.message, 'danger'); }
            return;
        }
        const clr = ev.target.closest('.override-clear');
        if (clr) {
            const qoMatId = clr.dataset.qoMaterialId;
            const qoId    = clr.dataset.qualityOrderId;
            if (!await appDialogs.confirm('Clear the size override and restore the original size?', { okText: 'Clear override' })) return;
            try {
                const data = await postJson('@Url.Action("ClearOverrideAjax", "QualityOrders")', { qoMaterialId: qoMatId, qualityOrderId: qoId });
                if (!data.ok) { showToast('Clear failed.', 'danger'); return; }
                updateSizeCell(qoMatId, data.materialSize, false);
                showToast('Override cleared.');
            } catch (e) { showToast('Clear failed: ' + e.message, 'danger'); }
        }
    });

    function updateSizeCell(qoMaterialId, newSize, overridden) {
        const cell = document.querySelector('.size-cell[data-qo-material-id="' + qoMaterialId + '"]');
        if (!cell) return;
        cell.querySelector('.size-value').textContent = newSize || '';
        const ob = cell.querySelector('.override-badge');
        if (overridden) ob?.classList.remove('d-none'); else ob?.classList.add('d-none');
    }

    // Override modal: open with prefilled data; submit via AJAX.
    document.getElementById('overrideModal')?.addEventListener('show.bs.modal', e => {
        const b = e.relatedTarget;
        document.getElementById('ov-qo-material-id').value   = b.dataset.qoMaterialId;
        document.getElementById('ov-quality-order-id').value = b.dataset.qualityOrderId;
        document.getElementById('ov-current').textContent    = b.dataset.currentSize || '—';
    });
    document.getElementById('overrideForm')?.addEventListener('submit', async ev => {
        ev.preventDefault();
        const fd = new FormData(ev.currentTarget);
        try {
            const data = await postForm('@Url.Action("SaveOverrideAjax", "QualityOrders")', fd);
            if (!data.ok) { showToast(data.error || 'Override failed.', 'danger'); return; }
            updateSizeCell(data.qoMaterialId, data.materialSize, true);
            bootstrap.Modal.getInstance(document.getElementById('overrideModal'))?.hide();
            showToast('Size override saved.');
        } catch (e) { showToast('Override failed: ' + e.message, 'danger'); }
    });

    // ---- Material details modal: lazy-load the form, save via AJAX --------
    const mdModalEl = document.getElementById('materialDetailsModal');
    const mdBody    = document.getElementById('materialDetailsBody');
    let mdCurrentMatId = null;
    mdModalEl?.addEventListener('show.bs.modal', async e => {
        const qoMatId = e.relatedTarget?.dataset.qoMaterialId;
        mdCurrentMatId = qoMatId;
        mdBody.innerHTML = '<div class="text-center text-muted py-4"><span class="spinner-border spinner-border-sm me-2"></span>Loading…</div>';
        const res = await fetch('@Url.Action("MaterialPanel", "QualityOrders")?qoMaterialId=' + qoMatId, { headers: { 'Accept': 'text/html' } });
        mdBody.innerHTML = res.ok ? await res.text() : '<div class="alert alert-danger m-2">Could not load material details.</div>';
        // Hide the Save button when the loaded form is read-only (QO not Open),
        // so a disabled, no-op Save isn't shown next to the "Read-only" banner.
        const loadedForm = mdBody.querySelector('#materialDetailsForm');
        const saveBtn = document.getElementById('mdm-save');
        if (saveBtn) saveBtn.classList.toggle('d-none', !loadedForm || loadedForm.dataset.editable !== 'true');
    });
    document.getElementById('mdm-save')?.addEventListener('click', async () => {
        const form = mdBody.querySelector('#materialDetailsForm');
        if (!form) return;
        if (!form.reportValidity()) return;          // honour required fields
        const fd = new FormData(form);
        try {
            const data = await postForm('@Url.Action("SaveMaterialHeaderAjax", "QualityOrders")', fd);
            if (!data.ok) { showToast(data.error || 'Save failed.', 'danger'); return; }
            bootstrap.Modal.getInstance(mdModalEl)?.hide();
            // Values are copied onto every sample server-side (and show in the
            // PDF); there's no on-page recap to refresh.
            showToast('Material details saved and applied to all samples.');
        } catch (e) { showToast('Save failed: ' + e.message, 'danger'); }
    });

    // ---- Defect steppers (delegated; works for any drawer instance) ------
    // Rule: SUM of all defect values on a sample <= sample size. Each input's
    // own cap is (sampleSize - sumOfOtherDefects). The server applies the
    // same clamp in catalog order on save.
    // Defensive: read size from form.dataset.sampleSize, fall back to the
    // Sample Size input value so the cap survives any render path where one
    // source is missing.
    function resolveSampleSize(form) {
        if (!form) return 0;
        const fromData = parseFloat(form.dataset.sampleSize);
        if (fromData > 0) return fromData;
        const sizeInput = form.querySelector('.sample-size-input');
        const fromInput = parseFloat(sizeInput?.value);
        return (fromInput > 0) ? fromInput : 0;
    }
    function sumOtherDefects(form, exceptInput) {
        let sum = 0;
        form.querySelectorAll('.defect-value').forEach(el => {
            if (el === exceptInput) return;
            const x = parseFloat(el.value);
            if (!isNaN(x) && x > 0) sum += x;
        });
        return sum;
    }
    function refreshDefectTotal(form, clampedTo) {
        if (!form) return;
        const size = resolveSampleSize(form);
        let total = 0;
        form.querySelectorAll('.defect-value').forEach(el => {
            const x = parseFloat(el.value);
            if (!isNaN(x) && x > 0) total += x;
        });
        const banner    = form.querySelector('.defect-total-banner');
        const curSpan   = form.querySelector('.defect-total-current');
        const sizeSpan  = form.querySelector('.defect-total-size');
        const noteSpan  = form.querySelector('.defect-total-note');
        if (curSpan)  curSpan.textContent  = (Math.round(total * 1000) / 1000).toString();
        if (sizeSpan) sizeSpan.textContent = (size > 0) ? size.toString() : '—';
        if (!banner) return;
        if (!(size > 0)) {
            // No denominator -- explain instead of silently allowing any value.
            banner.dataset.state = 'no-size';
            banner.classList.remove('text-danger', 'fw-bold');
            banner.classList.add('text-muted');
            banner.title = '';
            if (noteSpan) noteSpan.textContent = ' — sample size not set; use "Override size" on the material card.';
            return;
        }
        if (noteSpan) noteSpan.textContent = '';
        const atCap = (total >= size - 1e-9);
        const justClamped = (clampedTo === true) && atCap;
        if (justClamped) {
            banner.dataset.state = 'over';
            banner.classList.remove('text-muted');
            banner.classList.add('text-danger', 'fw-bold');
            banner.title = 'Sample size limit reached — extra values were capped';
        } else {
            banner.dataset.state = 'ok';
            banner.classList.remove('text-danger', 'fw-bold');
            banner.classList.add('text-muted');
            banner.title = '';
        }
    }
    function wireDefectSteppers(scope) {
        scope.querySelectorAll('.defect-stepper').forEach(row => {
            const input    = row.querySelector('.defect-value');
            const minus    = row.querySelector('.defect-minus');
            const plus     = row.querySelector('.defect-plus');
            const isDecimal = (row.dataset.valueType || 'Number').toLowerCase() === 'decimal';
            // v: candidate value for THIS input. Returns it capped to the
            // room left after every OTHER defect on the form. With sample
            // size 100 and others summing to 80, this caps at 20.
            const clampToRemaining = v => {
                const form = row.closest('form');
                const size = resolveSampleSize(form);
                if (!(size > 0)) return v;
                const remaining = Math.max(0, size - sumOtherDefects(form, input));
                return (v > remaining) ? remaining : v;
            };
            const updatePct = () => {
                const form = row.closest('form');
                const size = resolveSampleSize(form);
                // Browser-level upper bound: max = (size - sumOthers). With
                // the typed-into input excluded from sumOthers, max == remaining
                // room. Native number-input spinners + form validity honour this.
                if (size > 0) {
                    input.max = Math.max(0, size - sumOtherDefects(form, input));
                } else {
                    input.removeAttribute('max');
                }
                let v = parseFloat(input.value);
                let clamped = false;
                if (!isNaN(v)) {
                    const capped = clampToRemaining(v);
                    if (capped !== v) { input.value = capped; v = capped; clamped = true; }
                }
                const pctInput = form.querySelector('input[name="defect_' + input.dataset.id + '_pct"]');
                const badge = row.querySelector('.defect-pct-badge');
                if (!isNaN(v) && size > 0) {
                    const pct = (v / size * 100);
                    if (pctInput) pctInput.value = pct.toFixed(2);
                    if (badge) {
                        badge.textContent = pct.toFixed(1) + '%';
                        badge.className = 'badge defect-pct-badge ' + (pct < 2 ? 'bg-success' : pct < 5 ? 'bg-warning text-dark' : 'bg-danger');
                    }
                } else if (badge) {
                    badge.textContent = '';
                    badge.className = 'badge defect-pct-badge bg-light text-muted';
                }
                refreshDefectTotal(form, clamped);
            };
            const bump = delta => {
                // Stepper always nudges by 1 -- intuitive for both integer and
                // decimal defects. Decimal precision is preserved when the
                // operator types into the field directly.
                const cur = parseFloat(input.value);
                let next = (isNaN(cur) ? 0 : cur) + delta;
                if (next < 0) next = 0;
                next = clampToRemaining(next);
                input.value = isDecimal ? Number(next.toFixed(3)) : Math.round(next);
                updatePct();
            };
            minus?.addEventListener('click', () => bump(-1));
            plus?.addEventListener('click',  () => bump(+1));
            // Listen to input + change + blur so the cap re-applies regardless
            // of which event the browser fires for typing / paste / autocomplete.
            input?.addEventListener('input',  updatePct);
            input?.addEventListener('change', updatePct);
            input?.addEventListener('blur',   updatePct);
            updatePct();
        });
        // Keep data-sample-size + banner + defect maxes in sync when the
        // operator edits the per-sample Sample Size input. Defect-% badges
        // also recompute via updatePct (triggered by the dispatched 'input'
        // event on every .defect-value).
        scope.querySelectorAll('form.sample-form').forEach(form => {
            const sizeInput = form.querySelector('.sample-size-input');
            if (sizeInput && sizeInput.dataset.banwired !== '1') {
                sizeInput.dataset.banwired = '1';
                sizeInput.addEventListener('input', () => {
                    const n = parseFloat(sizeInput.value);
                    form.dataset.sampleSize = (n > 0) ? n : '';
                    form.querySelectorAll('.defect-value').forEach(el => {
                        el.dispatchEvent(new Event('input', { bubbles: true }));
                    });
                    refreshDefectTotal(form, false);
                });
            }
            refreshDefectTotal(form, false);
        });
    }

    // ---- Net weight = sample Gross - material Tara (read-only NET input) ---
    // Tara is now a single material-level value (data-weight-role="mattara"),
    // shared by every sample. If tara exceeds gross the net would be negative:
    // we flag the field red, show the error and disable Save so the mistake
    // can't be stored (the server re-checks too).
    function wireWeightCompute(scope) {
        scope.querySelectorAll('form.sample-form').forEach(form => {
            const gross = form.querySelector('[data-weight-role="gross"]');
            const tara  = form.querySelector('[data-weight-role="mattara"]');
            const net   = form.querySelector('[data-weight-role="net"]');
            if (!net) return;
            const errEl   = form.querySelector('.net-weight-error');
            const saveBtn = form.querySelector('button[type="submit"], input[type="submit"]');
            const recompute = () => {
                const g = parseFloat(gross?.value);
                const t = parseFloat(tara?.value);
                if (!isNaN(g) && !isNaN(t)) {
                    const val = Math.round((g - t) * 100) / 100;
                    net.value = val.toFixed(2);
                    const bad = val < 0;
                    net.classList.toggle('is-invalid', bad);
                    if (errEl) errEl.classList.toggle('d-none', !bad);
                    if (saveBtn) saveBtn.disabled = bad;
                } else {
                    net.value = '';
                    net.classList.remove('is-invalid');
                    if (errEl) errEl.classList.add('d-none');
                    if (saveBtn) saveBtn.disabled = false;
                }
            };
            gross?.addEventListener('input', recompute);
            tara?.addEventListener('input', recompute);
            recompute();
        });
    }

    // ---- Send report to supplier modal -------------------------------
    // Groups the offered documents by where they live, and keeps a running
    // total: mail servers reject oversized messages, and the sender should see
    // the weight building up rather than discover it from a bounce.
    function renderSrmDocs(docs) {
        const wrap = document.getElementById('srm-docs-wrap');
        const box  = document.getElementById('srm-docs');
        if (!wrap || !box) return;
        box.innerHTML = '';
        if (!docs.length) { wrap.classList.add('d-none'); return; }
        wrap.classList.remove('d-none');

        const bySource = {};
        docs.forEach(d => { (bySource[d.source] = bySource[d.source] || []).push(d); });
        Object.keys(bySource).forEach(src => {
            const h = document.createElement('div');
            h.className = 'text-muted small fw-semibold mt-1 mb-1';
            h.textContent = src;
            box.appendChild(h);
            bySource[src].forEach(d => {
                const row = document.createElement('div');
                row.className = 'form-check';
                const id = 'srm-doc-' + d.id;
                row.innerHTML =
                    '<input class="form-check-input" type="checkbox" value="' + d.id + '" id="' + id + '">' +
                    '<label class="form-check-label small" for="' + id + '"></label>';
                const lbl = row.querySelector('label');
                lbl.textContent = d.name;
                const meta = document.createElement('span');
                meta.className = 'text-muted';
                meta.textContent = '  ' + (d.category || '') + ' · ' + d.sizeKb + ' KB';
                lbl.appendChild(meta);
                row.querySelector('input').addEventListener('change', srmDocTotal);
                box.appendChild(row);
            });
        });
        srmDocTotal();

        function srmDocTotal() {
            let kb = 0;
            document.querySelectorAll('#srm-docs input[type=checkbox]:checked').forEach(c => {
                const d = docs.find(x => String(x.id) === c.value);
                if (d) kb += d.sizeKb;
            });
            const el = document.getElementById('srm-docs-total');
            el.textContent = kb === 0 ? '' : (kb / 1024).toFixed(1) + ' MB selected, plus the report';
        }
    }

    let SRM_VENDOR_NO = '';
    const srmEl = document.getElementById('sendReportModal');
    if (srmEl) {
        srmEl.addEventListener('show.bs.modal', async () => {
            document.getElementById('srm-load').classList.remove('d-none');
            document.getElementById('srm-form').classList.add('d-none');
            try {
                const res = await fetch('@Url.Action("PrepareSendQualityReport", "Reports")?id=' + QO_ID);
                if (!res.ok) throw new Error('HTTP ' + res.status);
                const data = await res.json();
                document.getElementById('srm-to').value      = data.to || '';
                document.getElementById('srm-cc').value      = '';
                document.getElementById('srm-subject').value = data.subject || '';
                document.getElementById('srm-body').value    = data.body || '';
                document.getElementById('srm-filename').textContent = data.fileName || 'report.pdf';
                SRM_VENDOR_NO = data.vendorNo || '';

                const always = data.alwaysCc || [];
                const wrap = document.getElementById('srm-alwayscc-wrap');
                document.getElementById('srm-alwayscc').textContent = always.join(', ');
                wrap.classList.toggle('d-none', always.length === 0);

                const name = data.supplierName || 'this supplier';
                document.getElementById('srm-supplier-a').textContent = name;
                document.getElementById('srm-supplier-b').textContent = name;
                // Exactly one banner is visible at a time.
                const banners = {
                    none: document.getElementById('srm-no-email'),
                    qms:  document.getElementById('srm-email-qms'),
                    sap:  document.getElementById('srm-email-sap')
                };
                Object.values(banners).forEach(b => b.classList.add('d-none'));
                const which = !data.emailKnown ? 'none' : (data.emailSource === 'sap' ? 'sap' : 'qms');
                banners[which].classList.remove('d-none');

                // Nothing to store an address against without a vendor number,
                // and an address already coming FROM SAP should not be shadowed
                // by a QMS copy that would then go stale.
                const remember = document.getElementById('srm-remember');
                const canRemember = !!SRM_VENDOR_NO && which !== 'sap';
                remember.checked  = canRemember;
                remember.disabled = !canRemember;
                renderSrmDocs(data.documents || []);

                document.getElementById('srm-load').classList.add('d-none');
                document.getElementById('srm-form').classList.remove('d-none');
            } catch (e) {
                showToast('Could not prepare email: ' + e.message, 'danger');
                bootstrap.Modal.getInstance(srmEl)?.hide();
            }
        });
        document.getElementById('srm-send').addEventListener('click', async () => {
            const fd = new FormData();
            fd.append('id',      QO_ID);
            fd.append('to',      document.getElementById('srm-to').value);
            fd.append('cc',      document.getElementById('srm-cc').value);
            fd.append('subject', document.getElementById('srm-subject').value);
            fd.append('body',    document.getElementById('srm-body').value);
            document.querySelectorAll('#srm-docs input[type=checkbox]:checked')
                    .forEach(c => fd.append('documentIds', c.value));
            if (!fd.get('to') || !fd.get('subject') || !fd.get('body')) {
                showToast('Recipient, subject and body are required.', 'warning'); return;
            }
            const btn = document.getElementById('srm-send');
            btn.disabled = true; btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span>Sending…';
            try {
                const data = await postForm('@Url.Action("SendQualityReport", "Reports")', fd);
                if (data.ok) {
                    // Only after a successful send -- remembering an address that
                    // just bounced would bake the mistake in for everyone.
                    const remember = document.getElementById('srm-remember');
                    if (remember.checked && !remember.disabled && SRM_VENDOR_NO) {
                        const vf = new FormData();
                        vf.append('vendorNo', SRM_VENDOR_NO);
                        vf.append('email',    document.getElementById('srm-to').value);
                        try {
                            const sv = await postForm('@Url.Action("SaveSupplierEmail", "Reports")', vf);
                            if (!sv.ok) showToast('Report sent, but the address was not saved: ' + (sv.error || 'unknown error'), 'warning');
                        } catch (e) {
                            showToast('Report sent, but the address was not saved: ' + e.message, 'warning');
                        }
                    }
                    bootstrap.Modal.getInstance(srmEl)?.hide();
                    showToast('Report sent.');
                } else {
                    showToast('Send failed: ' + (data.error || 'unknown error'), 'danger');
                }
            } catch (e) { showToast('Send failed: ' + e.message, 'danger'); }
            finally { btn.disabled = false; btn.innerHTML = '<i class="bi bi-send me-1"></i>Send'; }
        });
    }
</script>
}
