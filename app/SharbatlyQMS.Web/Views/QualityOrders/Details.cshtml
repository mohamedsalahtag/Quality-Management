                                    <i class="bi bi-x-circle-fill"></i>
                                </button>
                            }
                        </span>
                    </div>
                    <div class="col-md-4 col-lg-3"><strong>@Loc["Weight:"]</strong> @m.NetWeight</div>
                </div>
            </div>

            <div class="samples-sublist" data-qo-material-id="@m.QoMaterialId">
                <div class="table-responsive">
                    <table class="table table-sm table-hover align-middle">
                        <thead class="table-light">
                            <tr>
                                <th>@Loc["Sample #"]</th>
                                <th>@Loc["Grower"]</th>
                                <th>@Loc["Pallet"]</th>
                                <th>@Loc["Lot"]</th>
                                <th>@Loc["Date code"]</th>
                                <th class="text-end">@Loc["Firmness"]</th>
                                <th class="text-end">@Loc["Brix"]</th>
                                <th class="text-end">@Loc["Size"]</th>
                                <th class="text-end">@Loc["Created"]</th>
                                <th class="text-end" style="min-width:110px;">@Loc["Actions"]</th>
                            </tr>
                        </thead>
                        <tbody class="samples-tbody" data-qo-material-id="@m.QoMaterialId">
                            @foreach (var s in matSamples)
                            {
                                var rowVm = new SampleRowVm {
                                    Sample = s, Editable = editable,
                                    HeaderValues = sampleHeaders?[s.SampleId].ToList() ?? new List<SampleHeaderValue>(),
                                    Readings    = sampleReadings?[s.SampleId].ToList() ?? new List<SampleReading>(),
                                    PhotoCount  = photoCounts.TryGetValue(s.SampleId, out var spc) ? spc : 0
                                };
                                <partial name="~/Views/QualityOrders/_SampleRow.cshtml" model="rowVm" />
                            }
                            @if (matSamples.Count == 0)
                            {
                                <tr class="empty-samples-row"><td colspan="10" class="text-center text-muted small py-2">@Loc["No samples recorded yet for this material."]</td></tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    @* V31 (2026-06-20): per-material Photos drawer removed. Photos are now
       per-sample (see the photo card inside the sample drawer in _SampleForm). *@
}

@* ---- ONE shared sample drawer for the whole page. Its body is filled
