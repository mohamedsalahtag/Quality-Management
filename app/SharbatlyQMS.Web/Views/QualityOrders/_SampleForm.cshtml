@using SharbatlyQMS.Web.Models
@using SharbatlyQMS.Web.ViewModels
@model SampleFormVm
@{
    var s             = Model.Sample;
    var qo            = Model.Qo;
    var qoMat         = Model.QoMaterial;
    var readingTypes  = Model.ReadingTypes;
    var defects       = Model.Defects;
    var sectionMap    = Model.SectionMap;
    var existingReads = Model.ExistingReadings;
    var existingDefs  = Model.ExistingDefects;
    var editable      = Model.Editable;

    decimal? RnumOf(string code) => existingReads.FirstOrDefault(x => x.ReadingTypeCode == code)?.NumericValue;
    string   RtxOf(string code)  => existingReads.FirstOrDefault(x => x.ReadingTypeCode == code)?.TextValue ?? "";
    decimal? DvalOf(int id) => existingDefs.FirstOrDefault(x => x.DefectId == id)?.DefectValue;
    decimal? DpctOf(int id) => existingDefs.FirstOrDefault(x => x.DefectId == id)?.DefectPercentage;

    // Defects are grouped into one section per category (V22+), ordered by
    // the category's sort_order and coloured by its colour. Categories come
    // from the admin-managed master list (Admin -> Defect Categories);
    // unknown/inactive categories fall to the end with a neutral colour so a
    // defect is never silently hidden.
    var catMeta = Model.Categories.ToDictionary(c => c.CategoryName, StringComparer.OrdinalIgnoreCase);
    int CatSort(string name) => catMeta.TryGetValue(name, out var m) ? m.SortOrder : 999;
    string CatColor(string name) =>
        (catMeta.TryGetValue(name, out var m) && !string.IsNullOrWhiteSpace(m.ColorHex)) ? m.ColorHex! : "#6c757d";
    var defectGroups = defects
        .GroupBy(d => d.DefectCategory ?? "", StringComparer.OrdinalIgnoreCase)
        .OrderBy(g => CatSort(g.Key)).ThenBy(g => g.Key)
        .ToList();

    var headerSubtitle = qoMat != null
        ? $"#{(s.SampleId == 0 ? "new" : s.SampleNo.ToString())} — {qoMat.MaterialNo} {qoMat.MaterialDesc}"
        : (s.SampleId == 0 ? "New sample" : $"Sample #{s.SampleNo}");
}

<style>
    /* Compact, tablet-friendly sample form: tighter cards, smaller paddings,
       4-col grid even on md so the form stays short. */
    .sample-form .card-header { padding: .25rem .5rem; font-size: .85rem; }
    .sample-form .card-body   { padding: .5rem; }
    .sample-form .form-label  { margin-bottom: .15rem; font-size: .75rem; color: #6c757d; }
    .sample-form .form-control-sm, .sample-form .form-select-sm { font-size: .82rem; padding: .2rem .4rem; }
    .sample-form .section-label {
        font-size: .7rem; letter-spacing: .06em; text-transform: uppercase;
        font-weight: 600; color: #6c757d; margin: .4rem 0 .25rem;
        border-left: 3px solid #6c757d; padding-left: .4rem;
    }
    /* Section colour now comes from the category (inline style); the base
       .section-label rule above supplies layout. */
    /* Defect stepper: chunky tap targets for tablet. */
    .defect-stepper { display: flex; align-items: center; gap: .15rem; }
    .defect-stepper .btn-step {
        min-width: 36px; min-height: 36px;
        padding: 0; font-size: 1.1rem; font-weight: 700;
        line-height: 1;
    }
    /* On touch devices (tablets / phones) bump the stepper to the WCAG
       recommended 44x44px minimum so warehouse staff don't mis-tap. */
    @@media (hover: none) and (pointer: coarse) {
        .defect-stepper .btn-step {
            min-width: 44px; min-height: 44px;
            font-size: 1.25rem;
        }
        .defect-stepper .defect-value {
            min-height: 44px;
        }
    }
    .defect-stepper .defect-value {
        width: 60px; text-align: center;
        font-size: .95rem; padding: .25rem;
    }
    .defect-row { padding: .2rem .35rem; border-bottom: 1px solid #f0f0f0; }
    .defect-row:hover { background: #fafbfc; }
    .defect-name { font-size: .82rem; }
    .defect-pct-badge { min-width: 48px; text-align: center; font-variant-numeric: tabular-nums; }
    /* Mandatory readings: highlight the input while empty so the operator
       sees what's still to fill. Loses the highlight on first keystroke. */
    .sample-form .is-mandatory-reading:invalid {
        border-color: #dc3545;
        background-color: #fff5f5;
    }
    /* Sample header bar: true 3-column layout (title | size | spacer) so the
       size control sits dead-centre and can never overlap the title. */
    .sample-form .sample-header-bar { display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; gap: .5rem; }
    .sample-form .sample-header-bar .shb-title { font-weight: 600; white-space: nowrap; }
    .sample-form .sample-header-bar .shb-size { justify-self: center; }
    /* Compact, polished "pill" holding the size label + input. */
    .sample-form .sample-size-chip { display: inline-flex; align-items: center; gap: .35rem;
        background: rgba(255,255,255,.16); border: 1px solid rgba(255,255,255,.35);
        border-radius: 999px; padding: .1rem .5rem .1rem .7rem; }
    .sample-form .sample-size-chip label { font-size: .72rem; font-weight: 600; white-space: nowrap; margin: 0; }
    .sample-form .sample-size-chip .sample-size-input { width: 4.25rem; text-align: center; font-weight: 600;
        border: none; border-radius: 999px; padding: .1rem .35rem; }
    .sample-form .sample-size-chip .sample-size-input:focus { box-shadow: 0 0 0 .18rem rgba(255,255,255,.5); }
    .sample-form .sample-size-chip .badge { font-size: .62rem; }
    @@media (max-width: 575.98px) {
        /* On a phone-width drawer, drop the spacer and let it be title | size. */
        .sample-form .sample-header-bar { grid-template-columns: 1fr auto; }
        .sample-form .sample-header-bar .shb-spacer { display: none; }
    }
    /* Tighter vertical rhythm so the added Material details card doesn't grow
       the form: trim card gaps and section spacing without shrinking inputs. */
    .sample-form .card { margin-bottom: .5rem !important; }
    .sample-form .section-label { margin: .3rem 0 .15rem; }
    .sample-form .row.g-1 { --bs-gutter-y: .25rem; }
    /* Material details card — a persistent, obvious reminder when unmaintained. */
    .sample-form .material-details-card .card-header { background: #f1f5ff; font-size: .82rem; }
    .sample-form .material-details-card.md-incomplete { border-color: #ffc107; }
    .sample-form .material-details-card.md-incomplete .card-header { background: #fff8e1; }
    .sample-form .material-details-card .md-hint { font-size: .72rem; color: #8a6d00; margin-bottom: .3rem; }
</style>

@if (!editable)
{
    <div class="alert alert-info small mb-2 py-2"><i class="bi bi-lock me-1"></i>Read-only because the Quality Order is <strong>@qo.StatusCode</strong>.</div>
}

@* data-sample-size is the defect-% denominator for the live JS. It carries
   the sample's effective size: the per-sample override if set (V24+),
   otherwise the material's default. Updated client-side whenever the user
   edits the Sample Size input. *@
@{
    // Sample's own value if set; otherwise the material's effective default
    // (numeric column if present, parsed from MARA's MaterialSize text otherwise).
    short? materialDefaultSize = qoMat?.EffectiveSampleSize;
    short? effectiveSampleSize = s.SampleSize ?? materialDefaultSize;
}
<form asp-action="SaveSample" method="post" class="sample-form"
      data-sample-size="@(effectiveSampleSize)">
    @Html.AntiForgeryToken()
    <input type="hidden" name="SampleId"       value="@s.SampleId" />
    <input type="hidden" name="QualityOrderId" value="@s.QualityOrderId" />
    <input type="hidden" name="QoMaterialId"   value="@s.QoMaterialId" />
    <fieldset @(editable ? "" : "disabled")>

        @* Sample header section: only Sample-scoped fields are entered here.
           Sample Size and the Material-scoped fields (grower pallet, pack code,
           date code, label, label number) are entered once per material on the
           "Material details" panel and inherited -- shown read-only below. *@
        @{
            string HfName(string code) => $"header_{code}";
            var hfByCode = Model.ExistingHeader.ToDictionary(h => h.FieldCode);
        }

        @* Sample Size lives inline in the card header (compact) so it no longer
           eats a full row. Keeps the .sample-size-input class + form
           data-sample-size hook the defect-% JS relies on. *@
        <div class="card mb-2">
            <div class="card-header bg-primary text-white sample-header-bar py-1">
                <span class="shb-title"><i class="bi bi-clipboard-data me-1"></i>Sample header</span>
                <span class="sample-size-chip shb-size">
                    <label class="mb-0" for="sampleSizeInput-@s.SampleId"><i class="bi bi-rulers me-1"></i>Sample size</label>
                    <input id="sampleSizeInput-@s.SampleId" name="SampleSize" type="number" min="1" step="1" inputmode="numeric"
                           class="form-control form-control-sm sample-size-input"
                           value="@(effectiveSampleSize)" />
                    @if (s.SizeOverridden)
                    {
                        <span class="badge bg-warning text-dark" title="Differs from material default (@(materialDefaultSize?.ToString() ?? "—"))">≠@(materialDefaultSize?.ToString() ?? "—")</span>
                    }
                </span>
                <span class="shb-spacer"></span>
            </div>
            @if (Model.HeaderFields.Count > 0)
            {
                <div class="card-body">
                    <div class="row g-1">
                        @* Dynamic Sample-scoped header fields from qms_sample_header_field. *@
                        @foreach (var f in Model.HeaderFields)
                        {
                            hfByCode.TryGetValue(f.FieldCode, out var existing);
                            <div class="col-6 col-md-3">
                                <label class="form-label">
                                    @f.FieldName <span class="text-muted">@f.DefaultUnit</span>
                                    @if (f.IsMandatory)
                                    {
                                        <span class="text-danger fw-bold">*</span>
                                    }
                                </label>
                                @if (f.ValueKind == "Numeric")
                                {
                                    <input name="@(HfName(f.FieldCode))" type="number" step="any" inputmode="decimal"
                                           class="form-control form-control-sm"
                                           value="@(existing?.NumericValue)"
                                           required="@(f.IsMandatory)" />
                                }
                                else if (f.ValueKind == "Date")
                                {
                                    <input name="@(HfName(f.FieldCode))" type="date"
                                           class="form-control form-control-sm"
                                           value="@(existing?.DateValue?.ToString("yyyy-MM-dd"))"
                                           required="@(f.IsMandatory)" />
                                }
                                else
                                {
                                    <input name="@(HfName(f.FieldCode))" type="text"
                                           class="form-control form-control-sm"
                                           value="@(existing?.TextValue)"
                                           required="@(f.IsMandatory)" />
                                }
                            </div>
                        }
                    </div>
                </div>
            }
        </div>

        @* Material details — editable inline (2026-07-26). Shared by every sample
           of this material: saving reflects to the material and all samples, so an
           operator can maintain them from any sample and is reminded when they are
           missing. NOT `required` here — it must never block a sample save. *@
        @{
            string MhName(string code) => $"mheader_{code}";
            var mhByCode = Model.MaterialHeaderValues.ToDictionary(v => v.FieldCode);
            bool MhFilled(SharbatlyQMS.Web.Models.SampleHeaderField f) =>
                mhByCode.TryGetValue(f.FieldCode, out var mv)
                && (!string.IsNullOrWhiteSpace(mv.TextValue) || mv.NumericValue.HasValue || mv.DateValue.HasValue);
            bool matIncomplete = Model.MaterialHeaderFields.Any(f => !MhFilled(f));
        }
        @if (Model.MaterialHeaderFields.Count > 0)
        {
            <div class="card mb-2 material-details-card @(matIncomplete ? "md-incomplete" : "md-complete")">
                <div class="card-header d-flex justify-content-between align-items-center gap-2 py-1">
                    <span><i class="bi bi-box-seam me-1"></i>Material details</span>
                    @if (matIncomplete)
                    {
                        <span class="badge bg-warning text-dark"><i class="bi bi-exclamation-triangle me-1"></i>Not filled in</span>
                    }
                    else
                    {
                        <span class="badge bg-success"><i class="bi bi-check2 me-1"></i>Filled</span>
                    }
                </div>
                <div class="card-body">
                    @if (editable && matIncomplete)
                    {
                        <div class="md-hint">Shared by all samples of this material — fill it here and it applies to every sample (past and future).</div>
                    }
                    <div class="row g-1">
                        @foreach (var f in Model.MaterialHeaderFields)
                        {
                            mhByCode.TryGetValue(f.FieldCode, out var mexisting);
                            <div class="col-6 col-md-3">
                                <label class="form-label">
                                    @f.FieldName <span class="text-muted">@f.DefaultUnit</span>
                                    @if (f.IsMandatory)
                                    {
                                        <span class="text-danger fw-bold">*</span>
                                    }
                                </label>
                                @if (f.ValueKind == "Numeric")
                                {
                                    <input name="@(MhName(f.FieldCode))" type="number" step="any" inputmode="decimal"
                                           class="form-control form-control-sm" value="@(mexisting?.NumericValue)" />
                                }
                                else if (f.ValueKind == "Date")
                                {
                                    <input name="@(MhName(f.FieldCode))" type="date"
                                           class="form-control form-control-sm" value="@(mexisting?.DateValue?.ToString("yyyy-MM-dd"))" />
                                }
                                else
                                {
                                    <input name="@(MhName(f.FieldCode))" type="text"
                                           class="form-control form-control-sm" value="@(mexisting?.TextValue)" />
                                }
                            </div>
                        }
                    </div>
                </div>
            </div>
        }

        @* Readings: section label + dense inputs, no card chrome.
           For a NEW sample, the GROSS_WEIGHT reading is pre-filled from the
           material's weight pulled from MARA (qoMat.NetWeight) so the
           operator doesn't retype the same number. Existing samples keep
           whatever value was saved.

           NET_WEIGHT is reserved and computed = GROSS - TARA. The Razor
           code below tags Gross / Tara / Net inputs with data-weight-role
           hooks so the inline JS at the bottom of the form can keep Net
           in sync as the operator types. Net is rendered read-only; the
           controller recomputes it server-side too (authoritative). *@
        @{
            var isNewSampleForm = s.SampleId == 0;
            decimal? maraWeight = qoMat?.NetWeight;
            bool IsGrossCode(string c) =>
                string.Equals(c, "GROSS_WEIGHT", StringComparison.OrdinalIgnoreCase) ||
                string.Equals(c, "GROSS",        StringComparison.OrdinalIgnoreCase);
            bool IsTaraCode(string c) =>
                string.Equals(c, "TARA",         StringComparison.OrdinalIgnoreCase) ||
                string.Equals(c, "TARA_WEIGHT",  StringComparison.OrdinalIgnoreCase);
            bool IsNetCode(string c) =>
                string.Equals(c, "NET_WEIGHT",   StringComparison.OrdinalIgnoreCase) ||
                string.Equals(c, "NET",          StringComparison.OrdinalIgnoreCase);
            // Pre-compute the displayed NET value: prefer (gross-tara) when
            // both readings are present, else fall back to whatever was
            // stored (or autoFill GROSS for a brand-new sample).
            decimal? grossStored = readingTypes.Where(r => IsGrossCode(r.ReadingTypeCode))
                                               .Select(r => RnumOf(r.ReadingTypeCode))
                                               .FirstOrDefault();
            decimal? taraStored  = readingTypes.Where(r => IsTaraCode(r.ReadingTypeCode))
                                               .Select(r => RnumOf(r.ReadingTypeCode))
                                               .FirstOrDefault();
        }
        <div class="section-label">Readings</div>
        <div class="row g-1">
            @foreach (var rt in readingTypes)
            {
                var stored = RnumOf(rt.ReadingTypeCode);
                bool isGross = IsGrossCode(rt.ReadingTypeCode);
                bool isTara  = IsTaraCode(rt.ReadingTypeCode);
                bool isNet   = IsNetCode(rt.ReadingTypeCode);
                // Auto-fill rule: GROSS on a new sample defaults to the
                // material weight when no operator entry exists yet.
                decimal? autoFill = null;
                if (isNewSampleForm && stored == null && maraWeight.HasValue && maraWeight.Value > 0 && isGross)
                {
                    autoFill = maraWeight.Value;
                }
                var numValue = stored ?? autoFill;
                // NET: render as GROSS - TARA when both sides have a value
                // (including the GROSS autoFill). Falls through to stored
                // value when one side is missing.
                if (isNet)
                {
                    var effGross = grossStored ?? (isNewSampleForm && maraWeight.HasValue && maraWeight.Value > 0 ? maraWeight : null);
                    if (effGross.HasValue && taraStored.HasValue)
                        numValue = decimal.Round(effGross.Value - taraStored.Value, 2);
                }
                string weightRole = isGross ? "gross" : isTara ? "tara" : isNet ? "net" : "";
                <div class="col-6 col-md-3">
                    <label class="form-label">
                        @rt.ReadingName <span class="text-muted">@rt.DefaultUnit</span>
                        @if (rt.IsMandatory && !isNet)
                        {
                            <span class="text-danger fw-bold">*</span>
                        }
                        @if (isNet)
                        {
                            <span class="badge bg-secondary ms-1">auto</span>
                        }
                    </label>
                    @if (rt.ValueKind == "Numeric")
                    {
                        if (isNet)
                        {
                            <input name="reading_@(rt.ReadingTypeCode)_num" type="number" step="any" inputmode="decimal"
                                   class="form-control form-control-sm bg-light"
                                   value="@numValue" readonly tabindex="-1"
                                   data-weight-role="net" />
                        }
                        else
                        {
                            <input name="reading_@(rt.ReadingTypeCode)_num" type="number" step="any" inputmode="decimal"
                                   class="form-control form-control-sm @(rt.IsMandatory ? "is-mandatory-reading" : "")"
                                   value="@numValue" required="@(rt.IsMandatory)"
                                   @(weightRole != "" ? $"data-weight-role={weightRole}" : "") />
                        }
                    }
                    else
                    {
                        <input name="reading_@(rt.ReadingTypeCode)_text"
                               class="form-control form-control-sm @(rt.IsMandatory ? "is-mandatory-reading" : "")"
                               value="@RtxOf(rt.ReadingTypeCode)" required="@(rt.IsMandatory)" />
                    }
                </div>
            }
            @if (readingTypes.Count == 0)
            {
                <div class="col-12"><div class="text-muted small">No reading types configured for this material group.</div></div>
            }
        </div>

        @* Defects: one section per category (ordered + coloured by the
           category master). Two sections side-by-side on wide screens,
           stacked on tablet/phone.

           The running-total banner enforces sum(defects) <= sample size --
           the JS updates it as values change and the server re-applies the
           same clamp on save. *@
        <div class="defect-total-banner small text-muted mt-2"
             data-state="ok" aria-live="polite">
            Defects total: <span class="defect-total-current">0</span>
            / <span class="defect-total-size">@(effectiveSampleSize?.ToString() ?? "—")</span><span class="defect-total-note"></span>
        </div>
        <div class="row g-2 mt-2">
            @if (defectGroups.Count == 0)
            {
                <div class="col-12"><div class="text-muted small">No defects configured for this material group.</div></div>
            }
            @foreach (var grp in defectGroups)
            {
                var color = CatColor(grp.Key);
                <div class="col-12 col-xxl-6">
                    <div class="section-label" style="color:@color;border-left-color:@color">
                        <i class="bi bi-exclamation-triangle me-1"></i>@grp.Key defects
                    </div>
                    @foreach (var d in grp.OrderBy(x => x.SortOrder).ThenBy(x => x.DefectName))
                    {
                        var v = DvalOf(d.DefectId);
                        var p = DpctOf(d.DefectId);
                        var isDecimal = string.Equals(d.ValueType, "Decimal", StringComparison.OrdinalIgnoreCase);
                        // Default to "0" instead of empty so downstream math (sums,
                        // averages) never sees nulls. Operator can type over it.
                        var valDisplay = v.HasValue
                            ? (isDecimal ? v.Value.ToString("0.###") : ((int)Math.Round(v.Value)).ToString())
                            : "0";
                        var pctDisplay = (p ?? 0m).ToString("0.##");
                        <div class="defect-row d-flex align-items-center gap-2 defect-stepper"
                             data-defect-id="@d.DefectId" data-value-type="@d.ValueType">
                            <div class="flex-grow-1 defect-name">@d.DefectName</div>
                            @if (editable)
                            {
                                <button type="button" class="btn btn-outline-secondary btn-step defect-minus" tabindex="-1">−</button>
                            }
                            @* No per-input max -- the cap is the SUM of all
                               defects on the form. JS enforces it live; the
                               controller re-clamps on save. *@
                            <input name="defect_@(d.DefectId)_value" type="number"
                                   inputmode="@(isDecimal ? "decimal" : "numeric")"
                                   min="0" step="@(isDecimal ? "any" : "1")"
                                   class="form-control form-control-sm defect-value" data-id="@d.DefectId"
                                   value="@valDisplay" />
                            @if (editable)
                            {
                                <button type="button" class="btn btn-outline-secondary btn-step defect-plus" tabindex="-1">+</button>
                            }
                            <span class="badge defect-pct-badge bg-light text-muted">@((p ?? 0m).ToString("0.#"))%</span>
                            <input name="defect_@(d.DefectId)_pct" type="hidden" value="@pctDisplay" />
                        </div>
                    }
                </div>
            }
        </div>

        @* V31 (2026-06-20): Photos card per sample. Brand-new samples (SampleId
           == 0) need to be saved before they get an id to attach photos to;
           we show a helpful placeholder until then. *@
        <div class="card mt-3">
            <div class="card-header py-2 d-flex align-items-center gap-2">
                <i class="bi bi-images"></i>
                <strong>Photos</strong>
            </div>
            <div class="card-body">
                @if (s.SampleId == 0)
                {
                    <div class="text-muted small">Save the sample first to enable photo uploads for it.</div>
                }
                else
                {
                    var sampleGalleryVm = new ImageGalleryVm
                    {
                        OwnerType = "Sample",
                        OwnerId   = s.SampleId,
                        Editable  = editable,
                        // V31 (2026-06-20): Ajax mode keeps the sample drawer
                        // open across uploads + deletes.
                        Ajax      = true
                    };
                    <partial name="~/Views/Shared/_ImageGallery.cshtml" model="sampleGalleryVm" />
                }
            </div>
        </div>

        @if (editable)
        {
            <div class="position-sticky bottom-0 bg-white border-top mt-2 py-2 px-2 text-end"
                 style="z-index: 5; box-shadow: 0 -2px 6px rgba(0,0,0,.06); margin-left:-1rem; margin-right:-1rem; padding-left:1rem !important; padding-right:1rem !important;">
                <button type="submit" class="btn btn-primary">
                    <i class="bi bi-save me-1"></i>Save sample
                </button>
            </div>
        }
    </fieldset>
</form>
