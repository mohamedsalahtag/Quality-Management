@using SharbatlyQMS.Web.ViewModels
@using SharbatlyQMS.Web.Services
@model SecurityVm
@{
    ViewData["Title"] = "Security";
    var sel = Model.Selected;
    var groups = Model.Cards.GroupBy(c => c.GroupName)
                            .OrderBy(g => Array.IndexOf(new[] { "General", "Records", "Reports", "Parameters", "Admin" }, g.Key))
                            .ToList();
}

<div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
    <h1 class="h3 mb-0">
        <i class="bi bi-shield-lock me-1"></i>Security
        <small class="text-muted fs-6 fw-normal ms-2">
            Build roles from the screens and buttons each one may use, then assign them on the Users screen.
        </small>
    </h1>
    <div class="d-flex gap-2 flex-wrap">
        <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#newRoleModal">
            <i class="bi bi-plus-circle me-1"></i>New role
        </button>
        <form asp-action="Rescan" method="post" class="m-0"
              data-confirm="Re-scan the application for new screens and buttons? Nothing already granted is changed."
              data-confirm-title="Refresh the permission list" data-confirm-ok="Refresh">
            @Html.AntiForgeryToken()
            <button type="submit" class="btn btn-outline-secondary"
                    title="Runs automatically when the app restarts. Use this after a deployment to pick up new buttons immediately.">
                <i class="bi bi-arrow-repeat me-1"></i>Refresh list
            </button>
        </form>
    </div>
</div>

@if (Model.NewSinceReview > 0)
{
    <div class="alert alert-info d-flex align-items-center gap-2">
        <i class="bi bi-stars fs-5"></i>
        <div>
            <strong>@Model.NewSinceReview permission(s) are not granted to any role.</strong>
            These are usually newly added buttons. Nobody can use them until you tick them for a role.
        </div>
    </div>
}

<ul class="nav nav-tabs mb-3">
    <li class="nav-item"><a class="nav-link active" data-bs-toggle="tab" href="#tab-editor">Role editor</a></li>
    <li class="nav-item"><a class="nav-link" data-bs-toggle="tab" href="#tab-matrix">Compare all roles</a></li>
</ul>

<div class="tab-content">
    @* ============================ ROLE EDITOR ============================ *@
    <div class="tab-pane fade show active" id="tab-editor">
        <div class="row g-3">
            @* ---- Role list ---- *@
            <div class="col-lg-3">
                <div class="card">
                    <div class="card-header py-2"><i class="bi bi-person-badge me-1"></i>Roles</div>
                    <div class="list-group list-group-flush">
                        @foreach (var r in Model.Roles)
                        {
                            <a class="list-group-item list-group-item-action @(sel?.RoleCode == r.RoleCode ? "active" : "")"
                               asp-action="Index" asp-route-role="@r.RoleCode" asp-route-showObsolete="@Model.ShowObsolete">
                                <div class="d-flex justify-content-between align-items-start">
                                    <div>
                                        <div class="fw-semibold">@r.DisplayName</div>
                                        <div class="small @(sel?.RoleCode == r.RoleCode ? "" : "text-muted")">
                                            @r.UserCount user@(r.UserCount == 1 ? "" : "s") · @r.GrantCount permission@(r.GrantCount == 1 ? "" : "s")
                                        </div>
                                    </div>
                                    <div class="text-end">
                                        @if (r.IsBuiltIn) { <span class="badge bg-secondary-subtle text-secondary-emphasis">Built-in</span> }
                                        @if (!r.IsActive) { <span class="badge bg-warning text-dark">Inactive</span> }
                                    </div>
                                </div>
                            </a>
                        }
                    </div>
                </div>
            </div>

            @* ---- Editor ---- *@
            <div class="col-lg-9">
                @if (sel == null)
                {
                    <div class="alert alert-light border">No roles yet. Click <em>New role</em> to create one.</div>
                }
                else
                {
                    <div class="card mb-3">
                        <div class="card-body">
                            <form asp-action="UpdateRole" method="post" class="row g-2 align-items-end">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="roleCode" value="@sel.RoleCode" />
                                <div class="col-md-4">
                                    <label class="form-label small mb-1">Role name</label>
                                    <input type="text" name="displayName" value="@sel.DisplayName" maxlength="60"
                                           class="form-control form-control-sm" @(sel.IsBuiltIn ? "readonly" : "") />
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label small mb-1">Description</label>
                                    <input type="text" name="description" value="@sel.Description" maxlength="400"
                                           class="form-control form-control-sm" placeholder="What is this role for?" />
                                </div>
                                <div class="col-md-2">
                                    <div class="form-check form-switch">
                                        <input class="form-check-input" type="checkbox" name="isPlantScoped" value="true"
                                               id="sel-plant" @(sel.IsPlantScoped ? "checked" : "") />
                                        <input type="hidden" name="isPlantScoped" value="false" />
                                        <label class="form-check-label small" for="sel-plant"
                                               title="Holders only see data for the single plant assigned to them on the Users screen.">
                                            One plant only
                                        </label>
                                    </div>
                                    <div class="form-check form-switch">
                                        <input class="form-check-input" type="checkbox" name="isActive" value="true"
                                               id="sel-active" @(sel.IsActive ? "checked" : "") @(sel.IsBuiltIn ? "disabled" : "") />
                                        <input type="hidden" name="isActive" value="@(sel.IsBuiltIn ? "true" : "false")" />
                                        <label class="form-check-label small" for="sel-active">Active</label>
                                    </div>
                                </div>
                                <div class="col-md-2 d-flex gap-2">
                                    <button type="submit" class="btn btn-outline-primary btn-sm">Save details</button>
                                </div>
                            </form>
                            @if (!sel.IsBuiltIn)
                            {
                                <form asp-action="DeleteRole" method="post" class="mt-2"
                                      data-confirm="Delete the role '@sel.DisplayName'? This cannot be undone."
                                      data-confirm-danger data-confirm-ok="Delete role">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="roleCode" value="@sel.RoleCode" />
                                    <button type="submit" class="btn btn-link btn-sm text-danger p-0">Delete this role</button>
                                </form>
                            }
                        </div>
                    </div>

                    @if (Model.EditingOwnRole)
                    {
                        <div class="alert alert-warning d-flex align-items-center gap-2">
                            <i class="bi bi-exclamation-triangle fs-5"></i>
                            <div>
                                <strong>This is your own role.</strong> Permission changes to it are refused, so that
                                nobody can accidentally remove their own access to this screen. Sign in as a different
                                administrator to change it.
                            </div>
                        </div>
                    }

                    <form asp-action="SaveGrants" method="post" id="grantsForm">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="roleCode" value="@sel.RoleCode" />

                        <div class="d-flex flex-wrap gap-2 align-items-center mb-2">
                            <input type="search" id="permSearch" class="form-control form-control-sm" style="max-width: 22rem"
                                   placeholder="Search screens and buttons…" autocomplete="off" />
                            <button type="button" class="btn btn-outline-secondary btn-sm" data-expand-all>Expand all</button>
                            <button type="button" class="btn btn-outline-secondary btn-sm" data-collapse-all>Collapse all</button>
                            <span class="ms-auto small text-muted" id="grantTotal"></span>
                        </div>

                        @foreach (var g in groups)
                        {
                            <h2 class="h6 text-uppercase text-muted mt-3 mb-2">@g.Key</h2>
                            foreach (var card in g)
                            {
                                var cardId = "card-" + card.ScreenKey.Replace('.', '-');
                                <div class="card mb-2 perm-card" data-card>
                                    <div class="card-header py-2 d-flex align-items-center gap-2 flex-wrap"
                                         role="button" data-bs-toggle="collapse" data-bs-target="#@cardId">
                                        <i class="bi bi-chevron-down small"></i>
                                        <strong>@card.Title</strong>
                                        <span class="badge bg-secondary-subtle text-secondary-emphasis" data-count>
                                            @card.GrantedCount / @card.TotalCount
                                        </span>
                                        @if (card.SupportsAccessLevel)
                                        {
                                            <span class="badge bg-info-subtle text-info-emphasis" title="This screen can be set to read-only.">
                                                read-only or edit
                                            </span>
                                        }
                                    </div>
                                    <div class="collapse @(card.GrantedCount > 0 ? "show" : "")" id="@cardId">
                                        <div class="card-body py-2">
                                            @if (card.HasScreenPermission)
                                            {
                                                <div class="mb-2 pb-2 border-bottom">
                                                    <label class="form-label small mb-1 d-block">Access to this screen</label>
                                                    @if (card.SupportsAccessLevel)
                                                    {
                                                        <div class="btn-group btn-group-sm" role="group" data-screen-level="@card.ScreenKey">
                                                            @foreach (var opt in new[] { (0, "No access"), (1, "Read only"), (2, "Edit") })
                                                            {
                                                                var id = cardId + "-lvl-" + opt.Item1;
                                                                <input type="radio" class="btn-check" name="lvl-@card.ScreenKey" id="@id"
                                                                       value="@opt.Item1" @((int)card.ScreenLevel == opt.Item1 ? "checked" : "") />
                                                                <label class="btn btn-outline-primary" for="@id">@opt.Item2</label>
                                                            }
                                                        </div>
                                                        <div class="form-text">
                                                            <strong>Read only</strong> also switches off every button below, on this screen and on the server.
                                                        </div>
                                                    }
                                                    else
                                                    {
                                                        var id = cardId + "-on";
                                                        <div class="form-check form-switch">
                                                            <input class="form-check-input" type="checkbox" id="@id"
                                                                   data-screen-toggle="@card.ScreenKey"
                                                                   @(card.ScreenLevel != AccessLevel.None ? "checked" : "") />
                                                            <label class="form-check-label" for="@id">Can open this screen</label>
                                                        </div>
                                                    }
                                                </div>
                                            }

                                            @if (card.Actions.Count == 0)
                                            {
                                                <div class="text-muted small fst-italic">No individual buttons on this screen.</div>
                                            }
                                            else
                                            {
                                                <div class="d-flex gap-2 mb-2">
                                                    <button type="button" class="btn btn-link btn-sm p-0" data-select-all>Select all</button>
                                                    <button type="button" class="btn btn-link btn-sm p-0" data-select-none>None</button>
                                                </div>
                                                <div class="row g-1">
                                                    @foreach (var a in card.Actions)
                                                    {
                                                        var aid = "p-" + a.Code.Replace('.', '-');
                                                        <div class="col-md-6 perm-row" data-label="@a.DisplayName @a.Code">
                                                            <div class="form-check form-switch">
                                                                <input class="form-check-input" type="checkbox" name="granted"
                                                                       value="@a.Code" id="@aid"
                                                                       @(a.Granted || a.IsLocked ? "checked" : "")
                                                                       @(a.IsLocked ? "disabled" : "") />
                                                                <label class="form-check-label small" for="@aid">
                                                                    @a.DisplayName
                                                                    @if (a.IsLocked)
                                                                    {
                                                                        <i class="bi bi-lock-fill text-muted ms-1"
                                                                           title="The built-in administrator can never lose this, so that the Security screen can always be reached."></i>
                                                                    }
                                                                    @if (a.IsObsolete)
                                                                    {
                                                                        <span class="badge bg-warning text-dark ms-1"
                                                                              title="This button no longer exists in the application.">retired</span>
                                                                    }
                                                                </label>
                                                            </div>
                                                        </div>
                                                    }
                                                </div>
                                            }
                                        </div>
                                    </div>
                                </div>
                            }
                        }

                        <div class="mt-3 d-flex gap-2 align-items-center">
                            <button type="submit" class="btn btn-primary" @(Model.EditingOwnRole ? "disabled" : "")>
                                <i class="bi bi-save me-1"></i>Save permissions for @sel.DisplayName
                            </button>
                            <span class="text-muted small">Takes effect on the next page anyone loads — no sign-out needed.</span>
                        </div>
                    </form>
                }
            </div>
        </div>
    </div>

    @* ============================ COMPARISON GRID ============================ *@
    <div class="tab-pane fade" id="tab-matrix">
        <div class="d-flex flex-wrap gap-2 align-items-center mb-2">
            <input type="search" id="matrixSearch" class="form-control form-control-sm" style="max-width: 22rem"
                   placeholder="Filter permissions…" autocomplete="off" />
            @if (Model.AnyObsolete)
            {
                <a class="btn btn-outline-secondary btn-sm" asp-action="Index"
                   asp-route-role="@sel?.RoleCode" asp-route-showObsolete="@(!Model.ShowObsolete)">
                    @(Model.ShowObsolete ? "Hide retired" : "Show retired")
                </a>
            }
            <span class="ms-auto small text-muted">
                @Model.MatrixRows.Count permissions × @Model.Roles.Count roles
            </span>
        </div>
        <div class="card">
            <div class="table-responsive">
                @* Deliberately no data-tablekit: it caches column indexes when it
                   enhances a table, and this grid gains a column whenever a role
                   is created. A plain table plus the filter above is enough. *@
                <table class="table table-sm table-hover align-middle mb-0" id="matrixTable">
                    <thead class="table-light">
                        <tr>
                            <th>Screen</th>
                            <th>Permission</th>
                            @foreach (var r in Model.Roles)
                            {
                                <th class="text-center small" title="@r.Description">@r.DisplayName</th>
                            }
                        </tr>
                    </thead>
                    <tbody>
                    @foreach (var row in Model.MatrixRows)
                    {
                        <tr data-label="@row.ScreenTitle @row.DisplayName @row.Code">
                            <td class="small text-muted">@row.ScreenTitle</td>
                            <td class="small">
                                @(row.Kind == "Screen" ? "Open the screen" : row.DisplayName)
                                @if (row.IsObsolete) { <span class="badge bg-warning text-dark ms-1">retired</span> }
                            </td>
                            @foreach (var lvl in row.Levels)
                            {
                                <td class="text-center">
                                    @switch (lvl)
                                    {
                                        case AccessLevel.Edit:
                                            <i class="bi bi-check-circle-fill text-success" title="Full access"></i>
                                            break;
                                        case AccessLevel.Read:
                                            <i class="bi bi-eye-fill text-info" title="Read only"></i>
                                            break;
                                        default:
                                            <span class="text-muted">·</span>
                                            break;
                                    }
                                </td>
                            }
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@* ---- New role modal ---- *@
<div class="modal fade" id="newRoleModal" tabindex="-1">
    <div class="modal-dialog">
        <form asp-action="CreateRole" method="post" class="modal-content">
            @Html.AntiForgeryToken()
            <div class="modal-header">
                <h5 class="modal-title">New role</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="mb-3">
                    <label class="form-label">Role name</label>
                    <input type="text" name="displayName" class="form-control" maxlength="60" required
                           placeholder="e.g. Night Shift Inspector" autocomplete="off" />
                    <div class="form-text">Shown on the Users screen. The internal code is generated for you.</div>
                </div>
                <div class="mb-3">
                    <label class="form-label">Description</label>
                    <input type="text" name="description" class="form-control" maxlength="400"
                           placeholder="What is this role for?" autocomplete="off" />
                </div>
                <div class="mb-3">
                    <label class="form-label">Start from</label>
                    <select name="copyFrom" class="form-select">
                        <option value="">Nothing — start with no permissions</option>
                        @foreach (var r in Model.Roles.Where(x => x.IsActive))
                        {
                            <option value="@r.RoleCode">A copy of @r.DisplayName (@r.GrantCount permissions)</option>
                        }
                    </select>
                    <div class="form-text">Copying is usually quicker than ticking a hundred boxes.</div>
                </div>
                <div class="form-check form-switch">
                    <input class="form-check-input" type="checkbox" name="isPlantScoped" value="true" id="new-plant" />
                    <input type="hidden" name="isPlantScoped" value="false" />
                    <label class="form-check-label" for="new-plant">
                        Restrict holders to one plant
                        <span class="text-muted small d-block">The plant itself is picked per user on the Users screen.</span>
                    </label>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="submit" class="btn btn-primary">Create role</button>
            </div>
        </form>
    </div>
</div>

@if (Model.PermissionsLoadedAt.HasValue)
{
    <p class="text-muted small mt-3">
        Permission list loaded @Model.PermissionsLoadedAt.Value.ToLocalTime().ToString("yyyy-MM-dd HH:mm").
    </p>
}

@section Scripts {
    <script src="~/js/security-matrix.js" asp-append-version="true"></script>
}
