@using SharbatlyQMS.Web.ViewModels
@using SharbatlyQMS.Web.Services
@model SecurityVm
@{
    ViewData["Title"] = Loc["Security"];
    var sel = Model.Selected;
    var groups = Model.Cards.GroupBy(c => c.GroupName)
                            .OrderBy(g => Array.IndexOf(new[] { "General", "Records", "Reports", "Parameters", "Admin" }, g.Key))
                            .ToList();
    var usersTab = string.Equals(Model.ActiveTab, "users", StringComparison.OrdinalIgnoreCase);
    var canManageUsers = Perms.Can(Perm.Admin.UsersEdit);
}

<div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
    <h1 class="h3 mb-0">
        <i class="bi bi-shield-lock me-1"></i>Security
        <small class="text-muted fs-6 fw-normal ms-2">
            Build roles from the screens and buttons each one may use, then assign them on the Users screen.
        </small>
    </h1>
    <div class="d-flex gap-2 flex-wrap">
        <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#newRoleModal">
            <i class="bi bi-plus-circle me-1"></i>@Loc["New role"]
        </button>
        <form asp-action="Rescan" method="post" class="m-0"
              data-confirm="Re-scan the application for new screens and buttons? Nothing already granted is changed."
              data-confirm-title="Refresh the permission list" data-confirm-ok="Refresh">
            @Html.AntiForgeryToken()
            <button type="submit" class="btn btn-outline-secondary"
                    title="Runs automatically when the app restarts. Use this after a deployment to pick up new buttons immediately.">
                <i class="bi bi-arrow-repeat me-1"></i>@Loc["Refresh list"]
            </button>
        </form>
    </div>
</div>

@if (Model.NewSinceReview > 0)
{
    <div class="alert alert-info d-flex align-items-center gap-2">
        <i class="bi bi-stars fs-5"></i>
        <div>
            <strong>@Model.NewSinceReview permission(s) are not granted to any role.</strong>
            These are usually newly added buttons. Nobody can use them until you tick them for a role.
        </div>
    </div>
}

@{ var openCompare = (bool?)ViewBag.OpenCompare ?? false; }
<ul class="nav nav-tabs mb-3">
    <li class="nav-item"><a class="nav-link @(openCompare ? "" : "active")" data-bs-toggle="tab" href="#tab-editor">@Loc["Role editor"]</a></li>
    <li class="nav-item"><a class="nav-link @(openCompare ? "active" : "")" data-bs-toggle="tab" href="#tab-matrix">@Loc["Compare all roles"]</a></li>
</ul>

<div class="tab-content">
    @* ============================ ROLE EDITOR ============================ *@
    <div class="tab-pane fade @(openCompare ? "" : "show active")" id="tab-editor">
        <div class="row g-3">
            @* ---- Role list ---- *@
            <div class="col-lg-3">
                <div class="card">
                    <div class="card-header py-2"><i class="bi bi-person-badge me-1"></i>@Loc["Roles"]</div>
                    <div class="list-group list-group-flush">
                        @foreach (var r in Model.Roles)
                        {
                            <a class="list-group-item list-group-item-action @(sel?.RoleCode == r.RoleCode ? "active" : "")"
                               asp-action="Index" asp-route-role="@r.RoleCode" asp-route-showObsolete="@Model.ShowObsolete">
                                <div class="d-flex justify-content-between align-items-start">
                                    <div>
                                        <div class="fw-semibold">@r.DisplayName</div>
                                        <div class="small @(sel?.RoleCode == r.RoleCode ? "" : "text-muted")">
                                            @r.UserCount user@(r.UserCount == 1 ? "" : "s") · @r.GrantCount permission@(r.GrantCount == 1 ? "" : "s")
                                        </div>
                                    </div>
                                    <div class="text-end">
                                        @if (r.IsBuiltIn) { <span class="badge bg-secondary-subtle text-secondary-emphasis">@Loc["Built-in"]</span> }
                                        @if (!r.IsActive) { <span class="badge bg-warning text-dark">@Loc["Inactive"]</span> }
                                    </div>
                                </div>
                            </a>
                        }
                    </div>
                </div>
            </div>

            @* ---- Editor ---- *@
            <div class="col-lg-9">
                @if (sel == null)
                {
                    <div class="alert alert-light border">No roles yet. Click <em>@Loc["New role"]</em> to create one.</div>
                }
                else
                {
                    <div class="card mb-3">
                        <div class="card-body">
                            <form asp-action="UpdateRole" method="post" class="row g-2 align-items-end">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="roleCode" value="@sel.RoleCode" />
                                <div class="col-md-4">
                                    <label class="form-label small mb-1">@Loc["Role name"]</label>
                                    <input type="text" name="displayName" value="@sel.DisplayName" maxlength="60"
                                           class="form-control form-control-sm" @(sel.IsBuiltIn ? "readonly" : "") />
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label small mb-1">@Loc["Description"]</label>
                                    <input type="text" name="description" value="@sel.Description" maxlength="400"
                                           class="form-control form-control-sm" placeholder='@Loc["What is this role for?"]' />
                                </div>
                                @* Plant access is a per-USER setting now (assigned on the Users
                                   screen), not a per-role flag, so the old "One plant only"
                                   switch is gone. is_plant_scoped is preserved server-side. *@
                                <input type="hidden" name="isPlantScoped" value="@(sel.IsPlantScoped ? "true" : "false")" />
                                <div class="col-md-2">
                                    <div class="form-check form-switch">
                                        <input class="form-check-input" type="checkbox" name="isActive" value="true"
                                               id="sel-active" @(sel.IsActive ? "checked" : "") @(sel.IsBuiltIn ? "disabled" : "") />
                                        <input type="hidden" name="isActive" value="@(sel.IsBuiltIn ? "true" : "false")" />
                                        <label class="form-check-label small" for="sel-active">@Loc["Active"]</label>
                                    </div>
                                </div>
                                <div class="col-md-2 d-flex gap-2">
                                    <button type="submit" class="btn btn-outline-primary btn-sm">@Loc["Save details"]</button>
                                </div>
                            </form>
                            @if (!sel.IsBuiltIn)
                            {
                                <form asp-action="DeleteRole" method="post" class="mt-2"
                                      data-confirm="Delete the role '@sel.DisplayName'? This cannot be undone."
                                      data-confirm-danger data-confirm-ok="Delete role">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="roleCode" value="@sel.RoleCode" />
                                    <button type="submit" class="btn btn-link btn-sm text-danger p-0">@Loc["Delete this role"]</button>
                                </form>
                            }
                        </div>
                    </div>

                    @if (Model.EditingOwnRole)
                    {
                        <div class="alert alert-warning d-flex align-items-center gap-2">
                            <i class="bi bi-exclamation-triangle fs-5"></i>
                            <div>
                                <strong>@Loc["This is your own role."]</strong> Permission changes to it are refused, so that
                                nobody can accidentally remove their own access to this screen. Sign in as a different
                                administrator to change it.
                            </div>
                        </div>
                    }
                    @if (Model.SelectedIsSuper)
                    {
                        <div class="alert alert-secondary d-flex align-items-center gap-2">
                            <i class="bi bi-shield-lock-fill fs-5"></i>
                            <div>
                                <strong>@Loc["The Administrator is a super role."]</strong> It always holds every permission —
                                including any added later — and can never be locked out, so its access is shown
                                read-only here.
                            </div>
                        </div>
                    }

                    <ul class="nav nav-pills mb-3">
                        <li class="nav-item">
                            <a class="nav-link @(usersTab ? "" : "active")" data-bs-toggle="tab" href="#sub-permissions">
                                <i class="bi bi-ui-checks me-1"></i>@Loc["Permissions"]
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(usersTab ? "active" : "")" data-bs-toggle="tab" href="#sub-users">
                                <i class="bi bi-people me-1"></i>Users
                                <span class="badge rounded-pill bg-secondary ms-1">@Model.Members.Count</span>
                            </a>
                        </li>
                    </ul>

                    <div class="tab-content">
                    <div class="tab-pane fade @(usersTab ? "" : "show active")" id="sub-permissions">
                    <form asp-action="SaveGrants" method="post" id="grantsForm">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="roleCode" value="@sel.RoleCode" />

                        <div class="d-flex flex-wrap gap-2 align-items-center mb-2">
                            <input type="search" id="permSearch" class="form-control form-control-sm" style="max-width: 22rem"
                                   placeholder='@Loc["Search screens and buttons…"]' autocomplete="off" />
                            <button type="button" class="btn btn-outline-secondary btn-sm" data-expand-all>@Loc["Expand all"]</button>
                            <button type="button" class="btn btn-outline-secondary btn-sm" data-collapse-all>@Loc["Collapse all"]</button>
                            <span class="ms-auto small text-muted" id="grantTotal"></span>
                        </div>

                        @foreach (var g in groups)
                        {
                            <h2 class="h6 text-uppercase text-muted mt-3 mb-2">@g.Key</h2>
                            foreach (var card in g)
                            {
                                var cardId = "card-" + card.ScreenKey.Replace('.', '-');
                                <div class="card mb-2 perm-card" data-card>
                                    <div class="card-header py-2 d-flex align-items-center gap-2 flex-wrap"
                                         role="button" data-bs-toggle="collapse" data-bs-target="#@cardId">
                                        <i class="bi bi-chevron-down small"></i>
                                        <strong>@card.Title</strong>
                                        <span class="badge bg-secondary-subtle text-secondary-emphasis" data-count>
                                            @card.GrantedCount / @card.TotalCount
                                        </span>
                                        @if (card.SupportsAccessLevel)
                                        {
                                            <span class="badge bg-info-subtle text-info-emphasis" title="This screen can be set to read-only.">
                                                @Loc["read-only or edit"]
                                            </span>
                                        }
                                    </div>
                                    <div class="collapse @(card.GrantedCount > 0 ? "show" : "")" id="@cardId">
                                        <div class="card-body py-2">
                                            @if (card.HasScreenPermission)
                                            {
                                                <div class="mb-2 pb-2 border-bottom">
                                                    <label class="form-label small mb-1 d-block">@Loc["Access to this screen"]</label>
                                                    @if (card.SupportsAccessLevel)
                                                    {
                                                        <div class="btn-group btn-group-sm" role="group" data-screen-level="@card.ScreenKey">
                                                            @foreach (var opt in new[] { (0, "No access"), (1, "Read only"), (2, "Edit") })
                                                            {
                                                                var id = cardId + "-lvl-" + opt.Item1;
                                                                <input type="radio" class="btn-check" name="lvl-@card.ScreenKey" id="@id"
                                                                       value="@opt.Item1" @((int)card.ScreenLevel == opt.Item1 ? "checked" : "")
                                                                       @(Model.SelectedIsSuper ? "disabled" : "") />
                                                                <label class="btn btn-outline-primary" for="@id">@opt.Item2</label>
                                                            }
                                                        </div>
                                                        <div class="form-text">
                                                            <strong>@Loc["No access"]</strong> — the role cannot open or even see this screen.
                                                            <strong>@Loc["Read only"]</strong> — the role can open and view the screen; only the
                                                            <span class="badge bg-info-subtle text-info-emphasis">@Loc["view / export"]</span>
                                                            buttons below can be granted, every button that changes data is switched off.
                                                            <strong>@Loc["Edit"]</strong> — every button below can be granted.
                                                        </div>
                                                        @* Restated for the current choice, updated live by security-matrix.js. *@
                                                        <div class="form-text fw-semibold text-body" data-level-hint></div>
                                                    }
                                                    else
                                                    {
                                                        var id = cardId + "-on";
                                                        <div class="form-check form-switch">
                                                            <input class="form-check-input" type="checkbox" id="@id"
                                                                   data-screen-toggle="@card.ScreenKey"
                                                                   @(card.ScreenLevel != AccessLevel.None ? "checked" : "")
                                                                   @(Model.SelectedIsSuper ? "disabled" : "") />
                                                            <label class="form-check-label" for="@id">@Loc["Can open this screen"]</label>
                                                        </div>
                                                    }
                                                </div>
                                            }

                                            @if (card.Actions.Count == 0)
                                            {
                                                <div class="text-muted small fst-italic">@Loc["No individual buttons on this screen."]</div>
                                            }
                                            else
                                            {
                                                <div class="d-flex gap-2 mb-2">
                                                    <button type="button" class="btn btn-link btn-sm p-0" data-select-all>@Loc["Select all"]</button>
                                                    <button type="button" class="btn btn-link btn-sm p-0" data-select-none>@Loc["None"]</button>
                                                </div>
                                                <div class="row g-1">
                                                    @foreach (var a in card.Actions)
                                                    {
                                                        var aid = "p-" + a.Code.Replace('.', '-');
                                                        <div class="col-md-6 perm-row" data-label="@a.DisplayName @a.Code">
                                                            <div class="form-check form-switch">
                                                                <input class="form-check-input" type="checkbox" name="granted"
                                                                       value="@a.Code" id="@aid"
                                                                       @(a.Granted || a.IsLocked ? "checked" : "")
                                                                       @(a.IsLocked ? "disabled" : "")
                                                                       @(a.IsLocked ? "data-locked=true" : "")
                                                                       @(a.IsReadOnlyAction ? "data-readonly=true" : "") />
                                                                <label class="form-check-label small" for="@aid">
                                                                    @a.DisplayName
                                                                    @if (a.IsReadOnlyAction)
                                                                    {
                                                                        <span class="badge bg-info-subtle text-info-emphasis ms-1"
                                                                              title="Only reads data. Stays available when this screen is set to read-only.">@Loc["view / export"]</span>
                                                                    }
                                                                    @if (a.IsLocked)
                                                                    {
                                                                        <i class="bi bi-lock-fill text-muted ms-1"
                                                                           title="The built-in administrator can never lose this, so that the Security screen can always be reached."></i>
                                                                    }
                                                                    @if (a.IsObsolete)
                                                                    {
                                                                        <span class="badge bg-warning text-dark ms-1"
                                                                              title="This button no longer exists in the application.">@Loc["retired"]</span>
                                                                    }
                                                                </label>
                                                            </div>
                                                        </div>
                                                    }
                                                </div>
                                            }
                                        </div>
                                    </div>
                                </div>
                            }
                        }

                        <div class="mt-3 d-flex gap-2 align-items-center">
                            <button type="submit" class="btn btn-primary" @((Model.EditingOwnRole || Model.SelectedIsSuper) ? "disabled" : "")>
                                <i class="bi bi-save me-1"></i>Save permissions for @sel.DisplayName
                            </button>
                            <span class="text-muted small">@Loc["Takes effect on the next page anyone loads — no sign-out needed."]</span>
                        </div>
                    </form>
                    </div>@* /sub-permissions *@

                    @* ============================ USERS TAB ============================ *@
                    @* Read-only: this tab shows who holds the selected role. Adding,
                       moving and removing people is done on the Users screen. *@
                    <div class="tab-pane fade @(usersTab ? "show active" : "")" id="sub-users">
                        <div class="card">
                            <div class="card-header py-2 d-flex align-items-center gap-2 flex-wrap">
                                <i class="bi bi-people me-1"></i>
                                <strong>Users with the “@sel.DisplayName” role</strong>
                                <span class="badge bg-secondary-subtle text-secondary-emphasis">@Model.Members.Count</span>
                                @if (canManageUsers)
                                {
                                    <a asp-controller="Admin" asp-action="Users" asp-route-role="@sel.RoleCode"
                                       class="btn btn-sm btn-outline-secondary ms-auto">
                                        <i class="bi bi-box-arrow-up-right me-1"></i>@Loc["Manage on the Users screen"]
                                    </a>
                                }
                            </div>
                            <div class="table-responsive">
                                <table class="table table-sm table-hover align-middle mb-0">
                                    <thead class="table-light">
                                        <tr>
                                            <th>@Loc["Full name"]</th>
                                            <th>@Loc["Username"]</th>
                                            <th>@Loc["Email"]</th>
                                            <th>@Loc["Department"]</th>
                                            @if (sel.IsPlantScoped) { <th>@Loc["Plant"]</th> }
                                            <th>@Loc["Status"]</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @if (Model.Members.Count == 0)
                                        {
                                            var cols = 5 + (sel.IsPlantScoped ? 1 : 0);
                                            <tr><td colspan="@cols" class="text-center text-muted py-4">
                                                @Loc["Nobody holds this role yet."]
                                            </td></tr>
                                        }
                                        else
                                        {
                                            foreach (var m in Model.Members)
                                            {
                                                <tr>
                                                    <td>@m.FullName</td>
                                                    <td><code>@m.Username</code></td>
                                                    <td>@m.Email</td>
                                                    <td>@m.Department</td>
                                                    @if (sel.IsPlantScoped)
                                                    {
                                                        <td>@(string.IsNullOrWhiteSpace(m.PlantCode) ? "—" : Codes.PlantDisplay(m.PlantCode))</td>
                                                    }
                                                    <td>
                                                        @if (m.IsActive) { <span class="badge bg-success">@Loc["Active"]</span> }
                                                        else { <span class="badge bg-secondary">@Loc["Disabled"]</span> }
                                                    </td>
                                                </tr>
                                            }
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>@* /sub-users *@
                    </div>@* /tab-content *@
                }
            </div>
        </div>
    </div>

    @* ==================== EDITABLE COMPARISON GRID ==================== *@
    @* One editable column per role. Each column posts granted_<role> (ticked
       actions) and screenLevel_<role> ("<screenKey>=<0|1|2>") exactly like the
       single-role editor, and is saved through the same SaveGrantsAsync guards. *@
    <div class="tab-pane fade @(openCompare ? "show active" : "")" id="tab-matrix">
        <form asp-action="SaveMatrix" method="post" id="matrixForm">
            @Html.AntiForgeryToken()
            @foreach (var r in Model.Roles)
            {
                <input type="hidden" name="role_present" value="@r.RoleCode" />
            }
            <div class="d-flex flex-wrap gap-2 align-items-center mb-2">
                <input type="search" id="matrixSearch" class="form-control form-control-sm" style="max-width: 22rem"
                       placeholder='@Loc["Filter permissions…"]' autocomplete="off" />
                @if (Model.AnyObsolete)
                {
                    <a class="btn btn-outline-secondary btn-sm" asp-action="Index"
                       asp-route-role="@sel?.RoleCode" asp-route-showObsolete="@(!Model.ShowObsolete)" asp-route-tab="compare">
                        @(Model.ShowObsolete ? "Hide retired" : "Show retired")
                    </a>
                }
                <span class="small text-muted">@Model.MatrixRows.Count permissions × @Model.Roles.Count roles</span>
                <button type="submit" class="btn btn-primary btn-sm ms-auto">
                    <i class="bi bi-save me-1"></i>@Loc["Save all roles"]
                </button>
            </div>
            <div class="alert alert-info py-1 px-2 small mb-2">
                Edit any role's access here, then <strong>@Loc["Save all roles"]</strong>. An action can only be
                granted once its screen is set to Read only or Edit. The Administrator's core cells and the
                role you are signed in as cannot be changed.
            </div>
            <div class="card">
                <div class="table-responsive">
                    <table class="table table-sm table-hover align-middle mb-0" id="matrixTable">
                        <thead class="table-light" style="position:sticky; top:0; z-index:2;">
                            <tr>
                                <th>@Loc["Screen"]</th>
                                <th>@Loc["Permission"]</th>
                                @foreach (var r in Model.Roles)
                                {
                                    <th class="text-center small" title="@r.Description">
                                        @r.DisplayName
                                        @if (r.IsSuper)
                                        {
                                            <i class="bi bi-shield-lock-fill text-muted ms-1" title="Super role — always full access, read-only"></i>
                                        }
                                    </th>
                                }
                            </tr>
                        </thead>
                        <tbody>
                        @foreach (var row in Model.MatrixRows)
                        {
                            <tr data-label="@row.ScreenTitle @row.DisplayName @row.Code" class="@(row.Kind == "Screen" ? "table-light" : "")">
                                <td class="small text-muted">@row.ScreenTitle</td>
                                <td class="small">
                                    @(row.Kind == "Screen" ? "Open the screen" : row.DisplayName)
                                    @if (row.IsReadOnlyAction) { <span class="badge bg-info-subtle text-info-emphasis ms-1">@Loc["view / export"]</span> }
                                    @if (row.IsObsolete) { <span class="badge bg-warning text-dark ms-1">@Loc["retired"]</span> }
                                </td>
                                @for (int i = 0; i < row.Cells.Count; i++)
                                {
                                    var cell = row.Cells[i];
                                    var rc   = Model.Roles[i].RoleCode;
                                    <td class="text-center">
                                        @if (row.Kind == "Screen")
                                        {
                                            @if (cell.Locked)
                                            {
                                                <span class="badge bg-success-subtle text-success-emphasis" title="Always on for the Administrator">@Loc["Edit"]</span>
                                                <input type="hidden" name="screenLevel_@rc" value="@(row.ScreenKey)=2" />
                                            }
                                            else
                                            {
                                                <select class="form-select form-select-sm d-inline-block matrix-screen"
                                                        style="width:auto; min-width:5.5rem"
                                                        name="screenLevel_@rc" data-role="@rc" data-screen="@row.ScreenKey">
                                                    <option value="@(row.ScreenKey)=0" selected="@(cell.Level == AccessLevel.None)">@Loc["No access"]</option>
                                                    @if (row.SupportsAccessLevel)
                                                    {
                                                        <option value="@(row.ScreenKey)=1" selected="@(cell.Level == AccessLevel.Read)">@Loc["Read only"]</option>
                                                    }
                                                    <option value="@(row.ScreenKey)=2" selected="@(cell.Level == AccessLevel.Edit)">@(row.SupportsAccessLevel ? "Edit" : "Access")</option>
                                                </select>
                                            }
                                        }
                                        else
                                        {
                                            @if (cell.Locked)
                                            {
                                                <i class="bi bi-lock-fill text-muted" title="Always on for the Administrator"></i>
                                                <input type="hidden" name="granted_@rc" value="@row.Code" />
                                            }
                                            else
                                            {
                                                <input class="form-check-input matrix-action" type="checkbox"
                                                       name="granted_@rc" value="@row.Code"
                                                       data-role="@rc" data-screen="@row.ScreenKey"
                                                       data-readonly="@(row.IsReadOnlyAction ? "true" : "false")"
                                                       checked="@(cell.Level != AccessLevel.None)" />
                                            }
                                        }
                                    </td>
                                }
                            </tr>
                        }
                        </tbody>
                    </table>
                </div>
            </div>
        </form>
    </div>
</div>

@* ---- New role modal ---- *@
<div class="modal fade" id="newRoleModal" tabindex="-1">
    <div class="modal-dialog">
        <form asp-action="CreateRole" method="post" class="modal-content">
            @Html.AntiForgeryToken()
            <div class="modal-header">
                <h5 class="modal-title">@Loc["New role"]</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="mb-3">
                    <label class="form-label">@Loc["Role name"]</label>
                    <input type="text" name="displayName" class="form-control" maxlength="60" required
                           placeholder='@Loc["e.g. Night Shift Inspector"]' autocomplete="off" />
                    <div class="form-text">@Loc["Shown on the Users screen. The internal code is generated for you."]</div>
                </div>
                <div class="mb-3">
                    <label class="form-label">@Loc["Description"]</label>
                    <input type="text" name="description" class="form-control" maxlength="400"
                           placeholder='@Loc["What is this role for?"]' autocomplete="off" />
                </div>
                <div class="mb-3">
                    <label class="form-label">@Loc["Start from"]</label>
                    <select name="copyFrom" class="form-select">
                        <option value="">@Loc["Nothing — start with no permissions"]</option>
                        @foreach (var r in Model.Roles.Where(x => x.IsActive))
                        {
                            <option value="@r.RoleCode">A copy of @r.DisplayName (@r.GrantCount permissions)</option>
                        }
                    </select>
                    <div class="form-text">@Loc["Copying is usually quicker than ticking a hundred boxes."]</div>
                </div>
                @* Plant access is assigned per user on the Users screen, so a new
                   role no longer carries a plant flag. *@
                <input type="hidden" name="isPlantScoped" value="false" />
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">@Loc["Cancel"]</button>
                <button type="submit" class="btn btn-primary">@Loc["Create role"]</button>
            </div>
        </form>
    </div>
</div>

@if (Model.PermissionsLoadedAt.HasValue)
{
    <p class="text-muted small mt-3">
        Permission list loaded @Model.PermissionsLoadedAt.Value.ToLocalTime().ToString("yyyy-MM-dd HH:mm").
    </p>
}

@section Scripts {
    <script src="~/js/security-matrix.js" asp-append-version="true"></script>
}
