@using SharbatlyQMS.Web.Models
@using SharbatlyQMS.Web.Services
@model IReadOnlyList<PendingPickupRow>
@{
    // One view, two modes. archived=true renders the ARCHIVE: same filters,
    // same pager, same columns -- only containers that were filed away, each
    // with a Restore action where Create normally sits.
    var isArchive     = ViewBag.Archived as bool? ?? false;
    var archivedCount = ViewBag.ArchivedCount as int? ?? 0;
    var canArchive    = Perms.Can(Perm.Arrivals.Archive);
    ViewData["Title"] = isArchive ? "Archived Containers" : "Pending Containers";
    var container   = ViewBag.Container  as string;
    var bol         = ViewBag.Bol        as string;
    var po          = ViewBag.Po         as string;
    var plant       = ViewBag.Plant      as string;
    var poType      = ViewBag.PoType     as string;
    var storageLoc  = ViewBag.StorageLoc as string;
    var supplier    = ViewBag.Supplier   as string;
    var material    = ViewBag.Material   as string;
    var fromDate    = ViewBag.From       as DateOnly?;
    var toDate      = ViewBag.To         as DateOnly?;
    var arrFromDate = ViewBag.ArrFrom    as DateOnly?;
    var arrToDate   = ViewBag.ArrTo      as DateOnly?;
    string Dstr(DateOnly? d) => d?.ToString("yyyy-MM-dd") ?? "";
    bool filtered = !string.IsNullOrWhiteSpace(container)
                    || !string.IsNullOrWhiteSpace(bol)
                    || !string.IsNullOrWhiteSpace(po)
                    || !string.IsNullOrWhiteSpace(supplier)
                    || !string.IsNullOrWhiteSpace(material)
                    || fromDate.HasValue || toDate.HasValue
                    || arrFromDate.HasValue || arrToDate.HasValue
                    || !string.IsNullOrWhiteSpace(plant)
                    || !string.IsNullOrWhiteSpace(poType)
                    || !string.IsNullOrWhiteSpace(storageLoc);
    var pullStatus       = ViewBag.PullStatus        as ContainerPullStatus;
    var plantOptions     = ViewBag.PlantOptions      as IReadOnlyList<string>          ?? Array.Empty<string>();
    var poTypeOptions    = ViewBag.PoTypeOptions     as IReadOnlyList<string>          ?? Array.Empty<string>();
    var storageOptions   = ViewBag.StorageLocOptions as IReadOnlyList<PlantStorageLoc> ?? Array.Empty<PlantStorageLoc>();
    var plantScopeLocked = ViewBag.PlantScopeLocked  as string;
    // QC Manager / Admin: reassign a pending container to another plant.
    // Not offered in the archive -- moving a container nobody is working on
    // says nothing; restore it first.
    var canOverridePlant = Perms.Can(Perm.Arrivals.OverridePlant) && !isArchive;
    var allPlants        = Codes.Plants;
    // Server-side paging state.
    var pageNo    = ViewBag.Page      as int?  ?? 1;
    var pageSize  = ViewBag.PageSize  as int?  ?? 100;
    var totalCount= ViewBag.TotalCount as int? ?? Model.Count;
    var pageCount = (int)Math.Ceiling((double)Math.Max(totalCount, 1) / pageSize);
    var firstRow  = totalCount == 0 ? 0 : (pageNo - 1) * pageSize + 1;
    var lastRow   = Math.Min(pageNo * pageSize, totalCount);
    // Current filter values, so pager links keep the same view. Only non-empty
    // filters are included so the URL stays clean; page + pageSize always ride.
    Func<int, int, Dictionary<string, string>> pageRoute = (p, size) =>
    {
        var d = new Dictionary<string, string>();
        void Add(string k, string? v) { if (!string.IsNullOrWhiteSpace(v)) d[k] = v!; }
        Add("container", container);
        Add("bol", bol);
        Add("po", po);
        Add("supplier", supplier);
        Add("material", material);
        // Carried through the pager, or clicking page 2 would silently widen
        // the filter back to every material.
        Add("matMajor", ViewBag.MatMajor as string);
        Add("matSubMajor", ViewBag.MatSubMajor as string);
        Add("from", Dstr(fromDate));
        Add("to", Dstr(toDate));
        Add("arrFrom", Dstr(arrFromDate));
        Add("arrTo", Dstr(arrToDate));
        Add("plant", plant);
        Add("storageLoc", storageLoc);
        Add("poType", poType);
        if (isArchive) d["archived"] = "true";
        d["page"]     = p.ToString();
        d["pageSize"] = size.ToString();
        return d;
    };
}

<div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
    <h1 class="h3 mb-0">
        @if (isArchive)
        {
            <i class="bi bi-archive me-1"></i><text>Archived Containers</text>
            <span class="badge bg-secondary ms-2">@totalCount</span>
            <small class="text-muted fs-6 fw-normal ms-2">@Loc["Filed away out of the pending list. Restore any of them."]</small>
        }
        else
        {
            <i class="bi bi-inbox me-1"></i><text>Pending Containers</text>
            <span class="badge bg-secondary ms-2">@totalCount</span>
            <small class="text-muted fs-6 fw-normal ms-2">@Loc["SAP containers without a QMS Arrival yet."]</small>
        }
    </h1>
    <div class="d-flex gap-2 flex-wrap">
        @* Pending / Archived switch. Always visible (not gated on canArchive) --
           anyone looking for a container that "disappeared" needs to be able to
           find it; only archiving and restoring are Manager/Admin. *@
        <div class="btn-group" role="group" aria-label='@Loc["Pending or archived"]'>
            <a asp-action="Pending" class="btn @(isArchive ? "btn-outline-secondary" : "btn-secondary")">
                <i class="bi bi-inbox me-1"></i>@Loc["Pending"]
            </a>
            <a asp-action="Pending" asp-route-archived="true"
               class="btn @(isArchive ? "btn-secondary" : "btn-outline-secondary")">
                <i class="bi bi-archive me-1"></i>Archived
                @if (archivedCount > 0)
                {
                    <span class="badge bg-light text-dark ms-1">@archivedCount</span>
                }
            </a>
        </div>
        @if (canArchive)
        {
            @if (isArchive)
            {
                <button type="button" class="btn btn-outline-success" data-bs-toggle="modal" data-bs-target="#restoreRangeModal"
                        title="Put a whole arrival-date range back into the pending list.">
                    <i class="bi bi-arrow-counterclockwise me-1"></i>@Loc["Restore by date"]
                </button>
            }
            else
            {
                <button type="button" class="btn btn-outline-warning" data-bs-toggle="modal" data-bs-target="#archiveRangeModal"
                        title="File containers that arrived before a given date out of this list. Nothing is deleted — the archive can restore them.">
                    <i class="bi bi-archive me-1"></i>@Loc["Archive by date"]
                </button>
            }
        }
        <form asp-action="RetrieveLatestContainers" method="post" class="m-0">
            @Html.AntiForgeryToken()
            <button type="submit" class="btn btn-success"
                    title="Fire an immediate SAP fetch using the admin-configured start date. Runs in the background; refresh after a moment.">
                <i class="bi bi-cloud-download me-1"></i>@Loc["Retrieve latest containers"]
            </button>
        </form>
        @* Columns menu, rendered here rather than injected by columntoggle.js so
           it paints with the rest of the header instead of popping in late on
           a line of its own. The script only fills the menu in. *@
        <div class="dropdown" data-coltoggle-ui="pending-containers">
            <button type="button" class="btn btn-outline-secondary dropdown-toggle"
                    data-bs-toggle="dropdown" data-bs-auto-close="outside" aria-expanded="false"
                    title="Choose which columns to show. Your choice is remembered on this device.">
                <i class="bi bi-layout-three-columns me-1"></i>Columns<span class="badge bg-secondary ms-1 d-none"
                     data-coltoggle-count title="Columns currently hidden"></span>
            </button>
            <div class="dropdown-menu dropdown-menu-end p-2" data-coltoggle-menu style="min-width: 13rem;"></div>
        </div>
        <div class="btn-group">
            <a asp-action="Index" class="btn btn-outline-secondary">
                <i class="bi bi-arrow-left me-1"></i>@Loc["Back to arrivals"]
            </a>
            <a asp-action="Search" class="btn btn-outline-primary">
                <i class="bi bi-search me-1"></i>@Loc["Search SAP directly"]
            </a>
        </div>
    </div>
</div>

@* TempData success / error alerts are rendered globally by _Layout.cshtml,
   so no duplicate block here. *@

@* ---- Retrieval status indicator (last completed + currently running) ---- *@
@if (pullStatus != null)
{
    <div class="card mb-3 border-0 shadow-sm">
        <div class="card-body py-2 px-3 d-flex flex-wrap align-items-center gap-3 small">
            @if (pullStatus.IsRunning && pullStatus.RunningSince.HasValue)
            {
                var elapsedSec  = (int)Math.Max(0, (DateTime.UtcNow - pullStatus.RunningSince.Value).TotalSeconds);
                var runningTrig = string.Equals(pullStatus.RunningTriggerSource, "Manual", StringComparison.OrdinalIgnoreCase) ? "Manual" : "Auto";
                <div class="text-info">
                    <i class="bi bi-arrow-repeat me-1"></i>
                    <strong>@Loc["Currently retrieving…"]</strong>
                    <span class="text-muted">(@runningTrig, started @pullStatus.RunningSince.Value.ToLocalTime().ToString("HH:mm:ss"), elapsed @(elapsedSec / 60) m @(elapsedSec % 60) s)</span>
                </div>
                <span class="text-muted">|</span>
            }
            <div>
                <strong>@Loc["Last successful retrieval:"]</strong>
                <span class="@(pullStatus.LastRunUtc.HasValue ? "" : "text-muted")">
                    @(pullStatus.LastRunUtc.HasValue ? pullStatus.LastRunUtc.Value.ToLocalTime().ToString("yyyy-MM-dd HH:mm") : "never")
                </span>
                @if (!string.IsNullOrEmpty(pullStatus.LastTriggerSource))
                {
                    var trigCss = string.Equals(pullStatus.LastTriggerSource, "Manual", StringComparison.OrdinalIgnoreCase) ? "bg-primary text-white" : "bg-info text-dark";
                    <span class="badge @trigCss ms-1" title="How the last retrieval was triggered">@pullStatus.LastTriggerSource</span>
                }
                @if (pullStatus.LastRowCount.HasValue)
                {
                    <span class="text-muted ms-1">— @pullStatus.LastRowCount rows fetched</span>
                }
            </div>
            @if (pullStatus.IsRunning)
            {
                <a asp-action="Pending" class="btn btn-sm btn-outline-info ms-auto">
                    <i class="bi bi-arrow-clockwise me-1"></i>@Loc["Refresh"]
                </a>
            }
        </div>
    </div>
}

@* ---- Filter form (collapsible) ----
   Free-text contains-match on Container / BOL / PO / Supplier / Material;
   exact-match on the SAP-categorical dropdowns (Plant, PO Type, Storage Loc);
   an arrival-date range. All filters live inside a Bootstrap `collapse`
   panel to save vertical space; the panel opens automatically when any filter
   is active so a bookmarked/filtered view isn't hidden.
   The Storage Loc dropdown is plant-scoped via `data-plant` on each option
   (storage-loc codes repeat across plants). *@
@{
    var activeCount =
        new[] { container, bol, po, supplier, material, plant, poType, storageLoc }
            .Count(x => !string.IsNullOrWhiteSpace(x))
        + (fromDate.HasValue ? 1 : 0) + (toDate.HasValue ? 1 : 0);
}
<div class="mb-3">
    <button type="button" class="btn btn-outline-secondary btn-sm"
            data-bs-toggle="collapse" data-bs-target="#pendingFilters"
            aria-expanded="@(filtered ? "true" : "false")" aria-controls="pendingFilters">
        <i class="bi bi-funnel me-1"></i>Filters
        @if (activeCount > 0)
        {
            <span class="badge bg-primary ms-1" title="Active filters">@activeCount</span>
        }
    </button>
    <div class="collapse @(filtered ? "show" : "")" id="pendingFilters">
    <div class="card card-body mt-2">
<form method="get" class="row g-2 mb-0">
    @* Filtering must not drop you back into the pending list. *@
    @if (isArchive)
    {
        <input type="hidden" name="archived" value="true" />
    }
    @* Container and BOL gave up a column each so Supplier could have two.
       All three are contains-matches, so a partial value is enough and the
       narrower boxes still show what you typed. *@
    <div class="col-6 col-md-1">
        <label class="form-label small mb-1">@Loc["Container"]</label>
        <input type="text" name="container" value="@container" class="form-control form-control-sm"
               placeholder='@Loc["CMAU12…"]' title="Container number — any part of it" autocomplete="off" />
    </div>
    <div class="col-6 col-md-1">
        <label class="form-label small mb-1">@Loc["BOL"]</label>
        <input type="text" name="bol" value="@bol" class="form-control form-control-sm"
               placeholder='@Loc["MSCUA…"]' title="Bill of lading — any part of it" autocomplete="off" />
    </div>
    <div class="col-6 col-md-1">
        <label class="form-label small mb-1">@Loc["PO"]</label>
        <input type="text" name="po" value="@po" class="form-control form-control-sm"
               placeholder='@Loc["EBELN"]' title="Purchase order number — any part of it" autocomplete="off" />
    </div>
    <div class="col-6 col-md-2">
        <label class="form-label small mb-1">@Loc["Supplier"]</label>
        <input type="text" name="supplier" value="@supplier" class="form-control form-control-sm"
               placeholder='@Loc["part of the name"]' title="Supplier name or number — any part of it, no need to type it in full"
               autocomplete="off" />
    </div>
    <div class="col-6 col-md-2">
        <label class="form-label small mb-1">@Loc["Material"]</label>
        <input type="text" name="material" value="@material" class="form-control form-control-sm"
               placeholder='@Loc["code or description"]' title="Material number or description — any part of it"
               autocomplete="off" />
    </div>
    <partial name="_MaterialCategoryFilter"
             model="@((ViewBag.MatMajor as string, ViewBag.MatSubMajor as string))" />
    <div class="col-md-2">
        <label class="form-label small mb-1">@Loc["Plant"]</label>
        @if (plantScopeLocked != null)
        {
            @* Operator is plant-scoped: forced server-side; render a locked
               badge instead of a dropdown so the user understands why every
               row belongs to their plant. *@
            <div class="form-control form-control-sm bg-light d-flex align-items-center"
                 title="Your account is restricted to this plant.">
                <i class="bi bi-lock-fill text-muted me-1"></i>
                <span class="small">@Codes.PlantLabel(plantScopeLocked)</span>
            </div>
            <input type="hidden" id="pending-plant-filter" data-plant-filter="pending" name="plant" value="@plantScopeLocked" />
        }
        else
        {
            <select name="plant" id="pending-plant-filter" data-plant-filter="pending" class="form-select form-select-sm">
                <option value="">@Loc["All plants"]</option>
                @foreach (var pl in plantOptions)
                {
                    <option value="@pl" selected="@(string.Equals(pl, plant, StringComparison.OrdinalIgnoreCase))">@Codes.PlantLabel(pl)</option>
                }
            </select>
        }
    </div>
    <div class="col-md-2">
        <label class="form-label small mb-1">@Loc["Storage Loc"]</label>
        <select name="storageLoc" id="pending-storage-filter" data-storage-filter="pending" class="form-select form-select-sm">
            <option value="">@Loc["All storage locations"]</option>
            @foreach (var sl in storageOptions)
            {
                <option value="@sl.Code" data-plant="@sl.Plant"
                        selected="@(string.Equals(sl.Code, storageLoc, StringComparison.OrdinalIgnoreCase)
                                    && (string.IsNullOrEmpty(plant) || string.Equals(sl.Plant, plant, StringComparison.OrdinalIgnoreCase)))">
                    @Codes.StorageLocationLabel(sl.Plant, sl.Code)
                </option>
            }
        </select>
    </div>
    <div class="col-md-1">
        <label class="form-label small mb-1">@Loc["PO type"]</label>
        <select name="poType" class="form-select form-select-sm">
            <option value="">@Loc["All"]</option>
            @foreach (var pt in poTypeOptions)
            {
                <option value="@pt" selected="@(string.Equals(pt, poType, StringComparison.OrdinalIgnoreCase))">@Codes.PoTypeDisplay(pt)</option>
            }
        </select>
    </div>
    @* The PO-date range is gone: this page is about when a container ARRIVED,
       and the PO date is no longer shown anywhere on it. The service still
       accepts from/to against doc_date for anyone with an old bookmark. *@
    @* Arrival-date range, so the QC team can work through one day's arrivals.
       Filters the same arrival_date the "Arr" cell displays. *@
    <div class="col-6 col-md-2">
        <label class="form-label small mb-1">@Loc["Arrival date from"]</label>
        <input type="date" name="arrFrom" value="@Dstr(arrFromDate)" class="form-control form-control-sm"
               title="Show containers that arrived on/after this date" />
    </div>
    <div class="col-6 col-md-2">
        <label class="form-label small mb-1">@Loc["Arrival date to"]</label>
        <input type="date" name="arrTo" value="@Dstr(arrToDate)" class="form-control form-control-sm"
               title="Show containers that arrived on/before this date" />
    </div>
    <div class="col-md-3 d-flex align-items-end gap-2">
        <button type="submit" class="btn btn-primary btn-sm">
            <i class="bi bi-funnel me-1"></i>@Loc["Filter"]
        </button>
        @if (filtered)
        {
            <a asp-action="Pending" asp-route-archived="@(isArchive ? "true" : null)"
               class="btn btn-outline-secondary btn-sm">@Loc["Clear"]</a>
        }
    </div>
</form>
    </div>
    </div>
</div>

<style>
    /* Compact grid: 13 columns wrapped on narrow screens. Combined cells
       (PO/STO, Plant/Storage, Dates) collapse to 10 columns; the
       supporting CSS below keeps each header on one line, codes in
       monospace + nowrap, and stacks the secondary value as a muted
       sub-line so primary sortable data still wins the eye. */
    /* Size and padding now come from .qms-index-table in site.css, the same
       as the Arrivals, Quality Orders and Claims lists. Only what is specific
       to this page's stacked cells stays here. */
    /* ---- Never scroll sideways ----
       12 columns of SAP data needed 1600px while a 1366 screen offers 1316,
       so the table used to overflow and the Action button fell off the right
       edge. Capping the wide columns only moves the threshold; a fixed layout
       removes it, because the table then divides the width it is GIVEN instead
       of demanding the width its content wants. Columns share it by the
       proportions below and long values ellipsize, with the full text already
       available in each cell's tooltip. */
    .pending-table              { table-layout: fixed; width: 100%; }
    .pending-table th,
    .pending-table td           { vertical-align: middle; overflow: hidden; text-overflow: ellipsis; }
    .pending-table th           { font-weight: 600; }
    /* Flex children need min-width:0 or they refuse to shrink below content. */
    .pending-table .pp-stack > *,
    .pending-table .pp-stack    { min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }

    /* ...except the cell holding the plant dropdown. A Bootstrap menu is a CHILD
       of the cell it opens from, so the ellipsis clipping above swallowed it
       whole: it opened at 240x113 and painted nothing, which read as "the plant
       override stopped working". Nothing overflows visually as a result -- the
       badge inside carries its own max-width and ellipsis. */
    .pending-table td.pp-has-menu,
    .pending-table td.pp-has-menu .pp-stack,
    .pending-table td.pp-has-menu .pp-stack > * { overflow: visible; }

    /* Percentages, not pixels, so every width scales with the window. They sum
       to 100. Vendor, Materials and BOL carry the reductions -- BOL is a fixed
       length code that never needed 189px, and Vendor/Materials were simply
       taking whatever their longest value asked for. */
    .pending-table th:nth-child(1)  { width:  8%; }   /* Container  */
    .pending-table th:nth-child(2)  { width:  8%; }   /* BOL        */
    .pending-table th:nth-child(3)  { width:  8%; }   /* PO / STO   */
    .pending-table th:nth-child(4)  { width:  5%; }   /* Type       */
    .pending-table th:nth-child(5)  { width:16.5%; }  /* Vendor     */
    .pending-table th:nth-child(6)  { width:  7%; }   /* Plant      */
    .pending-table th:nth-child(7)  { width:  9%; }   /* Storage    */
    .pending-table th:nth-child(8)  { width:4.5%; }   /* Lines      */
    .pending-table th:nth-child(9)  { width:16.5%; }  /* Materials  */
    .pending-table th:nth-child(10) { width:  9%; }   /* Arrival dt */
    .pending-table th:nth-child(11) { width:8.5%; }   /* Action     */
    .pp-code                    { font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace; }
    /* The secondary line under a value (STO, vendor code, "was" plant). Tight
       leading and no margin so a two-value cell costs a few pixels, not a
       second row's worth of height. */
    .pp-sub                     { font-size: .7rem; line-height: 1.1; color: var(--bs-secondary-color, #6c757d); }
    .pp-sub-label               { font-weight: 600; opacity: .65; margin-right: .2rem;
                                  text-transform: uppercase; letter-spacing: .02em; }
    .pp-stack                   { display: flex; flex-direction: column; gap: 0; }
    .pp-stack .pp-badges        { display: flex; gap: .2rem; flex-wrap: wrap; }
    /* Badges sit on their own baseline inside stacked cells; without this they
       carry Bootstrap's full line-height and re-inflate the row. The side
       padding comes down too: Plant and Storage are narrow columns, and the
       badge's default .65em a side was spending room the name needed. */
    .pending-table .badge       { line-height: 1.15; padding: .2rem .35rem; max-width: 100%;
                                  overflow: hidden; text-overflow: ellipsis; }
    /* Gap between the plant badge and its edit pencil. */
    .pending-table .pp-stack .d-flex { gap: .15rem; }

    /* Materials "peek": first material inline + count badge if there's
       more. Full list lives in the Bootstrap tooltip so the row stays
       on one line but the operator can hover to read everything. */
    .pp-peek         { display: flex; align-items: center; gap: .35rem;
                       max-width: 100%; min-width: 0;
                       overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }
    .pp-peek .pp-name{ min-width: 0; }
    /* The 19-character SAP material code was taking the whole column once the
       widths were fixed, leaving one letter of the description showing. The
       description is what people read; the code is still in the tooltip below,
       alongside every other material on the container. */
    .pp-peek .pp-no  { display: none; }
    .pp-peek .pp-name{ flex: 1 1 auto; }
    /* Keep the "+N more" count from being clipped away to a bare "+". */
    .pp-peek .badge  { flex: 0 0 auto; }
    .pp-peek .pp-name{ text-overflow: ellipsis; overflow: hidden; }
    /* The tooltip body is rendered as HTML so we can lay it out cleanly. */
    .tooltip-inner   { max-width: 460px; text-align: left; }
    .pp-tip          { margin: 0; padding: 0; list-style: none; font-size: .8rem; }
    .pp-tip li       { padding: 2px 0; border-bottom: 1px dashed rgba(255,255,255,.18); }
    .pp-tip li:last-child { border-bottom: 0; }
    .pp-tip .pp-tip-no   { font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
                           opacity: .8; margin-right: .35rem; }
    .pp-tip .pp-tip-qty  { opacity: .8; margin-left: .35rem; }
</style>

<div class="card">
    <div class="table-responsive">
        @* data-col-key drives the Columns menu (columntoggle.js). Keys are
           stable strings, not positions, so hiding survives a new column
           being added later. Action carries data-col-lock: hiding the only
           way to create an arrival would strand the page. *@
        @* Server-side paged: the controller ships one page of rows, so tablekit
           runs in sort-only mode (data-no-pager) and the pager below drives
           page navigation. data-coltoggle still powers the Columns menu. *@
        <table id="pending-containers" class="table table-hover align-middle mb-0 pending-table qms-index-table"
               data-tablekit data-no-pager data-coltoggle>
            <thead class="table-light">
                <tr>
                    <th data-sort data-col-key="container">@Loc["Container"]</th>
                    <th data-sort data-col-key="bol">@Loc["BOL"]</th>
                    <th data-sort data-col-key="po">@Loc["PO / STO"]</th>
                    <th data-sort data-col-key="type">@Loc["Type"]</th>
                    <th data-sort data-col-key="vendor">@Loc["Vendor"]</th>
                    <th data-sort data-col-key="plant">@Loc["Plant"]</th>
                    <th data-sort data-col-key="storage">@Loc["Storage"]</th>
                    <th class="text-end" data-sort="num" data-col-key="lines">@Loc["Lines"]</th>
                    <th data-col-key="materials">@Loc["Materials"]</th>
                    <th data-sort data-col-key="dates">@Loc["Arrival date"]</th>
                    <th class="text-end" data-col-key="action" data-col-lock>@Loc["Action"]</th>
                </tr>
            </thead>
            <tbody>
            @if (Model.Count == 0)
            {
                <tr><td colspan="11" class="text-center text-muted py-4">
                    @if (filtered)
                    {
                        <span>
                            No @(isArchive ? "archived" : "pending") containers match the filter.
                            <a asp-action="Pending" asp-route-archived="@(isArchive ? "true" : null)">@Loc["Clear"]</a> to see all.
                        </span>
                    }
                    else if (isArchive)
                    {
                        <span>@Loc["Nothing is archived. Containers you archive from the pending list land here."]</span>
                    }
                    else
                    {
                        <span>No pending containers — every SAP shipment since the configured start date already has a QMS Arrival.</span>
                    }
                </td></tr>
            }
            else
            {
                foreach (var r in Model)
                {
                    var firstMat = r.MaterialLines.FirstOrDefault();
                    var extra    = r.MaterialLines.Count - 1;
                    // Tooltip HTML: one <li> per material with code, name, qty/uom.
                    var tipHtml = "<ul class='pp-tip'>" +
                        string.Concat(r.MaterialLines.Select(ml =>
                            "<li>" +
                                "<span class='pp-tip-no'>" + System.Net.WebUtility.HtmlEncode(ml.MaterialNo ?? "") + "</span>" +
                                System.Net.WebUtility.HtmlEncode(ml.MaterialDesc ?? "(no description)") +
                                (ml.Quantity.HasValue && ml.Quantity.Value > 0
                                    ? "<span class='pp-tip-qty'>" + Fmt.Dec2(ml.Quantity.Value) + " " + System.Net.WebUtility.HtmlEncode(ml.Uom ?? "") + "</span>"
                                    : "") +
                            "</li>")) +
                        "</ul>";
                    <tr>
                        <td class="pp-code"><strong>@r.ContainerNo</strong></td>
                        <td class="pp-code" title="@r.BolNo">@r.BolNo</td>
                        <td class="pp-code">
                            <div class="pp-stack">
                                <span><strong>@r.Ebeln</strong></span>
                                @if (!string.IsNullOrEmpty(r.Sto))
                                {
                                    <span class="pp-sub"><span class="pp-sub-label">@Loc["STO"]</span>@r.Sto</span>
                                }
                            </div>
                        </td>
                        <td>
                            @if (!string.IsNullOrEmpty(r.PoType))
                            {
                                <span class="badge bg-light text-dark border"
                                      data-bs-toggle="tooltip" title="@r.PoType">@Codes.PoTypeDisplay(r.PoType)</span>
                            }
                            else
                            {
                                <span class="text-muted">—</span>
                            }
                        </td>
                        @* Fixed column widths mean a long supplier name is
                           clipped, so the full name has to live somewhere the
                           reader can reach -- this cell had no tooltip before. *@
                        <td title="@r.VendorName">
                            @r.VendorName
                            @if (!string.IsNullOrEmpty(r.VendorNo))
                            {
                                <div class="pp-sub">@r.VendorNo</div>
                            }
                        </td>
                        @* Plant and storage are separate columns so each can be
                           sorted and hidden on its own. Name in the badge, SAP
                           code in the tooltip -- the name is what people read.
                           pp-has-menu: this cell also holds the "move container
                           to another plant" dropdown, which must not be clipped
                           by the column's ellipsis rules -- see the stylesheet. *@
                        <td class="pp-has-menu">
                            <div class="pp-stack">
                                <div class="d-flex align-items-center gap-1">
                                    @if (!string.IsNullOrEmpty(r.Plant))
                                    {
                                        <span class="badge @(r.IsPlantOverridden ? "bg-info-subtle text-info-emphasis border border-info" : "bg-light text-dark border")"
                                              data-bs-toggle="tooltip"
                                              title="@(r.IsPlantOverridden ? r.Plant + " — reassigned from " + r.OriginalPlant : r.Plant)">
                                            @Codes.PlantDisplay(r.Plant)
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">—</span>
                                    }
                                    @if (canOverridePlant)
                                    {
                                        @* QC Manager / Admin: move the container to another plant.
                                           A small pencil icon beside the plant (native-title tooltip;
                                           it can't also be a Bootstrap tooltip because the click opens
                                           the dropdown). The form posts to OverridePlant; picking the
                                           original plant undoes a previous move. *@
                                        <div class="dropdown">
                                            <button type="button" class="btn btn-link btn-sm p-0 lh-1 text-secondary"
                                                    data-bs-toggle="dropdown" data-bs-auto-close="outside" aria-expanded="false"
                                                    aria-label='@Loc["Change plant"]' title="Change plant">
                                                <i class="bi bi-pencil-square"></i>
                                            </button>
                                            <div class="dropdown-menu p-2" style="min-width: 15rem;">
                                                <form asp-action="OverridePlant" method="post" class="m-0">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="containerNo" value="@r.ContainerNo" />
                                                    <input type="hidden" name="bolNo"       value="@r.BolNo" />
                                                    <input type="hidden" name="po"          value="@r.Ebeln" />
                                                    <label class="form-label small mb-1">@Loc["Move container to plant"]</label>
                                                    <select name="plant" class="form-select form-select-sm mb-2" required>
                                                        @foreach (var pl in allPlants)
                                                        {
                                                            <option value="@pl.Code"
                                                                    selected="@(string.Equals(pl.Code, r.Plant, StringComparison.OrdinalIgnoreCase))">
                                                                @Codes.PlantLabel(pl.Code)
                                                            </option>
                                                        }
                                                    </select>
                                                    <button type="submit" class="btn btn-sm btn-primary w-100">
                                                        <i class="bi bi-arrow-left-right me-1"></i>@Loc["Move container"]
                                                    </button>
                                                    @if (r.IsPlantOverridden)
                                                    {
                                                        <div class="form-text mt-1">Pick @Codes.PlantDisplay(r.OriginalPlant) to undo the move.</div>
                                                    }
                                                </form>
                                            </div>
                                        </div>
                                    }
                                </div>
                                @if (r.IsPlantOverridden && !string.IsNullOrEmpty(r.OriginalPlant))
                                {
                                    <span class="pp-sub"><span class="pp-sub-label">@Loc["was"]</span>@Codes.PlantDisplay(r.OriginalPlant)</span>
                                }
                            </div>
                        </td>
                        <td>
                            @if (!string.IsNullOrEmpty(r.StorageLocation))
                            {
                                <span class="badge bg-light text-dark border"
                                      data-bs-toggle="tooltip"
                                      title="@Codes.StorageLocationDisplay(r.Plant, r.StorageLocation) (@r.StorageLocation)">@Codes.StorageLocationDisplay(r.Plant, r.StorageLocation)</span>
                            }
                            else
                            {
                                <span class="text-muted">—</span>
                            }
                        </td>
                        <td class="text-end">
                            @if (r.LineCount > 1)
                            {
                                <span class="badge bg-warning text-dark"
                                      title="@r.LineCount material lines under one Container/BOL/PO — one Arrival will cover them all.">@r.LineCount</span>
                            }
                            else
                            {
                                <span class="text-muted">@r.LineCount</span>
                            }
                        </td>
                        <td>
                            @if (firstMat == null)
                            {
                                <span class="text-muted small fst-italic">@Loc["No material lines"]</span>
                            }
                            else
                            {
                                <div class="pp-peek"
                                     data-bs-toggle="tooltip"
                                     data-bs-html="true"
                                     data-bs-placement="bottom"
                                     data-bs-title="@tipHtml"
                                     title="@tipHtml">
                                    <span class="pp-no">@firstMat.MaterialNo</span>
                                    <span class="pp-name">@(string.IsNullOrWhiteSpace(firstMat.MaterialDesc) ? "(no description)" : firstMat.MaterialDesc)</span>
                                    @if (extra > 0)
                                    {
                                        <span class="badge bg-primary-subtle text-primary-emphasis">+@extra more</span>
                                    }
                                </div>
                            }
                        </td>
                        <td>
                            <div class="pp-stack pp-code">
                                @* Arrival date only. The PO date was the primary
                                   line here and is the one nobody works from --
                                   what matters is when the container landed. *@
                                <span>
                                    <span class="pp-sub-label">@Loc["Arr"]</span>
                                    @(r.ArrivalDate?.ToString("yyyy-MM-dd") ?? "—")
                                </span>
                                @* Who filed it away and when — the archive's only
                                   provenance, so it belongs next to the dates. *@
                                @if (isArchive && r.ArchivedAt.HasValue)
                                {
                                    <span class="pp-sub" title="Archived by @r.ArchivedBy">
                                        <span class="pp-sub-label">@Loc["Arch"]</span>
                                        @r.ArchivedAt.Value.ToLocalTime().ToString("yyyy-MM-dd")
                                    </span>
                                }
                            </div>
                        </td>
                        <td class="text-end">
                            @* Archived containers cannot be turned into an Arrival
                               straight from here: restore first, so the container
                               is back where the rest of the team can see it. *@
                            @if (isArchive)
                            {
                                @if (canArchive)
                                {
                                    <form asp-action="RestorePending" method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="containerNo" value="@r.ContainerNo" />
                                        <input type="hidden" name="bolNo"       value="@r.BolNo" />
                                        <input type="hidden" name="po"          value="@r.Ebeln" />
                                        <button type="submit" class="btn btn-sm btn-outline-success"
                                                title="Put this container back in the pending list">
                                            <i class="bi bi-arrow-counterclockwise me-1"></i>@Loc["Restore"]
                                        </button>
                                    </form>
                                }
                                else
                                {
                                    <span class="text-muted small">@Loc["Archived"]</span>
                                }
                            }
                            else
                            {
                                <form asp-action="Create" method="post" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="containerNo" value="@r.ContainerNo" />
                                    <input type="hidden" name="bolNo"       value="@r.BolNo" />
                                    <input type="hidden" name="po"          value="@r.Ebeln" />
                                    <button type="submit" class="btn btn-sm btn-primary">
                                        <i class="bi bi-plus-circle me-1"></i>@Loc["Create"]
                                    </button>
                                </form>
                            }
                        </td>
                    </tr>
                }
            }
            </tbody>
        </table>
    </div>

    @* ---- Server-side pager ----
       The controller ships one page at a time (pageSize 50/100). Each page is a
       small fraction of the old whole-list render, so a normal ?page=N reload is
       now fast — and keeping full navigation means tablekit sorting and the
       Columns menu re-init cleanly on every load (they have no re-attach hook).
       Links carry every active filter so paging never widens the view. *@
    @if (totalCount > 0)
    {
        <div class="tk-pager d-flex justify-content-between align-items-center flex-wrap gap-2 px-3 py-2 border-top"
             data-pending-pager>
            <div class="d-flex align-items-center gap-2 small text-muted">
                <label class="mb-0">@Loc["Show"]</label>
                <select class="form-select form-select-sm" style="width:auto" data-pagesize-select>
                    @foreach (var n in new[] { 50, 100 })
                    {
                        <option value="@n" selected="@(n == pageSize)">@n</option>
                    }
                </select>
                <span>@Loc["per page"]</span>
            </div>

            <span class="text-muted small">Showing @firstRow–@lastRow of @totalCount</span>

            @if (pageCount > 1)
            {
                <nav aria-label='@Loc["Pending container pages"]'>
                    <ul class="pagination pagination-sm mb-0">
                        @{
                            var from = Math.Max(1, pageNo - 2);
                            var to   = Math.Min(pageCount, pageNo + 2);
                        }
                        <li class="page-item @(pageNo == 1 ? "disabled" : "")">
                            <a class="page-link" data-pending-page="@(pageNo - 1)"
                               asp-action="Pending" asp-all-route-data="pageRoute(pageNo - 1, pageSize)" aria-label='@Loc["Previous"]'>«</a>
                        </li>
                        @if (from > 1)
                        {
                            <li class="page-item">
                                <a class="page-link" data-pending-page="1"
                                   asp-action="Pending" asp-all-route-data="pageRoute(1, pageSize)">1</a>
                            </li>
                            @if (from > 2)
                            {
                                <li class="page-item disabled"><span class="page-link">…</span></li>
                            }
                        }
                        @for (var pp = from; pp <= to; pp++)
                        {
                            <li class="page-item @(pp == pageNo ? "active" : "")">
                                <a class="page-link" data-pending-page="@pp"
                                   asp-action="Pending" asp-all-route-data="pageRoute(pp, pageSize)">@pp</a>
                            </li>
                        }
                        @if (to < pageCount)
                        {
                            @if (to < pageCount - 1)
                            {
                                <li class="page-item disabled"><span class="page-link">…</span></li>
                            }
                            <li class="page-item">
                                <a class="page-link" data-pending-page="@pageCount"
                                   asp-action="Pending" asp-all-route-data="pageRoute(pageCount, pageSize)">@pageCount</a>
                            </li>
                        }
                        <li class="page-item @(pageNo == pageCount ? "disabled" : "")">
                            <a class="page-link" data-pending-page="@(pageNo + 1)"
                               asp-action="Pending" asp-all-route-data="pageRoute(pageNo + 1, pageSize)" aria-label='@Loc["Next"]'>»</a>
                        </li>
                    </ul>
                </nav>
            }
        </div>
    }
</div>

@* ---- Archive / restore by ARRIVAL-date range (Manager / Admin) ----
   The range is matched on the same "Arr" date the grid prints, so what gets
   archived is exactly what the operator was looking at. Nothing is deleted:
   the flag is invisible to the SAP sweep, and the archive view restores. ---- *@
@if (canArchive)
{
    @if (isArchive)
    {
        <div class="modal fade" id="restoreRangeModal" tabindex="-1">
            <div class="modal-dialog">
                <form asp-action="RestorePendingRange" method="post" class="modal-content">
                    @Html.AntiForgeryToken()
                    <div class="modal-header">
                        <h5 class="modal-title"><i class="bi bi-arrow-counterclockwise me-1"></i>@Loc["Restore by arrival date"]</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                    </div>
                    <div class="modal-body">
                        <p class="small text-muted">
                            Puts every <strong>@Loc["archived"]</strong> container whose arrival date falls in this range
                            back into the pending list. Leave a bound empty for an open-ended range.
                        </p>
                        <div class="row g-2">
                            <div class="col-6">
                                <label class="form-label small mb-1">@Loc["Arrival date from"]</label>
                                <input type="date" name="from" class="form-control form-control-sm" />
                            </div>
                            <div class="col-6">
                                <label class="form-label small mb-1">@Loc["Arrival date to"]</label>
                                <input type="date" name="to" class="form-control form-control-sm" />
                            </div>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">@Loc["Cancel"]</button>
                        <button type="submit" class="btn btn-success">
                            <i class="bi bi-arrow-counterclockwise me-1"></i>@Loc["Restore range"]
                        </button>
                    </div>
                </form>
            </div>
        </div>
    }
    else
    {
        <div class="modal fade" id="archiveRangeModal" tabindex="-1">
            <div class="modal-dialog">
                <form asp-action="ArchivePending" method="post" class="modal-content">
                    @Html.AntiForgeryToken()
                    <div class="modal-header">
                        <h5 class="modal-title"><i class="bi bi-archive me-1"></i>@Loc["Archive by arrival date"]</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                    </div>
                    <div class="modal-body">
                        <p class="small text-muted mb-2">
                            Files every <strong>@Loc["pending"]</strong> container whose arrival date falls in this range out of
                            this list — typically old shipments that will never become an Arrival. Leave a bound
                            empty for an open-ended range (e.g. only a <em>@Loc["to"]</em> date archives everything older).
                        </p>
                        <div class="alert alert-light border small py-2">
                            <i class="bi bi-info-circle me-1"></i>
                            Nothing is deleted. Archived containers move to
                            <strong>@Loc["Archived"]</strong>, where they can be restored one by one or by the same range.
                        </div>
                        <div class="row g-2">
                            <div class="col-6">
                                <label class="form-label small mb-1">@Loc["Arrival date from"]</label>
                                <input type="date" name="from" class="form-control form-control-sm" />
                            </div>
                            <div class="col-6">
                                <label class="form-label small mb-1">@Loc["Arrival date to"]</label>
                                <input type="date" name="to" class="form-control form-control-sm" />
                            </div>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">@Loc["Cancel"]</button>
                        <button type="submit" class="btn btn-warning">
                            <i class="bi bi-archive me-1"></i>@Loc["Archive range"]
                        </button>
                    </div>
                </form>
            </div>
        </div>
    }
}

@* Bootstrap tooltips are wired site-wide by site.js, and the plant -> storage
   narrowing now lives in wwwroot/js/plant-storage-filter.js (shared with the
   Quality Orders filter panel). pending-pager.js only wires the "per page"
   selector to reload at page 1 with the chosen size. *@
@section Scripts {
    <script src="~/js/list-pager.js" asp-append-version="true"></script>
}
