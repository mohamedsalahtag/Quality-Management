@using SharbatlyQMS.Web.Models
@using SharbatlyQMS.Web.Services
@model IReadOnlyList<PendingPickupRow>
@{
    ViewData["Title"] = "Pending Containers";
    var container   = ViewBag.Container  as string;
    var bol         = ViewBag.Bol        as string;
    var po          = ViewBag.Po         as string;
    var plant       = ViewBag.Plant      as string;
    var poType      = ViewBag.PoType     as string;
    var storageLoc  = ViewBag.StorageLoc as string;
    var supplier    = ViewBag.Supplier   as string;
    bool filtered = !string.IsNullOrWhiteSpace(container)
                    || !string.IsNullOrWhiteSpace(bol)
                    || !string.IsNullOrWhiteSpace(po)
                    || !string.IsNullOrWhiteSpace(supplier)
                    || !string.IsNullOrWhiteSpace(plant)
                    || !string.IsNullOrWhiteSpace(poType)
                    || !string.IsNullOrWhiteSpace(storageLoc);
    var pullStatus       = ViewBag.PullStatus        as ContainerPullStatus;
    var plantOptions     = ViewBag.PlantOptions      as IReadOnlyList<string>          ?? Array.Empty<string>();
    var poTypeOptions    = ViewBag.PoTypeOptions     as IReadOnlyList<string>          ?? Array.Empty<string>();
    var storageOptions   = ViewBag.StorageLocOptions as IReadOnlyList<PlantStorageLoc> ?? Array.Empty<PlantStorageLoc>();
    var plantScopeLocked = ViewBag.PlantScopeLocked  as string;
}

<div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
    <h1 class="h3 mb-0">
        <i class="bi bi-inbox me-1"></i>Pending Containers
        <span class="badge bg-secondary ms-2">@Model.Count</span>
        <small class="text-muted fs-6 fw-normal ms-2">SAP containers without a QMS Arrival yet.</small>
    </h1>
    <div class="d-flex gap-2 flex-wrap">
        <form asp-action="RetrieveLatestContainers" method="post" class="m-0">
            @Html.AntiForgeryToken()
            <button type="submit" class="btn btn-success"
                    title="Fire an immediate SAP fetch using the admin-configured start date. Runs in the background; refresh after a moment.">
                <i class="bi bi-cloud-download me-1"></i>Retrieve latest containers
            </button>
        </form>
        @* Columns menu, rendered here rather than injected by columntoggle.js so
           it paints with the rest of the header instead of popping in late on
           a line of its own. The script only fills the menu in. *@
        <div class="dropdown" data-coltoggle-ui="pending-containers">
            <button type="button" class="btn btn-outline-secondary dropdown-toggle"
                    data-bs-toggle="dropdown" data-bs-auto-close="outside" aria-expanded="false"
                    title="Choose which columns to show. Your choice is remembered on this device.">
                <i class="bi bi-layout-three-columns me-1"></i>Columns<span class="badge bg-secondary ms-1 d-none"
                     data-coltoggle-count title="Columns currently hidden"></span>
            </button>
            <div class="dropdown-menu dropdown-menu-end p-2" data-coltoggle-menu style="min-width: 13rem;"></div>
        </div>
        <div class="btn-group">
            <a asp-action="Index" class="btn btn-outline-secondary">
                <i class="bi bi-arrow-left me-1"></i>Back to arrivals
            </a>
            <a asp-action="Search" class="btn btn-outline-primary">
                <i class="bi bi-search me-1"></i>Search SAP directly
            </a>
        </div>
    </div>
</div>

@* TempData success / error alerts are rendered globally by _Layout.cshtml,
   so no duplicate block here. *@

@* ---- Retrieval status indicator (last completed + currently running) ---- *@
@if (pullStatus != null)
{
    <div class="card mb-3 border-0 shadow-sm">
        <div class="card-body py-2 px-3 d-flex flex-wrap align-items-center gap-3 small">
            @if (pullStatus.IsRunning && pullStatus.RunningSince.HasValue)
            {
                var elapsedSec  = (int)Math.Max(0, (DateTime.UtcNow - pullStatus.RunningSince.Value).TotalSeconds);
                var runningTrig = string.Equals(pullStatus.RunningTriggerSource, "Manual", StringComparison.OrdinalIgnoreCase) ? "Manual" : "Auto";
                <div class="text-info">
                    <i class="bi bi-arrow-repeat me-1"></i>
                    <strong>Currently retrieving…</strong>
                    <span class="text-muted">(@runningTrig, started @pullStatus.RunningSince.Value.ToLocalTime().ToString("HH:mm:ss"), elapsed @(elapsedSec / 60) m @(elapsedSec % 60) s)</span>
                </div>
                <span class="text-muted">|</span>
            }
            <div>
                <strong>Last successful retrieval:</strong>
                <span class="@(pullStatus.LastRunUtc.HasValue ? "" : "text-muted")">
                    @(pullStatus.LastRunUtc.HasValue ? pullStatus.LastRunUtc.Value.ToLocalTime().ToString("yyyy-MM-dd HH:mm") : "never")
                </span>
                @if (!string.IsNullOrEmpty(pullStatus.LastTriggerSource))
                {
                    var trigCss = string.Equals(pullStatus.LastTriggerSource, "Manual", StringComparison.OrdinalIgnoreCase) ? "bg-primary text-white" : "bg-info text-dark";
                    <span class="badge @trigCss ms-1" title="How the last retrieval was triggered">@pullStatus.LastTriggerSource</span>
                }
                @if (pullStatus.LastRowCount.HasValue)
                {
                    <span class="text-muted ms-1">— @pullStatus.LastRowCount rows fetched</span>
                }
            </div>
            @if (pullStatus.IsRunning)
            {
                <a asp-action="Pending" class="btn btn-sm btn-outline-info ms-auto">
                    <i class="bi bi-arrow-clockwise me-1"></i>Refresh
                </a>
            }
        </div>
    </div>
}

@* ---- Filter form ----
   Free-text contains-match on Container / BOL / PO; exact-match on the
   three SAP-categorical dropdowns (Plant, PO Type, Storage Loc).
   The Storage Loc dropdown is plant-scoped: each <option> carries the
   parent plant code in `data-plant`; site-level JS narrows visible
   options when the Plant dropdown changes (storage-loc codes repeat
   across plants in SAP, so showing all of them un-scoped would be
   ambiguous). *@
<form method="get" class="row g-2 mb-3">
    @* Container and BOL gave up a column each so Supplier could have two.
       All three are contains-matches, so a partial value is enough and the
       narrower boxes still show what you typed. *@
    <div class="col-6 col-md-1">
        <label class="form-label small mb-1">Container</label>
        <input type="text" name="container" value="@container" class="form-control form-control-sm"
               placeholder="CMAU12…" title="Container number — any part of it" autocomplete="off" />
    </div>
    <div class="col-6 col-md-1">
        <label class="form-label small mb-1">BOL</label>
        <input type="text" name="bol" value="@bol" class="form-control form-control-sm"
               placeholder="MSCUA…" title="Bill of lading — any part of it" autocomplete="off" />
    </div>
    <div class="col-6 col-md-1">
        <label class="form-label small mb-1">PO</label>
        <input type="text" name="po" value="@po" class="form-control form-control-sm"
               placeholder="EBELN" title="Purchase order number — any part of it" autocomplete="off" />
    </div>
    <div class="col-6 col-md-2">
        <label class="form-label small mb-1">Supplier</label>
        <input type="text" name="supplier" value="@supplier" class="form-control form-control-sm"
               placeholder="part of the name" title="Supplier name or number — any part of it, no need to type it in full"
               autocomplete="off" />
    </div>
    <div class="col-md-2">
        <label class="form-label small mb-1">Plant</label>
        @if (plantScopeLocked != null)
        {
            @* Operator is plant-scoped: forced server-side; render a locked
               badge instead of a dropdown so the user understands why every
               row belongs to their plant. *@
            <div class="form-control form-control-sm bg-light d-flex align-items-center"
                 title="Your account is restricted to this plant.">
                <i class="bi bi-lock-fill text-muted me-1"></i>
                <span class="small">@Codes.PlantLabel(plantScopeLocked)</span>
            </div>
            <input type="hidden" id="pending-plant-filter" data-plant-filter="pending" name="plant" value="@plantScopeLocked" />
        }
        else
        {
            <select name="plant" id="pending-plant-filter" data-plant-filter="pending" class="form-select form-select-sm">
                <option value="">All plants</option>
                @foreach (var pl in plantOptions)
                {
                    <option value="@pl" selected="@(string.Equals(pl, plant, StringComparison.OrdinalIgnoreCase))">@Codes.PlantLabel(pl)</option>
                }
            </select>
        }
    </div>
    <div class="col-md-2">
        <label class="form-label small mb-1">Storage Loc</label>
        <select name="storageLoc" id="pending-storage-filter" data-storage-filter="pending" class="form-select form-select-sm">
            <option value="">All storage locations</option>
            @foreach (var sl in storageOptions)
            {
                <option value="@sl.Code" data-plant="@sl.Plant"
                        selected="@(string.Equals(sl.Code, storageLoc, StringComparison.OrdinalIgnoreCase)
                                    && (string.IsNullOrEmpty(plant) || string.Equals(sl.Plant, plant, StringComparison.OrdinalIgnoreCase)))">
                    @Codes.StorageLocationLabel(sl.Plant, sl.Code)
                </option>
            }
        </select>
    </div>
    <div class="col-md-1">
        <label class="form-label small mb-1">PO type</label>
        <select name="poType" class="form-select form-select-sm">
            <option value="">All</option>
            @foreach (var pt in poTypeOptions)
            {
                <option value="@pt" selected="@(string.Equals(pt, poType, StringComparison.OrdinalIgnoreCase))">@Codes.PoTypeDisplay(pt)</option>
            }
        </select>
    </div>
    <div class="col-md-2 d-flex align-items-end gap-2">
        <button type="submit" class="btn btn-primary btn-sm">
            <i class="bi bi-funnel me-1"></i>Filter
        </button>
        @if (filtered)
        {
            <a asp-action="Pending" class="btn btn-outline-secondary btn-sm">Clear</a>
        }
    </div>
</form>

<style>
    /* Compact grid: 13 columns wrapped on narrow screens. Combined cells
       (PO/STO, Plant/Storage, Dates) collapse to 10 columns; the
       supporting CSS below keeps each header on one line, codes in
       monospace + nowrap, and stacks the secondary value as a muted
       sub-line so primary sortable data still wins the eye. */
    .pending-table              { font-size: .875rem; }
    .pending-table th           { white-space: nowrap; vertical-align: middle; font-weight: 600; }
    .pending-table td           { vertical-align: middle; }
    .pp-code                    { font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
                                  white-space: nowrap; }
    .pp-sub                     { font-size: .72rem; line-height: 1.15; color: var(--bs-secondary-color, #6c757d);
                                  white-space: nowrap; }
    .pp-sub-label               { font-weight: 600; opacity: .65; margin-right: .2rem;
                                  text-transform: uppercase; letter-spacing: .02em; }
    .pp-stack                   { display: flex; flex-direction: column; gap: 1px; }
    .pp-stack .pp-badges        { display: flex; gap: .25rem; flex-wrap: wrap; }

    /* Materials "peek": first material inline + count badge if there's
       more. Full list lives in the Bootstrap tooltip so the row stays
       on one line but the operator can hover to read everything. */
    .pp-peek         { display: flex; align-items: center; gap: .35rem;
                       max-width: 320px; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }
    .pp-peek .pp-no  { font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
                       font-size: .75rem; color: var(--bs-secondary-color, #6c757d); }
    .pp-peek .pp-name{ text-overflow: ellipsis; overflow: hidden; }
    /* The tooltip body is rendered as HTML so we can lay it out cleanly. */
    .tooltip-inner   { max-width: 460px; text-align: left; }
    .pp-tip          { margin: 0; padding: 0; list-style: none; font-size: .8rem; }
    .pp-tip li       { padding: 2px 0; border-bottom: 1px dashed rgba(255,255,255,.18); }
    .pp-tip li:last-child { border-bottom: 0; }
    .pp-tip .pp-tip-no   { font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
                           opacity: .8; margin-right: .35rem; }
    .pp-tip .pp-tip-qty  { opacity: .8; margin-left: .35rem; }
</style>

<div class="card">
    <div class="table-responsive">
        @* data-col-key drives the Columns menu (columntoggle.js). Keys are
           stable strings, not positions, so hiding survives a new column
           being added later. Action carries data-col-lock: hiding the only
           way to create an arrival would strand the page. *@
        <table id="pending-containers" class="table table-sm table-hover align-middle mb-0 pending-table"
               data-tablekit data-page-size="50" data-coltoggle>
            <thead class="table-light">
                <tr>
                    <th data-sort data-col-key="container">Container</th>
                    <th data-sort data-col-key="bol">BOL</th>
                    <th data-sort data-col-key="po">PO / STO</th>
                    <th data-sort data-col-key="type">Type</th>
                    <th data-sort data-col-key="vendor">Vendor</th>
                    <th data-sort data-col-key="plant">Plant</th>
                    <th data-sort data-col-key="storage">Storage</th>
                    <th class="text-end" data-sort="num" data-col-key="lines">Lines</th>
                    <th data-col-key="materials">Materials</th>
                    <th data-sort data-col-key="dates">Dates</th>
                    <th class="text-end" data-sort="num" data-col-key="transit">Transit</th>
                    <th class="text-end" data-col-key="action" data-col-lock>Action</th>
                </tr>
            </thead>
            <tbody>
            @if (Model.Count == 0)
            {
                <tr><td colspan="12" class="text-center text-muted py-4">
                    @if (filtered)
                    {
                        <span>No pending containers match the filter. <a asp-action="Pending">Clear</a> to see all.</span>
                    }
                    else
                    {
                        <span>No pending containers — every SAP shipment since the configured start date already has a QMS Arrival.</span>
                    }
                </td></tr>
            }
            else
            {
                foreach (var r in Model)
                {
                    var firstMat = r.MaterialLines.FirstOrDefault();
                    var extra    = r.MaterialLines.Count - 1;
                    // Tooltip HTML: one <li> per material with code, name, qty/uom.
                    var tipHtml = "<ul class='pp-tip'>" +
                        string.Concat(r.MaterialLines.Select(ml =>
                            "<li>" +
                                "<span class='pp-tip-no'>" + System.Net.WebUtility.HtmlEncode(ml.MaterialNo ?? "") + "</span>" +
                                System.Net.WebUtility.HtmlEncode(ml.MaterialDesc ?? "(no description)") +
                                (ml.Quantity.HasValue && ml.Quantity.Value > 0
                                    ? "<span class='pp-tip-qty'>" + ml.Quantity.Value.ToString("0.##") + " " + System.Net.WebUtility.HtmlEncode(ml.Uom ?? "") + "</span>"
                                    : "") +
                            "</li>")) +
                        "</ul>";
                    <tr>
                        <td class="pp-code"><strong>@r.ContainerNo</strong></td>
                        <td class="pp-code">@r.BolNo</td>
                        <td class="pp-code">
                            <div class="pp-stack">
                                <span><strong>@r.Ebeln</strong></span>
                                @if (!string.IsNullOrEmpty(r.Sto))
                                {
                                    <span class="pp-sub"><span class="pp-sub-label">STO</span>@r.Sto</span>
                                }
                            </div>
                        </td>
                        <td>
                            @if (!string.IsNullOrEmpty(r.PoType))
                            {
                                <span class="badge bg-light text-dark border"
                                      data-bs-toggle="tooltip" title="@r.PoType">@Codes.PoTypeDisplay(r.PoType)</span>
                            }
                            else
                            {
                                <span class="text-muted">—</span>
                            }
                        </td>
                        <td>
                            @r.VendorName
                            @if (!string.IsNullOrEmpty(r.VendorNo))
                            {
                                <div class="pp-sub">@r.VendorNo</div>
                            }
                        </td>
                        @* Plant and storage are separate columns so each can be
                           sorted and hidden on its own. Name in the badge, SAP
                           code in the tooltip -- the name is what people read. *@
                        <td>
                            @if (!string.IsNullOrEmpty(r.Plant))
                            {
                                <span class="badge bg-light text-dark border"
                                      data-bs-toggle="tooltip" title="@r.Plant">@Codes.PlantDisplay(r.Plant)</span>
                            }
                            else
                            {
                                <span class="text-muted">—</span>
                            }
                        </td>
                        <td>
                            @if (!string.IsNullOrEmpty(r.StorageLocation))
                            {
                                <span class="badge bg-light text-dark border"
                                      data-bs-toggle="tooltip" title="@r.StorageLocation">@Codes.StorageLocationDisplay(r.Plant, r.StorageLocation)</span>
                            }
                            else
                            {
                                <span class="text-muted">—</span>
                            }
                        </td>
                        <td class="text-end">
                            @if (r.LineCount > 1)
                            {
                                <span class="badge bg-warning text-dark"
                                      title="@r.LineCount material lines under one Container/BOL/PO — one Arrival will cover them all.">@r.LineCount</span>
                            }
                            else
                            {
                                <span class="text-muted">@r.LineCount</span>
                            }
                        </td>
                        <td>
                            @if (firstMat == null)
                            {
                                <span class="text-muted small fst-italic">No material lines</span>
                            }
                            else
                            {
                                <div class="pp-peek"
                                     data-bs-toggle="tooltip"
                                     data-bs-html="true"
                                     data-bs-placement="bottom"
                                     data-bs-title="@tipHtml"
                                     title="@tipHtml">
                                    <span class="pp-no">@firstMat.MaterialNo</span>
                                    <span class="pp-name">@(string.IsNullOrWhiteSpace(firstMat.MaterialDesc) ? "(no description)" : firstMat.MaterialDesc)</span>
                                    @if (extra > 0)
                                    {
                                        <span class="badge bg-primary-subtle text-primary-emphasis">+@extra more</span>
                                    }
                                </div>
                            }
                        </td>
                        <td>
                            <div class="pp-stack pp-code">
                                <span>
                                    <span class="pp-sub-label">PO</span>
                                    @(r.DocDate?.ToString("yyyy-MM-dd") ?? "—")
                                </span>
                                <span class="pp-sub">
                                    <span class="pp-sub-label">Arr</span>
                                    @(r.ArrivalDate?.ToString("yyyy-MM-dd") ?? "—")
                                </span>
                            </div>
                        </td>
                        <td class="text-end pp-code">
                            @* Days in transit, straight from SAP. tablekit's
                               numeric sort strips the unit, so "12 d" sorts. *@
                            @if (r.TransitDays.HasValue)
                            {
                                <span>@r.TransitDays d</span>
                            }
                            else
                            {
                                <span class="text-muted">—</span>
                            }
                        </td>
                        <td class="text-end">
                            <form asp-action="Create" method="post" class="d-inline">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="containerNo" value="@r.ContainerNo" />
                                <input type="hidden" name="bolNo"       value="@r.BolNo" />
                                <input type="hidden" name="po"          value="@r.Ebeln" />
                                <button type="submit" class="btn btn-sm btn-primary">
                                    <i class="bi bi-plus-circle me-1"></i>Create
                                </button>
                            </form>
                        </td>
                    </tr>
                }
            }
            </tbody>
        </table>
    </div>
</div>

@* Bootstrap tooltips are wired site-wide by site.js, and the plant -> storage
   narrowing now lives in wwwroot/js/plant-storage-filter.js (shared with the
   Quality Orders filter panel) — this view needs no script block of its own. *@
