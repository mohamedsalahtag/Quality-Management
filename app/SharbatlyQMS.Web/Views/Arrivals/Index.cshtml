@using SharbatlyQMS.Web.Models
@using SharbatlyQMS.Web.ViewModels
@model IReadOnlyList<Arrival>
@{
    ViewData["Title"] = Loc["Arrivals"];
    var f       = ViewBag.Filter as ArrivalListFilter ?? new ArrivalListFilter();
    var opts    = ViewBag.FilterOptions as ArrivalFilterOptions ?? new ArrivalFilterOptions();
    var status  = f.Status;
    var search  = f.Search;
    var plantScopeLocked = ViewBag.PlantScopeLocked as string;
    var canEdit   = Perms.Can(Perm.Arrivals.Create);
    var canManage = Perms.Can(Perm.Arrivals.Delete);
    // Panel starts collapsed, but opens itself when the URL already carries panel
    // filters -- otherwise a bookmarked link shows a short list with no reason.
    var panelOpen = f.AnyPanelFilter;
    string D(DateTime? d) => d?.ToString("yyyy-MM-dd") ?? "";

    // ---- Server-side page window ----
    var totalCount = ViewBag.Total    as int? ?? Model.Count;
    var pageNo     = ViewBag.Page     as int? ?? 1;
    var pageSize   = ViewBag.PageSize as int? ?? 50;
    var pageCount  = Math.Max(1, (int)Math.Ceiling(totalCount / (double)pageSize));
    var firstRow   = totalCount == 0 ? 0 : (pageNo - 1) * pageSize + 1;
    var lastRow    = Math.Min(pageNo * pageSize, totalCount);

    // Every page link carries the active filters, so paging never silently
    // widens the result the way a bare ?page=2 would.
    Dictionary<string, string> pageRoute(int p, int size)
    {
        var d = new Dictionary<string, string>();
        void Add(string k, string? v) { if (!string.IsNullOrWhiteSpace(v)) d[k] = v!; }
        Add("status", f.Status);        Add("search", f.Search);
        Add("container", f.Container);  Add("bol", f.Bol);
        Add("po", f.Po);                Add("arrivalNo", f.ArrivalNo);
        Add("material", f.Material);    Add("supplier", f.Supplier);
        Add("plant", f.Plant);          Add("storageLoc", f.StorageLoc);
        Add("createdBy", f.CreatedBy);
        Add("from", D(f.From));         Add("to", D(f.To));
        d["page"]     = p.ToString();
        d["pageSize"] = size.ToString();
        return d;
    }
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0"><i class="bi bi-box-arrow-in-down me-1"></i>@Loc["Arrivals"]</h1>
    @if (canEdit)
    {
        <a asp-action="Search" class="btn btn-primary">
            <i class="bi bi-search me-1"></i>@Loc["New arrival from SAP"]
        </a>
    }
</div>

@{
    // Status filter chips (same mechanism as Quality Orders): each toggle is its
    // own submit, so picking a status posts the form and preserves the search
    // text without an extra click. Cancelled is omitted -- arrivals aren't
    // cancelled in practice, matching the old dropdown's Draft/Completed.
    var statuses = new (string Value, string OutlineCss)[]
    {
        ("",                       "btn-outline-secondary"),
        (ArrivalStatus.Draft,      "btn-outline-warning"),
        (ArrivalStatus.Completed,  "btn-outline-success"),
        (ArrivalStatus.Rejected,   "btn-outline-danger"),
    };
    string ChipLabel(string v) => v.Length == 0 ? "All" : v;
    string ActiveClass(string v, string baseCss) =>
        (status ?? "") == v ? baseCss.Replace("btn-outline-", "btn-") + " active" : baseCss;
}
@* One form for everything: the always-visible quick bar and the collapsible
   panel below it. Collapsed inputs still submit (display:none is not disabled),
   so the two sets AND together. *@
<form method="get" class="mb-3" data-filter-memory="arrivals">
    @* Enter inside a panel field does this plain submit rather than the first
       status chip (which would change the status filter). *@
    <button type="submit" class="visually-hidden" tabindex="-1" aria-hidden="true"></button>
    <div class="row g-2 align-items-stretch">
        <div class="col-auto d-flex gap-2">
            @* Filters toggle on the left, styled like the Pending Containers
               page. The panel carries its own Apply/Reset buttons. *@
            <button class="btn btn-outline-secondary" type="button"
                    data-bs-toggle="collapse" data-bs-target="#arrFilters"
                    aria-expanded="@(panelOpen ? "true" : "false")" aria-controls="arrFilters">
                <i class="bi bi-funnel me-1"></i>Filters
                @if (f.PanelFilterCount > 0)
                {
                    <span class="badge bg-primary ms-1">@f.PanelFilterCount</span>
                }
            </button>
            @if (f.Any)
            {
                <a asp-action="Index" class="btn btn-outline-secondary" title="Clear every filter" data-filter-clear>@Loc["Clear"]</a>
            }
        </div>
        <div class="col-auto">
            <div class="btn-group" role="group" aria-label='@Loc["Filter by status"]'>
                @foreach (var s in statuses)
                {
                    <button type="submit" name="status" value="@s.Value" class="btn btn-sm @ActiveClass(s.Value, s.OutlineCss)" style="min-width:6.5rem">@ChipLabel(s.Value)</button>
                }
            </div>
        </div>
    </div>

    <div class="collapse @(panelOpen ? "show" : "")" id="arrFilters">
        <div class="card card-body mt-2 bg-body-tertiary">
            <div class="row g-2">
                <div class="col-6 col-md-2">
                    <label class="form-label small mb-1">@Loc["Container"]</label>
                    <input type="text" name="container" value="@f.Container" class="form-control form-control-sm"
                           placeholder='@Loc["any part"]' autocomplete="off" />
                </div>
                <div class="col-6 col-md-2">
                    <label class="form-label small mb-1">@Loc["BOL"]</label>
                    <input type="text" name="bol" value="@f.Bol" class="form-control form-control-sm"
                           placeholder='@Loc["any part"]' autocomplete="off" />
                </div>
                <div class="col-6 col-md-2">
                    <label class="form-label small mb-1">@Loc["PO"]</label>
                    <input type="text" name="po" value="@f.Po" class="form-control form-control-sm"
                           placeholder='@Loc["EBELN"]' autocomplete="off" />
                </div>
                <div class="col-6 col-md-2">
                    <label class="form-label small mb-1">@Loc["Arrival no."]</label>
                    <input type="text" name="arrivalNo" value="@f.ArrivalNo" class="form-control form-control-sm"
                           placeholder='@Loc["ARR-…"]' autocomplete="off" />
                </div>
                <div class="col-12 col-md-4">
                    <label class="form-label small mb-1">@Loc["Material"]</label>
                    <input type="text" name="material" value="@f.Material" class="form-control form-control-sm"
                           placeholder='@Loc["code or description"]' autocomplete="off" />
                </div>
                <partial name="_MaterialCategoryFilter" model="@((f.MatMajor, f.MatSubMajor))" />

                <div class="col-12 col-md-4">
                    <label class="form-label small mb-1">@Loc["Supplier"]</label>
                    <select name="supplier" class="form-select form-select-sm">
                        <option value="">@Loc["All suppliers"]</option>
                        @foreach (var sup in opts.Suppliers)
                        {
                            <option value="@sup" selected="@(string.Equals(sup, f.Supplier, StringComparison.OrdinalIgnoreCase))">@sup</option>
                        }
                    </select>
                </div>

                <div class="col-6 col-md-3">
                    <label class="form-label small mb-1">@Loc["Plant"]</label>
                    @if (plantScopeLocked != null)
                    {
                        @* Scoped operator: the server forces this plant anyway, so
                           show why instead of a dropdown that can't take effect. *@
                        <div class="form-control form-control-sm bg-light d-flex align-items-center"
                             title="Your account is restricted to this plant.">
                            <i class="bi bi-lock-fill text-muted me-1"></i>
                            <span class="small">@Codes.PlantLabel(plantScopeLocked)</span>
                        </div>
                        <input type="hidden" id="arr-plant-filter" data-plant-filter="arr" data-filter-ignore name="plant" value="@plantScopeLocked" />
                    }
                    else
                    {
                        <select name="plant" id="arr-plant-filter" data-plant-filter="arr" class="form-select form-select-sm">
                            <option value="">@Loc["All plants"]</option>
                            @foreach (var pl in opts.Plants)
                            {
                                <option value="@pl" selected="@(string.Equals(pl, f.Plant, StringComparison.OrdinalIgnoreCase))">@Codes.PlantLabel(pl)</option>
                            }
                        </select>
                    }
                </div>
                <div class="col-6 col-md-3">
                    <label class="form-label small mb-1">@Loc["Storage location"]</label>
                    <select name="storageLoc" id="arr-storage-filter" data-storage-filter="arr" class="form-select form-select-sm">
                        <option value="">@Loc["All storage locations"]</option>
                        @foreach (var sl in opts.StorageLocations)
                        {
                            <option value="@sl.Code" data-plant="@sl.Plant"
                                    selected="@(string.Equals(sl.Code, f.StorageLoc, StringComparison.OrdinalIgnoreCase)
                                                && (string.IsNullOrEmpty(f.Plant) || string.Equals(sl.Plant, f.Plant, StringComparison.OrdinalIgnoreCase)))">
                                @Codes.StorageLocationLabel(sl.Plant, sl.Code)
                            </option>
                        }
                    </select>
                </div>
                <div class="col-6 col-md-2">
                    <label class="form-label small mb-1">@Loc["Created by"]</label>
                    <select name="createdBy" class="form-select form-select-sm">
                        <option value="">@Loc["Anyone"]</option>
                        @foreach (var cb in opts.CreatedBy)
                        {
                            <option value="@cb" selected="@(string.Equals(cb, f.CreatedBy, StringComparison.OrdinalIgnoreCase))">@cb</option>
                        }
                    </select>
                </div>
                <div class="col-6 col-md-2">
                    <label class="form-label small mb-1">@Loc["Created from"]</label>
                    <input type="date" name="from" value="@D(f.From)" class="form-control form-control-sm" />
                </div>
                <div class="col-6 col-md-2">
                    <label class="form-label small mb-1">@Loc["Created to"]</label>
                    <input type="date" name="to" value="@D(f.To)" class="form-control form-control-sm" />
                </div>
            </div>
            <div class="mt-2 d-flex gap-2">
                <button type="submit" class="btn btn-primary btn-sm"><i class="bi bi-funnel me-1"></i>@Loc["Apply filters"]</button>
                @if (f.AnyPanelFilter)
                {
                    <a asp-action="Index" asp-route-status="@status" asp-route-search="@search"
                       class="btn btn-outline-secondary btn-sm">@Loc["Reset these filters"]</a>
                }
            </div>
        </div>
    </div>
</form>

<div class="card">
    <div class="table-responsive">
        @* Server-side paged: the controller ships one page, so tablekit runs in
   sort-only mode (data-no-pager) and the pager below navigates. Before
   this the page shipped every arrival and the browser paginated, which
   is what made the list paint wide for ~2.5s on each load. *@
        <table class="table table-hover align-middle mb-0 qms-index-table"
               data-tablekit data-no-pager>
            <thead class="table-light">
                <tr>
                    <th data-sort>@Loc["Arrival #"]</th>
                    <th data-sort>@Loc["Container"]</th>
                    <th data-sort>@Loc["BOL"]</th>
                    <th data-sort>@Loc["Plant"]</th>
                    <th data-sort>@Loc["Storage"]</th>
                    <th data-sort>@Loc["Type"]</th>
                    <th data-sort>@Loc["Vendor"]</th>
                    <th data-sort>@Loc["Created"]</th>
                    <th data-sort>@Loc["Created By"]</th>
                    <th data-sort>@Loc["Status"]</th>
                    <th>@Loc["Quality Order"]</th>
                    <th class="text-end">@Loc["View"]</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr><td colspan="12" class="text-center text-muted py-4">
                        No arrivals yet. Click <em>@Loc["New arrival from SAP"]</em> to create the first one.
                    </td></tr>
                }
                else
                {
                    foreach (var a in Model)
                    {
                        <tr>
                            <td><code>@a.ArrivalNo</code></td>
                            <td>@a.ContainerNo</td>
                            <td>@a.BolNo</td>
                            <td>
                                @if (!string.IsNullOrEmpty(a.Plant))
                                {
                                    <span class="badge bg-light text-dark border"
                                          data-bs-toggle="tooltip" title="@a.Plant">@Codes.PlantDisplay(a.Plant)</span>
                                }
                                else
                                {
                                    <span class="text-muted">—</span>
                                }
                            </td>
                            @* Storage location and PO type read as names; the raw
                               SAP code stays available in the tooltip. Both are
                               null on arrivals created before M13 backfilled them. *@
                            <td>
                                @if (!string.IsNullOrEmpty(a.StorageLocation))
                                {
                                    <span class="badge bg-light text-dark border"
                                          data-bs-toggle="tooltip" title="@a.StorageLocation">@Codes.StorageLocationDisplay(a.Plant, a.StorageLocation)</span>
                                }
                                else
                                {
                                    <span class="text-muted">—</span>
                                }
                            </td>
                            <td>
                                @if (!string.IsNullOrEmpty(a.PoType))
                                {
                                    <span class="badge bg-light text-dark border"
                                          data-bs-toggle="tooltip" title="@a.PoType">@Codes.PoTypeDisplay(a.PoType)</span>
                                }
                                else
                                {
                                    <span class="text-muted">—</span>
                                }
                            </td>
                            <td class="cell-clip" title="@a.VendorName">@a.VendorName</td>
                            <td>@a.CreatedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</td>
                            <td>@a.CreatedBy</td>
                            <td>
                                @* The shared helper, not a fourth private copy of
                                   the same switch on raw string literals. *@
                                @{ var (cls, label) = ArrivalStatus.Badge(a.StatusCode); }
                                <span class="badge bg-@cls">@label</span>
                            </td>
                            <td>
                                @if (a.QualityOrderId.HasValue)
                                {
                                    <a asp-controller="QualityOrders" asp-action="Details"
                                       asp-route-id="@a.QualityOrderId" class="btn btn-sm btn-outline-primary"
                                       title="@a.QualityOrderNo">
                                        <i class="bi bi-clipboard-data me-1"></i>@Loc["Open Quality Order"]
                                    </a>
                                }
                                else if (a.StatusCode == ArrivalStatus.Completed && canEdit)
                                {
                                    <form asp-controller="QualityOrders" asp-action="CreateForArrival"
                                          method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="arrivalId" value="@a.ArrivalId" />
                                        <button type="submit" class="btn btn-sm btn-success">
                                            <i class="bi bi-plus-circle me-1"></i>@Loc["Create Quality Order"]
                                        </button>
                                    </form>
                                }
                                else
                                {
                                    <span class="text-muted small">—</span>
                                }
                            </td>
                            <td class="text-end">
                                <a asp-action="Details" asp-route-id="@a.ArrivalId" class="btn btn-sm btn-outline-primary" title="View arrival">
                                    <i class="bi bi-eye"></i>
                                </a>
                                <a asp-controller="Reports" asp-action="ArrivalChecklistPdf" asp-route-id="@a.ArrivalId"
                                   class="btn btn-sm btn-outline-danger ms-1" target="_blank" title="Download checklist PDF">
                                    <i class="bi bi-file-earmark-pdf"></i>
                                </a>
                                @if (canManage && !a.QualityOrderId.HasValue)
                                {
                                    <button type="button" class="btn btn-sm btn-outline-danger ms-1"
                                            data-bs-toggle="modal" data-bs-target="#deleteListModal"
                                            data-arrival-id="@a.ArrivalId"
                                            data-arrival-no="@a.ArrivalNo"
                                            title="Delete this arrival">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                }
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>

    @* ---- Server-side pager ----
       Mirrors /Arrivals/Pending: plain links that reload, which keeps tablekit
       sorting re-initialising cleanly (it has no re-attach hook) and is cheap
       now that a page is 50 rows rather than the whole table. *@
    @if (totalCount > 0)
    {
        <div class="tk-pager d-flex justify-content-between align-items-center flex-wrap gap-2 px-3 py-2 border-top">
            <div class="d-flex align-items-center gap-2 small text-muted">
                <label class="mb-0">@Loc["Show"]</label>
                <select class="form-select form-select-sm" style="width:auto" data-pagesize-select>
                    @foreach (var n in new[] { 25, 50, 100 })
                    {
                        <option value="@n" selected="@(n == pageSize)">@n</option>
                    }
                </select>
                <span>@Loc["per page"]</span>
            </div>

            <span class="text-muted small">Showing @firstRow&ndash;@lastRow of @totalCount</span>

            @if (pageCount > 1)
            {
                <nav aria-label='@Loc["Arrival pages"]'>
                    <ul class="pagination pagination-sm mb-0">
                        @{
                            var pFrom = Math.Max(1, pageNo - 2);
                            var pTo   = Math.Min(pageCount, pageNo + 2);
                        }
                        <li class="page-item @(pageNo == 1 ? "disabled" : "")">
                            <a class="page-link" asp-action="Index"
                               asp-all-route-data="pageRoute(pageNo - 1, pageSize)" aria-label='@Loc["Previous"]'>&laquo;</a>
                        </li>
                        @if (pFrom > 1)
                        {
                            <li class="page-item">
                                <a class="page-link" asp-action="Index" asp-all-route-data="pageRoute(1, pageSize)">1</a>
                            </li>
                            @if (pFrom > 2)
                            {
                                <li class="page-item disabled"><span class="page-link">&hellip;</span></li>
                            }
                        }
                        @for (var pp = pFrom; pp <= pTo; pp++)
                        {
                            <li class="page-item @(pp == pageNo ? "active" : "")">
                                <a class="page-link" asp-action="Index" asp-all-route-data="pageRoute(pp, pageSize)">@pp</a>
                            </li>
                        }
                        @if (pTo < pageCount)
                        {
                            @if (pTo < pageCount - 1)
                            {
                                <li class="page-item disabled"><span class="page-link">&hellip;</span></li>
                            }
                            <li class="page-item">
                                <a class="page-link" asp-action="Index" asp-all-route-data="pageRoute(pageCount, pageSize)">@pageCount</a>
                            </li>
                        }
                        <li class="page-item @(pageNo == pageCount ? "disabled" : "")">
                            <a class="page-link" asp-action="Index"
                               asp-all-route-data="pageRoute(pageNo + 1, pageSize)" aria-label='@Loc["Next"]'>&raquo;</a>
                        </li>
                    </ul>
                </nav>
            }
        </div>
    }
</div>

@* ---- Manager+ : list-level delete confirmation ---- *@
@if (canManage)
{
    <div class="modal fade" id="deleteListModal" tabindex="-1">
        <div class="modal-dialog">
            <form id="deleteListForm" method="post" class="modal-content">
                @Html.AntiForgeryToken()
                <div class="modal-header bg-danger text-white">
                    <h5 class="modal-title">Delete arrival <code id="del-arrival-no" class="text-white"></code></h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <p class="small mb-2">
                        Permanently removes the arrival and all its child rows -- checklist, shipment snapshot,
                        SAP snapshot, item rows, and image links.
                    </p>
                    <div class="alert alert-warning small mb-0">
                        <i class="bi bi-exclamation-triangle me-1"></i>@Loc["This cannot be undone."]
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">@Loc["Cancel"]</button>
                    <button type="submit" class="btn btn-danger"><i class="bi bi-trash me-1"></i>@Loc["Delete permanently"]</button>
                </div>
            </form>
        </div>
    </div>

    @section Scripts {
        <script src="~/js/list-filter-memory.js" asp-append-version="true"></script>
        <script src="~/js/list-pager.js" asp-append-version="true"></script>
        <script>
            // Wire delete modal: each trigger button carries the arrival id +
            // arrival-no in data-* attrs. We rewrite the form action when shown.
            document.getElementById('deleteListModal')?.addEventListener('show.bs.modal', function (e) {
                var btn = e.relatedTarget;
                var id  = btn?.dataset.arrivalId;
                var no  = btn?.dataset.arrivalNo;
                var form = document.getElementById('deleteListForm');
                form.action = '/Arrivals/Delete/' + encodeURIComponent(id);
                document.getElementById('del-arrival-no').textContent = no || ('#' + id);
            });
        </script>
    }
}
