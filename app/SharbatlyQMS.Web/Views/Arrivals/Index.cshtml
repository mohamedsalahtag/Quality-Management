@using SharbatlyQMS.Web.Models
@model IReadOnlyList<Arrival>
@{
    ViewData["Title"] = "Arrivals";
    var status   = ViewBag.Status as string;
    var search   = ViewBag.Search as string;
    var role     = User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value;
    var canEdit  = role == UserRoles.Operator || role == UserRoles.Manager || role == UserRoles.SiteAdmin;
    var canManage = role == UserRoles.Manager || role == UserRoles.SiteAdmin;
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0"><i class="bi bi-box-arrow-in-down me-1"></i>Arrivals</h1>
    @if (canEdit)
    {
        <a asp-action="Search" class="btn btn-primary">
            <i class="bi bi-search me-1"></i>New arrival from SAP
        </a>
    }
</div>

<form method="get" class="row g-2 mb-3">
    <div class="col-md-5">
        <input type="text" name="search" value="@search" class="form-control" placeholder="Container / BOL / vendor / arrival number..." />
    </div>
    <div class="col-md-3">
        <select name="status" class="form-select">
            <option value="">All statuses</option>
            <option value="Draft"     selected="@(status == "Draft")">Draft</option>
            <option value="Completed" selected="@(status == "Completed")">Completed</option>
        </select>
    </div>
    <div class="col-md-2">
        <button type="submit" class="btn btn-outline-secondary w-100">Filter</button>
    </div>
</form>

<div class="card">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0" data-tablekit data-page-size="50">
            <thead class="table-light">
                <tr>
                    <th data-sort>Arrival #</th>
                    <th data-sort>Container</th>
                    <th data-sort>BOL</th>
                    <th data-sort>Plant</th>
                    <th data-sort>Storage</th>
                    <th data-sort>Type</th>
                    <th data-sort>Vendor</th>
                    <th data-sort>Created</th>
                    <th data-sort>Created By</th>
                    <th data-sort>Status</th>
                    <th>Quality Order</th>
                    <th class="text-end">View</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr><td colspan="12" class="text-center text-muted py-4">
                        No arrivals yet. Click <em>New arrival from SAP</em> to create the first one.
                    </td></tr>
                }
                else
                {
                    foreach (var a in Model)
                    {
                        <tr>
                            <td><code>@a.ArrivalNo</code></td>
                            <td>@a.ContainerNo</td>
                            <td>@a.BolNo</td>
                            <td>
                                @if (!string.IsNullOrEmpty(a.Plant))
                                {
                                    <span class="badge bg-light text-dark border"
                                          data-bs-toggle="tooltip" title="@a.Plant">@Codes.PlantDisplay(a.Plant)</span>
                                }
                                else
                                {
                                    <span class="text-muted">—</span>
                                }
                            </td>
                            @* Storage location and PO type read as names; the raw
                               SAP code stays available in the tooltip. Both are
                               null on arrivals created before M13 backfilled them. *@
                            <td>
                                @if (!string.IsNullOrEmpty(a.StorageLocation))
                                {
                                    <span class="badge bg-light text-dark border"
                                          data-bs-toggle="tooltip" title="@a.StorageLocation">@Codes.StorageLocationDisplay(a.Plant, a.StorageLocation)</span>
                                }
                                else
                                {
                                    <span class="text-muted">—</span>
                                }
                            </td>
                            <td>
                                @if (!string.IsNullOrEmpty(a.PoType))
                                {
                                    <span class="badge bg-light text-dark border"
                                          data-bs-toggle="tooltip" title="@a.PoType">@Codes.PoTypeDisplay(a.PoType)</span>
                                }
                                else
                                {
                                    <span class="text-muted">—</span>
                                }
                            </td>
                            <td>@a.VendorName</td>
                            <td>@a.CreatedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</td>
                            <td>@a.CreatedBy</td>
                            <td>
                                @{ var (cls, label) = a.StatusCode switch {
                                    "Draft"     => ("warning", "Draft"),
                                    "Completed" => ("success", "Completed"),
                                    "Cancelled" => ("secondary", "Cancelled"),
                                    _           => ("secondary", a.StatusCode) }; }
                                <span class="badge bg-@cls">@label</span>
                            </td>
                            <td>
                                @if (a.QualityOrderId.HasValue)
                                {
                                    <a asp-controller="QualityOrders" asp-action="Details"
                                       asp-route-id="@a.QualityOrderId" class="btn btn-sm btn-outline-primary"
                                       title="@a.QualityOrderNo">
                                        <i class="bi bi-clipboard-data me-1"></i>Open Quality Order
                                    </a>
                                }
                                else if (a.StatusCode == ArrivalStatus.Completed && canEdit)
                                {
                                    <form asp-controller="QualityOrders" asp-action="CreateForArrival"
                                          method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="arrivalId" value="@a.ArrivalId" />
                                        <button type="submit" class="btn btn-sm btn-success">
                                            <i class="bi bi-plus-circle me-1"></i>Create Quality Order
                                        </button>
                                    </form>
                                }
                                else
                                {
                                    <span class="text-muted small">—</span>
                                }
                            </td>
                            <td class="text-end">
                                <a asp-action="Details" asp-route-id="@a.ArrivalId" class="btn btn-sm btn-outline-primary" title="View arrival">
                                    <i class="bi bi-eye"></i>
                                </a>
                                <a asp-controller="Reports" asp-action="ArrivalChecklistPdf" asp-route-id="@a.ArrivalId"
                                   class="btn btn-sm btn-outline-danger ms-1" target="_blank" title="Download checklist PDF">
                                    <i class="bi bi-file-earmark-pdf"></i>
                                </a>
                                @if (canManage && !a.QualityOrderId.HasValue)
                                {
                                    <button type="button" class="btn btn-sm btn-outline-danger ms-1"
                                            data-bs-toggle="modal" data-bs-target="#deleteListModal"
                                            data-arrival-id="@a.ArrivalId"
                                            data-arrival-no="@a.ArrivalNo"
                                            title="Delete this arrival">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                }
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>

@* ---- Manager+ : list-level delete confirmation ---- *@
@if (canManage)
{
    <div class="modal fade" id="deleteListModal" tabindex="-1">
        <div class="modal-dialog">
            <form id="deleteListForm" method="post" class="modal-content">
                @Html.AntiForgeryToken()
                <div class="modal-header bg-danger text-white">
                    <h5 class="modal-title">Delete arrival <code id="del-arrival-no" class="text-white"></code></h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <p class="small mb-2">
                        Permanently removes the arrival and all its child rows -- checklist, shipment snapshot,
                        SAP snapshot, item rows, and image links.
                    </p>
                    <div class="alert alert-warning small mb-0">
                        <i class="bi bi-exclamation-triangle me-1"></i>This cannot be undone.
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-danger"><i class="bi bi-trash me-1"></i>Delete permanently</button>
                </div>
            </form>
        </div>
    </div>

    @section Scripts {
        <script>
            // Wire delete modal: each trigger button carries the arrival id +
            // arrival-no in data-* attrs. We rewrite the form action when shown.
            document.getElementById('deleteListModal')?.addEventListener('show.bs.modal', function (e) {
                var btn = e.relatedTarget;
                var id  = btn?.dataset.arrivalId;
                var no  = btn?.dataset.arrivalNo;
                var form = document.getElementById('deleteListForm');
                form.action = '/Arrivals/Delete/' + encodeURIComponent(id);
                document.getElementById('del-arrival-no').textContent = no || ('#' + id);
            });
        </script>
    }
}
