            @if (Model.RejectedAt.HasValue)
            {
                <text> — @Model.RejectedAt.Value.ToLocalTime().ToString("yyyy-MM-dd HH:mm") @Loc["by"] @Model.RejectedBy</text>
            }
            @if (!string.IsNullOrWhiteSpace(Model.RejectReason))
            {
                <div class="mt-1">@Model.RejectReason</div>
            }
            <div class="small mt-2">
                @Loc["No inspection is performed. A finished quality order carrying a potential claim was raised so the damage reaches the supplier."]
                @if (hasQo)
                {
                    <a asp-controller="QualityOrders" asp-action="Details" asp-route-id="@Model.QualityOrderId"
                       class="alert-link ms-1">@Model.QualityOrderNo</a>
                }
            </div>
        </div>
    </div>
}

@if (draft && Perms.Can(Perm.Arrivals.Reject))
{
    <div class="modal fade" id="rejectContainerModal" tabindex="-1">
        <div class="modal-dialog">
            <form asp-action="Reject" asp-route-id="@Model.ArrivalId" method="post" class="modal-content">
                @Html.AntiForgeryToken()
                <div class="modal-header bg-danger text-white">
                    <h5 class="modal-title"><i class="bi bi-x-octagon me-1"></i>@Loc["Reject container"]</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <p class="small text-muted">
                        @Loc["Use this when the container arrived in a condition that makes inspection pointless. No QC inspection will be performed. A quality order is raised automatically, already finished and carrying a potential claim, so the damage can be sent to the supplier."]
                    </p>
                    <label class="form-label small mb-1">
                        @Loc["Why is the container not accepted?"] <span class="text-danger">*</span>
                    </label>
                    @* Required AND minlength, but the server checks it again:
                       a crafted POST ignores both, and this text is printed on
                       the report the supplier receives. *@
                    <textarea name="reason" rows="3" required minlength="10" maxlength="500"
                              class="form-control"
                              placeholder='@Loc["Describe the damage — this is printed on the report sent to the supplier."]'></textarea>
                    <div class="form-check mt-3">
                        <input class="form-check-input" type="checkbox" id="rejectAck" required />
                        <label class="form-check-label small" for="rejectAck">
                            @Loc["I understand the arrival becomes Rejected and can no longer be completed."]
                        </label>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">@Loc["Cancel"]</button>
                    <button type="submit" class="btn btn-danger">
                        <i class="bi bi-x-octagon me-1"></i>@Loc["Reject container"]
                    </button>
                </div>
            </form>
        </div>
    </div>
}

@if (Model.StatusCode == ArrivalStatus.Rejected && Perms.Can(Perm.Arrivals.CancelRejection))
{
    <div class="modal fade" id="cancelRejectionModal" tabindex="-1">
        <div class="modal-dialog">
            <form asp-action="CancelRejection" asp-route-id="@Model.ArrivalId" method="post" class="modal-content">
                @Html.AntiForgeryToken()
                <div class="modal-header">
                    <h5 class="modal-title"><i class="bi bi-arrow-counterclockwise me-1"></i>@Loc["Undo rejection"]</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <p class="small text-muted">
                        @Loc["Returns the arrival to Draft and cancels its claim order. Use this when a container was refused by mistake."]
                    </p>
                    <label class="form-label small mb-1">@Loc["Reason"] <span class="text-danger">*</span></label>
                    <textarea name="reason" rows="2" required minlength="5" maxlength="500" class="form-control"></textarea>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">@Loc["Cancel"]</button>
                    <button type="submit" class="btn btn-warning">@Loc["Undo rejection"]</button>
                </div>
            </form>
        </div>
    </div>
}

<div class="tab-pane fade" id="tab-documents">
    @{
        var arrivalDocsVm = new SharbatlyQMS.Web.ViewModels.DocumentListVm
        {
            OwnerType = "Arrival",
            OwnerId   = Model.ArrivalId,
            // Documents can be attached/removed in any status (per user request),
            // mirroring the images tab's bare `canEdit`. DocumentsController.GateEditAsync
            // no longer status-gates either, so the upload form here always works.
            Editable  = canEdit,
            Ajax      = true,
            Categories = new[] { "Invoice", "PackingList", "Certificate", "ClaimDocument", "TemperatureLog", "Other" }
        };
    }
    @* Side-by-side list and viewer, the same shape as the quality order's
       documents dialog. Without a [data-preview-host] the preview buttons in
       the grid would click and do nothing, which is worse than not offering
       them. *@
    <div class="row g-3" data-preview-host>
        <div class="col-xl-7">
            <partial name="_DocumentList" model="arrivalDocsVm" />
        </div>
        <div class="col-xl-5">
            <div class="card h-100">
                <div class="card-header py-2 d-flex align-items-center gap-2 small bg-transparent">
                    <i class="bi bi-eye text-muted"></i>
                    <span class="fw-semibold text-truncate" data-preview-title>@Loc["Preview"]</span>
                </div>
                <div class="card-body p-0 position-relative" style="min-height:60vh">
                    <div class="position-absolute top-0 start-0 w-100 h-100 d-flex
                                align-items-center justify-content-center text-muted small px-4 text-center"
                         data-preview-status>
                        @Loc["Select a file to preview it here. PDF and text files open in place; anything else downloads."]
                    </div>
                    <iframe class="w-100 h-100 border-0 d-none"
                            title="@Loc["Document preview"]" data-preview-frame></iframe>
                </div>
            </div>
        </div>
    </div>
</div>

</div>
