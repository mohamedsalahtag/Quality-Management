@* ===== Images ===== *@
<div class="tab-pane fade" id="tab-images">
    @{
        var arrivalGalleryVm = new SharbatlyQMS.Web.ViewModels.ImageGalleryVm
        {
            OwnerType = "Arrival",
            OwnerId   = Model.ArrivalId,
            // Supporting photos may still be ADDED once the checklist is
            // completed (e.g. the quality manager attaches an evidence shot
            // after sign-off); every such upload is written to the audit trail
            // with the arrival's status. Removing a photo stays Draft-only, so
            // a signed-off photo set is append-only. A Cancelled arrival takes
            // neither. ImagesController.GateOwnerAsync enforces the same rule
            // server-side. All other Arrival edits remain gated by `draft`.
            Editable    = canEdit && Model.StatusCode != ArrivalStatus.Cancelled,
            // The signed-off override (Attachments.PhotoDeleteAfterClose, admins
            // only) also unlocks Remove here. ImagesController.GateOwnerAsync
            // applies the identical rule, and the AJAX redraw asks that gate
            // directly -- so the button and the endpoint cannot drift apart.
            AllowDelete = canEdit && (draft || Perms.Can(Perm.Attachments.PhotoDeleteAfterClose)),
            Notice      = Model.StatusCode == ArrivalStatus.Completed
                            ? (Perms.Can(Perm.Attachments.PhotoDeleteAfterClose)
                                ? "This arrival is Completed. New photos are still recorded in the audit trail, and you may remove one because you hold the signed-off override."
                                : "This arrival is Completed. New photos can still be added and are recorded in the audit trail; existing photos can no longer be removed.")
                            : null,
            Ajax      = true,
            Categories = new[] { "ArrivalExternal", "ArrivalInternal", "TemperatureDisplay", "DataLogger" }
        };
    }
    <partial name="_ImageGallery" model="arrivalGalleryVm" />
</div>

