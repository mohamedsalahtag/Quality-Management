@using SharbatlyQMS.Web.Models
@inject SharbatlyQMS.Web.Services.IDocumentService DocSvc
@model Arrival
@{
    ViewData["Title"] = "Arrival " + Model.ArrivalNo;
    var items     = ViewBag.Items     as IReadOnlyList<ArrivalItem> ?? new List<ArrivalItem>();
    var checklist = ViewBag.Checklist as ArrivalChecklist           ?? new ArrivalChecklist { ArrivalId = Model.ArrivalId };
    var shipment  = ViewBag.Shipment  as ShipmentSnapshot;
    // V36: admin-defined fields applicable to this arrival's material groups.
    var customFields = ViewBag.CustomFields as IReadOnlyList<ArrivalCustomField> ?? new List<ArrivalCustomField>();
    // Counted server-side so the badge is right on first paint; document-list-ajax.js
    // keeps it right after an upload or a delete without a page reload.
    var docCount  = (await DocSvc.ListAsync("Arrival", Model.ArrivalId)).Count;
    var draft     = Model.StatusCode == ArrivalStatus.Draft;
    var role      = User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value;
    var canEdit       = Perms.CanEdit(Screens.ArrivalsDetails);
    var canManage     = Perms.Can(Perm.Arrivals.Delete);
    var isAdmin       = canManage;   // backward-compat alias for blocks that already use isAdmin
    // Completed arrivals are data-locked: only the Administrator may edit them.
    // The Role claim holds the role code, so compare against RoleCodes.Admin.
    var canEditCompleted = string.Equals(role, RoleCodes.Admin, StringComparison.OrdinalIgnoreCase);
    // Combined "edit allowed on this arrival" gate: draft is editable by every
    // OperatorOrAbove; Completed is editable by the Administrator only.
    var canEditArrival = (draft && canEdit) || (Model.StatusCode == ArrivalStatus.Completed && canEditCompleted);
    // W6: per-field editability + mandatory markers, from the Arrival Field Rules.
    var fieldEditable = ViewBag.FieldEditable as Func<string, bool> ?? (Func<string, bool>)(_ => canEditArrival);
    var mandatoryKeys = ViewBag.MandatoryKeys as HashSet<string> ?? new HashSet<string>(StringComparer.OrdinalIgnoreCase);
    // Bare attribute: "disabled" when a field can't be edited in the current state.
    Func<string, string> FDis = key => fieldEditable(key) ? "" : "disabled";
    bool FMand(string key) => mandatoryKeys.Contains(key);
    var shipKeys = new[] { "discharge_date", "unloading_date", "pullout_date", "time_bar", "arrival_place", "inspection_point", "joint_survey", "time_bar_exceeded" };
    bool anyShipmentEditable = shipKeys.Any(fieldEditable);
    bool anyChecklistEditable =
        ArrivalFieldRegistry.All.Where(f => f.Form == ArrivalFieldRegistry.Checklist).Any(f => fieldEditable(f.Key))
        || fieldEditable("__photo_flags__");   // true for Draft (all) or admin
    var hasQo     = Model.QualityOrderId.HasValue;
    // One helper, shared with the list and the dashboard. Each of the three
    // used to carry its own switch on raw string literals, so adding a status
    // meant finding all of them -- and they had already drifted apart.
    var (cls, label) = ArrivalStatus.Badge(Model.StatusCode);
    string YN(bool? b) => b switch { true => "Yes", false => "No", _ => "—" };

    // Tablet-friendly Yes/No toggle. The CSS in this view gives the SELECTED
    // half a solid colored fill + bold weight + drop shadow, and renders the
    // UNSELECTED half faded gray. The visual gap between the two states is
    // intentionally large so an inspector glancing at the form can tell at
    // 2 metres which answer is captured.
    string YesNo(string name, bool? value)
    {
        var y = value == true  ? "checked" : "";
        var n = value == false ? "checked" : "";
        var unanswered = value == null ? "yn-unanswered" : "";
        return $@"<div class='yn-toggle {unanswered}' role='group'>
          <input type='radio' class='btn-check' name='{name}' id='{name}-y' value='true'  {y}>
          <label class='yn-half yn-yes' for='{name}-y'><i class='bi bi-check-circle-fill'></i><span>YES</span></label>
          <input type='radio' class='btn-check' name='{name}' id='{name}-n' value='false' {n}>
          <label class='yn-half yn-no' for='{name}-n'><i class='bi bi-x-circle-fill'></i><span>NO</span></label>
        </div>";
    }

    // Photo-flag: card-style tile with camera icon + label + toggle, always
    // self-contained inside its column (no overflow).
    string PhotoFlag(string name, bool? value, string label)
    {
        var checkedAttr = value == true ? "checked" : "";
        var tileClass   = value == true ? "photo-tile photo-tile-on" : "photo-tile";
        return $@"<label class='{tileClass}' for='{name}'>
          <input type='checkbox' class='form-check-input' role='switch' name='{name}' value='true' id='{name}' {checkedAttr}>
          <i class='bi bi-camera-fill photo-tile-icon'></i>
          <span class='photo-tile-label'>{label}</span>
        </label>";
    }

    // Legacy alias so existing call sites keep compiling.
    string TriRadio(string name, bool? value) => YesNo(name, value);
}

<div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
    <div>
        <h1 class="h3 mb-1"><i class="bi bi-box-arrow-in-down me-1"></i>@Model.ArrivalNo</h1>
        <span class="badge bg-@cls fs-6">@label</span>
        <span class="text-muted small ms-2">created @Model.CreatedAt.ToLocalTime().ToString("g") by @Model.CreatedBy</span>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="Index" class="btn btn-outline-secondary"><i class="bi bi-arrow-left me-1"></i>@Loc["Back"]</a>
        <a asp-controller="Reports" asp-action="ArrivalChecklistPdf" asp-route-id="@Model.ArrivalId"
           class="btn btn-outline-danger" target="_blank" title="Download Arrival Checklist PDF">
            <i class="bi bi-file-earmark-pdf me-1"></i>@Loc["Download checklist PDF"]
        </a>
        @if (draft && canEdit)
        {
            <form asp-action="Complete" asp-route-id="@Model.ArrivalId" method="post"
                  data-confirm="Complete this arrival? After completion the checklist becomes read-only and a Quality Order can be opened."
                  data-confirm-title="Complete arrival" data-confirm-ok="Complete">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-success">
                    <i class="bi bi-check-circle me-1"></i>@Loc["Complete arrival"]
                </button>
            </form>
        }
        @* Refusing a damaged container. Draft only: past that an order may
           already exist, and rejecting around one would either strand it or
           destroy inspection data. *@
        @if (draft && Perms.Can(Perm.Arrivals.Reject))
        {
            <button type="button" class="btn btn-danger"
                    data-bs-toggle="modal" data-bs-target="#rejectContainerModal">
                <i class="bi bi-x-octagon me-1"></i>@Loc["Reject container"]
            </button>
        }
        @if (Model.StatusCode == ArrivalStatus.Rejected && Perms.Can(Perm.Arrivals.CancelRejection))
        {
            <button type="button" class="btn btn-outline-secondary"
                    data-bs-toggle="modal" data-bs-target="#cancelRejectionModal">
                <i class="bi bi-arrow-counterclockwise me-1"></i>@Loc["Undo rejection"]
            </button>
        }
        @if (Model.StatusCode == ArrivalStatus.Completed && !hasQo && canEdit)
        {
            <form asp-controller="QualityOrders" asp-action="CreateForArrival" method="post" class="d-inline">
                @Html.AntiForgeryToken()
                <input type="hidden" name="arrivalId" value="@Model.ArrivalId" />
                <button type="submit" class="btn btn-primary">
                    <i class="bi bi-clipboard-data me-1"></i>@Loc["Create Quality Order"]
                </button>
            </form>
        }
        @if (hasQo)
        {
            <a asp-controller="QualityOrders" asp-action="Details" asp-route-id="@Model.QualityOrderId"
               class="btn btn-primary">
                <i class="bi bi-clipboard-data me-1"></i>View QO @Model.QualityOrderNo
            </a>
        }
        @* ---- Admin-only: edit completed / delete arrival ---- *@
        @if (isAdmin && Model.StatusCode == ArrivalStatus.Completed && !hasQo)
        {
            <button type="button" class="btn btn-outline-warning"
                    data-bs-toggle="modal" data-bs-target="#reopenEditModal">
                <i class="bi bi-pencil-square me-1"></i>@Loc["Edit"]
            </button>
        }
        @if (isAdmin && !hasQo)
        {
            <button type="button" class="btn btn-outline-danger"
                    data-bs-toggle="modal" data-bs-target="#deleteArrivalModal">
                <i class="bi bi-trash me-1"></i>@Loc["Delete"]
            </button>
        }
    </div>
</div>

@* ---- Admin modal: re-open completed arrival for edit ---- *@
@if (isAdmin)
{
    <div class="modal fade" id="reopenEditModal" tabindex="-1">
        <div class="modal-dialog">
            <form asp-action="ReopenForEdit" asp-route-id="@Model.ArrivalId" method="post" class="modal-content">
                @Html.AntiForgeryToken()
                <div class="modal-header"><h5 class="modal-title">@Loc["Re-open arrival for edit"]</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button></div>
                <div class="modal-body">
                    <p class="small text-muted mb-2">
                        The arrival will return to <strong>@Loc["Draft"]</strong> so checklist and shipment
                        details become editable. The action is logged in the status history. Complete
                        the arrival again when you finish editing.
                    </p>
                    <label class="form-label">@Loc["Reason"]</label>
                    <textarea name="reason" class="form-control" rows="2" placeholder='@Loc["Why is the arrival being re-opened?"]'></textarea>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">@Loc["Cancel"]</button>
                    <button type="submit" class="btn btn-warning"><i class="bi bi-pencil-square me-1"></i>@Loc["Re-open for edit"]</button>
                </div>
            </form>
        </div>
    </div>

    <div class="modal fade" id="deleteArrivalModal" tabindex="-1">
        <div class="modal-dialog">
            <form asp-action="Delete" asp-route-id="@Model.ArrivalId" method="post" class="modal-content">
                @Html.AntiForgeryToken()
                <div class="modal-header bg-danger text-white">
                    <h5 class="modal-title">Delete arrival @Model.ArrivalNo</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <p class="small">
                        This permanently removes the arrival, its checklist, shipment snapshot, SAP snapshot,
                        item rows, and image links. Quality Orders linked to this arrival would block the delete
                        &mdash; cancel them first if there are any.
                    </p>
                    <div class="alert alert-warning small mb-0">
                        <i class="bi bi-exclamation-triangle me-1"></i>@Loc["This cannot be undone."]
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">@Loc["Cancel"]</button>
                    <button type="submit" class="btn btn-danger"><i class="bi bi-trash me-1"></i>@Loc["Delete permanently"]</button>
                </div>
            </form>
        </div>
    </div>
}

@if (!draft)
{
    <div class="alert alert-info">
        <i class="bi bi-lock me-1"></i>
        This arrival is <strong>@label</strong>. The checklist and shipment details are now read-only.
    </div>
}

<ul class="nav nav-tabs mb-3" id="arrivalTabs" role="tablist">
    <li class="nav-item"><button class="nav-link active" data-bs-toggle="tab" data-bs-target="#tab-checklist"><i class="bi bi-clipboard-check me-1"></i>@Loc["Inspection Checklist"]</button></li>
    <li class="nav-item"><button class="nav-link"        data-bs-toggle="tab" data-bs-target="#tab-shipment"><i class="bi bi-truck me-1"></i>@Loc["Shipment"]</button></li>
    <li class="nav-item"><button class="nav-link"        data-bs-toggle="tab" data-bs-target="#tab-summary"><i class="bi bi-info-circle me-1"></i>@Loc["Summary"]</button></li>
    <li class="nav-item"><button class="nav-link"        data-bs-toggle="tab" data-bs-target="#tab-materials"><i class="bi bi-list-ul me-1"></i>Materials (@items.Count)</button></li>
    <li class="nav-item"><button class="nav-link"        data-bs-toggle="tab" data-bs-target="#tab-images"><i class="bi bi-images me-1"></i>@Loc["Images"]</button></li>
    <li class="nav-item"><button class="nav-link"        data-bs-toggle="tab" data-bs-target="#tab-documents"><i class="bi bi-paperclip me-1"></i>@Loc["Documents"]<span class="badge rounded-pill bg-secondary ms-1" data-doc-count-badge="Arrival-@Model.ArrivalId" hidden="@(docCount == 0)">@docCount</span></button></li>
</ul>

<div class="tab-content">

@* ===== Summary ===== *@
<div class="tab-pane fade" id="tab-summary">
    <div class="row g-3">
        <div class="col-lg-6">
            <div class="card h-100">
                <div class="card-header"><i class="bi bi-truck me-1"></i>@Loc["Shipment identity"]</div>
                <div class="card-body">
                    <dl class="row mb-0 small">
                        <dt class="col-sm-4">@Loc["Container"]</dt><dd class="col-sm-8"><code>@Model.ContainerNo</code></dd>
                        <dt class="col-sm-4">@Loc["BOL"]</dt><dd class="col-sm-8">@Model.BolNo</dd>
                        <dt class="col-sm-4">@Loc["PO (EBELN)"]</dt><dd class="col-sm-8">@Model.Ebeln</dd>
                        <dt class="col-sm-4">@Loc["Vendor"]</dt><dd class="col-sm-8">@Model.VendorName (@Model.VendorNo)</dd>
                        <dt class="col-sm-4">@Loc["Procurement type"]</dt><dd class="col-sm-8">@(string.IsNullOrWhiteSpace(Model.PoType) ? "—" : Codes.PoTypeDisplay(Model.PoType))</dd>
                        <dt class="col-sm-4">@Loc["Vessel / Voyage"]</dt><dd class="col-sm-8">@shipment?.VesselName / @shipment?.VoyageNumber</dd>
                        <dt class="col-sm-4">@Loc["Loading port"]</dt><dd class="col-sm-8">@shipment?.LoadingPort, @Countries.Display(shipment?.LoadingCountry)</dd>
                        <dt class="col-sm-4">@Loc["Arrival port"]</dt><dd class="col-sm-8">@shipment?.ArrivalPlace</dd>
                    </dl>
                </div>
            </div>
        </div>
        <div class="col-lg-6">
            <div class="card h-100">
                <div class="card-header"><i class="bi bi-clipboard-check me-1"></i>@Loc["Inspection summary"]</div>
                <div class="card-body">
                    <dl class="row mb-0 small">
                        <dt class="col-sm-5">@Loc["Seal #"]</dt><dd class="col-sm-7">@(string.Join(", ", (checklist.SealNo ?? "").Split('\n', StringSplitOptions.RemoveEmptyEntries).Select(x => x.Trim())))</dd>
                        <dt class="col-sm-5">@Loc["Seal intact"]</dt><dd class="col-sm-7">@YN(checklist.SealIntact)</dd>
                        <dt class="col-sm-5">@Loc["External damage"]</dt><dd class="col-sm-7">@YN(checklist.ExternalDamageExists)</dd>
                        <dt class="col-sm-5">@Loc["Visual cargo OK"]</dt><dd class="col-sm-7">@YN(checklist.VisualCargoAcceptable)</dd>
                        <dt class="col-sm-5">@Loc["Set / Display temp"]</dt><dd class="col-sm-7">@checklist.SetTemperature / @checklist.DisplayTemperature °C</dd>
                        <dt class="col-sm-5">@Loc["Pulp F/M/B"]</dt><dd class="col-sm-7">@checklist.PulpTempFront / @checklist.PulpTempMiddle / @checklist.PulpTempBack °C</dd>
                        <dt class="col-sm-5">@Loc["Logger serial"]</dt><dd class="col-sm-7">@(string.Join(", ", (checklist.DataLoggerSerial ?? "").Split('\n', StringSplitOptions.RemoveEmptyEntries).Select(x => x.Trim())))</dd>
                    </dl>
                </div>
            </div>
        </div>
    </div>

</div>

@* ===== Shipment ===== *@
<div class="tab-pane fade" id="tab-shipment">
    <form asp-action="SaveShipment" method="post">
        @Html.AntiForgeryToken()
        <input type="hidden" name="ArrivalId" value="@Model.ArrivalId" />
        @if (shipment != null)
        {
            <input type="hidden" name="ShipmentSnapshotId" value="@shipment.ShipmentSnapshotId" />
            <input type="hidden" name="InternalShipmentNo" value="@shipment.InternalShipmentNo" />
        }
        <div class="card">
            <div class="card-header bg-primary text-white"><i class="bi bi-truck me-1"></i>Shipment snapshot @(shipment != null ? "— " + shipment.InternalShipmentNo : "")</div>
            <div class="card-body">
                <fieldset @(anyShipmentEditable ? "" : "disabled")>
                    <div class="row g-3">
                        <div class="col-md-3"><label class="form-label">@Loc["Vessel name"]</label>
                            <input class="form-control" value="@shipment?.VesselName" disabled /></div>
                        <div class="col-md-3"><label class="form-label">@Loc["Voyage number"]</label>
                            <input class="form-control" value="@shipment?.VoyageNumber" disabled /></div>
                        <div class="col-md-3"><label class="form-label">@Loc["Loading port"]</label>
                            <input class="form-control" value="@shipment?.LoadingPort" disabled /></div>
                        <div class="col-md-3"><label class="form-label">@Loc["Country of origin"]</label>
                            <input class="form-control" value="@Countries.DisplayWithCode(shipment?.LoadingCountry)" disabled /></div>

                        @* Procurement type is SAP-owned (EKKO.BSART on the PO,
                           copied onto the arrival at creation) -- read-only here. *@
                        <div class="col-md-3"><label class="form-label">@Loc["Procurement type"]</label>
                            <input class="form-control" value="@Codes.PoTypeDisplay(Model.PoType)" disabled />
                            <small class="text-muted">@Loc["From SAP (PO type)"]</small></div>

                        @* Dates run in the order the events actually happen --
                           loading -> examination -> arrival -> discharge ->
                           pullout -> receive -> unloading -> inspection -- so
                           the row reads as the shipment's timeline and an
                           out-of-order entry is obvious. Same sequence as the
                           QC report, the QO page and the Claims page. Editable
                           and read-only fields are interleaved by date, not
                           grouped by who owns them. *@
                        <div class="col-md-3"><label class="form-label">@Loc["Loading date"]</label>
                            <input type="date" class="form-control" value="@shipment?.SailingDate?.ToString("yyyy-MM-dd")" disabled /></div>
                        <div class="col-md-3"><label class="form-label">@Loc["Examination date"]</label>
                            <input type="date" class="form-control" value="@shipment?.ExaminationDate?.ToString("yyyy-MM-dd")" disabled /></div>
                        <div class="col-md-3"><label class="form-label">@Loc["Arrival date"]</label>
                            <input type="date" class="form-control" value="@shipment?.ArrivalDate?.ToString("yyyy-MM-dd")" disabled /></div>
                        <div class="col-md-3"><label class="form-label">@Loc["Discharge date"]@(FMand("discharge_date") ? Html.Raw(" <span class='text-danger fw-bold'>*</span>") : null)</label>
                            <input name="DischargeDate" type="date" class="form-control" value="@shipment?.DischargeDate?.ToString("yyyy-MM-dd")" @FDis("discharge_date") />
                            <small class="text-muted">@Loc["Basis for the report Time Bar"]</small></div>

                        <div class="col-md-3"><label class="form-label">@Loc["Pull-out date"]@(FMand("pullout_date") ? Html.Raw(" <span class='text-danger fw-bold'>*</span>") : null)</label>
                            <input name="PullOutDate" type="date" class="form-control" value="@shipment?.PullOutDate?.ToString("yyyy-MM-dd")" @FDis("pullout_date") /></div>
                        <div class="col-md-3"><label class="form-label">@Loc["Receive date"]</label>
                            <input type="date" class="form-control" disabled
                                   value="@shipment?.ReceiveDate?.ToString("yyyy-MM-dd")" />
                            <small class="text-muted">@Loc["From SAP (Receive_Date)"]</small></div>
                        <div class="col-md-3"><label class="form-label">@Loc["Unloading date"]@(FMand("unloading_date") ? Html.Raw(" <span class='text-danger fw-bold'>*</span>") : null)</label>
                            <input name="UnloadingDate" type="date" class="form-control" value="@shipment?.UnloadingDate?.ToString("yyyy-MM-dd")" @FDis("unloading_date") /></div>
                        @* This is the ARRIVAL's own date (when the container was
                           checked in). The QC report and the Claims window show
                           the date the Quality Order was opened instead, which
                           is often days later — they are different events, not a
                           discrepancy. Labelled so nobody reconciles the two. *@
                        <div class="col-md-3"><label class="form-label">@Loc["Inspection date"]</label>
                            <input type="date" class="form-control" disabled
                                   value="@(shipment?.InspectionDate?.ToString("yyyy-MM-dd") ?? Model.CreatedAt.ToLocalTime().ToString("yyyy-MM-dd"))" />
                            <small class="text-muted">Auto — arrival check-in date. The QC report uses the date its Quality Order was opened.</small></div>

                        <div class="col-md-3"><label class="form-label">@Loc["Transit days"]</label>
                            <input type="number" class="form-control" value="@shipment?.TransitDays" disabled /></div>
                        <div class="col-md-3"><label class="form-label">@Loc["Time bar (days)"]@(FMand("time_bar") ? Html.Raw(" <span class='text-danger fw-bold'>*</span>") : null)</label>
                            <input name="TimeBar" type="number" class="form-control" value="@shipment?.TimeBar" @FDis("time_bar") /></div>
                        <div class="col-md-3"><label class="form-label">@Loc["Arrival port"]@(FMand("arrival_place") ? Html.Raw(" <span class='text-danger fw-bold'>*</span>") : null)</label>
                            <input name="ArrivalPlace" class="form-control" value="@shipment?.ArrivalPlace" @FDis("arrival_place") /></div>
                        <div class="col-md-3"><label class="form-label">@Loc["Inspection point"]@(FMand("inspection_point") ? Html.Raw(" <span class='text-danger fw-bold'>*</span>") : null)</label>
                            <input name="InspectionPoint" class="form-control" value="@shipment?.InspectionPoint" @FDis("inspection_point") /></div>

                        @* Joint Survey / Time Bar Exceeded use radios; wrap each in
                           its own fieldset so it can be locked/unlocked per policy
                           independently of the surrounding form. *@
                        <div class="col-md-4">
                            <label class="form-label d-block">@Loc["Joint Survey"]@(FMand("joint_survey") ? Html.Raw(" <span class='text-danger fw-bold'>*</span>") : null)</label>
                            <fieldset class="border-0 p-0 m-0" @FDis("joint_survey")>@Html.Raw(TriRadio("JointSurvey", shipment?.JointSurvey))</fieldset>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label d-block">@Loc["Time Bar Exceeded"]@(FMand("time_bar_exceeded") ? Html.Raw(" <span class='text-danger fw-bold'>*</span>") : null)</label>
                            <fieldset class="border-0 p-0 m-0" @FDis("time_bar_exceeded")>@Html.Raw(TriRadio("TimeBarExceeded", shipment?.TimeBarExceeded))</fieldset>
                        </div>
                    </div>
                </fieldset>
            </div>
            @if (anyShipmentEditable)
            {
                <div class="card-footer text-end">
                    <button type="submit" class="btn btn-primary"><i class="bi bi-save me-1"></i>@Loc["Save shipment details"]</button>
                    @if (!draft)
                    {
                        <span class="small text-warning ms-2"><i class="bi bi-shield-lock me-1"></i>@Loc["Editing a Completed arrival — only unlocked fields will change"]</span>
                    }
                </div>
            }
        </div>
    </form>
</div>

@* ===== Checklist — tablet-first compact single-page layout (DEFAULT TAB) ===== *@
<div class="tab-pane fade show active" id="tab-checklist">
    <style>
        /* =====================================================================
           Yes / No toggle  (segmented switch, very clear selected state).
           The two halves are color-tinted pills. The SELECTED half is solid +
           bold + raised shadow + slightly larger; the UNSELECTED half is
           faded gray. When neither is chosen, both sides are gray with a
           dashed border to signal "not answered yet".
           ===================================================================== */
        .yn-toggle {
            display: inline-flex;
            border-radius: 10px;
            overflow: hidden;
            box-shadow: 0 0 0 1px rgba(0,0,0,0.08);
            min-width: 150px;
        }
        .yn-toggle.yn-unanswered { box-shadow: 0 0 0 1px rgba(108,117,125,0.35); }
        .yn-toggle .yn-half {
            flex: 1;
            padding: 0.55rem 0.9rem;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 6px;
            font-weight: 500;
            font-size: 0.92rem;
            letter-spacing: 0.5px;
            cursor: pointer;
            user-select: none;
            transition: all 0.15s ease;
            border: 0;
            background: #f8f9fa;
            color: #adb5bd;
        }
        .yn-toggle .yn-half i  { font-size: 1.05rem; }
        .yn-toggle .yn-yes:hover { background: #e8f5ec; color: #198754; }
        .yn-toggle .yn-no:hover  { background: #fae7e9; color: #dc3545; }

        /* Selected state -- solid colored, white text, drop shadow, bold. */
        .yn-toggle .btn-check:checked + .yn-yes {
            background: linear-gradient(180deg, #198754 0%, #146c43 100%);
            color: #fff;
            font-weight: 700;
            box-shadow: inset 0 0 0 1px rgba(255,255,255,0.25),
                        0 2px 8px rgba(25,135,84,0.45);
            text-shadow: 0 1px 0 rgba(0,0,0,0.18);
        }
        .yn-toggle .btn-check:checked + .yn-no {
            background: linear-gradient(180deg, #dc3545 0%, #b02a37 100%);
            color: #fff;
            font-weight: 700;
            box-shadow: inset 0 0 0 1px rgba(255,255,255,0.25),
                        0 2px 8px rgba(220,53,69,0.45);
            text-shadow: 0 1px 0 rgba(0,0,0,0.18);
        }
        /* When one side is selected the OTHER side fades further so contrast wins. */
        .yn-toggle:not(.yn-unanswered) .yn-yes,
        .yn-toggle:not(.yn-unanswered) .yn-no { background: #f1f3f5; color: #ced4da; }
        .yn-toggle .btn-check:checked + .yn-yes,
        .yn-toggle .btn-check:checked + .yn-no { /* override fade for selected */ }

        /* Compact question/answer rows. */
        .checklist-qa td { padding: 0.45rem 0.4rem; vertical-align: middle; border: none; }
        .checklist-qa td:first-child { font-size: 0.92rem; }
        .checklist-qa tr + tr td { border-top: 1px dashed var(--theme-border, #dee2e6); }

        /* =====================================================================
           Photo Attachments tiles.  Each tile is a self-contained card with a
           camera icon, label, and integrated switch -- never overflows its
           column. Tile lights up with a green border + tinted background when
           "photo taken" is true.
           ===================================================================== */
        .photo-tile {
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 8px 12px;
            border: 2px solid #dee2e6;
            border-radius: 10px;
            background: #fafbfc;
            cursor: pointer;
            user-select: none;
            transition: all 0.15s ease;
            min-height: 56px;
            margin: 0;
        }
        .photo-tile:hover { border-color: #adb5bd; }
        .photo-tile .form-check-input {
            flex: 0 0 auto;
            width: 2.3em;
            height: 1.15em;
            margin: 0;
            cursor: pointer;
        }
        .photo-tile-icon  { font-size: 1.15rem; color: #adb5bd; flex: 0 0 auto; }
        .photo-tile-label {
            flex: 1 1 auto;
            font-size: 0.86rem;
            line-height: 1.15;
            color: #495057;
            min-width: 0;          /* allow text to wrap */
            word-break: break-word;
        }
        .photo-tile-on {
            border-color: #198754;
            background: #e8f5ec;
        }
        .photo-tile-on .photo-tile-icon  { color: #198754; }
        .photo-tile-on .photo-tile-label { color: #146c43; font-weight: 600; }
    </style>
