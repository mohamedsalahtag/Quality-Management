                                            break;
                                        case "Date":
                                            <input name="cf_@cf.FieldId" type="date" class="form-control" value="@cf.InputValue" />
                                            break;
                                        case "YesNo":
                                            <select name="cf_@cf.FieldId" class="form-select">
