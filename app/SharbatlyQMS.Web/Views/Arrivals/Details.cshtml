@section Scripts {
<script>
    // The checklist UI shows the same photo-taken flag in two places: inline in
    // its own section AND as a tick in the section-6 "Photo Attachments
    // Checklist" summary grid. The grid copies use a "Mirror" suffix on the
    // input name (e.g. DisplayTempPhotoTakenMirror) so the server only receives
    // the canonical field. This snippet keeps the UI state of each pair in sync
    // so ticking either copy reflects in the other immediately.
    document.querySelectorAll('input[name$="Mirror"]').forEach(function (mirror) {
        var base = mirror.name.replace(/Mirror$/, '');
        var primary = document.querySelector('input[name="' + base + '"]');
        if (!primary) return;
        function sync(from, to) {
            if (to.checked !== from.checked) {
                to.checked = from.checked;
                to.dispatchEvent(new Event('change', { bubbles: false }));
            }
        }
        mirror.addEventListener('change',  function () { sync(mirror, primary); });
        primary.addEventListener('change', function () { sync(primary, mirror); });
        // Mirror checkbox is purely UI -- strip its name on form submit so the
        // server never receives a duplicate value that could confuse model binding.
        var form = mirror.closest('form');
        if (form) form.addEventListener('submit', function () { mirror.removeAttribute('name'); });
    });

    // Photo tiles light up green when their switch is on. Toggle the
    // .photo-tile-on class live so the user gets immediate visual feedback.
    document.querySelectorAll('.photo-tile .form-check-input').forEach(function (cb) {
        cb.addEventListener('change', function () {
            cb.closest('.photo-tile').classList.toggle('photo-tile-on', cb.checked);
        });
    });

    // Same lift on the Yes/No toggle: remove the "unanswered" hint as soon as
    // the user picks an answer.
    document.querySelectorAll('.yn-toggle .btn-check').forEach(function (rb) {
        rb.addEventListener('change', function () {
            rb.closest('.yn-toggle').classList.remove('yn-unanswered');
        });
    });
</script>
}

