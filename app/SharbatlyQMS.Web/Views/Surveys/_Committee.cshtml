@using SharbatlyQMS.Web.Models
@using SharbatlyQMS.Web.ViewModels
@model Survey
@*
    What a CONFIRMED survey's committee does (M46): who is on it, the
    appointment, who attended, and the QC officer's confirmation that the
    shipment was inspected. Plus the survey's attachments, which exist in every
    status.

    None of this changes the survey's status. One person or team keeps it on
    behalf of the whole committee; each kind of act is its own permission, and
    the server checks every one of them again.
*@
@{
    var members      = ViewBag.Members      as IReadOnlyList<SurveyMember>      ?? Array.Empty<SurveyMember>();
    var appointments = ViewBag.Appointments as IReadOnlyList<SurveyAppointment> ?? Array.Empty<SurveyAppointment>();
    var documents    = ViewBag.Documents    as IReadOnlyList<DocumentInfo>      ?? Array.Empty<DocumentInfo>();
    var committeeConfigured = (bool?)ViewBag.CommitteeConfigured ?? false;
    var current = appointments.FirstOrDefault(a => a.IsCurrent);
    var earlier = appointments.Where(a => !a.IsCurrent).ToList();

    var confirmed            = Model.IsConfirmed;
    var canSchedule          = confirmed && Perms.Can(Perm.Surveys.Schedule);
    var canAttend            = confirmed && Perms.Can(Perm.Surveys.Attendance);
    var canConfirmAttendance = confirmed && Perms.Can(Perm.Surveys.ConfirmAttendance);
    var canConfirmInspection = confirmed && !Model.InspectionConfirmed && Perms.Can(Perm.Surveys.ConfirmInspection);
    var canAttach            = Perms.Can(Perm.Surveys.Attachments);

    string TsUtc(DateTime? d) => d.HasValue
        ? DateTime.SpecifyKind(d.Value, DateTimeKind.Utc).ToLocalTime().ToString("yyyy-MM-dd HH:mm")
        : "—";
    // Appointment and visit times are local wall-clock times, shown as typed.
    string Local(DateTime? d) => d?.ToString("yyyy-MM-dd HH:mm") ?? "—";
    string Txt(string? v) => string.IsNullOrWhiteSpace(v) ? "—" : v;
    string YN(bool? b) => b switch { true => "Yes", false => "No", _ => "Not recorded" };
    string Time(TimeSpan? t) => t.HasValue ? t.Value.ToString(@"hh\:mm") : "—";

    // The fields shared by "save appointment" and "reschedule".
    void AppointmentFields(string p, SurveyAppointment? a, bool lockWhen)
    {
        <div class="row g-2">
            <div class="col-6">
                <label class="form-label small mb-0" for="@(p)Date">@Loc["Planned date"]</label>
                <input type="date" class="form-control form-control-sm" name="PlannedDate" id="@(p)Date" required
                       value="@(a?.PlannedAt.ToString("yyyy-MM-dd"))" readonly="@lockWhen" />
            </div>
            <div class="col-6">
                <label class="form-label small mb-0" for="@(p)Time">@Loc["Planned time"]</label>
                <input type="time" class="form-control form-control-sm" name="PlannedTime" id="@(p)Time" required
                       value="@(a?.PlannedAt.ToString("HH:mm"))" readonly="@lockWhen" />
            </div>
            @if (lockWhen)
            {
                <div class="col-12 small text-muted">@Loc["The schedule is confirmed. To change the date or time, use Reschedule."]</div>
            }
            <div class="col-12">
                <label class="form-label small mb-0" for="@(p)Location">@Loc["Survey location"]</label>
                <input class="form-control form-control-sm" name="Location" id="@(p)Location" maxlength="200" value="@a?.Location" />
            </div>
            <div class="col-6">
                <label class="form-label small mb-0" for="@(p)Company">@Loc["Survey company"]</label>
                <input class="form-control form-control-sm" name="SurveyCompany" id="@(p)Company" maxlength="120" value="@a?.SurveyCompany" />
            </div>
            <div class="col-6">
                <label class="form-label small mb-0" for="@(p)Surveyor">@Loc["Surveyor name"]</label>
                <input class="form-control form-control-sm" name="SurveyorName" id="@(p)Surveyor" maxlength="120" value="@a?.SurveyorName" />
            </div>
            <div class="col-6">
                <label class="form-label small mb-0" for="@(p)Phone">@Loc["Surveyor telephone"]</label>
                <input class="form-control form-control-sm" name="SurveyorPhone" id="@(p)Phone" maxlength="40" value="@a?.SurveyorPhone" />
            </div>
            <div class="col-6">
                <label class="form-label small mb-0" for="@(p)Email">@Loc["Surveyor e-mail"]</label>
                <input type="email" class="form-control form-control-sm" name="SurveyorEmail" id="@(p)Email" maxlength="256" value="@a?.SurveyorEmail" />
            </div>
            <div class="col-12">
                <label class="form-label small mb-0" for="@(p)Ref">@Loc["Insurance reference"]</label>
                <input class="form-control form-control-sm" name="InsuranceRef" id="@(p)Ref" maxlength="80" value="@a?.InsuranceRef" />
            </div>
            <div class="col-12">
                <label class="form-label small mb-0" for="@(p)Instructions">@Loc["Instructions for the participants"]</label>
                <textarea class="form-control form-control-sm" name="Instructions" id="@(p)Instructions" rows="2" maxlength="1000">@a?.Instructions</textarea>
                <div class="form-text">@Loc["Sent with the appointment, including to external participants."]</div>
            </div>
            <div class="col-12">
                <label class="form-label small mb-0" for="@(p)Internal">@Loc["Internal comments"]</label>
                <textarea class="form-control form-control-sm" name="InternalComments" id="@(p)Internal" rows="2" maxlength="1000">@a?.InternalComments</textarea>
                <div class="form-text">@Loc["Never sent to anyone."]</div>
            </div>
        </div>
    }
}

@if (!confirmed)
{
    <div class="col-12">
        <div class="card card-body text-muted small">
            <span><i class="bi bi-people me-1"></i>
                @(Model.IsOpen
                    ? Loc["The committee, the appointment, attendance and the inspection confirmation start once this survey is confirmed."]
                    : Loc["This survey was passed, so there is no committee activity."])
            </span>
        </div>
    </div>
}
else
{
    @* ---------------- Committee ---------------- *@
    <div class="col-12" id="committee">
        <div class="card">
            <div class="card-header fw-semibold d-flex justify-content-between align-items-center">
                <span><i class="bi bi-people me-1"></i>@Loc["Committee"]</span>
                @if (Model.CommitteeId.HasValue)
                {
                    <span class="small fw-normal text-muted">@Model.CommitteeName · @Loc["assigned"] @TsUtc(Model.CommitteeAssignedAt) @Loc["by"] @Model.CommitteeAssignedBy</span>
                }
            </div>
            @if (!Model.CommitteeId.HasValue)
            {
                <div class="card-body">
                    <div class="alert alert-warning mb-0 d-flex align-items-start">
                        <i class="bi bi-exclamation-triangle-fill me-2 mt-1"></i>
                        <div class="flex-grow-1">
                            <strong>@Loc["No committee is assigned to this survey"]</strong>
                            <div class="small mt-1">
                                @(committeeConfigured
                                    ? Loc["None was set up for this branch when the survey was confirmed. One is set up now and can be assigned."]
                                    : Loc["No committee is set up for this branch, and there is no default committee. The survey and the QC process carry on; set a committee up under Parameters, Survey committees, then assign it here."])
                            </div>
                            @if (Perms.CanView(Screens.SurveyCommittees))
                            {
                                <a asp-controller="SurveyCommittees" asp-action="Index" class="small">@Loc["Open Survey committees"]</a>
                            }
                        </div>
                        @if (committeeConfigured && canSchedule)
                        {
                            <form asp-action="AssignCommittee" asp-route-id="@Model.SurveyId" method="post" class="ms-3">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-sm btn-warning">@Loc["Assign committee"]</button>
                            </form>
                        }
                    </div>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-sm align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>@Loc["Member"]</th><th>@Loc["Type"]</th><th>@Loc["Role on the committee"]</th>
                                <th>@Loc["Department / organisation"]</th><th>@Loc["E-mail"]</th><th>@Loc["Phone"]</th>
                                <th class="text-center">@Loc["Expected to attend"]</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (members.Count == 0)
                            {
                                <tr><td colspan="7" class="text-muted text-center py-3">@Loc["The committee had no active members when it was assigned."]</td></tr>
                            }
                            @foreach (var m in members)
                            {
                                <tr>
                                    <td>@m.MemberName</td>
                                    <td>@Loc[m.IsInternal ? "Internal" : "External"]</td>
                                    <td>@Loc[CommitteeRole.Label(m.CommitteeRole)]</td>
                                    <td>@Txt(m.IsInternal ? m.Department : m.Organisation)</td>
                                    <td>@Txt(m.Email)</td>
                                    <td>@Txt(m.Phone)</td>
                                    <td class="text-center">@(m.ExpectedAttendance ? "✓" : "")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                <div class="card-footer small text-muted">@Loc["This is the committee as it was when the survey was confirmed. Later changes to the committee setup do not alter it."]</div>
            }
        </div>
    </div>

    @* ---------------- Appointment ---------------- *@
    <div class="col-lg-6" id="appointment">
        <div class="card h-100">
            <div class="card-header fw-semibold d-flex justify-content-between align-items-center">
                <span><i class="bi bi-calendar-event me-1"></i>@Loc["Survey appointment"]</span>
                @if (current != null)
                {
                    <span class="badge @(current.ScheduleConfirmed ? "bg-success" : "bg-warning text-dark")">
                        @Loc[current.ScheduleConfirmed ? "Schedule confirmed" : "Not confirmed — participants not told yet"]
                    </span>
                }
            </div>
            <div class="card-body">
                @if (current == null)
                {
                    <p class="text-muted mb-2">@Loc["No appointment has been made yet."]</p>
                }
                else
                {
                    <dl class="row srv-dl mb-2">
                        <dt class="col-sm-4">@Loc["Planned for"]</dt><dd class="col-sm-8 fw-semibold">@Local(current.PlannedAt)</dd>
                        <dt class="col-sm-4">@Loc["Location"]</dt><dd class="col-sm-8">@Txt(current.Location)</dd>
                        <dt class="col-sm-4">@Loc["Survey company"]</dt><dd class="col-sm-8">@Txt(current.SurveyCompany)</dd>
                        <dt class="col-sm-4">@Loc["Surveyor"]</dt>
                        <dd class="col-sm-8">@Txt(current.SurveyorName) <span class="text-muted">@current.SurveyorPhone @current.SurveyorEmail</span></dd>
                        <dt class="col-sm-4">@Loc["Insurance reference"]</dt><dd class="col-sm-8">@Txt(current.InsuranceRef)</dd>
                        <dt class="col-sm-4">@Loc["Instructions"]</dt><dd class="col-sm-8 srv-pre">@Txt(current.Instructions)</dd>
                        <dt class="col-sm-4">@Loc["Internal comments"]</dt><dd class="col-sm-8 srv-pre">@Txt(current.InternalComments)</dd>
                        @if (current.ScheduleConfirmed)
                        {
                            <dt class="col-sm-4">@Loc["Confirmed"]</dt><dd class="col-sm-8">@TsUtc(current.ScheduleConfirmedAt) @Loc["by"] @current.ScheduleConfirmedBy</dd>
                        }
                    </dl>
                }
                @if (canSchedule)
                {
                    <div class="d-flex gap-2 flex-wrap">
                        @if (current == null || !current.AttendanceEntered)
                        {
                            <button type="button" class="btn btn-sm btn-outline-primary" data-bs-toggle="modal" data-bs-target="#appointmentModal">
                                <i class="bi bi-pencil me-1"></i>@Loc[current == null ? "Schedule" : "Edit"]
                            </button>
                        }
                        @if (current != null && !current.ScheduleConfirmed)
                        {
                            <form asp-action="ConfirmSchedule" asp-route-id="@Model.SurveyId" method="post"
                                  data-confirm="@Loc["Confirm this schedule? The committee members and the surveyor will be notified."]"
                                  data-confirm-title="@Loc["Confirm schedule"]" data-confirm-ok="@Loc["Confirm"]">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-sm btn-success"><i class="bi bi-check2 me-1"></i>@Loc["Confirm schedule"]</button>
                            </form>
                        }
                        @if (current != null && (current.ScheduleConfirmed || current.AttendanceEntered))
                        {
                            <button type="button" class="btn btn-sm btn-outline-secondary" data-bs-toggle="modal" data-bs-target="#rescheduleModal">
                                <i class="bi bi-arrow-repeat me-1"></i>@Loc["Reschedule"]
                            </button>
                        }
                    </div>
                }
                @if (earlier.Count > 0)
                {
                    <div class="small fw-semibold mt-3 mb-1">@Loc["Earlier appointments"]</div>
                    <ul class="list-unstyled small mb-0">
                        @foreach (var a in earlier)
                        {
                            <li class="mb-1">
                                @Local(a.PlannedAt) · @Txt(a.Location) ·
                                @Loc["surveyor attended"]: @Loc[YN(a.SurveyorAttended)]
                                <div class="text-muted">@Loc["Replaced"] @TsUtc(a.SupersededAt) @Loc["by"] @a.SupersededBy: @a.SupersedeReason</div>
                            </li>
                        }
                    </ul>
                }
            </div>
        </div>
    </div>

    @* ---------------- Attendance ---------------- *@
    <div class="col-lg-6" id="attendance">
        <div class="card h-100">
            <div class="card-header fw-semibold d-flex justify-content-between align-items-center">
                <span><i class="bi bi-person-check me-1"></i>@Loc["Committee attendance"]</span>
                @if (current is { AttendanceConfirmed: true })
                {
                    <span class="badge bg-success">@Loc["Confirmed"]</span>
                }
                else if (current is { AttendanceEntered: true })
                {
                    <span class="badge bg-warning text-dark">@Loc["Recorded, not confirmed"]</span>
                }
            </div>
            <div class="card-body">
                @if (current == null)
                {
                    <p class="text-muted mb-0">@Loc["Schedule an appointment first. Attendance is recorded against it."]</p>
                }
                else
                {
                    @if (current.SurveyorAttended == false)
                    {
                        <div class="alert alert-warning py-2 small">
                            <i class="bi bi-exclamation-triangle me-1"></i>@Loc["The surveyor did not attend this appointment. Reschedule the survey to plan another visit."]
                        </div>
                    }
                    @if (canAttend && !current.AttendanceConfirmed)
                    {
                        <form asp-action="SaveAttendance" asp-route-id="@Model.SurveyId" method="post">
                            @Html.AntiForgeryToken()
                            <div class="row g-2 mb-2">
                                <div class="col-6">
                                    <label class="form-label small mb-0" for="attDate">@Loc["Actual date"]</label>
                                    <input type="date" class="form-control form-control-sm" name="ActualDate" id="attDate" required
                                           value="@((current.ActualAt ?? current.PlannedAt).ToString("yyyy-MM-dd"))" />
                                </div>
                                <div class="col-6">
                                    <label class="form-label small mb-0" for="attTime">@Loc["Actual time"]</label>
                                    <input type="time" class="form-control form-control-sm" name="ActualTime" id="attTime" required
                                           value="@((current.ActualAt ?? current.PlannedAt).ToString("HH:mm"))" />
                                </div>
                                <div class="col-12">
                                    <label class="form-label small mb-0" for="attLocation">@Loc["Actual location"]</label>
                                    <input class="form-control form-control-sm" name="ActualLocation" id="attLocation" maxlength="200"
                                           value="@(current.ActualLocation ?? current.Location)" />
                                </div>
                                <div class="col-6">
                                    <label class="form-label small mb-0 d-block">@Loc["Did the surveyor attend?"]</label>
                                    <div class="btn-group btn-group-sm" role="group">
                                        <input type="radio" class="btn-check" name="SurveyorAttended" id="attSurveyorY" value="true" required checked="@(current.SurveyorAttended == true)" />
                                        <label class="btn btn-outline-success" for="attSurveyorY">@Loc["Yes"]</label>
                                        <input type="radio" class="btn-check" name="SurveyorAttended" id="attSurveyorN" value="false" required checked="@(current.SurveyorAttended == false)" />
                                        <label class="btn btn-outline-danger" for="attSurveyorN">@Loc["No"]</label>
                                    </div>
                                </div>
                                <div class="col-6">
                                    <label class="form-label small mb-0" for="attSurveyor">@Loc["Surveyor who came"]</label>
                                    <input class="form-control form-control-sm" name="ActualSurveyorName" id="attSurveyor" maxlength="120"
                                           value="@(current.ActualSurveyorName ?? current.SurveyorName)" />
                                </div>
                            </div>

                            @if (members.Count > 0)
                            {
                                <div class="table-responsive">
                                    <table class="table table-sm align-middle mb-2">
                                        <thead class="table-light">
                                            <tr><th>@Loc["Member"]</th><th>@Loc["Role"]</th><th>@Loc["Attendance"]</th><th>@Loc["Comment"]</th></tr>
                                        </thead>
                                        <tbody>
                                            @for (var i = 0; i < members.Count; i++)
                                            {
                                                var m = members[i];
                                                <tr>
                                                    <td>
                                                        <input type="hidden" name="Members[@i].SurveyMemberId" value="@m.SurveyMemberId" />
                                                        @m.MemberName
                                                        <div class="small text-muted">
                                                            @Loc[m.IsInternal ? "Internal" : "External"]@(m.ExpectedAttendance ? "" : " · " + Loc["not expected"])
                                                        </div>
                                                    </td>
                                                    <td>@Loc[CommitteeRole.Label(m.CommitteeRole)]</td>
                                                    <td class="text-nowrap">
                                                        @* Three answers on purpose: "not recorded" is not "absent". *@
                                                        <div class="btn-group btn-group-sm" role="group">
                                                            <input type="radio" class="btn-check" name="Members[@i].Attended" id="att@(i)y" value="true" checked="@(m.Attended == true)" />
                                                            <label class="btn btn-outline-success" for="att@(i)y">@Loc["Present"]</label>
                                                            <input type="radio" class="btn-check" name="Members[@i].Attended" id="att@(i)n" value="false" checked="@(m.Attended == false)" />
                                                            <label class="btn btn-outline-danger" for="att@(i)n">@Loc["Absent"]</label>
                                                            <input type="radio" class="btn-check" name="Members[@i].Attended" id="att@(i)u" value="" checked="@(m.Attended == null)" />
                                                            <label class="btn btn-outline-secondary" for="att@(i)u">@Loc["Not recorded"]</label>
                                                        </div>
                                                    </td>
                                                    <td><input class="form-control form-control-sm" name="Members[@i].Comments" maxlength="500" value="@m.AttendanceComments" /></td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            }
                            <div class="mb-2">
                                <label class="form-label small mb-0" for="attDetails">@Loc["Additional attendance details"]</label>
                                <textarea class="form-control form-control-sm" name="AttendanceDetails" id="attDetails" rows="2" maxlength="1000">@current.AttendanceDetails</textarea>
                            </div>
                            <div class="mb-2">
                                <label class="form-label small mb-0" for="attComments">@Loc["Comments"]</label>
                                <textarea class="form-control form-control-sm" name="AttendanceComments" id="attComments" rows="2" maxlength="1000">@current.AttendanceComments</textarea>
                            </div>
                            <button type="submit" class="btn btn-sm btn-primary"><i class="bi bi-save me-1"></i>@Loc["Save attendance"]</button>
                        </form>
                    }
                    else if (current.AttendanceEntered)
                    {
                        <dl class="row srv-dl mb-2">
                            <dt class="col-sm-5">@Loc["Actual date and time"]</dt><dd class="col-sm-7">@Local(current.ActualAt)</dd>
                            <dt class="col-sm-5">@Loc["Actual location"]</dt><dd class="col-sm-7">@Txt(current.ActualLocation)</dd>
                            <dt class="col-sm-5">@Loc["Surveyor attended"]</dt><dd class="col-sm-7">@Loc[YN(current.SurveyorAttended)]</dd>
                            <dt class="col-sm-5">@Loc["Surveyor who came"]</dt><dd class="col-sm-7">@Txt(current.ActualSurveyorName)</dd>
                            <dt class="col-sm-5">@Loc["Details"]</dt><dd class="col-sm-7 srv-pre">@Txt(current.AttendanceDetails)</dd>
                            <dt class="col-sm-5">@Loc["Comments"]</dt><dd class="col-sm-7 srv-pre">@Txt(current.AttendanceComments)</dd>
                        </dl>
                        @if (members.Count > 0)
                        {
                            <table class="table table-sm mb-2">
                                <thead class="table-light"><tr><th>@Loc["Member"]</th><th>@Loc["Role"]</th><th>@Loc["Attendance"]</th><th>@Loc["Comment"]</th></tr></thead>
                                <tbody>
                                    @foreach (var m in members)
                                    {
                                        <tr>
                                            <td>@m.MemberName</td>
                                            <td>@Loc[CommitteeRole.Label(m.CommitteeRole)]</td>
                                            <td>
                                                <span class="badge @(m.Attended == true ? "bg-success" : m.Attended == false ? "bg-danger" : "bg-secondary")">
                                                    @Loc[m.Attended == true ? "Present" : m.Attended == false ? "Absent" : "Not recorded"]
                                                </span>
                                            </td>
                                            <td>@m.AttendanceComments</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        }
                    }
                    else
                    {
                        <p class="text-muted mb-0">@Loc["Attendance has not been recorded for this appointment."]</p>
                    }

                    @if (current.AttendanceEntered)
                    {
                        <div class="small text-muted mt-2">
                            @Loc["Recorded"] @TsUtc(current.AttendanceEnteredAt) @Loc["by"] @current.AttendanceEnteredBy
                            @if (current.AttendanceConfirmed)
                            {
                                <span>· @Loc["confirmed"] @TsUtc(current.AttendanceConfirmedAt) @Loc["by"] @current.AttendanceConfirmedBy</span>
                            }
                        </div>
                        @if (canConfirmAttendance && !current.AttendanceConfirmed)
                        {
                            <form asp-action="ConfirmAttendance" asp-route-id="@Model.SurveyId" method="post" class="mt-2"
                                  data-confirm="@Loc["Confirm this attendance record? It cannot be changed afterwards."]"
                                  data-confirm-title="@Loc["Confirm attendance"]" data-confirm-ok="@Loc["Confirm"]">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-sm btn-success"><i class="bi bi-check2-all me-1"></i>@Loc["Confirm attendance"]</button>
                            </form>
                        }
                    }
                }
            </div>
        </div>
    </div>

    @* ---------------- QC officer: the inspection happened ---------------- *@
    <div class="col-12" id="inspection">
        <div class="card">
            <div class="card-header fw-semibold d-flex justify-content-between align-items-center">
                <span><i class="bi bi-search me-1"></i>@Loc["Survey inspection"]</span>
                <span class="badge @(Model.InspectionConfirmed ? "bg-success" : "bg-secondary")">
                    @Loc[Model.InspectionConfirmed ? "Inspection conducted — confirmed" : "Not confirmed yet"]
                </span>
            </div>
            <div class="card-body">
                @if (Model.InspectionConfirmed)
                {
                    <dl class="row srv-dl mb-0">
                        <dt class="col-sm-3">@Loc["Surveyor attended"]</dt><dd class="col-sm-9">@Loc[YN(Model.SurveyorAttended)]</dd>
                        <dt class="col-sm-3">@Loc["Shipment inspected"]</dt><dd class="col-sm-9">@Loc[YN(Model.ShipmentInspected)]</dd>
                        <dt class="col-sm-3">@Loc["Inspection date"]</dt>
                        <dd class="col-sm-9">@(Model.InspectionDate?.ToString("yyyy-MM-dd") ?? "—"), @Time(Model.InspectionStartTime)@(Model.InspectionEndTime.HasValue ? " – " + Time(Model.InspectionEndTime) : "")</dd>
                        <dt class="col-sm-3">@Loc["QC officer's observations"]</dt><dd class="col-sm-9 srv-pre">@Txt(Model.InspectionObservations)</dd>
                        <dt class="col-sm-3">@Loc["Inspection findings"]</dt><dd class="col-sm-9 srv-pre">@Txt(Model.InspectionFindings)</dd>
                        <dt class="col-sm-3">@Loc["Additional damage"]</dt><dd class="col-sm-9 srv-pre">@Txt(Model.InspectionDamage)</dd>
                        <dt class="col-sm-3">@Loc["Comments"]</dt><dd class="col-sm-9 srv-pre">@Txt(Model.InspectionComments)</dd>
                        <dt class="col-sm-3">@Loc["Confirmed"]</dt><dd class="col-sm-9">@TsUtc(Model.InspectionConfirmedAt) @Loc["by"] @Model.InspectionConfirmedBy</dd>
                    </dl>
                }
                else if (canConfirmInspection)
                {
                    <p class="small text-muted">
                        @Loc["The QC officer confirms here that the surveyor attended and really inspected the shipment. It does not approve the claim, it does not change the survey's status, and it cannot be changed afterwards."]
                    </p>
                    <form asp-action="ConfirmInspection" asp-route-id="@Model.SurveyId" method="post"
                          data-confirm="@Loc["Confirm that the surveyor inspected this shipment? This cannot be changed afterwards."]"
                          data-confirm-title="@Loc["Confirm survey inspection"]" data-confirm-ok="@Loc["Confirm"]">
                        @Html.AntiForgeryToken()
                        <div class="row g-2 mb-2">
                            <div class="col-md-3">
                                <label class="form-label small mb-0 d-block">@Loc["Surveyor attended"]</label>
                                <div class="btn-group btn-group-sm" role="group">
                                    <input type="radio" class="btn-check" name="SurveyorAttended" id="insAttY" value="true" required />
                                    <label class="btn btn-outline-success" for="insAttY">@Loc["Yes"]</label>
                                    <input type="radio" class="btn-check" name="SurveyorAttended" id="insAttN" value="false" required />
                                    <label class="btn btn-outline-danger" for="insAttN">@Loc["No"]</label>
                                </div>
                            </div>
                            <div class="col-md-3">
                                <label class="form-label small mb-0 d-block">@Loc["Shipment inspected"]</label>
                                <div class="btn-group btn-group-sm" role="group">
                                    <input type="radio" class="btn-check" name="ShipmentInspected" id="insDoneY" value="true" required />
                                    <label class="btn btn-outline-success" for="insDoneY">@Loc["Yes"]</label>
                                    <input type="radio" class="btn-check" name="ShipmentInspected" id="insDoneN" value="false" required />
                                    <label class="btn btn-outline-danger" for="insDoneN">@Loc["No"]</label>
                                </div>
                            </div>
                            <div class="col-md-2">
                                <label class="form-label small mb-0" for="insDate">@Loc["Inspection date"]</label>
                                <input type="date" class="form-control form-control-sm" name="InspectionDate" id="insDate" required
                                       value="@((current?.ActualAt ?? current?.PlannedAt)?.ToString("yyyy-MM-dd"))" />
                            </div>
                            <div class="col-md-2">
                                <label class="form-label small mb-0" for="insStart">@Loc["Start time"]</label>
                                <input type="time" class="form-control form-control-sm" name="StartTime" id="insStart" required
                                       value="@((current?.ActualAt ?? current?.PlannedAt)?.ToString("HH:mm"))" />
                            </div>
                            <div class="col-md-2">
                                <label class="form-label small mb-0" for="insEnd">@Loc["End time (optional)"]</label>
                                <input type="time" class="form-control form-control-sm" name="EndTime" id="insEnd" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label small mb-0" for="insObs">@Loc["QC officer's observations"]</label>
                                <textarea class="form-control form-control-sm" name="Observations" id="insObs" rows="2" maxlength="2000"></textarea>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label small mb-0" for="insFind">@Loc["Inspection findings"]</label>
                                <textarea class="form-control form-control-sm" name="Findings" id="insFind" rows="2" maxlength="2000"></textarea>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label small mb-0" for="insDamage">@Loc["Additional damage details"]</label>
                                <textarea class="form-control form-control-sm" name="Damage" id="insDamage" rows="2" maxlength="2000"></textarea>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label small mb-0" for="insComments">@Loc["Additional comments"]</label>
                                <textarea class="form-control form-control-sm" name="Comments" id="insComments" rows="2" maxlength="2000"></textarea>
                            </div>
                        </div>
                        <button type="submit" class="btn btn-sm btn-success"><i class="bi bi-check2-circle me-1"></i>@Loc["Confirm survey inspection"]</button>
                        <span class="small text-muted ms-2">@Loc["Photographs and the surveyor's report go under Attachments."]</span>
                    </form>
                }
                else
                {
                    <p class="text-muted mb-0">@Loc["The QC officer has not yet confirmed that the surveyor inspected the shipment."]</p>
                }
            </div>
        </div>
    </div>
}

@* ---------------- Attachments (every status) ---------------- *@
<div class="col-12" id="attachments">
    <div class="card">
        <div class="card-header fw-semibold"><i class="bi bi-paperclip me-1"></i>@Loc["Attachments"] <span class="badge bg-light text-dark border ms-1">@documents.Count</span></div>
        @if (documents.Count > 0)
        {
            <div class="table-responsive">
                <table class="table table-sm align-middle mb-0">
                    <thead class="table-light">
                        <tr><th>@Loc["File"]</th><th>@Loc["Kind"]</th><th>@Loc["Size"]</th><th>@Loc["Added"]</th><th></th></tr>
                    </thead>
                    <tbody>
                        @foreach (var d in documents)
                        {
                            var ext = System.IO.Path.GetExtension(d.OriginalName ?? "").ToLowerInvariant();
                            var viewable = ext == ".pdf" || DocumentService.SurveyImageExtensions.Contains(ext);
                            <tr>
                                <td>
                                    <a asp-action="Document" asp-route-id="@Model.SurveyId" asp-route-documentId="@d.DocumentId">@d.OriginalName</a>
                                    @if (viewable)
                                    {
                                        <a asp-action="Document" asp-route-id="@Model.SurveyId" asp-route-documentId="@d.DocumentId" asp-route-inline="true"
                                           target="_blank" class="ms-2 small" title="@Loc["Open in a new tab"]"><i class="bi bi-eye"></i></a>
                                    }
                                </td>
                                <td>@Loc[SurveyDocCategory.Label(d.Category)]</td>
                                <td class="text-nowrap">@DocumentDisplay.FormatBytes(d.FileSizeBytes)</td>
                                <td class="text-nowrap small">@TsUtc(d.UploadedAt) · @d.UploadedBy</td>
                                <td class="text-end">
                                    @if (canAttach)
                                    {
                                        <form asp-action="DeleteDocument" asp-route-id="@Model.SurveyId" method="post" class="d-inline"
                                              data-confirm="@Loc["Remove this attachment?"]" data-confirm-title="@Loc["Remove attachment"]"
                                              data-confirm-ok="@Loc["Remove"]" data-confirm-danger>
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="documentId" value="@d.DocumentId" />
                                            <button type="submit" class="btn btn-sm btn-outline-danger"><i class="bi bi-trash"></i></button>
                                        </form>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        <div class="card-body">
            @if (documents.Count == 0)
            {
                <p class="text-muted mb-2">@Loc["Nothing attached yet."]</p>
            }
            @if (canAttach)
            {
                <form asp-action="UploadDocument" asp-route-id="@Model.SurveyId" method="post" enctype="multipart/form-data" class="row g-2 align-items-end">
                    @Html.AntiForgeryToken()
                    <div class="col-md-3">
                        <label class="form-label small mb-0" for="docCategory">@Loc["Kind"]</label>
                        <select class="form-select form-select-sm" name="category" id="docCategory">
                            @foreach (var c in SurveyDocCategory.All)
                            {
                                <option value="@c.Code">@Loc[c.Label]</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label small mb-0" for="docFiles">@Loc["Files"]</label>
                        <input type="file" class="form-control form-control-sm" name="files" id="docFiles" multiple required
                               accept=".pdf,.doc,.docx,.xls,.xlsx,.csv,.txt,.msg,.eml,.zip,.jpg,.jpeg,.png,.gif,.bmp,.webp" />
                    </div>
                    <div class="col-md-3">
                        <button type="submit" class="btn btn-sm btn-primary"><i class="bi bi-upload me-1"></i>@Loc["Attach"]</button>
                    </div>
                </form>
            }
            <div class="small text-muted mt-2">
                <i class="bi bi-eye-slash me-1"></i>@Loc["Survey attachments are internal. They are never printed on the QC report and are not offered when a report is e-mailed to a supplier."]
            </div>
        </div>
    </div>
</div>

@if (canSchedule)
{
    <div class="modal fade" id="appointmentModal" tabindex="-1">
        <div class="modal-dialog">
            <form asp-action="SaveAppointment" asp-route-id="@Model.SurveyId" method="post" class="modal-content">
                @Html.AntiForgeryToken()
                <div class="modal-header">
                    <h5 class="modal-title"><i class="bi bi-calendar-event me-1"></i>@Loc["Survey appointment"]</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    @{ AppointmentFields("ap", current, current is { ScheduleConfirmed: true }); }
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">@Loc["Cancel"]</button>
                    <button type="submit" class="btn btn-primary">@Loc["Save"]</button>
                </div>
            </form>
        </div>
    </div>

    @if (current != null)
    {
        <div class="modal fade" id="rescheduleModal" tabindex="-1">
            <div class="modal-dialog">
                <form asp-action="Reschedule" asp-route-id="@Model.SurveyId" method="post" class="modal-content">
                    @Html.AntiForgeryToken()
                    <div class="modal-header">
                        <h5 class="modal-title"><i class="bi bi-arrow-repeat me-1"></i>@Loc["Reschedule the survey"]</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                    </div>
                    <div class="modal-body">
                        <p class="small text-muted">@Loc["The present appointment is kept as history, with whatever attendance was recorded. The participants are told about the new one at once."]</p>
                        <div class="mb-2">
                            <label class="form-label small mb-0" for="rsReason">@Loc["Why is it being rescheduled? (required)"]</label>
                            <textarea class="form-control form-control-sm" name="reason" id="rsReason" rows="2" required minlength="5" maxlength="500"></textarea>
                        </div>
                        @{ AppointmentFields("rs", current, false); }
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">@Loc["Cancel"]</button>
                        <button type="submit" class="btn btn-primary">@Loc["Reschedule"]</button>
                    </div>
                </form>
            </div>
        </div>
    }
}
