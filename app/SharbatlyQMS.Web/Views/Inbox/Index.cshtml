@model IReadOnlyList<NotificationRow>
@{
    ViewData["Title"] = Loc["Notifications"];
    string TsUtc(DateTime d) => DateTime.SpecifyKind(d, DateTimeKind.Utc).ToLocalTime().ToString("yyyy-MM-dd HH:mm");
    var unread = Model.Count(r => r.IsUnread);
}
<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0"><i class="bi bi-bell me-1"></i>@Loc["Notifications"]</h1>
    @if (unread > 0)
    {
        <form asp-action="MarkAllRead" method="post">
            @Html.AntiForgeryToken()
            <button type="submit" class="btn btn-outline-secondary"><i class="bi bi-check2-all me-1"></i>@Loc["Mark all as read"]</button>
        </form>
    }
</div>

<div class="card">
    @if (Model.Count == 0)
    {
        <div class="card-body text-muted">@Loc["You have no notifications."]</div>
    }
    else
    {
        <div class="list-group list-group-flush">
            @foreach (var r in Model)
            {
                <a asp-action="Open" asp-route-id="@r.NotificationId"
                   class="list-group-item list-group-item-action @(r.IsUnread ? "" : "text-muted")">
                    <div class="d-flex justify-content-between gap-3">
                        <span class="@(r.IsUnread ? "fw-semibold" : "")">
                            @if (r.IsUnread) { <span class="badge bg-danger me-1" title="@Loc["Unread"]">&nbsp;</span> }
                            @r.Title
                        </span>
                        <span class="small text-muted text-nowrap">@TsUtc(r.CreatedAt)</span>
                    </div>
                    @if (!string.IsNullOrWhiteSpace(r.Body))
                    {
                        <div class="small">@r.Body</div>
                    }
                </a>
            }
        </div>
    }
</div>
<p class="text-muted small mt-2 mb-0">@Loc["The newest 200 are shown. Opening a notification marks it as read."]</p>
