@using System.Text.Json
@using SharbatlyQMS.Web.Models
@using SharbatlyQMS.Web.ViewModels
@model DashboardVm
@{
    ViewData["Title"] = "Dashboard";
    var role     = User?.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value;
    var fullName = User?.FindFirst(System.Security.Claims.ClaimTypes.GivenName)?.Value;

    // Status badges: every bg-* is paired with an explicit text-* utility so
    // dark-theme contrast holds. Without it the global theme can recolor
    // body text to white-on-yellow / dark-on-dark.
    string ArrivalBadge(string s) => s switch
    {
        ArrivalStatus.Draft     => "bg-warning text-dark",
        ArrivalStatus.Completed => "bg-success text-white",
        ArrivalStatus.Cancelled => "bg-secondary text-white",
        _ => "bg-light text-dark"
    };
    string QoBadge(string s) => s switch
    {
        "Initial"  => "bg-secondary text-white",
        "Open"     => "bg-primary text-white",
        "Reopened" => "bg-warning text-dark",
        "Closed"   => "bg-success text-white",
        "Cancelled"=> "bg-danger text-white",
        _          => "bg-light text-dark"
    };

    var avgDefect = Model.AvgDefectPctLast30;
    string DefectTone() => avgDefect == null
        ? ""
        : (avgDefect > Model.Thresholds.DefectPctRed    ? "text-danger"
        : (avgDefect > Model.Thresholds.DefectPctYellow ? "text-warning"
        :  "text-success"));

    // JSON payload consumed by dashboard.js. Camel-cased so the JS reads
    // `trend`, `qoByStatus`, `avgDefectPct`, `thresholds`,
    // `throughput`, `openQoAge`, `defectByGroup`.
    var payload = new
    {
        trend         = Model.ArrivalsTrend,
        qoByStatus    = Model.QoByStatus,
        avgDefectPct  = Model.AvgDefectPctLast30,
        thresholds    = Model.Thresholds,
        throughput    = Model.ThroughputTrend,
        openQoAge     = Model.OpenQoAgeBuckets,
        defectByGroup = Model.DefectByGroup
    };
    var payloadJson = JsonSerializer.Serialize(payload);
}

<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
    <div>
        <h1 class="h3 mb-1">Welcome, @fullName</h1>
        <p class="text-muted mb-0">Sharbatly Quality Management System</p>
    </div>
    <span class="badge bg-secondary fs-6">@role</span>
</div>

@* ---- SAP sync failure warning (admins only) ---- *@
@if (Model.IsAdmin && Model.SyncFailures.Any())
{
    <div class="alert alert-warning d-flex align-items-start" role="alert">
        <i class="bi bi-exclamation-triangle-fill me-2 mt-1"></i>
        <div>
            <strong>SAP sync needs attention.</strong>
            The most recent sync failed for:
            @foreach (var sf in Model.SyncFailures)
            {
                <div class="small">
                    <span class="fw-semibold">@sf.EndpointKey</span>
                    @if (sf.CompletedAt.HasValue) { <text>— @sf.CompletedAt.Value.ToLocalTime().ToString("g")</text> }
                    @if (!string.IsNullOrWhiteSpace(sf.Message)) { <text>: @(sf.Message!.Length > 160 ? sf.Message[..160] + "…" : sf.Message)</text> }
                </div>
            }
            <div class="small mt-1">Open <a asp-controller="Admin" asp-action="Settings" asp-route-activeTab="sap">Site Configuration → SAP</a> to retry.</div>
        </div>
    </div>
}

@* ---- KPI tiles ---- *@
<div class="row g-3 mb-3">
    <div class="col-6 col-md-4 col-xl-2">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body py-3">
                <div class="text-muted small text-uppercase fw-semibold mb-1">
                    <i class="bi bi-pencil-square text-primary me-1"></i>Arrivals in Draft
                </div>
                <div class="fs-2 fw-semibold lh-1">@Model.Counts.ArrivalsDraft</div>
                <div class="text-muted small mt-1">Awaiting checklist completion</div>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-4 col-xl-2">
        <a asp-controller="Arrivals" asp-action="Pending" class="text-decoration-none">
        <div class="card border-0 shadow-sm h-100 @(Model.Counts.PendingContainers > 0 ? "border-start border-4 border-danger" : "")">
            <div class="card-body py-3">
                <div class="text-muted small text-uppercase fw-semibold mb-1">
                    <i class="bi bi-inbox text-danger me-1"></i>Containers without Arrival
                </div>
                <div class="fs-2 fw-semibold lh-1 @(Model.Counts.PendingContainers > 0 ? "text-danger" : "")">
                    @Model.Counts.PendingContainers
                </div>
                <div class="text-muted small mt-1">Click to review pending</div>
            </div>
        </div>
        </a>
    </div>
    <div class="col-6 col-md-4 col-xl-2">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body py-3">
                <div class="text-muted small text-uppercase fw-semibold mb-1">
                    <i class="bi bi-clipboard-data text-primary me-1"></i>Quality Orders Open
                </div>
                <div class="fs-2 fw-semibold lh-1">@Model.Counts.QoOpen</div>
                <div class="text-muted small mt-1">Initial, Open & Reopened</div>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-4 col-xl-2">
        <div class="card border-0 shadow-sm h-100 @(Model.Counts.StaleArrivals > 0 ? "border-start border-4 border-danger" : "")">
            <div class="card-body py-3">
                <div class="text-muted small text-uppercase fw-semibold mb-1">
                    <i class="bi bi-hourglass-split text-danger me-1"></i>Stale Arrivals
                </div>
                <div class="fs-2 fw-semibold lh-1 @(Model.Counts.StaleArrivals > 0 ? "text-danger" : "")">@Model.Counts.StaleArrivals</div>
                <div class="text-muted small mt-1">Draft &gt; @Model.Thresholds.StaleArrivalDays day(s)</div>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-4 col-xl-2">
        <div class="card border-0 shadow-sm h-100 @(Model.Counts.AgedOpenQos > 0 ? "border-start border-4 border-warning" : "")">
            <div class="card-body py-3">
                <div class="text-muted small text-uppercase fw-semibold mb-1">
                    <i class="bi bi-stopwatch text-warning me-1"></i>Aged Open QOs
                </div>
                <div class="fs-2 fw-semibold lh-1 @(Model.Counts.AgedOpenQos > 0 ? "text-warning" : "")">@Model.Counts.AgedOpenQos</div>
                <div class="text-muted small mt-1">Open &gt; @Model.Thresholds.OpenQoDays day(s)</div>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-4 col-xl-2">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body py-3">
                <div class="text-muted small text-uppercase fw-semibold mb-1">
                    <i class="bi bi-graph-down-arrow text-info me-1"></i>Avg Defect % (30 d)
                </div>
                <div class="fs-2 fw-semibold lh-1 @DefectTone()">
                    @(avgDefect == null ? "—" : $"{avgDefect.Value:0.0}%")
                </div>
                <div class="text-muted small mt-1">Across closed QOs</div>
            </div>
        </div>
    </div>
</div>

@* ---- Charts row 1 (existing) ---- *@
<div class="row g-3 mb-3">
    <div class="col-lg-5">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-header bg-transparent border-0 d-flex justify-content-between align-items-center py-2">
                <span class="fw-semibold"><i class="bi bi-activity me-1"></i>Arrivals Trend</span>
                <span class="text-muted small">Last 12 weeks</span>
            </div>
            <div class="card-body pt-0">
                <div style="position: relative; height: 240px;">
                    <canvas id="chartArrivalsTrend"></canvas>
                </div>
            </div>
        </div>
    </div>
    <div class="col-lg-4">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-header bg-transparent border-0 d-flex justify-content-between align-items-center py-2">
                <span class="fw-semibold"><i class="bi bi-pie-chart-fill me-1"></i>Quality Orders by Status</span>
            </div>
            <div class="card-body pt-0">
                <div style="position: relative; height: 240px;">
                    <canvas id="chartQoStatus"></canvas>
                </div>
            </div>
        </div>
    </div>
    <div class="col-lg-3">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-header bg-transparent border-0 d-flex justify-content-between align-items-center py-2">
                <span class="fw-semibold"><i class="bi bi-speedometer me-1"></i>Defect Rate</span>
                <span class="text-muted small" title="Red above @(Model.Thresholds.DefectPctRed)%, Amber above @(Model.Thresholds.DefectPctYellow)%">
                    <i class="bi bi-info-circle"></i>
                </span>
            </div>
            <div class="card-body pt-0">
                <div style="position: relative; height: 240px;">
                    <canvas id="chartDefectGauge"></canvas>
                </div>
            </div>
        </div>
    </div>
</div>

@* ---- Charts row 2 (new innovative) ---- *@
<div class="row g-3 mb-3">
    <div class="col-lg-5">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-header bg-transparent border-0 d-flex justify-content-between align-items-center py-2">
                <span class="fw-semibold"><i class="bi bi-bar-chart-steps me-1"></i>Throughput vs QC pace</span>
                <span class="text-muted small">Arrivals received vs QOs closed (12 wk)</span>
            </div>
            <div class="card-body pt-0">
                <div style="position: relative; height: 240px;">
                    <canvas id="chartThroughput"></canvas>
                </div>
            </div>
        </div>
    </div>
    <div class="col-lg-3">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-header bg-transparent border-0 d-flex justify-content-between align-items-center py-2">
                <span class="fw-semibold"><i class="bi bi-bar-chart me-1"></i>Open QO Age</span>
                <span class="text-muted small">Days since opened</span>
            </div>
            <div class="card-body pt-0">
                <div style="position: relative; height: 240px;">
                    <canvas id="chartOpenQoAge"></canvas>
                </div>
            </div>
        </div>
    </div>
    <div class="col-lg-4">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-header bg-transparent border-0 d-flex justify-content-between align-items-center py-2">
                <span class="fw-semibold"><i class="bi bi-bar-chart-line me-1"></i>Defect % by Material Group</span>
                <span class="text-muted small">Top 8 (30 d)</span>
            </div>
            <div class="card-body pt-0">
                <div style="position: relative; height: 240px;">
                    <canvas id="chartDefectByGroup"></canvas>
                </div>
            </div>
        </div>
    </div>
</div>

@* ---- Bottom row: Open Arrivals (left) + Open Quality Orders (right) 50/50 ---- *@
<div class="row g-3 mb-3">
    <div class="col-lg-6">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-header bg-transparent border-0 d-flex justify-content-between align-items-center py-2">
                <span class="fw-semibold"><i class="bi bi-box-arrow-in-down me-1"></i>Open Arrivals</span>
                <a asp-controller="Arrivals" asp-action="Index" asp-route-status="Draft" class="small text-decoration-none">
                    View all <i class="bi bi-arrow-right-short"></i>
                </a>
            </div>
            <div class="table-responsive">
                <table class="table table-sm table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Arrival</th>
                            <th>Container</th>
                            <th>Vendor</th>
                            <th>Status</th>
                            <th class="text-end">Created</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var a in Model.OpenArrivals)
                        {
                            <tr>
                                <td>
                                    <a asp-controller="Arrivals" asp-action="Details" asp-route-id="@a.ArrivalId"
                                       class="text-decoration-none">@a.ArrivalNo</a>
                                </td>
                                <td><code>@a.ContainerNo</code></td>
                                <td>@a.VendorName</td>
                                <td><span class="badge @ArrivalBadge(a.StatusCode)">@a.StatusCode</span></td>
                                <td class="text-end small text-muted">@a.CreatedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</td>
                            </tr>
                        }
                        @if (Model.OpenArrivals.Count == 0)
                        {
                            <tr><td colspan="5" class="text-center text-muted small py-3">No open arrivals.</td></tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
    <div class="col-lg-6">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-header bg-transparent border-0 d-flex justify-content-between align-items-center py-2">
                <span class="fw-semibold"><i class="bi bi-clipboard-data me-1"></i>Open Quality Orders</span>
                <a asp-controller="QualityOrders" asp-action="Index" class="small text-decoration-none">
                    View all <i class="bi bi-arrow-right-short"></i>
                </a>
            </div>
            <div class="table-responsive">
                <table class="table table-sm table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>QO</th>
                            <th>Container</th>
                            <th>Vendor</th>
                            <th>Status</th>
                            <th class="text-end">Opened</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var qo in Model.OpenQos)
                        {
                            var opened = qo.OpenedAt ?? qo.CreatedAt;
                            <tr>
                                <td>
                                    <a asp-controller="QualityOrders" asp-action="Details" asp-route-id="@qo.QualityOrderId"
                                       class="text-decoration-none">@qo.QualityOrderNo</a>
                                </td>
                                <td><code>@qo.ContainerNo</code></td>
                                <td>@qo.VendorName</td>
                                <td><span class="badge @QoBadge(qo.StatusCode)">@qo.StatusCode</span></td>
                                <td class="text-end small text-muted">@opened.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</td>
                            </tr>
                        }
                        @if (Model.OpenQos.Count == 0)
                        {
                            <tr><td colspan="5" class="text-center text-muted small py-3">No open quality orders.</td></tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script id="dash-data" type="application/json">@Html.Raw(payloadJson)</script>
    <script src="~/lib/chartjs/chart.umd.min.js"></script>
    <script src="~/js/dashboard.js" asp-append-version="true"></script>
}
