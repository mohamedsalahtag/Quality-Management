@using System.Text.Json
@using SharbatlyQMS.Web.Models
@using SharbatlyQMS.Web.ViewModels
@using SharbatlyQMS.Web.Extensions
@model DashboardVm
@{
    ViewData["Title"] = Loc["Dashboard"];
    var role     = User?.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value;
    var fullName = User?.FindFirst(System.Security.Claims.ClaimTypes.GivenName)?.Value;

    // Status badges: every bg-* is paired with an explicit text-* utility so
    // dark-theme contrast holds. Without it the global theme can recolor
    // body text to white-on-yellow / dark-on-dark.
    string ArrivalBadge(string s) => s switch
    {
        ArrivalStatus.Draft     => "bg-warning text-dark",
        ArrivalStatus.Completed => "bg-success text-white",
        ArrivalStatus.Rejected  => "bg-danger text-white",
        ArrivalStatus.Cancelled => "bg-secondary text-white",
        _ => "bg-light text-dark"
    };
    string QoBadge(string s) => s switch
    {
        "Initial"  => "bg-secondary text-white",
        "Open"     => "bg-primary text-white",
        "Reopened" => "bg-warning text-dark",
        "Closed"   => "bg-success text-white",
        "Cancelled"=> "bg-danger text-white",
        _          => "bg-light text-dark"
    };

    var avgDefect = Model.AvgDefectPctLast30;
    string DefectTone() => avgDefect == null
        ? ""
        : (avgDefect > Model.Thresholds.DefectPctRed    ? "text-danger"
        : (avgDefect > Model.Thresholds.DefectPctYellow ? "text-warning"
        :  "text-success"));

    // ---- The current slice, and the links that carry it onward ----
    var f            = Model.Filter;
    var (perFrom, perTo) = f.Resolve();
    var plantLocked  = User?.SinglePlantOrNull();     // single-plant operator
    var periodLabel  = f.Label;

    // Drill-through: open the matching list already filtered to what the
    // portlet was showing, so the number on the dashboard and the rows on the
    // list can never disagree. EVENT-based portlets carry the period; BACKLOG
    // tiles ("as of now") deliberately do not, or the list would contradict
    // the tile the moment the backlog predates the range.
    Func<string?, string?, bool, Dictionary<string, string>> Drill =
        (plant, status, withPeriod) =>
    {
        var d = new Dictionary<string, string>();
        var pl = plant ?? f.Plant;
        if (!string.IsNullOrWhiteSpace(pl))     d["plant"]  = pl!;
        if (!string.IsNullOrWhiteSpace(status)) d["status"] = status!;
        if (withPeriod)
        {
            d["from"] = perFrom.ToString("yyyy-MM-dd");
            d["to"]   = perTo.ToString("yyyy-MM-dd");
        }
        return d;
    };

    // Links that change the dashboard's own slice (period chips, plant chips).
    Func<string, string?, Dictionary<string, string>> Slice = (period, plant) =>
    {
        var d = new Dictionary<string, string> { ["period"] = period };
        if (!string.IsNullOrWhiteSpace(plant)) d["plant"] = plant!;
        if (period == DashboardFilter.Periods.Custom)
        {
            d["from"] = perFrom.ToString("yyyy-MM-dd");
            d["to"]   = perTo.ToString("yyyy-MM-dd");
        }
        return d;
    };

    var totalReceived  = Model.Commitment.Sum(x => x.Received);
    var totalCommitted = Model.Commitment.Sum(x => x.Committed);
    var totalQosMade   = Model.Commitment.Sum(x => x.QosCreated);
    var totalOutstanding = Model.Commitment.Sum(x => x.Outstanding);
    var totalCatchUp   = Model.Commitment.Sum(x => x.QosCatchUp);

    // Clicking a number has to land on exactly the rows it counted, so the link
    // carries the same period the portlet was drawn with rather than the
    // defaults the detail page would otherwise resolve.
    Func<string, string?, Dictionary<string, string>> Bucket = (bucket, rowPlant) =>
    {
        var d = new Dictionary<string, string> { ["bucket"] = bucket };
        if (!string.IsNullOrWhiteSpace(f.Period)) d["period"] = f.Period!;
        if (!string.IsNullOrWhiteSpace(f.Plant))  d["plant"]  = f.Plant!;
        if (f.From.HasValue) d["from"] = f.From.Value.ToString("yyyy-MM-dd");
        if (f.To.HasValue)   d["to"]   = f.To.Value.ToString("yyyy-MM-dd");
        if (!string.IsNullOrWhiteSpace(rowPlant)) d["detailPlant"] = rowPlant!;
        return d;
    };
    decimal? totalCoverage = totalReceived == 0
        ? null : Math.Round(totalCommitted * 100m / totalReceived, 1);
    var rate = Model.DefectRate;

    // JSON payload consumed by dashboard.js. Camel-cased so the JS reads
    // `trend`, `qoByStatus`, `avgDefectPct`, `thresholds`,
    // `throughput`, `openQoAge`, `defectByGroup`, `commitment`.
    var payload = new
    {
        trend           = Model.ArrivalsTrend,
        qoByStatus      = Model.QoByStatus,
        avgDefectPct    = Model.AvgDefectPctLast30,
        thresholds      = Model.Thresholds,
        throughput      = Model.ThroughputTrend,
        openQoAge       = Model.OpenQoAgeBuckets,
        defectByGroup   = Model.DefectByGroup,
        commitmentTrend = Model.CommitmentTrend,
        commitment      = Model.Commitment.Select(x => new {
                              plant      = Codes.PlantDisplay(x.Plant),
                              received   = x.Received,
                              committed  = x.Committed,
                              qosCreated = x.QosCreated }),
        bucketByDay     = f.BucketByDay,
        bucketByHour    = f.BucketByHour
    };
    var payloadJson = JsonSerializer.Serialize(payload);
}

<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
    <div>
        <h1 class="h3 mb-1">Welcome, @fullName</h1>
        <p class="text-muted mb-0">@Loc["Sharbatly Quality Management System"]</p>
    </div>
    <span class="badge bg-secondary fs-6">@role</span>
</div>

@* ---- SAP sync failure warning (admins only) ---- *@
@if (Model.IsAdmin && Model.SyncFailures.Any())
{
    <div class="alert alert-warning d-flex align-items-start" role="alert">
        <i class="bi bi-exclamation-triangle-fill me-2 mt-1"></i>
        <div>
            <strong>@Loc["SAP sync needs attention."]</strong>
            The most recent sync failed for:
            @foreach (var sf in Model.SyncFailures)
            {
                <div class="small">
                    <span class="fw-semibold">@sf.EndpointKey</span>
                    @if (sf.CompletedAt.HasValue) { <text>— @sf.CompletedAt.Value.ToLocalTime().ToString("g")</text> }
                    @if (!string.IsNullOrWhiteSpace(sf.Message)) { <text>: @(sf.Message!.Length > 160 ? sf.Message[..160] + "…" : sf.Message)</text> }
                </div>
            }
            <div class="small mt-1">Open <a asp-controller="Admin" asp-action="Settings" asp-route-activeTab="sap">@Loc["Site Configuration → SAP"]</a> to retry.</div>
        </div>
    </div>
}

@* ---- Slice bar: one plant, one period. Everything below obeys it, and
       every drill-through link carries it into the list it opens. ---- *@
<div class="card border-0 shadow-sm mb-3">
    <div class="card-body py-2 d-flex flex-wrap align-items-center gap-3">
        <div class="d-flex align-items-center gap-2">
            <span class="text-muted small text-uppercase fw-semibold">@Loc["Period"]</span>
            <div class="btn-group btn-group-sm" role="group" aria-label='@Loc["Period"]'>
                @foreach (var (key, text) in new[] {
                    (DashboardFilter.Periods.Today,   "Today"),
                    (DashboardFilter.Periods.Week,    "7 days"),
                    (DashboardFilter.Periods.Month,   "30 days"),
                    (DashboardFilter.Periods.Quarter, "90 days") })
                {
                    <a asp-action="Index" asp-all-route-data="Slice(key, f.Plant)"
                       class="btn @(f.Period == key ? "btn-primary" : "btn-outline-secondary")">@text</a>
                }
            </div>
        </div>

        @* Custom range. Submitting sets period=custom, so the chips above
           unselect and the label reads the real dates. *@
        <form asp-action="Index" method="get" class="d-flex align-items-center gap-2 m-0">
            <input type="hidden" name="period" value="@DashboardFilter.Periods.Custom" />
            @if (!string.IsNullOrWhiteSpace(f.Plant))
            {
                <input type="hidden" name="plant" value="@f.Plant" />
            }
            <input type="date" name="from" value="@perFrom.ToString("yyyy-MM-dd")"
                   class="form-control form-control-sm" style="width:9.5rem" aria-label='@Loc["From"]' />
            <span class="text-muted small">@Loc["to"]</span>
            <input type="date" name="to" value="@perTo.ToString("yyyy-MM-dd")"
                   class="form-control form-control-sm" style="width:9.5rem" aria-label='@Loc["To"]' />
            <button type="submit" class="btn btn-sm btn-outline-primary">@Loc["Apply"]</button>
        </form>

        <div class="d-flex align-items-center gap-2 ms-auto">
            <span class="text-muted small text-uppercase fw-semibold">@Loc["Plant"]</span>
            @if (plantLocked != null)
            {
                @* Plant-scoped operator: the scope is forced server-side, so a
                   picker would only offer choices that come back identical. *@
                <span class="badge bg-light text-dark border" title="Your account is restricted to this plant.">
                    <i class="bi bi-lock-fill text-muted me-1"></i>@Codes.PlantLabel(plantLocked)
                </span>
            }
            else
            {
                <div class="btn-group btn-group-sm" role="group" aria-label='@Loc["Plant"]'>
                    <a asp-action="Index" asp-all-route-data="Slice(f.Period, null)"
                       class="btn @(string.IsNullOrWhiteSpace(f.Plant) ? "btn-secondary" : "btn-outline-secondary")">@Loc["All"]</a>
                    @foreach (var pl in Model.PlantOptions)
                    {
                        <a asp-action="Index" asp-all-route-data="Slice(f.Period, pl)"
                           class="btn @(string.Equals(pl, f.Plant, StringComparison.OrdinalIgnoreCase) ? "btn-secondary" : "btn-outline-secondary")"
                           title="@pl">@Codes.PlantDisplay(pl)</a>
                    }
                </div>
            }
        </div>
    </div>
</div>

@* ---- Received vs committed: did QC keep up with what arrived? ----
       Received  = containers taken in (arrivals created) in the period.
       Committed = those taken into QC (quality orders created).
       The gap is the backlog built during the period. Every number opens the
       list it was counted from. ---- *@
<div class="card border-0 shadow-sm mb-3">
    <div class="card-header bg-transparent border-0 d-flex justify-content-between align-items-center py-2 flex-wrap gap-2">
        <span class="fw-semibold">
            <i class="bi bi-truck me-1"></i>Received vs Committed to QC
            <span class="badge bg-light text-dark border ms-1">@periodLabel</span>
        </span>
        <span class="d-flex align-items-center gap-2 flex-wrap">
            <span class="text-muted small">
                @totalReceived @Loc["received"] &middot; @totalCommitted @Loc["inspected"]
                @if (totalCoverage.HasValue)
                {
                    <span class="ms-1 fw-semibold @(totalCoverage >= 100 ? "text-success" : (totalCoverage >= 80 ? "text-warning" : "text-danger"))">
                        @totalCoverage.Value.ToString("0.#")%
                    </span>
                }
                <span class="ms-2">&middot; @totalQosMade @Loc["total inspected"]</span>
                @if (totalCatchUp > 0)
                {
                    <span class="ms-1">(@totalCatchUp @Loc["backlog"])</span>
                }
            </span>
            <a class="btn btn-sm btn-outline-success py-0 px-2"
               asp-action="CommitmentExcel" asp-all-route-data="Slice(f.Period, f.Plant)"
               title="@Loc["Export this table to Excel"]">
                <i class="bi bi-file-earmark-excel"></i>
            </a>
        </span>
    <div class="card-body pt-0">
        @* Folded away. The explanation earns its place the first time someone
           asks why the last columns exceed the first, and takes up half the
           portlet every day after that. *@
        <details class="small mb-2">
            <summary class="text-muted" style="cursor:pointer">
                @Loc["What do these columns count?"]
            </summary>
            <div class="mt-2 ps-3 border-start">
                @Loc["The first four columns are about the containers RECEIVED in this period. The last three count inspections OPENED in the period, whichever day their container arrived — which is why the total can be larger."]
                <div class="text-muted mt-1">
                    @Loc["Total Inspected = Period Inspection + Backlog Inspected, always. Example: 3 received and 1 inspected (2 pending, 33% coverage), while the team opened 13 inspections — 10 of them clearing containers that arrived earlier."]
                </div>
            </div>
        </details>
        <div class="row g-3">
            <div class="col-lg-6">
                <div class="table-responsive">
                    <table class="table table-sm table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>@Loc["Plant"]</th>
                                <th class="text-end" title='@Loc["Containers that arrived in this period."]'>
                                    @Loc["Received"]
                                </th>
                                <th class="text-end" title='@Loc["Inspections opened in this period against containers received in it."]'>
                                    @Loc["Period Inspection"]
                                </th>
                                <th class="text-end" title='@Loc["Received minus Period Inspection: arrived but not yet inspected."]'>
                                    @Loc["Pending Inspection"]
                                </th>
                                <th class="text-end" title='@Loc["Period Inspection as a share of Received."]'>
                                    @Loc["Coverage"]
                                </th>
                                <th class="text-end border-start" title='@Loc["Of the inspections opened, how many were on containers that arrived BEFORE this period."]'>
                                    @Loc["Backlog Inspected"]
                                </th>
                                <th class="text-end" title='@Loc["Every inspection opened in this period. Equals Period Inspection plus Backlog Inspected."]'>
                                    @Loc["Total Inspected"]
                                </th>
                                <th class="text-end" title='@Loc["Total Inspected divided by the days in the period."]'>
                                    @Loc["Daily Average"]
                                </th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var row in Model.Commitment.OrderByDescending(x => x.Received).ThenBy(x => x.Plant))
                            {
                                <tr>
                                    <td>
                                        <a asp-action="Index" asp-all-route-data="Slice(f.Period, row.Plant)"
                                           class="text-decoration-none" title="Show the whole dashboard for @row.Plant">
                                            @Codes.PlantDisplay(row.Plant)
                                        </a>
                                    </td>
                                    <td class="text-end">
                                        <a asp-action="CommitmentDetail"
                                           asp-all-route-data="Bucket(CommitmentBuckets.Received, row.Plant)"
                                           class="text-decoration-none">@row.Received</a>
                                    </td>
                                    <td class="text-end">
                                        <a asp-action="CommitmentDetail"
                                           asp-all-route-data="Bucket(CommitmentBuckets.PeriodInspection, row.Plant)"
                                           class="text-decoration-none">@row.Committed</a>
                                    </td>
                                    <td class="text-end @(row.Outstanding > 0 ? "text-danger fw-semibold" : "text-muted")">
                                        @if (row.Outstanding > 0)
                                        {
                                            <a asp-action="CommitmentDetail"
                                               asp-all-route-data="Bucket(CommitmentBuckets.PendingInspection, row.Plant)"
                                               class="text-reset text-decoration-none border-bottom border-danger-subtle"
                                               title="@Loc["Show the containers still waiting"]">@row.Outstanding</a>
                                        }
                                        else
                                        {
                                            @row.Outstanding
                                        }
                                    </td>
                                    <td class="text-end">
                                        @if (row.CoveragePct.HasValue)
                                        {
                                            <span class="badge @(row.CoveragePct >= 100 ? "bg-success" : (row.CoveragePct >= 80 ? "bg-warning text-dark" : "bg-danger"))">
                                                @row.CoveragePct.Value.ToString("0.#")%
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">&mdash;</span>
                                        }
                                    </td>
                                    <td class="text-end border-start">
                                        @if (row.QosCatchUp > 0)
                                        {
                                            <a asp-action="CommitmentDetail"
                                               asp-all-route-data="Bucket(CommitmentBuckets.BacklogInspected, row.Plant)"
                                               class="badge bg-info-subtle text-info-emphasis border border-info-subtle text-decoration-none"
                                               title="@row.QosOnNewArrivals on this period's arrivals, @row.QosCatchUp on earlier ones">
                                                @row.QosCatchUp
                                            </a>
                                        }
                                        else
                                        {
                                            <span class="text-muted">&mdash;</span>
                                        }
                                    </td>
                                    <td class="text-end fw-semibold">
                                        <a asp-action="CommitmentDetail"
                                           asp-all-route-data="Bucket(CommitmentBuckets.TotalInspected, row.Plant)"
                                           class="text-decoration-none">@row.QosCreated</a>
                                    </td>
                                    <td class="text-end text-muted">
                                        @(row.DailyAverage(Model.PeriodDays)?.ToString("0.#") ?? "—")
                                    </td>
                                </tr>
                            }
                            @if (Model.Commitment.Count == 0)
                            {
                                <tr><td colspan="8" class="text-center text-muted small py-3">
                                    @Loc["Nothing arrived and no QC orders were opened in this period."]
                                </td></tr>
                            }
                        </tbody>
                        @if (Model.Commitment.Count > 0)
                        {
                            @* Totals across every plant in view. Coverage is
                               recomputed from the totals, not averaged from the
                               rows: averaging percentages would weight a plant
                               with two containers the same as one with forty. *@
                            <tfoot class="table-light fw-semibold">
                                <tr>
                                    <td>@Loc["All plants"]</td>
                                    <td class="text-end">@totalReceived</td>
                                    <td class="text-end">@totalCommitted</td>
                                    <td class="text-end @(totalOutstanding > 0 ? "text-danger" : "text-muted")">@totalOutstanding</td>
                                    <td class="text-end">
                                        @if (totalCoverage.HasValue)
                                        {
                                            <span class="badge @(totalCoverage >= 100 ? "bg-success" : (totalCoverage >= 80 ? "bg-warning text-dark" : "bg-danger"))">
                                                @totalCoverage.Value.ToString("0.#")%
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">&mdash;</span>
                                        }
                                    </td>
                                    <td class="text-end border-start">@(totalCatchUp > 0 ? totalCatchUp.ToString() : "—")</td>
                                    <td class="text-end">@totalQosMade</td>
                                    <td class="text-end">
                                        @((Model.PeriodDays > 0 ? (double)totalQosMade / Model.PeriodDays : 0).ToString("0.#"))
                                    </td>
                                </tr>
                            </tfoot>
                        }
                    </table>
                </div>
            </div>
            <div class="col-lg-6">
                <div style="position: relative; height: 240px;">
                    <canvas id="chartCommitment"></canvas>
                </div>
            </div>
        </div>
    </div>
</div>

@* ---- KPI tiles ---- *@
<div class="row g-3 mb-3">
    @* Backlog tiles drill through WITHOUT the period: a draft arrival that has
       been sitting since last month is exactly the one you want to open, and a
       date-filtered list would hide it and contradict the number above it. *@
    <div class="col-6 col-md-4 col-xl-2">
        <a asp-controller="Arrivals" asp-action="Index"
           asp-all-route-data="Drill(null, ArrivalStatus.Draft, false)" class="text-decoration-none text-reset">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body py-3">
                <div class="text-muted small text-uppercase fw-semibold mb-1">
                    <i class="bi bi-pencil-square text-primary me-1"></i>@Loc["Arrivals in Draft"]
                </div>
                <div class="fs-2 fw-semibold lh-1">@Model.Counts.ArrivalsDraft</div>
                <div class="text-muted small mt-1">@Loc["Awaiting checklist completion"]</div>
            </div>
        </div>
        </a>
    </div>
    <div class="col-6 col-md-4 col-xl-2">
        <a asp-controller="Arrivals" asp-action="Pending"
           asp-all-route-data="Drill(null, null, false)" class="text-decoration-none">
        <div class="card border-0 shadow-sm h-100 @(Model.Counts.PendingContainers > 0 ? "border-start border-4 border-danger" : "")">
            <div class="card-body py-3">
                <div class="text-muted small text-uppercase fw-semibold mb-1">
                    <i class="bi bi-inbox text-danger me-1"></i>@Loc["Containers without Arrival"]
                </div>
                <div class="fs-2 fw-semibold lh-1 @(Model.Counts.PendingContainers > 0 ? "text-danger" : "")">
                    @Model.Counts.PendingContainers
                </div>
                <div class="text-muted small mt-1">@Loc["Click to review pending"]</div>
            </div>
        </div>
        </a>
    </div>
    <div class="col-6 col-md-4 col-xl-2">
        <a asp-controller="QualityOrders" asp-action="Index"
           asp-all-route-data="Drill(null, null, false)" class="text-decoration-none text-reset">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body py-3">
                <div class="text-muted small text-uppercase fw-semibold mb-1">
                    <i class="bi bi-clipboard-data text-primary me-1"></i>@Loc["Quality Orders Open"]
                </div>
                <div class="fs-2 fw-semibold lh-1">@Model.Counts.QoOpen</div>
                <div class="text-muted small mt-1">Initial, Open & Reopened</div>
            </div>
        </div>
        </a>
    </div>
    <div class="col-6 col-md-4 col-xl-2">
        <a asp-controller="Arrivals" asp-action="Index"
           asp-all-route-data="Drill(null, ArrivalStatus.Draft, false)" class="text-decoration-none text-reset">
        <div class="card border-0 shadow-sm h-100 @(Model.Counts.StaleArrivals > 0 ? "border-start border-4 border-danger" : "")">
            <div class="card-body py-3">
                <div class="text-muted small text-uppercase fw-semibold mb-1">
                    <i class="bi bi-hourglass-split text-danger me-1"></i>@Loc["Stale Arrivals"]
                </div>
                <div class="fs-2 fw-semibold lh-1 @(Model.Counts.StaleArrivals > 0 ? "text-danger" : "")">@Model.Counts.StaleArrivals</div>
                <div class="text-muted small mt-1">Draft &gt; @Model.Thresholds.StaleArrivalDays day(s)</div>
            </div>
        </div>
        </a>
    </div>
    <div class="col-6 col-md-4 col-xl-2">
        <a asp-controller="QualityOrders" asp-action="Index"
           asp-all-route-data="Drill(null, null, false)" class="text-decoration-none text-reset">
        <div class="card border-0 shadow-sm h-100 @(Model.Counts.AgedOpenQos > 0 ? "border-start border-4 border-warning" : "")">
            <div class="card-body py-3">
                <div class="text-muted small text-uppercase fw-semibold mb-1">
                    <i class="bi bi-stopwatch text-warning me-1"></i>@Loc["Aged Open QOs"]
                </div>
                <div class="fs-2 fw-semibold lh-1 @(Model.Counts.AgedOpenQos > 0 ? "text-warning" : "")">@Model.Counts.AgedOpenQos</div>
                <div class="text-muted small mt-1">Open &gt; @Model.Thresholds.OpenQoDays day(s)</div>
            </div>
        </div>
        </a>
    </div>
    <div class="col-6 col-md-4 col-xl-2">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body py-3">
                <div class="text-muted small text-uppercase fw-semibold mb-1">
                    <i class="bi bi-graph-down-arrow text-info me-1"></i>@Loc["Avg Defect %"]
                </div>
                <div class="fs-2 fw-semibold lh-1 @DefectTone()">
                    @(avgDefect == null ? "—" : $"{avgDefect.Value:0.0}%")
                </div>
                <div class="text-muted small mt-1">Closed QOs &middot; @periodLabel</div>
            </div>
        </div>
    </div>
</div>

@* ---- Charts row 1 (existing) ---- *@
<div class="row g-3 mb-3">
    <div class="col-lg-5">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-header bg-transparent border-0 d-flex justify-content-between align-items-center py-2">
                <span class="fw-semibold"><i class="bi bi-activity me-1"></i>@Loc["Arrivals Trend"]</span>
                <span class="text-muted small">@periodLabel</span>
            </div>
            <div class="card-body pt-0">
                <div style="position: relative; height: 240px;">
                    <canvas id="chartArrivalsTrend"></canvas>
                </div>
            </div>
        </div>
    </div>
    <div class="col-lg-4">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-header bg-transparent border-0 d-flex justify-content-between align-items-center py-2">
                <span class="fw-semibold"><i class="bi bi-pie-chart-fill me-1"></i>@Loc["Quality Orders by Status"]</span>
            </div>
            <div class="card-body pt-0">
                <div style="position: relative; height: 240px;">
                    <canvas id="chartQoStatus"></canvas>
                </div>
            </div>
        </div>
    </div>
    <div class="col-lg-3">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-header bg-transparent border-0 d-flex justify-content-between align-items-center py-2">
                <span class="fw-semibold"><i class="bi bi-speedometer me-1"></i>@Loc["Defect Rate"]</span>
                <span class="text-muted small" title="Red above @(Model.Thresholds.DefectPctRed)%, Amber above @(Model.Thresholds.DefectPctYellow)%">
                    <i class="bi bi-info-circle"></i>
                </span>
            </div>
            <div class="card-body pt-0">
                @* The gauge alone was a number with no provenance -- "which
                   defect, which order, which material?" had no answer on the
                   page. The rate is unchanged; what follows it is the evidence:
                   how much was inspected, across how many orders, and the
                   defects actually driving it. A rate over four samples and one
                   over four hundred are different claims and now look it. *@
                <div style="position: relative; height: 150px;">
                    <canvas id="chartDefectGauge"></canvas>
                </div>
                @if (rate.Samples > 0)
                {
                    <div class="text-center small text-muted border-top pt-2">
                        @Loc["from"] <strong>@rate.Samples</strong> @Loc["samples"]
                        @Loc["across"] <strong>@rate.Orders</strong> @Loc["closed orders"]
                        <div>
                            <strong>@Fmt.Dec2(rate.DefectiveUnits)</strong> @Loc["defective of"]
                            <strong>@Fmt.Dec2(rate.InspectedUnits)</strong> @Loc["inspected"]
                        </div>
                    </div>
                    @if (rate.TopDefects.Count > 0)
                    {
                        <div class="mt-2">
                            <div class="text-muted small text-uppercase fw-semibold mb-1">@Loc["Biggest contributors"]</div>
                            <ul class="list-unstyled mb-0 small">
                                @foreach (var td in rate.TopDefects.Take(4))
                                {
                                    <li class="d-flex justify-content-between gap-2 border-bottom py-1">
                                        <span class="text-truncate" title="@td.DefectCategory@(string.IsNullOrWhiteSpace(td.MaterialGroup) ? "" : " · " + td.MaterialGroup)">
                                            @td.DefectName
                                        </span>
                                        <span class="fw-semibold text-nowrap">@td.PctOfInspected.ToString("0.##")%</span>
                                    </li>
                                }
                            </ul>
                            <a asp-controller="Reports" asp-action="FlatDefects"
                               asp-all-route-data="Drill(null, null, false)"
                               class="small text-decoration-none d-inline-block mt-1">
                                @Loc["Break it down in the Data hub"] <i class="bi bi-arrow-right-short"></i>
                            </a>
                        </div>
                    }
                }
                else
                {
                    <div class="text-center small text-muted border-top pt-2">
                        @Loc["No closed orders with samples in this period."]
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@* ---- Charts row 2 (new innovative) ---- *@
<div class="row g-3 mb-3">
    <div class="col-lg-5">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-header bg-transparent border-0 d-flex justify-content-between align-items-center py-2">
                <span class="fw-semibold"><i class="bi bi-bar-chart-steps me-1"></i>@Loc["Throughput vs QC pace"]</span>
                <span class="text-muted small">Received vs QOs closed &middot; @periodLabel</span>
            </div>
            <div class="card-body pt-0">
                <div style="position: relative; height: 240px;">
                    <canvas id="chartThroughput"></canvas>
                </div>
            </div>
        </div>
    </div>
    <div class="col-lg-3">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-header bg-transparent border-0 d-flex justify-content-between align-items-center py-2">
                <span class="fw-semibold"><i class="bi bi-bar-chart me-1"></i>@Loc["Open QO Age"]</span>
                <span class="text-muted small">@Loc["Days since opened"]</span>
            </div>
            <div class="card-body pt-0">
                <div style="position: relative; height: 240px;">
                    <canvas id="chartOpenQoAge"></canvas>
                </div>
            </div>
        </div>
    </div>
    <div class="col-lg-4">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-header bg-transparent border-0 d-flex justify-content-between align-items-center py-2">
                <span class="fw-semibold"><i class="bi bi-bar-chart-line me-1"></i>@Loc["Defect % by Material Group"]</span>
                <span class="text-muted small">Top 8 &middot; @periodLabel</span>
            </div>
            <div class="card-body pt-0">
                <div style="position: relative; height: 240px;">
                    <canvas id="chartDefectByGroup"></canvas>
                </div>
            </div>
        </div>
    </div>
</div>

@* ---- Bottom row: Open Arrivals (left) + Open Quality Orders (right) 50/50 ---- *@
<div class="row g-3 mb-3">
    <div class="col-lg-6">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-header bg-transparent border-0 d-flex justify-content-between align-items-center py-2">
                <span class="fw-semibold"><i class="bi bi-box-arrow-in-down me-1"></i>@Loc["Open Arrivals"]</span>
                <a asp-controller="Arrivals" asp-action="Index"
                   asp-all-route-data="Drill(null, ArrivalStatus.Draft, false)" class="small text-decoration-none">
                    View all <i class="bi bi-arrow-right-short"></i>
                </a>
            </div>
            <div class="table-responsive">
                <table class="table table-sm table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>@Loc["Arrival"]</th>
                            <th>@Loc["Container"]</th>
                            <th>@Loc["Vendor"]</th>
                            <th>@Loc["Status"]</th>
                            <th class="text-end">@Loc["Created"]</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var a in Model.OpenArrivals)
                        {
                            <tr>
                                <td>
                                    <a asp-controller="Arrivals" asp-action="Details" asp-route-id="@a.ArrivalId"
                                       class="text-decoration-none">@a.ArrivalNo</a>
                                </td>
                                <td><code>@a.ContainerNo</code></td>
                                <td>@a.VendorName</td>
                                <td><span class="badge @ArrivalBadge(a.StatusCode)">@a.StatusCode</span></td>
                                <td class="text-end small text-muted">@a.CreatedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</td>
                            </tr>
                        }
                        @if (Model.OpenArrivals.Count == 0)
                        {
                            <tr><td colspan="5" class="text-center text-muted small py-3">@Loc["No open arrivals."]</td></tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
    <div class="col-lg-6">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-header bg-transparent border-0 d-flex justify-content-between align-items-center py-2">
                <span class="fw-semibold"><i class="bi bi-clipboard-data me-1"></i>@Loc["Open Quality Orders"]</span>
                <a asp-controller="QualityOrders" asp-action="Index"
                   asp-all-route-data="Drill(null, null, false)" class="small text-decoration-none">
                    View all <i class="bi bi-arrow-right-short"></i>
                </a>
            </div>
            <div class="table-responsive">
                <table class="table table-sm table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>@Loc["QO"]</th>
                            <th>@Loc["Container"]</th>
                            <th>@Loc["Vendor"]</th>
                            <th>@Loc["Status"]</th>
                            <th class="text-end">@Loc["Opened"]</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var qo in Model.OpenQos)
                        {
                            var opened = qo.OpenedAt ?? qo.CreatedAt;
                            <tr>
                                <td>
                                    <a asp-controller="QualityOrders" asp-action="Details" asp-route-id="@qo.QualityOrderId"
                                       class="text-decoration-none">@qo.QualityOrderNo</a>
                                </td>
                                <td><code>@qo.ContainerNo</code></td>
                                <td>@qo.VendorName</td>
                                <td><span class="badge @QoBadge(qo.StatusCode)">@qo.StatusCode</span></td>
                                <td class="text-end small text-muted">@opened.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</td>
                            </tr>
                        }
                        @if (Model.OpenQos.Count == 0)
                        {
                            <tr><td colspan="5" class="text-center text-muted small py-3">@Loc["No open quality orders."]</td></tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script id="dash-data" type="application/json">@Html.Raw(payloadJson)</script>
    <script src="~/lib/chartjs/chart.umd.min.js"></script>
    <script src="~/js/dashboard.js" asp-append-version="true"></script>
}
