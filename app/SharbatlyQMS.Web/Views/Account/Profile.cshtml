@model SharbatlyQMS.Web.Models.ProfileVm
@{
    ViewData["Title"] = "My Profile";
}

<div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
    <h1 class="h3 mb-0"><i class="bi bi-person-vcard me-1"></i>My Profile</h1>
    <span class="badge bg-secondary fs-6">@Model.Role</span>
</div>

<div class="row g-3">
    <div class="col-lg-4">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-header bg-transparent border-0 py-2 fw-semibold">
                <i class="bi bi-image me-1"></i>Avatar
            </div>
            <div class="card-body text-center">
                <div class="mb-3 d-flex justify-content-center">
                    @await Html.PartialAsync("_UserAvatar", new ViewDataDictionary(ViewData) { { "Size", 120 } })
                </div>
                <form asp-action="UploadProfilePicture" method="post" enctype="multipart/form-data" class="mt-2">
                    @Html.AntiForgeryToken()
                    <input type="file" name="avatar" accept=".png,.jpg,.jpeg,.gif,.webp"
                           class="form-control form-control-sm mb-2" required />
                    <button type="submit" class="btn btn-sm btn-primary w-100">
                        <i class="bi bi-upload me-1"></i>Upload picture
                    </button>
                    <div class="text-muted small mt-2">PNG / JPG / GIF / WEBP, up to 2 MB.</div>
                </form>
            </div>
        </div>
    </div>

    <div class="col-lg-8">
        <div class="card border-0 shadow-sm mb-3">
            <div class="card-header bg-transparent border-0 py-2 fw-semibold">
                <i class="bi bi-person-lines-fill me-1"></i>Profile details
            </div>
            <div class="card-body">
                <form asp-action="Profile" method="post">
                    @Html.AntiForgeryToken()
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label">Username</label>
                            <input class="form-control" value="@Model.Username" disabled />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Employee ID</label>
                            <input class="form-control" value="@Model.EmployeeId" disabled />
                        </div>
                        <div class="col-md-6">
                            <label asp-for="FullName" class="form-label">Full name *</label>
                            <input asp-for="FullName" class="form-control" required maxlength="200" />
                            <span asp-validation-for="FullName" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Email" class="form-label">Email</label>
                            <input asp-for="Email" type="email" class="form-control" maxlength="200" />
                            <span asp-validation-for="Email" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Department" class="form-label">Department</label>
                            <input asp-for="Department" class="form-control" maxlength="200" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Role</label>
                            <input class="form-control" value="@Model.Role" disabled />
                        </div>
                    </div>
                    <div class="mt-3">
                        <button type="submit" class="btn btn-primary">
                            <i class="bi bi-save me-1"></i>Save changes
                        </button>
                    </div>
                </form>
            </div>
        </div>

        <div class="card border-0 shadow-sm">
            <div class="card-header bg-transparent border-0 py-2 fw-semibold">
                <i class="bi bi-shield-lock me-1"></i>Change password
            </div>
            <div class="card-body">
                @if (Model.IsAdUser)
                {
                    <div class="alert alert-info mb-0">
                        <i class="bi bi-info-circle me-1"></i>
                        This account uses Active Directory. Change your password in your Windows / domain settings.
                    </div>
                }
                else
                {
                    <form asp-action="ChangePassword" method="post">
                        @Html.AntiForgeryToken()
                        <div class="row g-3">
                            <div class="col-md-4">
                                <label class="form-label">Current password</label>
                                <input type="password" name="CurrentPassword" class="form-control" required />
                            </div>
                            <div class="col-md-4">
                                <label class="form-label">New password</label>
                                <input type="password" name="NewPassword" class="form-control" required minlength="6" />
                            </div>
                            <div class="col-md-4">
                                <label class="form-label">Confirm new password</label>
                                <input type="password" name="ConfirmPassword" class="form-control" required minlength="6" />
                            </div>
                        </div>
                        <div class="mt-3">
                            <button type="submit" class="btn btn-warning">
                                <i class="bi bi-key me-1"></i>Update password
                            </button>
                        </div>
                    </form>
                }
            </div>
        </div>
    </div>
</div>
