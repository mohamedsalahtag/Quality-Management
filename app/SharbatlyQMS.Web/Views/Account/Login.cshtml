@model SharbatlyQMS.Web.Models.LoginViewModel
@{
    Layout = null;
    ViewData["Title"] = "Sign in";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Sign in - Sharbatly QMS</title>
    <script>
        (function () {
            var t = localStorage.getItem("app-theme") || "light";
            document.documentElement.setAttribute("data-theme", t);
            document.documentElement.setAttribute("data-bs-theme", t === "dark" ? "dark" : "light");
        })();
    </script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/theme-pack.css" asp-append-version="true" />
    <style>
        body { display: flex; align-items: center; min-height: 100vh; }
        .login-card { width: 100%; max-width: 420px; }
    </style>
</head>
<body>
    <div class="container">
        <div class="login-card mx-auto">
            <div class="text-center mb-4">
                <i class="bi bi-clipboard2-check display-4 text-primary"></i>
                <h1 class="h4 mt-2">Sharbatly QMS</h1>
                <p class="text-muted small">Quality Management System</p>
            </div>

            <div class="card shadow-sm">
                <div class="card-body p-4">
                    <h2 class="h5 mb-3">Sign in</h2>

                    @if ((bool?)ViewBag.AdEnabled == true)
                    {
                        <div class="alert alert-info py-2 small mb-3" role="alert">
                            <i class="bi bi-shield-check me-1"></i>
                            Use your <strong>domain credentials</strong> (Windows / Active Directory).
                        </div>
                    }

                    @if (!ViewData.ModelState.IsValid)
                    {
                        <div class="alert alert-danger" role="alert">
                            @foreach (var err in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                            {
                                <div>@err.ErrorMessage</div>
                            }
                        </div>
                    }

                    <form asp-action="Login" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" asp-for="ReturnUrl" value="@ViewBag.ReturnUrl" />

                        <div class="mb-3">
                            <label asp-for="Username" class="form-label">Username</label>
                            <input asp-for="Username" class="form-control" autocomplete="username"
                                   placeholder="e.g. mohamed.tag" autofocus required />
                            <div class="form-text">Your domain username — with or without @@sharbatlyfruit.com.</div>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Password" class="form-label">Password</label>
                            <input asp-for="Password" type="password" class="form-control"
                                   autocomplete="current-password" required />
                        </div>

                        <div class="form-check mb-3">
                            <input asp-for="RememberMe" class="form-check-input" />
                            <label asp-for="RememberMe" class="form-check-label">Keep me signed in for 30 days</label>
                        </div>

                        <button type="submit" class="btn btn-primary w-100">
                            <i class="bi bi-box-arrow-in-right me-1"></i>Sign in
                        </button>
                    </form>
                </div>
            </div>

            <p class="text-muted text-center small mt-3">
                Forgot your password? Contact your administrator.
            </p>
        </div>
    </div>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        // Prevent duplicate sign-ins on a slow network: disable the button as
        // soon as the form is submitted. Uses setTimeout 0 so the form payload
        // is still collected with the button's name/value intact.
        document.querySelector('form').addEventListener('submit', function () {
            var btn = this.querySelector('button[type="submit"]');
            if (!btn) return;
            setTimeout(function () {
                btn.disabled = true;
                btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span>Signing in…';
            }, 0);
        });
    </script>
</body>
</html>
