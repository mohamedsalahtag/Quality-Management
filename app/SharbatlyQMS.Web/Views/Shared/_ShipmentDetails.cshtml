@using SharbatlyQMS.Web.ViewModels
@model ShipmentDetailsVm
@*
    The Shipment Details block — the same header the QC report PDF prints, shown
    at the top of the "Generate Summary" popup. Reuses the .qcs-f label/value
    rows from _QcSummary (host page carries the .qc-summary CSS).
*@
@{
    var a  = Model.Arrival;
    var s  = Model.Shipment;
    var cl = Model.Checklist;
    string D(DateTime? d) => d?.ToString("MMM dd, yyyy") ?? "—";
    string V(string? v)   => string.IsNullOrWhiteSpace(v) ? "—" : v!;
    string YN(bool? b)    => b == true ? "Yes" : (b == false ? "No" : "—");
}
<div class="mb-3">
    <div class="fw-semibold text-primary mb-2"><i class="bi bi-truck me-1"></i>Shipment Details</div>
    <div class="row g-3 small">
        <div class="col-md-4">
            <div class="qcs-f"><span>Shipper</span><span>@V(a.VendorName)</span></div>
            <div class="qcs-f"><span>Report Location</span><span>@V(a.Plant)</span></div>
            <div class="qcs-f"><span>Bill of Lading No.</span><span>@V(a.BolNo)</span></div>
            <div class="qcs-f"><span>Container</span><span>@V(a.ContainerNo)</span></div>
            <div class="qcs-f"><span>Purch.Doc.</span><span>@V(a.Ebeln)</span></div>
            <div class="qcs-f"><span>Country Of Origin</span><span>@V(s?.LoadingCountry)</span></div>
            <div class="qcs-f"><span>Loading Port</span><span>@V(s?.LoadingPort)</span></div>
            <div class="qcs-f"><span>Port Of Arrival</span><span>@V(s?.ArrivalPlace)</span></div>
            <div class="qcs-f"><span>Loading Date</span><span>@D(s?.SailingDate)</span></div>
        </div>
        <div class="col-md-4">
            <div class="qcs-f"><span>Vessel Name</span><span>@V(s?.VesselName)</span></div>
            <div class="qcs-f"><span>Arrival Date</span><span>@D(s?.ArrivalDate)</span></div>
            <div class="qcs-f"><span>Pullout Date</span><span>@D(s?.PullOutDate)</span></div>
            <div class="qcs-f"><span>Receive Date</span><span>@D(s?.ReceiveDate)</span></div>
            <div class="qcs-f"><span>Unloading Date</span><span>@D(s?.UnloadingDate)</span></div>
            <div class="qcs-f"><span>Inspection Date</span><span>@D(s?.InspectionDate)</span></div>
            <div class="qcs-f"><span>Discharge Date</span><span>@D(s?.DischargeDate)</span></div>
            <div class="qcs-f"><span>Transit Days</span><span>@(s?.TransitDays?.ToString() ?? "—")</span></div>
            <div class="qcs-f"><span>Logger Serial</span><span>@V(cl?.DataLoggerSerial)</span></div>
        </div>
        <div class="col-md-4">
            <div class="qcs-f"><span>Seal No</span><span>@V(cl?.SealNo?.Replace("\n", ", "))</span></div>
            <div class="qcs-f"><span>Temperature</span><span>@Fmt.Dec2(cl?.LoggerTemperature)</span></div>
            <div class="qcs-f"><span>Joint Survey</span><span>@YN(s?.JointSurvey)</span></div>
            <div class="qcs-f"><span>Seal Intact?</span><span>@YN(cl?.SealIntact)</span></div>
            <div class="qcs-f"><span>External damage</span><span>@YN(cl?.ExternalDamageExists)</span></div>
            <div class="qcs-f"><span>Visual cargo acceptable</span><span>@YN(cl?.VisualCargoAcceptable)</span></div>
            <div class="qcs-f"><span>Logger active &amp; data</span><span>@YN(cl?.LoggerActiveDataAvailable)</span></div>
        </div>
    </div>

    @if (Model.CustomFields.Count > 0)
    {
        <div class="mt-2">
            <div class="fw-semibold small text-decoration-underline text-muted">Additional Fields</div>
            <div class="row g-1 small mt-0">
                @foreach (var f in Model.CustomFields.OrderBy(x => x.SortOrder).ThenBy(x => x.FieldName))
                {
                    var pct = Model.PercentOf(f);
                    <div class="col-md-4 d-flex justify-content-between gap-2">
                        <span class="text-muted">@f.FieldName</span>
                        <span class="fw-semibold text-end">
                            @f.DisplayValue@(pct.HasValue ? $" ({Fmt.Dec2(pct.Value)}%)" : "")
                        </span>
                    </div>
                }
            </div>
        </div>
    }
    <hr class="my-3" />
</div>
