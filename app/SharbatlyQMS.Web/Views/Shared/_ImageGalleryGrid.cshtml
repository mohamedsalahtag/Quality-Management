@using SharbatlyQMS.Web.Services
@using SharbatlyQMS.Web.ViewModels
@model ImageGalleryVm
@inject IImageService ImageSvc
@inject ISettingsService SettingsSvc
@{
    var images = await ImageSvc.ListAsync(Model.OwnerType, Model.OwnerId);
    var thumb  = await SettingsSvc.GetThumbnailConfigAsync();
    var returnUrl = Context.Request.Path + Context.Request.QueryString;
}

@if (images.Count == 0)
{
    <div class="alert alert-light text-center text-muted">
        <i class="bi bi-images me-1"></i>No images uploaded yet.
    </div>
}
else
{
    <div class="d-flex flex-wrap gap-3">
        @foreach (var img in images)
        {
            <div class="card ig-card" data-image-link-id="@img.ImageLinkId" style="width:@(thumb.ScreenWidth + 16)px">
                <a href="@img.StorageUrl" target="_blank" class="text-decoration-none">
                    <img src="@(img.ThumbnailUrl ?? img.StorageUrl)"
                         class="card-img-top" loading="lazy"
                         style="width:@(thumb.ScreenWidth)px;height:@(thumb.ScreenHeight)px;object-fit:@(thumb.FitMode.Equals("Cover", StringComparison.OrdinalIgnoreCase) ? "cover" : "contain")"
                         alt="@img.OriginalName" />
                </a>
                <div class="card-body p-2">
                    <div class="small fw-bold text-truncate" title="@img.OriginalName">@img.OriginalName</div>
                    <div class="small text-muted">@img.Category</div>
                    <div class="small text-muted">@img.UploadedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</div>
                    @if (Model.Editable)
                    {
                        <form asp-controller="Images" asp-action="Delete" method="post"
                              data-confirm="Remove this image?" data-confirm-danger data-confirm-ok="Remove" class="mt-1">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="imageLinkId" value="@img.ImageLinkId" />
                            <input type="hidden" name="ownerType" value="@Model.OwnerType" />
                            <input type="hidden" name="ownerId" value="@Model.OwnerId" />
                            <input type="hidden" name="returnUrl" value="@returnUrl" />
                            <button type="submit" class="btn btn-sm btn-outline-danger w-100">
                                <i class="bi bi-trash"></i>
                            </button>
                        </form>
                    }
                </div>
            </div>
        }
    </div>
}
