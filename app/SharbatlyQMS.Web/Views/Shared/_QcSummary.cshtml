@using SharbatlyQMS.Web.Models
@using SharbatlyQMS.Web.Services.Pdf
@model IReadOnlyList<MaterialGroupSummary>
@*
    The grouped QC summary — the exact page-1 rollup the QC report prints, shared
    by the claim page (rendered inline) and the QO page's "Generate Summary"
    popup (loaded on demand). Model is the list from BuildGroupSummariesAsync.
    Requires the .qc-summary CSS on the host page (see QO Details.cshtml).
*@
@{
    var groupSummaries = Model ?? new List<MaterialGroupSummary>();
    var D = (string? v) => string.IsNullOrWhiteSpace(v) ? "—" : v!;
}
@if (groupSummaries.Count == 0)
{
    <p class="text-muted mb-0">No samples recorded yet — the summary appears once samples exist.</p>
}
else
{
    <div>
        @for (int gi = 0; gi < groupSummaries.Count; gi++)
        {
            var g = groupSummaries[gi];
            if (gi > 0) { <hr class="my-3" /> }

            var keyParts = new List<string>();
            if (!string.IsNullOrWhiteSpace(g.Brand))   { keyParts.Add(g.Brand!); }
            if (!string.IsNullOrWhiteSpace(g.Variety)) { keyParts.Add(g.Variety!); }
            if (!string.IsNullOrWhiteSpace(g.Grade))   { keyParts.Add(g.Grade!); }
            var keyLine = keyParts.Count > 0 ? string.Join("  ·  ", keyParts) : "(brand / variety / grade not set)";

            <div class="d-flex justify-content-between align-items-start flex-wrap gap-2">
                <div class="fw-semibold text-primary">@keyLine</div>
                <div class="small text-muted">
                    Material Group: <span class="fw-semibold">@g.MaterialGroup</span>@(string.IsNullOrWhiteSpace(g.MaterialGroupDesc) ? "" : " — " + g.MaterialGroupDesc)
                </div>
            </div>

            <div class="row g-3 mt-1 small">
                <div class="col-md-4">
                    <div class="qcs-f"><span>Product</span><span>@D(g.MajorCategory)</span></div>
                    <div class="qcs-f"><span>Brand</span><span>@D(g.Brand)</span></div>
                    <div class="qcs-f"><span>Variety</span><span>@D(g.Variety)</span></div>
                    <div class="qcs-f"><span>Grade</span><span>@D(g.Grade)</span></div>
                </div>
                <div class="col-md-4">
                    <div class="qcs-f"><span>Material Group</span><span>@D(g.MaterialGroup)</span></div>
                    <div class="qcs-f"><span>Count of Materials</span><span>@g.MaterialCount</span></div>
                    <div class="qcs-f"><span>Samples</span><span>@g.SampleCount Cartons</span></div>
                </div>
                <div class="col-md-4">
                    <div class="qcs-f"><span>Sample Size</span><span>@g.SumSampleSize @g.SampleUnit</span></div>
                    <div class="qcs-f"><span>PO Quantity</span><span>@g.SumPoQuantity.ToString("0.###")</span></div>
                </div>
            </div>

            var vis = SummaryReadingFilter.VisibleSummaryReadings(g.Readings);
            @if (vis.Count > 0)
            {
                <div class="mt-2">
                    <div class="fw-semibold small text-decoration-underline text-muted">Readings</div>
                    <div class="row g-1 small mt-0">
                        @foreach (var r in vis)
                        {
                            var lbl = string.IsNullOrWhiteSpace(r.Unit) ? r.Name : $"{r.Name} ({r.Unit})";
                            <div class="col-md-4 d-flex justify-content-between gap-2">
                                <span class="text-muted">@lbl</span>
                                <span class="fw-semibold text-end">@r.DisplayValue</span>
                            </div>
                        }
                    </div>
                </div>
            }

            @if (g.DefectSections.Count > 0)
            {
                <div class="row g-3 mt-1">
                    @foreach (var sec in g.DefectSections)
                    {
                        var col = SummaryReadingFilter.ReadableOnWhite(sec.ColorHex);
                        <div class="col-md-6">
                            <table class="table table-sm qcs-defects mb-0">
                                <thead>
                                    <tr>
                                        <th style="color:@col">@sec.CategoryName</th>
                                        <th class="text-end text-muted fw-normal">@sec.Unit</th>
                                        <th class="text-end text-muted fw-normal">Percentage</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @if (sec.Rows.Count == 0)
                                    {
                                        <tr><td colspan="3" class="fst-italic text-muted">No defects configured for this category in Defect Catalog.</td></tr>
                                    }
                                    else
                                    {
                                        foreach (var dr in sec.Rows)
                                        {
                                            <tr>
                                                <td>@dr.Name</td>
                                                <td class="text-end">@dr.SumValue.ToString("0.##")</td>
                                                <td class="text-end fw-semibold" style="color:@col">@dr.Percentage.ToString("0.##")%</td>
                                            </tr>
                                        }
                                        <tr class="qcs-total">
                                            <td class="fw-semibold">Total</td>
                                            <td class="text-end fw-semibold">@sec.TotalPieces.ToString("0.##")</td>
                                            <td class="text-end fw-bold" style="color:@col">@sec.TotalPct.ToString("0.##")%</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
            }
        }
    </div>
}
