@model ErrorViewModel
@{
    ViewData["Title"] = "Something went wrong";
    // SECURITY: this view is the friendly fallback for /Home/Error and is
    // wired up via app.UseExceptionHandler("/Home/Error") in Program.cs
    // ONLY when !Environment.IsDevelopment(). It must never render the
    // raw exception, stack trace, message, or query string -- any of
    // those can leak internals to an attacker. Only the RequestId
    // correlation token is shown, and only when the framework opted in.
}
<div class="text-center py-5">
    <i class="bi bi-exclamation-octagon display-1 text-danger"></i>
    <h1 class="h3 mt-3">Something went wrong</h1>
    <p class="text-muted">
        An unexpected error occurred while processing your request. Please try again,
        and contact your administrator if the problem continues.
    </p>
    @if (Model.ShowRequestId)
    {
        <p class="text-muted small mb-0">
            Reference for support: <code>@Model.RequestId</code>
        </p>
    }
    <a asp-controller="Home" asp-action="Index" class="btn btn-primary mt-3">
        <i class="bi bi-house me-1"></i>Back to dashboard
    </a>
</div>
