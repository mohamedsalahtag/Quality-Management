@using SharbatlyQMS.Web.Services
@using SharbatlyQMS.Web.ViewModels
@model ImageGalleryVm
@{
    var returnUrl = Context.Request.Path + Context.Request.QueryString;
}

<div class="image-gallery" data-ajax="@(Model.Ajax ? "true" : "false")"
     data-owner-type="@Model.OwnerType" data-owner-id="@Model.OwnerId">

@if (Model.Editable)
{
    <div class="card mb-3">
        <div class="card-header"><i class="bi bi-cloud-upload me-1"></i>Upload images</div>
        <div class="card-body">
            <form asp-controller="Images" asp-action="Upload" method="post" enctype="multipart/form-data" class="ig-upload-form">
                @Html.AntiForgeryToken()
                <input type="hidden" name="ownerType" value="@Model.OwnerType" />
                <input type="hidden" name="ownerId"   value="@Model.OwnerId" />
                <input type="hidden" name="returnUrl" value="@returnUrl" />
                <div class="row g-2 align-items-end">
                    @if (Model.Categories.Length > 0)
                    {
                        <div class="col-md-4">
                            <label class="form-label mb-1">Category</label>
                            <select name="category" class="form-select" required>
                                @foreach (var cat in Model.Categories)
                                {
                                    <option value="@cat">@cat</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label mb-1">Files</label>
                            <input type="file" name="files" class="form-control" multiple accept="image/*" required />
                        </div>
                        <div class="col-md-2">
                            <button type="submit" class="btn btn-primary w-100">
                                <i class="bi bi-cloud-upload me-1"></i>Upload
                            </button>
                        </div>
                    }
                    else
                    {
                        @* No categories configured (e.g. QO material photos) -
                           hide the dropdown and post an empty category. The
                           server tolerates a blank value. *@
                        <input type="hidden" name="category" value="" />
                        <div class="col-md-10">
                            <label class="form-label mb-1">Files</label>
                            <input type="file" name="files" class="form-control" multiple accept="image/*" required />
                        </div>
                        <div class="col-md-2">
                            <button type="submit" class="btn btn-primary w-100">
                                <i class="bi bi-cloud-upload me-1"></i>Upload
                            </button>
                        </div>
                    }
                </div>
                <small class="text-muted d-block mt-1">JPG / PNG / GIF / WEBP. Max 10 MB each.</small>
            </form>
        </div>
    </div>
}

<div class="ig-grid">
    <partial name="_ImageGalleryGrid" model="Model" />
</div>

</div>

@if (Model.Ajax)
{
    <script>
    // Add/remove images without a full-page reload so the surrounding tab stays
    // active. Delegated on document and registered once; only acts on galleries
    // flagged data-ajax="true". Other galleries keep their normal POST+redirect.
    (function () {
        if (window.__igAjaxInit) return;
        window.__igAjaxInit = true;

        function ajaxGalleryOf(el) {
            var g = el.closest('.image-gallery');
            return (g && g.getAttribute('data-ajax') === 'true') ? g : null;
        }

        document.addEventListener('submit', function (e) {
            if (e.defaultPrevented) return;          // e.g. delete confirm() was cancelled
            var form = e.target;
            var gallery = ajaxGalleryOf(form);
            if (!gallery) return;
            var grid = gallery.querySelector('.ig-grid');

            var isUpload = form.classList.contains('ig-upload-form');
            var isDelete = !isUpload && grid && grid.contains(form);
            if (!isUpload && !isDelete) return;

            e.preventDefault();
            var btn = form.querySelector('button[type="submit"]');
            if (btn) btn.disabled = true;

            fetch(form.action, {
                method: 'POST',
                headers: { 'X-Requested-With': 'XMLHttpRequest' },
                body: new FormData(form)
            })
            .then(function (r) { if (!r.ok) throw new Error('Request failed'); return r.text(); })
            .then(function (html) {
                grid.innerHTML = html;
                if (isUpload) {
                    var file = form.querySelector('input[type="file"]');
                    if (file) file.value = '';
                }
            })
            .catch(function () { alert(isUpload ? 'Upload failed. Please try again.' : 'Could not remove the image.'); })
            .finally(function () { if (btn) btn.disabled = false; });
        });
    })();
    </script>
}
