@using SharbatlyQMS.Web.Services
@using SharbatlyQMS.Web.ViewModels
@model ImageGalleryVm
@{
    var returnUrl = Context.Request.Path + Context.Request.QueryString;
}

<div class="image-gallery" data-ajax="@(Model.Ajax ? "true" : "false")"
     data-owner-type="@Model.OwnerType" data-owner-id="@Model.OwnerId">

@if (Model.Editable)
{
    <div class="card mb-3">
        <div class="card-header"><i class="bi bi-cloud-upload me-1"></i>Upload images</div>
        <div class="card-body">
            <form asp-controller="Images" asp-action="Upload" method="post" enctype="multipart/form-data" class="ig-upload-form">
                @Html.AntiForgeryToken()
                <input type="hidden" name="ownerType" value="@Model.OwnerType" />
                <input type="hidden" name="ownerId"   value="@Model.OwnerId" />
                <input type="hidden" name="returnUrl" value="@returnUrl" />
                <div class="row g-2 align-items-end">
                    @if (Model.Categories.Length > 0)
                    {
                        <div class="col-md-4">
                            <label class="form-label mb-1">Category</label>
                            <select name="category" class="form-select" required>
                                @foreach (var cat in Model.Categories)
                                {
                                    <option value="@cat">@cat</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label mb-1">Files</label>
                            <input type="file" name="files" class="form-control" multiple accept="image/*" required />
                        </div>
                        <div class="col-md-2">
                            <button type="submit" class="btn btn-primary w-100">
                                <i class="bi bi-cloud-upload me-1"></i>Upload
                            </button>
                        </div>
                    }
                    else
                    {
                        @* No categories configured (e.g. QO material photos) -
                           hide the dropdown and post an empty category. The
                           server tolerates a blank value.

                           V31 (2026-06-20): for per-sample galleries (Ajax=true)
                           render an enriched drop-zone -- drag/drop, paste, and
                           click-to-pick all submit the file list. *@
                        <input type="hidden" name="category" value="" />
                        @if (Model.Ajax)
                        {
                            @* V31 (2026-06-20): per-sample upload bar.
                               - Browse: standard file picker (works on desktop + mobile).
                               - Camera: capture="environment" -> rear camera on mobile/tablet;
                                 desktop browsers ignore capture and fall back to the picker.
                               - Drop-zone: drag/drop + paste + click-to-pick (existing). *@
                            <div class="col-12">
                                <div class="d-flex flex-wrap gap-2 mb-2 align-items-center">
                                    <label class="btn btn-primary btn-sm mb-0 ig-browse-label">
                                        <i class="bi bi-folder2-open me-1"></i>Browse files
                                        <input class="ig-extra-file" type="file" name="files"
                                               multiple accept="image/*" hidden />
                                    </label>
                                    <label class="btn btn-outline-primary btn-sm mb-0 ig-camera-label"
                                           title="Open the device camera (mobile / tablet) or file picker (desktop)">
                                        <i class="bi bi-camera me-1"></i>Camera
                                        <input class="ig-extra-file" type="file" name="files"
                                               multiple accept="image/*" capture="environment" hidden />
                                    </label>
                                    <span class="text-muted small">or drag &amp; drop / paste from clipboard:</span>
                                </div>
                                <div class="photo-dropzone" role="button" tabindex="0">
                                    <i class="bi bi-cloud-arrow-up fs-3 d-block mb-1 text-muted"></i>
                                    <strong>Drop photos here</strong>
                                    <div class="small text-muted mt-1">JPG / PNG / GIF / WEBP — max 10 MB each. Multiple files supported.</div>
                                    <input type="file" name="files" multiple accept="image/*" />
                                </div>
                            </div>
                        }
                        else
                        {
                            <div class="col-md-10">
                                <label class="form-label mb-1">Files</label>
                                <input type="file" name="files" class="form-control" multiple accept="image/*" required />
                            </div>
                            <div class="col-md-2">
                                <button type="submit" class="btn btn-primary w-100">
                                    <i class="bi bi-cloud-upload me-1"></i>Upload
                                </button>
                            </div>
                        }
                    }
                </div>
                <small class="text-muted d-block mt-1">JPG / PNG / GIF / WEBP. Max 10 MB each.</small>
            </form>
        </div>
    </div>
}

<div class="ig-grid">
    <partial name="_ImageGalleryGrid" model="Model" />
</div>

</div>

@* V31 (2026-06-20): AJAX wiring moved to /js/image-gallery-ajax.js (loaded
   once in _Layout.cshtml). Inline <script> tags inside this partial would not
   execute when the partial is injected via innerHTML in the sample drawer. *@
