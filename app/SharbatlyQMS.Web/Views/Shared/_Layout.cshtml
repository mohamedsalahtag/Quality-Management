@using SharbatlyQMS.Web.Models
@using SharbatlyQMS.Web.Services
@inject ISettingsService _siteSettings
@{
    var siteName = "Sharbatly QMS";
    // Branding settings drive the <link rel="icon"> emitted below. One small
    // DB hit per request -- acceptable for an internal LAN app. If profiling
    // ever shows this as hot, wrap in IMemoryCache (already registered).
    var branding = await _siteSettings.GetBrandingConfigAsync();
    var role = User?.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value;
    var fullName = User?.FindFirst(System.Security.Claims.ClaimTypes.GivenName)?.Value
                ?? User?.Identity?.Name;
    // Plant scope claim — present only for Operators with a plant assignment.
    // Rendered as a badge next to the user name so the operator can tell at a
    // glance which plant's data they're seeing.
    var plantScope = User?.FindFirst("PlantCode")?.Value;
    if (string.IsNullOrWhiteSpace(plantScope)) plantScope = null;
    // Role gates for menu visibility. Parameters need Manager or SiteAdmin;
    // Admin pages stay SiteAdmin-only.
    var canSeeParameters = role == UserRoles.Manager || role == UserRoles.SiteAdmin;
    var canSeeAdmin      = role == UserRoles.SiteAdmin;
    // Audit Log nav moved under the Admin dropdown 2026-05-21 -- gated by
    // canSeeAdmin (SiteAdmin only). Per-record audit panels on QO/Arrival/
    // Claim detail pages are STILL visible to Manager + SiteAdmin via their
    // own local `canSeeAudit` variable in those views. The Auditor role
    // itself was retired on 2026-05-21 (V16 migration).
    var userIdClaim      = User?.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
    // View-as impersonation: the real SiteAdmin role lands in OriginalRole
    // while the swapped role lands in Role. realRole drives the dropdown
    // (only real admins see it); impersonating == claims differ.
    var originalRole  = User?.FindFirst(ViewAsClaimsTransformer.OriginalRoleClaim)?.Value;
    var realRole      = originalRole ?? role;
    var impersonating = originalRole != null && originalRole != role;
    var canViewAs     = realRole == UserRoles.SiteAdmin;
    var returnUrl     = Context.Request.Path + Context.Request.QueryString;

    // Navbar active-link highlighting. The Parameters and Admin menus both live
    // on the Admin controller, so they're disambiguated by action set rather
    // than controller alone.
    var curCtl = ViewContext.RouteData.Values["controller"] as string ?? "";
    var curAct = ViewContext.RouteData.Values["action"] as string ?? "";
    bool NavOn(string ctl) => string.Equals(curCtl, ctl, StringComparison.OrdinalIgnoreCase);
    bool ActOn(string act) => string.Equals(curAct, act, StringComparison.OrdinalIgnoreCase);
    var paramActions = new[] { "DefectCatalog", "DefectCategories", "ReadingTypes", "SampleHeaders", "MailTemplate" };
    var paramsOn     = NavOn("Admin") && paramActions.Contains(curAct, StringComparer.OrdinalIgnoreCase);
    var adminOn      = (NavOn("Admin") && (ActOn("Settings") || ActOn("Users"))) || NavOn("Audit");
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@(ViewData["Title"] != null ? ViewData["Title"] + " - " + siteName : siteName)</title>

    @* Favicon: driven by Branding.FaviconChoice. `sizes="any"` tells the
       browser to use this for every requested size and ignore the default
       /favicon.ico (which static-file middleware still serves as a fallback
       for the bare /favicon.ico request from some clients). *@
    <link rel="icon" href="@branding.FaviconHref" type="@branding.FaviconType" sizes="any" />

    @* theme-pack: FOUC prevention -- MUST be the first script in <head>, BEFORE any CSS. *@
    <script>
        (function () {
            var t = localStorage.getItem("app-theme") || "light";
            document.documentElement.setAttribute("data-theme", t);
            document.documentElement.setAttribute("data-bs-theme", t === "dark" ? "dark" : "light");
        })();
    </script>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/lib/bootstrap-icons/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    @* theme-pack stylesheet -- MUST be the LAST stylesheet so it can override Bootstrap variables. *@
    <link rel="stylesheet" href="~/css/theme-pack.css" asp-append-version="true" />
</head>
<body>
    @if (User?.Identity?.IsAuthenticated == true)
    {
    <header>
        <nav class="navbar navbar-expand-md bg-primary mb-3 shadow-sm">
            <div class="container-fluid">
                <a class="navbar-brand fw-semibold" asp-controller="Home" asp-action="Index">
                    <i class="bi bi-clipboard2-check me-1"></i>@siteName
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="mainNav">
                    <ul class="navbar-nav me-auto">
                        @{
                            // Pending Containers is hosted under ArrivalsController so we
                            // distinguish by action to highlight the right nav item.
                            var onPending  = NavOn("Arrivals") && ActOn("Pending");
                            var onArrivals = NavOn("Arrivals") && !ActOn("Pending");
                        }
                        <li class="nav-item">
                            <a class="nav-link @(onPending ? "active" : "")" aria-current="@(onPending ? "page" : null)" asp-controller="Arrivals" asp-action="Pending">
                                <i class="bi bi-inbox me-1"></i>Pending Containers
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(onArrivals ? "active" : "")" aria-current="@(onArrivals ? "page" : null)" asp-controller="Arrivals" asp-action="Index">
                                <i class="bi bi-box-arrow-in-down me-1"></i>Arrivals
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(NavOn("QualityOrders") ? "active" : "")" aria-current="@(NavOn("QualityOrders") ? "page" : null)" asp-controller="QualityOrders" asp-action="Index">
                                <i class="bi bi-clipboard-data me-1"></i>Quality Orders
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(NavOn("ClaimManagement") ? "active" : "")" aria-current="@(NavOn("ClaimManagement") ? "page" : null)" asp-controller="ClaimManagement" asp-action="Index">
                                <i class="bi bi-shield-exclamation me-1"></i>Claims
                            </a>
                        </li>
                        @* V31 (2026-06-20): flat per-defect data hub for analytics.
                           Gated client-side by role (Supervisor and above) -- the
                           controller's [Authorize] guard is authoritative. *@
                        @if (role == UserRoles.Supervisor || role == UserRoles.Manager || role == UserRoles.SiteAdmin)
                        {
                            <li class="nav-item">
                                <a class="nav-link @(NavOn("Reports") ? "active" : "")" asp-controller="Reports" asp-action="FlatDefects">
                                    <i class="bi bi-grid-3x3-gap me-1"></i>Data hub
                                </a>
                            </li>
                        }
                        @if (canSeeParameters)
                        {
                            @* Parameters: per-material-group catalogs that drive
                               the sample form (defects + readings). Manager+
                               can access; Operator and Viewer cannot. *@
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle @(paramsOn ? "active" : "")" aria-current="@(paramsOn ? "page" : null)" href="#" data-bs-toggle="dropdown">
                                    <i class="bi bi-sliders2 me-1"></i>Parameters
                                </a>
                                <ul class="dropdown-menu">
                                    <li><a class="dropdown-item @(ActOn("DefectCatalog") ? "active" : "")" asp-controller="Admin" asp-action="DefectCatalog"><i class="bi bi-list-check me-1"></i>Defect Catalog</a></li>
                                    <li><a class="dropdown-item @(ActOn("DefectCategories") ? "active" : "")" asp-controller="Admin" asp-action="DefectCategories"><i class="bi bi-palette me-1"></i>Defect Categories</a></li>
                                    <li><a class="dropdown-item @(ActOn("ReadingTypes") ? "active" : "")" asp-controller="Admin" asp-action="ReadingTypes"><i class="bi bi-rulers me-1"></i>Reading Types</a></li>
                                    <li><a class="dropdown-item @(ActOn("SampleHeaders") ? "active" : "")" asp-controller="Admin" asp-action="SampleHeaders"><i class="bi bi-card-heading me-1"></i>Sample Headers</a></li>
                                    <li><a class="dropdown-item @(ActOn("MailTemplate") ? "active" : "")" asp-controller="Admin" asp-action="MailTemplate"><i class="bi bi-envelope-paper me-1"></i>Mail Template</a></li>
                                </ul>
                            </li>
                        }
                        @if (canSeeAdmin)
                        {
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle @(adminOn ? "active" : "")" aria-current="@(adminOn ? "page" : null)" href="#" data-bs-toggle="dropdown">
                                    <i class="bi bi-gear me-1"></i>Admin
                                </a>
                                <ul class="dropdown-menu">
                                    <li><a class="dropdown-item @(ActOn("Settings") ? "active" : "")" asp-controller="Admin" asp-action="Settings"><i class="bi bi-sliders me-1"></i>Site Configuration</a></li>
                                    <li><a class="dropdown-item @(ActOn("Users") ? "active" : "")" asp-controller="Admin" asp-action="Users"><i class="bi bi-people me-1"></i>Users</a></li>
                                    <li><a class="dropdown-item @(NavOn("Audit") ? "active" : "")" asp-controller="Audit" asp-action="Index"><i class="bi bi-shield-shaded me-1"></i>Audit Log</a></li>
                                </ul>
                            </li>
                        }
                    </ul>
                    <ul class="navbar-nav">
                        @if (canViewAs)
                        {
                            @* View site as: SiteAdmin-only role impersonation
                               for testing security gates without re-login. *@
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle @(impersonating ? "text-warning fw-semibold" : "")"
                                   href="#" data-bs-toggle="dropdown"
                                   title="View site as another role (testing)">
                                    <i class="bi bi-incognito me-1"></i>View as: @role
                                </a>
                                <ul class="dropdown-menu dropdown-menu-end">
                                    <li><h6 class="dropdown-header">View site as</h6></li>
                                    @* V31 (2026-06-20): Supervisor added to the impersonation list. *@
                                    @foreach (var r in new[] { UserRoles.Viewer, UserRoles.Operator, UserRoles.Supervisor, UserRoles.Manager, UserRoles.ClaimManager })
                                    {
                                        <li>
                                            <form asp-controller="Account" asp-action="ViewAs" method="post" class="d-inline">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="role" value="@r" />
                                                <input type="hidden" name="returnUrl" value="@returnUrl" />
                                                <button type="submit" class="dropdown-item @(role == r ? "active" : "")">
                                                    <i class="bi bi-person me-2"></i>@r
                                                </button>
                                            </form>
                                        </li>
                                    }
                                    <li><hr class="dropdown-divider" /></li>
                                    <li>
                                        <form asp-controller="Account" asp-action="ViewAs" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="role" value="" />
                                            <input type="hidden" name="returnUrl" value="@returnUrl" />
                                            <button type="submit" class="dropdown-item @(!impersonating ? "active" : "")">
                                                <i class="bi bi-person-check me-2"></i>Become self (SiteAdmin)
                                            </button>
                                        </form>
                                    </li>
                                </ul>
                            </li>
                        }
                        @* theme-pack picker *@
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle" href="#" data-bs-toggle="dropdown" title="Theme" aria-label="Theme picker">
                                <i class="bi bi-palette"></i>
                            </a>
                            <ul class="dropdown-menu dropdown-menu-end">
                                <li><h6 class="dropdown-header">Theme</h6></li>
                                <li><a class="dropdown-item theme-pick" data-theme="light"  href="#"><i class="bi bi-sun me-2"></i>Light</a></li>
                                <li><a class="dropdown-item theme-pick" data-theme="dark"   href="#"><i class="bi bi-moon-stars me-2"></i>Dark</a></li>
                                <li><a class="dropdown-item theme-pick" data-theme="blue"   href="#"><i class="bi bi-droplet me-2"></i>Blue</a></li>
                                <li><a class="dropdown-item theme-pick" data-theme="sepia"  href="#"><i class="bi bi-cup-hot me-2"></i>Sepia</a></li>
                                <li><a class="dropdown-item theme-pick" data-theme="forest" href="#"><i class="bi bi-tree me-2"></i>Forest</a></li>
                                <li><a class="dropdown-item theme-pick" data-theme="rose"   href="#"><i class="bi bi-flower1 me-2"></i>Rose</a></li>
                            </ul>
                        </li>
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle d-flex align-items-center gap-2" href="#" data-bs-toggle="dropdown">
                                @await Html.PartialAsync("_UserAvatar", new ViewDataDictionary(ViewData) { { "Size", 28 } })
                                <span>@fullName</span>
                                @if (plantScope != null)
                                {
                                    <span class="badge bg-info text-dark border ms-1"
                                          title="Your queue, arrivals, and quality orders are restricted to this plant.">
                                        <i class="bi bi-geo-alt me-1"></i>@plantScope
                                    </span>
                                }
                            </a>
                            <ul class="dropdown-menu dropdown-menu-end">
                                <li><h6 class="dropdown-header">@role @if (plantScope != null) { <text>— @SapPlantDirectory.PlantLabel(plantScope)</text> }</h6></li>
                                <li><a class="dropdown-item" asp-controller="Account" asp-action="Profile"><i class="bi bi-person-vcard me-1"></i>My Profile</a></li>
                                <li><hr class="dropdown-divider" /></li>
                                <li>
                                    <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="dropdown-item">
                                            <i class="bi bi-box-arrow-right me-1"></i>Sign out
                                        </button>
                                    </form>
                                </li>
                            </ul>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
        @if (impersonating)
        {
            <div class="alert alert-warning rounded-0 mb-0 py-2 d-flex align-items-center" role="alert">
                <i class="bi bi-incognito me-2"></i>
                <span>Viewing the site as <strong>@role</strong> (your real role: <strong>@originalRole</strong>).</span>
                <form asp-controller="Account" asp-action="ViewAs" method="post" class="ms-auto">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="role" value="" />
                    <input type="hidden" name="returnUrl" value="@returnUrl" />
                    <button type="submit" class="btn btn-sm btn-warning">
                        <i class="bi bi-person-check me-1"></i>Become self
                    </button>
                </form>
            </div>
        }
    </header>
    }

    <div class="container-fluid px-4">
        @if (TempData["Success"] is string okMsg)
        {
            @* Success flash messages auto-dismiss after 4 s so quick
               actions like image upload don't leave a sticky banner. *@
            <div class="alert alert-success alert-dismissible fade show" role="alert" data-auto-dismiss="4000">
                <i class="bi bi-check-circle me-1"></i>@okMsg
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }
        @if (TempData["Error"] is string errMsg)
        {
            @* Errors stay until the user closes them. *@
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                <i class="bi bi-exclamation-triangle me-1"></i>@errMsg
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/theme-pack.js" asp-append-version="true"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/tablekit.js" asp-append-version="true"></script>
    @* Auto-dismiss any alert tagged with `data-auto-dismiss="<ms>"`. Lives
       here, after Bootstrap loads, so the fade animation reliably runs. *@
    <script>
        (function () {
            function dismiss(el) {
                el.classList.remove('show');
                setTimeout(function () { el.remove(); }, 250);
            }
            function arm() {
                document.querySelectorAll('.alert[data-auto-dismiss]').forEach(function (el) {
                    if (el.dataset._armed === '1') return;
                    el.dataset._armed = '1';
                    var ms = parseInt(el.getAttribute('data-auto-dismiss'), 10) || 4000;
                    setTimeout(function () { dismiss(el); }, ms);
                });
            }
            if (document.readyState === 'loading') {
                document.addEventListener('DOMContentLoaded', arm);
            } else {
                arm();
            }
        })();
    </script>
    @* V31 (2026-06-20): document-level AJAX wiring for any image gallery on
       the page (including ones injected later into the sample drawer via
       innerHTML, where inline <script> tags would not run). *@
    <script src="~/js/image-gallery-ajax.js" defer></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
