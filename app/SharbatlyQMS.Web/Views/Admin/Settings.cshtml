    @* ---- Page icon (favicon) ---- *@
    <div class="card mt-3">
        <div class="card-header bg-primary text-white"><i class="bi bi-globe me-1"></i>Page icon (browser tab favicon)</div>
        <div class="card-body">
            <p class="small text-muted mb-3">
                Icon shown in the browser tab and bookmark bar. Real photo-style 3D fruit images
                from Microsoft's Fluent UI Emoji set — identical on every browser. Apple and
                banana are first because they're Sharbatly's majors.
            </p>
            <style>
                .fav-tile {
                    border: 2px solid var(--bs-border-color);
                    border-radius: .4rem;
                    padding: .35rem .25rem;
                    text-align: center;
                    cursor: pointer;
                    transition: all .15s;
                    background: var(--bs-body-bg);
                }
                .fav-tile:hover { border-color: var(--bs-primary); }
                .fav-tile.selected {
                    border-color: var(--bs-primary);
                    box-shadow: 0 0 0 .12rem rgba(13,110,253,.25);
                    background: var(--bs-primary-bg-subtle, #cfe2ff);
                }
                .fav-tile .fav-img { width: 32px; height: 32px; object-fit: contain; display: block; margin: 0 auto; }
                .fav-tile .fav-default-icon { font-size: 1.5rem; line-height: 1; color: var(--bs-primary); }
                .fav-tile .fav-label { font-size: .7rem; margin-top: .2rem; color: var(--bs-body-color); }
                .fav-tile button { all: unset; display: block; width: 100%; }
            </style>
            <form asp-action="SaveFaviconChoice" method="post" id="favChoiceForm">
                @Html.AntiForgeryToken()
                <input type="hidden" name="choice" id="favChoiceInput" value="@Model.Branding.FaviconChoice" />
                <div class="row row-cols-3 row-cols-md-6 row-cols-lg-8 g-2">
                    @* Default (current bundled favicon.ico) *@
                    @{
                        var isDefault = string.IsNullOrEmpty(Model.Branding.FaviconChoice);
                    }
                    <div class="col">
                        <div class="fav-tile @(isDefault ? "selected" : "")" data-fav="">
                            <button type="button" title="Default QMS icon">
                                <div class="fav-default-icon"><i class="bi bi-clipboard2-check"></i></div>
                                <div class="fav-label">Default</div>
                            </button>
                        </div>
                    </div>

                    @* Built-in fruit choices (real 3D images, singles only) *@
                    @foreach (var (key, label) in FaviconChoices.BuiltIn)
                    {
                        var isSel = Model.Branding.FaviconChoice == key;
                        <div class="col">
                            <div class="fav-tile @(isSel ? "selected" : "")" data-fav="@key">
                                <button type="button" title="@label">
                                    <img class="fav-img" src="@FaviconChoices.WebPath(key)" alt="@label" />
                                    <div class="fav-label">@label</div>
                                </button>
                            </div>
                        </div>
                    }

                    @* Custom uploaded image tile.
                       Two states:
                         - HasCustomFavicon=false: tile is a <label> wrapping the
                           hidden file input below. Clicking it opens the OS file
                           picker; selecting a file auto-submits the upload form.
                         - HasCustomFavicon=true: tile picks the "custom" choice
                           (same as a fruit tile) and an extra "Replace" link
                           (also a <label> for the same hidden input) lets the
                           user swap the file. *@
                    @{
                        var isCustom = Model.Branding.FaviconChoice == FaviconChoices.Custom
                                       && Model.Branding.HasCustomFavicon;
                    }
                    @if (Model.Branding.HasCustomFavicon)
                    {
                        <div class="col">
                            <div class="fav-tile @(isCustom ? "selected" : "")" data-fav="@FaviconChoices.Custom">
                                <button type="button" title="Use my uploaded image">
                                    @* Cache-bust the preview with a timestamp so a freshly-replaced
                                       file shows up immediately. *@
                                    <img class="fav-img"
                                         src="/branding/@Model.Branding.FaviconCustomFilename?v=@DateTime.UtcNow.Ticks"
                                         alt="My uploaded image" />
                                    <div class="fav-label">My image</div>
                                </button>
                            </div>
                            <div class="text-center mt-1">
                                <label for="custom-favicon-file"
                                       class="text-primary small"
                                       style="cursor:pointer; font-size:.7rem;">
                                    <i class="bi bi-arrow-repeat"></i> Replace
                                </label>
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="col">
                            @* The whole tile is a <label> that triggers the hidden
                               file input. No JS needed -- native HTML behavior. *@
                            <label for="custom-favicon-file" class="fav-tile m-0" style="cursor:pointer;">
                                <div class="fav-default-icon"><i class="bi bi-cloud-arrow-up text-success"></i></div>
                                <div class="fav-label">Upload yours</div>
                            </label>
                        </div>
                    }
                </div>
            </form>

            @* The single hidden upload form. Both the "Upload yours" tile (when
               no custom file exists) and the "Replace" link (when one does)
               point at this same file input. Auto-submits when a file is
               picked, so the user never sees a separate "save" step. *@
            <form asp-action="UploadCustomFavicon" method="post"
                  enctype="multipart/form-data" id="customUploadForm" class="d-none">
                @Html.AntiForgeryToken()
                <input type="file"
                       id="custom-favicon-file"
                       name="favicon"
                       accept=".png,.jpg,.jpeg,.gif,.webp,.svg,.ico" />
            </form>

            @if (Model.Branding.HasCustomFavicon)
            {
                <div class="mt-3 d-flex align-items-center gap-2">
                    <small class="text-muted">
                        <i class="bi bi-info-circle me-1"></i>
                        Current upload: <code>@Model.Branding.FaviconCustomFilename</code>
                    </small>
                    <form asp-action="RemoveCustomFavicon" method="post" class="ms-auto"
                          onsubmit="return confirm('Remove your uploaded image? If it is currently active, the default icon will be restored.');">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-outline-danger btn-sm">
                            <i class="bi bi-trash me-1"></i>Remove uploaded image
                        </button>
                    </form>
                </div>
            }
            <div class="mt-2 small text-muted">
                Accepts PNG / JPG / SVG / ICO up to 2 MB. Square images (32x32 px or larger) work best.
                After uploading, your image becomes the page icon — press <kbd>Ctrl</kbd>+<kbd>F5</kbd> to refresh the tab.
            </div>
        </div>
    </div>
</div>

<script>
    (function () {
        // Auto-submit the picker form when a tile with data-fav is clicked.
        // Tiles without data-fav (the upload-trigger tile when no custom
        // file exists yet) fall through to native <label for=...> behavior,
        // which opens the OS file dialog for the hidden file input.
        var form  = document.getElementById('favChoiceForm');
        var input = document.getElementById('favChoiceInput');
        if (form && input) {
            document.querySelectorAll('.fav-tile[data-fav]').forEach(function (tile) {
                tile.addEventListener('click', function () {
                    input.value = tile.getAttribute('data-fav') || '';
                    form.submit();
                });
            });
        }

        // Auto-submit the upload form the moment the user picks a file --
        // no separate "Upload" button. One click on the tile -> file picker
        // -> select -> form submits -> page reloads with the new favicon.
        var fileInput = document.getElementById('custom-favicon-file');
        var uploadForm = document.getElementById('customUploadForm');
        if (fileInput && uploadForm) {
            fileInput.addEventListener('change', function () {
                if (fileInput.files && fileInput.files.length > 0) {
                    uploadForm.submit();
                }
            });
        }
    })();
</script>

