<div class="@TabPaneClass("syncstatus")" id="tab-syncstatus">
    <div class="card mb-3">
        <div class="card-header bg-primary text-white"><i class="bi bi-bar-chart me-1"></i>Per-endpoint sync status</div>
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Endpoint</th>
                        <th>Last sync</th>
                        <th class="text-end">Rows</th>
                        <th>Result</th>
                        <th>Auto-sync</th>
                        <th>Hours</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var s in new[] { Model.MaterialSync, Model.VendorSync })
                    {
                        var label = s.EndpointKey == SyncableEndpoints.MaterialMaster ? "Material Master" : "Vendor Master";
                        var ok = !string.IsNullOrWhiteSpace(s.LastResult) && s.LastResult!.StartsWith("OK", StringComparison.OrdinalIgnoreCase);
                        <tr>
                            <td><strong>@label</strong></td>
                            <td>@(s.LastRunUtc.HasValue ? s.LastRunUtc.Value.ToLocalTime().ToString("yyyy-MM-dd HH:mm") : "—")</td>
                            <td class="text-end">@(s.LastRowCount?.ToString("N0") ?? "—")</td>
                            <td>
                                @if (string.IsNullOrWhiteSpace(s.LastResult))
                                {
                                    <span class="text-muted">—</span>
                                }
                                else
                                {
                                    <span class="@(ok ? "text-success" : "text-danger") small">@s.LastResult</span>
                                }
                            </td>
                            <td>
                                @if (s.Enabled)
                                {
                                    <span class="badge bg-success">Enabled</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">Disabled</span>
                                }
                            </td>
                            <td>
                                @(s.Hours.Count > 0
                                  ? string.Join(", ", s.Hours.OrderBy(h => h).Select(h => h.ToString("D2") + ":00"))
                                  : "—")
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    @* ---- Per-endpoint schedule editor ---- *@
    @foreach (var s in new[] { Model.MaterialSync, Model.VendorSync })
    {
        var label = s.EndpointKey == SyncableEndpoints.MaterialMaster ? "Material Master" : "Vendor Master";
        var hoursCsv = string.Join(", ", s.Hours.OrderBy(h => h));
        <div class="card mb-3">
            <div class="card-header bg-primary text-white">
                <i class="bi bi-clock-history me-1"></i>@label &mdash; auto-sync schedule
            </div>
            <div class="card-body">
                <form asp-action="SaveEndpointSync" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="endpointKey" value="@s.EndpointKey" />
                    <div class="form-check form-switch mb-3">
                        <input class="form-check-input" type="checkbox" role="switch"
                               id="enabled-@s.EndpointKey" name="enabled" value="true"
                               @(s.Enabled ? "checked" : "") />
                        <label class="form-check-label fw-bold" for="enabled-@s.EndpointKey">
                            Enable scheduled auto-sync
                        </label>
                        <div class="text-muted small">
                            Background scheduler polls every minute; same hour will not trigger twice.
                        </div>
                    </div>
                    <label class="form-label small fw-bold mb-1">Scheduled hours (24-hour clock, comma-separated)</label>
                    <input type="text" name="hoursCsv" value="@hoursCsv"
                           class="form-control font-monospace mb-2" placeholder="e.g. 2, 14" />
                    <small class="text-muted d-block mb-3">
                        Example: <code>2, 14</code> runs at 02:00 and 14:00 server local time.
                        Leave blank to disable scheduled runs.
                    </small>
                    <button type="submit" class="btn btn-primary">
                        <i class="bi bi-save me-1"></i>Save @label schedule
                    </button>
                </form>
            </div>
        </div>
    }
</div>

