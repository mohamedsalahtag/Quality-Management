        <div class="card-header bg-primary text-white"><i class="bi bi-person-lines-fill me-1"></i>Active Directory (domain sign-in)</div>
        <div class="card-body">
            <p class="text-muted small mb-3">
                When configured, users sign in with their <strong>domain credentials</strong>
                (LDAP bind). The local seed admin still works as a recovery path.
                Use the <strong>Test connection</strong> button to verify the values without saving.
            </p>
            <form asp-action="SaveAdSettings" method="post" id="ad-form">
                @Html.AntiForgeryToken()
                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label">Domain *</label>
                        <input name="Domain" id="ad-domain" value="@Model.Ad.Domain"
                               class="form-control" placeholder="sharbatly.local" />
                        <div class="form-text">e.g. <code>sharbatly.local</code> or <code>corp.example.com</code>.</div>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">LDAP path</label>
                        <input name="LdapPath" id="ad-ldap" value="@Model.Ad.LdapPath"
                               class="form-control" placeholder="dc1.sharbatly.local/DC=sharbatly,DC=local" />
                        <div class="form-text">Optional. Server + base DN. Leave blank to use the domain.</div>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Service account user</label>
                        <input name="ServiceUser" id="ad-user" value="@Model.Ad.ServiceUser"
                               class="form-control" placeholder="svc-qms" />
                        <div class="form-text">Read-only AD account used for browsing the user list and the Test button.</div>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Service account password</label>
                        <input name="ServicePassword" id="ad-pass" type="password"
                               class="form-control" placeholder="Leave blank to keep the saved password"
                               autocomplete="new-password" />
                    </div>
                    <div class="col-12">
                        <div class="form-check form-switch">
                            <input name="AutoCreateOnLogin" id="ad-autocreate" class="form-check-input"
                                   type="checkbox" role="switch" value="true"
                                   @(Model.Ad.AutoCreateOnLogin ? "checked" : "") />
                            <label class="form-check-label" for="ad-autocreate">
                                Auto-create local profile on first successful AD login
                                <span class="text-muted small">— new users land with the <strong>Viewer</strong> role until an admin promotes them. Leave off to require admins to pick AD users explicitly.</span>
                            </label>
                        </div>
                    </div>
                </div>
                <div class="mt-3 d-flex gap-2 flex-wrap align-items-center">
                    <button type="submit" class="btn btn-primary"><i class="bi bi-save me-1"></i>Save AD settings</button>
                    <button type="button" id="testAdBtn" class="btn btn-outline-secondary">
                        <i class="bi bi-plug me-1"></i>Test connection
                    </button>
                    <span id="testAdResult" class="ms-2 small"></span>
                </div>
            </form>
        </div>
    </div>
</div>

@* ===================== Danger Zone ===================== *@
<div class="@TabPaneClass("danger")" id="tab-danger">
    <div class="card border-danger">
        <div class="card-header bg-danger text-white d-flex align-items-center">
            <i class="bi bi-exclamation-octagon-fill me-2"></i>
            <strong>Danger Zone</strong>
            <span class="badge bg-light text-danger ms-2">Destructive &mdash; irreversible</span>
        </div>
        <div class="card-body">
            <h5 class="text-danger"><i class="bi bi-trash3-fill me-1"></i>Purge all operational data</h5>
            <p class="mb-2">
                Use this when moving from <strong>testing</strong> to <strong>production</strong> so the live system
                starts with a clean slate. Everything users have created during testing is wiped; the system goes
                back to a freshly-installed state.
            </p>
            <div class="alert alert-danger mb-3">
                <strong><i class="bi bi-exclamation-triangle-fill me-1"></i>This action will permanently delete:</strong>
                <ul class="mb-1 mt-2">
                    <li><strong>All Arrival Overviews</strong> &mdash; including arrival items, checklists, and SAP/shipment snapshots</li>
                    <li><strong>All Quality Orders</strong> &mdash; including materials, samples, readings, observations, and per-sample defects</li>
                    <li><strong>All uploaded images and thumbnails</strong> &mdash; database records <em>and</em> the files under <code>wwwroot/uploads/</code></li>
                    <li><strong>All status history, audit log entries, and generated PDF report records</strong></li>
                </ul>
                <strong>Sequence counters reset:</strong> the next Arrival, Internal Shipment, and Quality Order will start at <code>#1</code> again.
                <hr class="my-2">
                <strong>What is preserved:</strong>
                <ul class="mb-0 mt-1">
                    <li>Users, roles, AD configuration, email groups</li>
                    <li>Defect catalog and reading-type definitions (per material group)</li>
                    <li>Site Configuration (SMTP / SAP / branding / alert thresholds / mail templates)</li>
                    <li>SAP material and vendor sync caches</li>
                </ul>
            </div>

            <form asp-action="PurgeAll" method="post" id="purge-form" class="border border-danger rounded p-3 bg-light"
                  onsubmit="return confirm('FINAL WARNING\n\nThis will delete EVERY Arrival, Quality Order, sample, defect, observation, reading, image, and audit log entry. Sequence numbers will reset to 1.\n\nThere is no undo. Continue?');">
                @Html.AntiForgeryToken()
                <label for="purgeConfirm" class="form-label">
                    To enable the button, type <code>PURGE ALL</code> below (case-sensitive):
                </label>
                <input type="text" class="form-control mb-3" id="purgeConfirm" name="confirmation"
                       autocomplete="off" placeholder="PURGE ALL" required />
                <button type="submit" id="purgeBtn" class="btn btn-danger" disabled>
                    <i class="bi bi-trash3-fill me-1"></i>Purge all operational data
                </button>
                <span class="text-muted small ms-2">This page will reload showing how many rows were deleted.</span>
            </form>
        </div>
    </div>
</div>


</div>
