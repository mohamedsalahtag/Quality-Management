@using SharbatlyQMS.Web.Controllers
@using SharbatlyQMS.Web.Services
@using SharbatlyQMS.Web.Services.Sap
@model SettingsVm
@{
    ViewData["Title"] = "Site Configuration";
    var activeTab = (ViewBag.ActiveTab as string) ?? "sap";
    string TabClass(string id)    => activeTab == id ? "nav-link active" : "nav-link";
    string TabPaneClass(string id) => activeTab == id ? "tab-pane fade show active" : "tab-pane fade";
    var preview = ViewBag.PreviewBody as string;
    var previewOk = (bool?)ViewBag.PreviewOk ?? false;
    var previewUrl = ViewBag.PreviewUrl as string;
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0"><i class="bi bi-gear me-1"></i>Site Configuration</h1>
</div>

<ul class="nav nav-tabs mb-3" role="tablist">
    <li class="nav-item">
        <button class="@TabClass("sap")" data-bs-toggle="tab" data-bs-target="#tab-sap" type="button">
            <i class="bi bi-cloud-arrow-down me-1"></i>SAP OData
        </button>
    </li>
    <li class="nav-item">
        <button class="@TabClass("branding")" data-bs-toggle="tab" data-bs-target="#tab-branding" type="button">
            <i class="bi bi-palette2 me-1"></i>Branding
        </button>
    </li>
    <li class="nav-item">
        <button class="@TabClass("smtp")" data-bs-toggle="tab" data-bs-target="#tab-smtp" type="button">
            <i class="bi bi-envelope-at me-1"></i>Email (SMTP)
        </button>
    </li>
    <li class="nav-item">
        <button class="@TabClass("thumbnails")" data-bs-toggle="tab" data-bs-target="#tab-thumbnails" type="button">
            <i class="bi bi-image me-1"></i>Images / Thumbnails
        </button>
    </li>
    <li class="nav-item">
        <button class="@TabClass("alerts")" data-bs-toggle="tab" data-bs-target="#tab-alerts" type="button">
            <i class="bi bi-bell me-1"></i>Alert Thresholds
        </button>
    </li>
    <li class="nav-item">
        <button class="@TabClass("syncstatus")" data-bs-toggle="tab" data-bs-target="#tab-syncstatus" type="button">
            <i class="bi bi-arrow-repeat me-1"></i>Sync Status
        </button>
    </li>
    <li class="nav-item">
        <button class="@TabClass("ad")" data-bs-toggle="tab" data-bs-target="#tab-ad" type="button">
            <i class="bi bi-person-lines-fill me-1"></i>Active Directory
        </button>
    </li>
    <li class="nav-item ms-auto">
        <button class="@TabClass("danger") text-danger" data-bs-toggle="tab" data-bs-target="#tab-danger" type="button">
            <i class="bi bi-exclamation-octagon-fill me-1"></i>Danger Zone
        </button>
    </li>
</ul>

<div class="tab-content">

@* ===================== SAP OData ===================== *@
<div class="@TabPaneClass("sap")" id="tab-sap">
    <div class="card">
        <div class="card-header bg-primary text-white"><i class="bi bi-cloud-arrow-down me-1"></i>SAP S/4HANA OData endpoints</div>
        <div class="card-body">
            <p class="text-muted small mb-3">
                Fill in the OData URL for each CDS view. The application reads from these
                endpoints (read-only) to power the arrival search, material details,
                vendor lookup, shipment data and PO context. Leave any field empty until
                its CDS view is published &mdash; the arrival search will fall back to the
                in-memory demo data while URLs are blank.
                <br />
                Use the <strong>Test</strong> button to verify connectivity (probes the URL with <code>$top=1</code>)
                and <strong>Preview</strong> to inspect the actual JSON SAP returns. Both work
                against the value currently in the input box &mdash; you do not need to Save first.
            </p>
            <form asp-action="SaveSapSettings" method="post" id="sap-form">
                @Html.AntiForgeryToken()
                <div class="row g-3">
                    <div class="col-md-12">
                        <div class="alert alert-light border small mb-0">
                            <i class="bi bi-info-circle me-1"></i>
                            <strong>How credentials are resolved:</strong> the per-URL <em>User</em> and <em>Password</em>
                            below each endpoint take priority. If a per-URL <em>User</em> is left blank, the global
                            default below is used instead. This lets you point one URL at a dev server and another
                            at production with different accounts.
                        </div>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">SAP username <span class="text-muted small">(global default)</span></label>
                        <input asp-for="Sap.User" class="form-control" autocomplete="off" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label d-flex align-items-center gap-2">
                            <span>SAP password <span class="text-muted small">(global default)</span></span>
                            @if (!string.IsNullOrEmpty(Model.Sap.Password))
                            {
                                <span class="badge bg-success" title="A password is stored. Leave this field blank to keep it.">
                                    <i class="bi bi-shield-check"></i> Saved
                                </span>
                            }
                        </label>
                        <input name="Sap.Password" type="password" class="form-control" autocomplete="new-password"
                               placeholder="@(!string.IsNullOrEmpty(Model.Sap.Password) ? "•••••••• (saved — leave blank to keep)" : "Enter password")" />
                        <small class="text-muted">Leave blank to keep existing password.</small>
                    </div>
                </div>
                <hr />

                <h6 class="text-uppercase small fw-bold text-success mt-2 mb-2">
                    <i class="bi bi-arrow-repeat me-1"></i>Master data &mdash; synced into local cache
                </h6>
                <p class="small text-muted mb-3">
                    Material Master and Vendor Master are pulled into a local cache so lookups are fast.
                    Use <strong>Sync now</strong> to pull immediately, or schedule auto-sync hours
                    on the <em>Sync Status</em> tab.
                </p>

                @{
                    // Renders one configurable endpoint row: URL + Test + Preview (+ optional Sync now)
                    // plus a second line with per-URL User / Password (blank = inherit global).
                    void EndpointRow(string label, bool syncable, string urlAsp, string userAsp, string pwdAsp,
                                     string idBase, string endpointKey, string urlValue, string userValue,
                                     bool hasSavedPassword,
                                     string placeholder, string hint, EndpointSyncConfig? sync, bool searchOnly)
                    {
                        var urlId  = $"sap-url-{idBase}";
                        var userId = $"sap-user-{idBase}";
                        var pwdId  = $"sap-pwd-{idBase}";
                        var resultId = $"{urlId}-result";
                        <div class="mb-4 border rounded p-2">
                            <label class="form-label fw-semibold mb-1">
                                @label
                                @if (searchOnly) { <span class="badge bg-info text-dark ms-1">Search-only</span> }
                            </label>
                            <div class="input-group mb-1">
                                <input id="@urlId" name="@urlAsp" value="@urlValue" class="form-control font-monospace" placeholder="@placeholder" />
                                <button type="button" class="btn btn-outline-info"
                                        onclick="sapTest('@urlId','@userId','@pwdId','@endpointKey','@resultId')">
                                    <i class="bi bi-plug"></i> Test
                                </button>
                                <button type="button" class="btn btn-outline-secondary"
                                        onclick="sapPreview('@urlId','@userId','@pwdId','@endpointKey','@resultId')">
                                    <i class="bi bi-eye"></i> Preview
                                </button>
                                @if (syncable)
                                {
                                    <button type="button" class="btn btn-success"
                                            onclick="sapSync('@endpointKey','@resultId')">
                                        <i class="bi bi-arrow-down-circle"></i> Sync now
                                    </button>
                                }
                            </div>
                            <div class="row g-2 mb-1">
                                <div class="col-md-6">
                                    <input id="@userId" name="@userAsp" value="@userValue"
                                           class="form-control form-control-sm" autocomplete="off"
                                           placeholder="SAP user for this URL (blank = use global default)" />
                                </div>
                                <div class="col-md-6">
                                    <div class="input-group input-group-sm">
                                        <input id="@pwdId" name="@pwdAsp" type="password"
                                               class="form-control form-control-sm" autocomplete="new-password"
                                               placeholder="@(hasSavedPassword ? "•••••••• (saved — leave blank to keep)" : "Password for this URL (blank = use global)")" />
                                        @if (hasSavedPassword)
                                        {
                                            <span class="input-group-text bg-success text-white" title="A password is stored for this URL. Test/Preview/Sync use it automatically when this field is blank.">
                                                <i class="bi bi-shield-check"></i>&nbsp;Saved
                                            </span>
                                        }
                                    </div>
                                </div>
                            </div>
                            <small class="text-muted">@hint@(searchOnly ? " Data is fetched live when an inspector creates an arrival checklist and snapshotted on save — never bulk-synced." : "")</small>
                            @if (syncable && sync != null)
                            {
                                <div class="small mt-1">
                                    <strong>Last sync:</strong>
                                    <span class="@(sync.LastRunUtc.HasValue ? "" : "text-muted")">
                                        @(sync.LastRunUtc.HasValue ? sync.LastRunUtc.Value.ToLocalTime().ToString("yyyy-MM-dd HH:mm") : "never")
                                    </span>
                                    @if (sync.LastRowCount.HasValue)
                                    {
                                        <span class="text-muted ms-2">(@sync.LastRowCount rows)</span>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(sync.LastResult))
                                    {
                                        var okResult = sync.LastResult!.StartsWith("OK", StringComparison.OrdinalIgnoreCase);
                                        <span class="ms-2 @(okResult ? "text-success" : "text-danger")">— @sync.LastResult</span>
                                    }
                                </div>
                            }
                            <div id="@resultId" class="mt-2"></div>
                        </div>
                    }
                }

                @{ EndpointRow("Material Master URL", syncable:true,
                    urlAsp:"Sap.MaterialMasterUrl", userAsp:"Sap.MaterialMasterUser", pwdAsp:"Sap.MaterialMasterPassword",
                    idBase:"material", endpointKey:SyncableEndpoints.MaterialMaster,
                    urlValue:Model.Sap.MaterialMasterUrl, userValue:Model.Sap.MaterialMasterUser,
                    hasSavedPassword:!string.IsNullOrEmpty(Model.Sap.MaterialMasterPassword),
                    placeholder:"https://host:port/sap/opu/odata/sap/MATERIAL_CDS/Materials",
                    hint:"Provides material description, group, origin, variety, class, weight, size, brand, pack type.",
                    sync:Model.MaterialSync, searchOnly:false); }
                @{ EndpointRow("Vendor Master URL", syncable:true,
                    urlAsp:"Sap.VendorMasterUrl", userAsp:"Sap.VendorMasterUser", pwdAsp:"Sap.VendorMasterPassword",
                    idBase:"vendor", endpointKey:SyncableEndpoints.VendorMaster,
                    urlValue:Model.Sap.VendorMasterUrl, userValue:Model.Sap.VendorMasterUser,
                    hasSavedPassword:!string.IsNullOrEmpty(Model.Sap.VendorMasterPassword),
                    placeholder:"https://host:port/sap/opu/odata/sap/VENDOR_CDS/Vendors",
                    hint:"Vendor / supplier identity and name lookup.",
                    sync:Model.VendorSync, searchOnly:false); }

                <h6 class="text-uppercase small fw-bold text-info mt-4 mb-2">
                    <i class="bi bi-search me-1"></i>Search-only &mdash; live OData, snapshotted on arrival save
                </h6>
                <p class="small text-muted mb-3">
                    PO / Shipment / Container search calls SAP live when inspectors create an arrival checklist.
                    The exact slice they pick is then snapshotted into the arrival, and downstream Quality Order /
                    Sample / Report flows read the snapshot &mdash; never SAP. These URLs are <strong>not</strong> bulk-synced.
                </p>

                @{ EndpointRow("Container Search URL", syncable:false,
                    urlAsp:"Sap.ContainerSearchUrl", userAsp:"Sap.ContainerSearchUser", pwdAsp:"Sap.ContainerSearchPassword",
                    idBase:"container", endpointKey:"ContainerSearch",
                    urlValue:Model.Sap.ContainerSearchUrl, userValue:Model.Sap.ContainerSearchUser,
                    hasSavedPassword:!string.IsNullOrEmpty(Model.Sap.ContainerSearchPassword),
                    placeholder:"https://host:port/sap/opu/odata/sap/CONTAINER_CDS/Containers",
                    hint:"Combined view: ekko + ekpo + ekes + lfa1 + mara + makt joined with zqc_arrival to drive the SAP search grid.",
                    sync:null, searchOnly:true); }
                @{ EndpointRow("Shipment Data URL", syncable:false,
                    urlAsp:"Sap.ShipmentDataUrl", userAsp:"Sap.ShipmentDataUser", pwdAsp:"Sap.ShipmentDataPassword",
                    idBase:"shipment", endpointKey:"ShipmentData",
                    urlValue:Model.Sap.ShipmentDataUrl, userValue:Model.Sap.ShipmentDataUser,
                    hasSavedPassword:!string.IsNullOrEmpty(Model.Sap.ShipmentDataPassword),
                    placeholder:"https://host:port/sap/opu/odata/sap/SHIPMENT_CDS/Shipments",
                    hint:"Vessel, voyage, loading/sailing/arrival dates, transit days, ports.",
                    sync:null, searchOnly:true); }
                @{ EndpointRow("Purchase Order URL", syncable:false,
                    urlAsp:"Sap.PurchaseOrderUrl", userAsp:"Sap.PurchaseOrderUser", pwdAsp:"Sap.PurchaseOrderPassword",
                    idBase:"po", endpointKey:"PurchaseOrder",
                    urlValue:Model.Sap.PurchaseOrderUrl, userValue:Model.Sap.PurchaseOrderUser,
                    hasSavedPassword:!string.IsNullOrEmpty(Model.Sap.PurchaseOrderPassword),
                    placeholder:"https://host:port/sap/opu/odata/sap/PO_CDS/PurchaseOrders",
                    hint:"PO header and item context, plant, storage location, quantities, batches.",
                    sync:null, searchOnly:true); }

                <button type="submit" class="btn btn-primary mt-2">
                    <i class="bi bi-save me-1"></i>Save SAP settings
                </button>
            </form>

            <hr class="my-4" />

            <h6 class="text-uppercase small fw-bold text-primary mb-2">
                <i class="bi bi-clock-history me-1"></i>Pending Containers pulling
            </h6>
            <p class="small text-muted mb-3">
                The background puller hits the Container Search OData URL and caches every SAP row
                whose <code>Doc_Date</code> is on/after the start date below. The page
                <a asp-controller="Arrivals" asp-action="Pending">Arrivals → Pending Containers</a>
                renders cached rows that don't yet have a QMS Arrival — so no container slips
                through QC silently.
            </p>
            <form asp-action="SaveContainerPollSettings" method="post">
                @Html.AntiForgeryToken()
                <div class="row g-3 align-items-end">
                    <div class="col-md-4">
                        <label class="form-label" asp-for="ContainerPoll.StartDate">Start date (Doc_Date ≥)</label>
                        <input asp-for="ContainerPoll.StartDate" type="date" class="form-control form-control-sm" />
                        <small class="text-muted">Containers before this date are ignored. Set to your QMS go-live date.</small>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label" asp-for="ContainerPoll.PollingMinutes">Pull every (minutes)</label>
                        <input asp-for="ContainerPoll.PollingMinutes" type="number" min="5" max="1440" step="1"
                               class="form-control form-control-sm" />
                        <small class="text-muted">5 minutes – 24 hours (1440). Examples: 60 = hourly, 300 = every 5 h, 1440 = daily.</small>
                    </div>
                    <div class="col-md-4 d-flex gap-2">
                        <button type="submit" class="btn btn-primary btn-sm">
                            <i class="bi bi-save me-1"></i>Save settings
                        </button>
                        <button type="submit" formaction="@Url.Action("PullContainersNow")"
                                class="btn btn-success btn-sm"
                                title="Override the schedule and pull from SAP immediately">
                            <i class="bi bi-cloud-download me-1"></i>Pull now
                        </button>
                    </div>
                </div>
                <div class="small mt-3">
                    @if (Model.ContainerPoll.IsRunning && Model.ContainerPoll.RunningSince.HasValue)
                    {
                        var elapsedSec = (int)Math.Max(0, (DateTime.UtcNow - Model.ContainerPoll.RunningSince.Value).TotalSeconds);
                        <span class="text-info">
                            <i class="bi bi-arrow-repeat me-1"></i>
                            <strong>Currently pulling…</strong>
                            started @Model.ContainerPoll.RunningSince.Value.ToLocalTime().ToString("HH:mm:ss")
                            (elapsed @(elapsedSec / 60) min @(elapsedSec % 60) s) — refresh this page to update.
                        </span>
                        <br />
                    }
                    <strong>Last pull:</strong>
                    <span class="@(Model.ContainerPoll.LastRunUtc.HasValue ? "" : "text-muted")">
                        @(Model.ContainerPoll.LastRunUtc.HasValue ? Model.ContainerPoll.LastRunUtc.Value.ToLocalTime().ToString("yyyy-MM-dd HH:mm") : "never")
                    </span>
                    @if (Model.ContainerPoll.LastRowCount.HasValue)
                    {
                        <span class="text-muted ms-2">(@Model.ContainerPoll.LastRowCount rows fetched)</span>
                    }
                    @if (!string.IsNullOrWhiteSpace(Model.ContainerPoll.LastResult))
                    {
                        var okPoll = Model.ContainerPoll.LastResult!.StartsWith("Fetched", StringComparison.OrdinalIgnoreCase)
                                  || Model.ContainerPoll.LastResult.StartsWith("OK", StringComparison.OrdinalIgnoreCase);
                        <span class="ms-2 @(okPoll ? "text-success" : "text-danger")">— @Model.ContainerPoll.LastResult</span>
                    }
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
<script>
    // SAP endpoint Test / Preview AJAX helpers. Reads the live input value
    // (no need to Save first) and renders the result inline below the row.
    function _csrfToken() {
        var el = document.querySelector('input[name="__RequestVerificationToken"]');
        return el ? el.value : '';
    }
    function _escapeHtml(s) {
        return (s || '').replace(/[&<>"']/g, function (c) {
            return {'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c];
        });
    }
    // Builds the form body for sapTest/sapPreview. Per-URL user/password (read live
    // from the input fields) are sent on the wire so the admin can validate dev vs
    // prod credentials WITHOUT saving the form first. The endpointKey tells the
    // server which row this is, so when the password input is left blank the
    // server can substitute the previously-saved password for that endpoint
    // (rendered password fields never echo saved values back for security).
    async function _sapPost(action, url, user, password, endpointKey) {
        var token = _csrfToken();
        var body = 'url=' + encodeURIComponent(url) +
                   '&user=' + encodeURIComponent(user || '') +
                   '&password=' + encodeURIComponent(password || '') +
                   '&endpointKey=' + encodeURIComponent(endpointKey || '') +
                   '&__RequestVerificationToken=' + encodeURIComponent(token);
        var resp = await fetch(action, {
            method: 'POST',
            headers: {
                'Content-Type': 'application/x-www-form-urlencoded',
                'X-CSRF-TOKEN':  token,
                'Accept':        'application/json'
            },
            body: body
        });
        if (!resp.ok) throw new Error('HTTP ' + resp.status);
        return await resp.json();
    }
    function _readFieldsForRow(inputId, userId, pwdId) {
        var url  = (document.getElementById(inputId)?.value || '').trim();
        var user = (document.getElementById(userId)?.value  || '').trim();
        var pwd  = (document.getElementById(pwdId)?.value   || '');
        return { url: url, user: user, pwd: pwd };
    }
    async function sapTest(inputId, userId, pwdId, endpointKey, resultId) {
        var f = _readFieldsForRow(inputId, userId, pwdId);
        var result = document.getElementById(resultId);
        if (!f.url) {
            result.innerHTML = '<div class="alert alert-warning small mb-0 py-2">URL is empty</div>';
            return;
        }
        var credLabel = f.user
            ? '<span class="text-muted small ms-2">as <code>' + _escapeHtml(f.user) + '</code>' + (f.pwd ? '' : ' (using saved password)') + '</span>'
            : '<span class="text-muted small ms-2">using saved/global credentials</span>';
        result.innerHTML = '<div class="text-muted small"><span class="spinner-border spinner-border-sm me-1"></span>Testing...' + credLabel + '</div>';
        try {
            var data = await _sapPost('@Url.Action("TestSapEndpointAjax")', f.url, f.user, f.pwd, endpointKey);
            result.innerHTML = data.ok
                ? '<div class="alert alert-success small mb-0 py-2"><i class="bi bi-check-circle me-1"></i>' + _escapeHtml(data.message) + credLabel + '</div>'
                : '<div class="alert alert-danger small mb-0 py-2"><i class="bi bi-x-circle me-1"></i><pre class="mb-0 small" style="white-space:pre-wrap">' + _escapeHtml(data.message) + '</pre></div>';
        } catch (e) {
            result.innerHTML = '<div class="alert alert-danger small mb-0 py-2">Request failed: ' + _escapeHtml(e.message) + '</div>';
        }
    }
    async function sapSync(endpointKey, resultId) {
        var result = document.getElementById(resultId);
        if (!confirm('Run a full sync now for ' + endpointKey + '? This may take a few minutes for large catalogues.')) return;
        try {
            var token = _csrfToken();
            var resp = await fetch('@Url.Action("SyncSapEndpointAjax")', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/x-www-form-urlencoded',
                    'X-CSRF-TOKEN':  token,
                    'Accept':        'application/json'
                },
                body: 'endpointKey=' + encodeURIComponent(endpointKey) + '&__RequestVerificationToken=' + encodeURIComponent(token)
            });
            if (!resp.ok) throw new Error('HTTP ' + resp.status);
            var data = await resp.json();
            if (!data.ok) {
                result.innerHTML = '<div class="alert alert-danger small mb-0 py-2"><i class="bi bi-x-circle me-1"></i>' + _escapeHtml(data.message) + '</div>';
                return;
            }
            // Sync is running in background -- poll for completion every 3s.
            result.innerHTML = '<div class="alert alert-info small mb-0 py-2"><span class="spinner-border spinner-border-sm me-1"></span>' + _escapeHtml(data.message) + ' <span class="poll-count">(rows so far: 0)</span></div>';
            pollSyncStatus(endpointKey, resultId);
        } catch (e) {
            result.innerHTML = '<div class="alert alert-danger small mb-0 py-2">Request failed: ' + _escapeHtml(e.message) + '</div>';
        }
    }

    async function pollSyncStatus(endpointKey, resultId) {
        var result = document.getElementById(resultId);
        var attempts = 0;
        var poll = async function () {
            attempts++;
            try {
                var resp = await fetch('@Url.Action("SyncStatusAjax")?endpointKey=' + encodeURIComponent(endpointKey),
                    { headers: { 'Accept': 'application/json' } });
                var data = await resp.json();
                if (data.running) {
                    result.innerHTML = '<div class="alert alert-info small mb-0 py-2">' +
                        '<span class="spinner-border spinner-border-sm me-1"></span>' +
                        'Sync in progress... <strong>' + (data.cacheCount || 0).toLocaleString() + '</strong> rows in cache so far.' +
                        ' <span class="text-muted">(check ' + attempts + ')</span></div>';
                    if (attempts < 200) setTimeout(poll, 3000);
                } else {
                    var ok = data.success === true;
                    var icon = ok ? 'bi-check-circle' : 'bi-x-circle';
                    var cls  = ok ? 'alert-success' : 'alert-danger';
                    result.innerHTML = '<div class="alert ' + cls + ' small mb-0 py-2">' +
                        '<i class="bi ' + icon + ' me-1"></i>' +
                        (ok ? 'Sync complete &mdash; ' : 'Sync failed: ') +
                        _escapeHtml(data.message || '') +
                        ' Cache: ' + (data.cacheCount || 0).toLocaleString() + ' rows.' +
                        ' <a href="' + window.location.pathname + '?activeTab=syncstatus">view sync status</a></div>';
                }
            } catch (e) {
                result.innerHTML = '<div class="alert alert-warning small mb-0 py-2">Status poll failed: ' + _escapeHtml(e.message) + '</div>';
            }
        };
        setTimeout(poll, 1500);
    }
    async function sapPreview(inputId, userId, pwdId, endpointKey, resultId) {
        var f = _readFieldsForRow(inputId, userId, pwdId);
        var result = document.getElementById(resultId);
        if (!f.url) {
            result.innerHTML = '<div class="alert alert-warning small mb-0 py-2">URL is empty</div>';
            return;
        }
        result.innerHTML = '<div class="text-muted small"><span class="spinner-border spinner-border-sm me-1"></span>Fetching first record...</div>';
        try {
            var data = await _sapPost('@Url.Action("PreviewSapEndpointAjax")', f.url, f.user, f.pwd, endpointKey);
            var icon = data.ok ? 'bi-check-circle text-success' : 'bi-x-circle text-danger';
            var label = data.ok ? 'First record from SAP' : 'Preview failed';
            result.innerHTML =
                '<div class="border rounded">' +
                  '<div class="px-2 py-1 small d-flex justify-content-between align-items-center" style="background:var(--theme-surface-alt)">' +
                    '<span><i class="bi ' + icon + ' me-1"></i>' + label + '</span>' +
                    '<button type="button" class="btn btn-sm btn-link p-0" onclick="this.closest(\'.border\').remove()">close</button>' +
                  '</div>' +
                  '<pre class="bg-light p-2 small mb-0" style="max-height:400px;overflow:auto">' + _escapeHtml(data.body) + '</pre>' +
                '</div>';
        } catch (e) {
            result.innerHTML = '<div class="alert alert-danger small mb-0 py-2">Request failed: ' + _escapeHtml(e.message) + '</div>';
        }
    }

    // ---- Active Directory: Test connection (does NOT save) ----
    (function () {
        var btn = document.getElementById('testAdBtn');
        var out = document.getElementById('testAdResult');
        if (!btn || !out) return;
        btn.addEventListener('click', async function () {
            out.className = 'ms-2 small text-muted';
            out.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span>Testing…';
            try {
                var token = _csrfToken();
                var body  = new URLSearchParams();
                body.append('__RequestVerificationToken', token);
                body.append('domain',          document.getElementById('ad-domain').value);
                body.append('ldapPath',        document.getElementById('ad-ldap').value);
                body.append('serviceUser',     document.getElementById('ad-user').value);
                body.append('servicePassword', document.getElementById('ad-pass').value);
                var res = await fetch('@Url.Action("TestAdConnectionAjax", "Admin")', {
                    method: 'POST',
                    headers: { 'X-CSRF-TOKEN': token, 'Accept': 'application/json' },
                    body: body.toString(),
                    credentials: 'same-origin'
                });
                var data = await res.json();
                out.className = 'ms-2 small ' + (data.ok ? 'text-success' : 'text-danger');
                out.innerHTML = (data.ok ? '<i class="bi bi-check-circle me-1"></i>' : '<i class="bi bi-x-circle me-1"></i>')
                    + _escapeHtml(data.message || (data.ok ? 'OK' : 'Failed'));
            } catch (e) {
                out.className = 'ms-2 small text-danger';
                out.textContent = 'Request failed: ' + e.message;
            }
        });
    })();

    // Danger Zone -- enable Purge button only when the exact phrase is typed.
    (function () {
        var inp = document.getElementById('purgeConfirm');
        var btn = document.getElementById('purgeBtn');
        if (!inp || !btn) return;
        inp.addEventListener('input', function () {
            btn.disabled = inp.value !== 'PURGE ALL';
        });
    })();
</script>
}

