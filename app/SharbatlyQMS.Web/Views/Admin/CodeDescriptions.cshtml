@using SharbatlyQMS.Web.Services
@model IReadOnlyList<CodeDescriptionEntry>
@{
    ViewData["Title"] = "Code Descriptions";
    var domain     = ViewBag.Domain as string ?? CodeDomains.Plant;
    var query      = ViewBag.Query  as string;
    var counts     = ViewBag.Counts as IDictionary<string, int> ?? new Dictionary<string, int>();
    var plantCodes = ViewBag.PlantCodes as IReadOnlyList<string> ?? Array.Empty<string>();
    var isStorage  = domain == CodeDomains.StorageLocation;
}

<div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
    <h1 class="h3 mb-0">
        <i class="bi bi-translate me-1"></i>Code Descriptions
        <small class="text-muted fs-6 fw-normal ms-2">
            Friendly names for SAP codes — shown instead of the code on Arrivals, Quality Orders and Pending Containers.
        </small>
    </h1>
    <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#cdModal" data-mode="create">
        <i class="bi bi-plus-circle me-1"></i>Add description
    </button>
</div>

<ul class="nav nav-tabs mb-3">
    @foreach (var d in CodeDomains.All)
    {
        <li class="nav-item">
            <a class="nav-link @(domain == d ? "active" : "")"
               asp-action="CodeDescriptions" asp-route-domain="@d">
                @CodeDomains.DisplayName(d)
                <span class="badge bg-secondary ms-1">@(counts.TryGetValue(d, out var n) ? n : 0)</span>
            </a>
        </li>
    }
</ul>

<form method="get" class="row g-2 mb-3">
    <input type="hidden" name="domain" value="@domain" />
    <div class="col-md-4">
        <input type="text" name="q" value="@query" class="form-control form-control-sm"
               placeholder="Search code, name@(isStorage ? " or plant" : "")…" autocomplete="off" />
    </div>
    <div class="col-md-3 d-flex gap-2">
        <button type="submit" class="btn btn-outline-secondary btn-sm"><i class="bi bi-search me-1"></i>Search</button>
        @if (!string.IsNullOrWhiteSpace(query))
        {
            <a asp-action="CodeDescriptions" asp-route-domain="@domain" class="btn btn-outline-secondary btn-sm">Clear</a>
        }
    </div>
</form>

@if (domain == CodeDomains.PoType)
{
    <div class="alert alert-light border small">
        <i class="bi bi-info-circle me-1"></i>
        SAP has no master table for purchase-order document types, so these were seeded from the codes
        actually seen on containers. Edit each one to the wording your team uses.
    </div>
}

<div class="card">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0" data-tablekit data-page-size="50">
            <thead class="table-light">
                <tr>
                    @if (isStorage) { <th data-sort>Plant</th> }
                    <th data-sort>Code</th>
                    <th data-sort>Description</th>
                    <th data-sort>Active</th>
                    <th data-sort>Updated</th>
                    <th class="text-end" style="width: 120px">Actions</th>
                </tr>
            </thead>
            <tbody>
            @if (Model.Count == 0)
            {
                <tr><td colspan="@(isStorage ? 6 : 5)" class="text-center text-muted py-4">
                    @if (!string.IsNullOrWhiteSpace(query))
                    {
                        <span>Nothing matches that search.</span>
                    }
                    else
                    {
                        <span>No entries yet — click <em>Add description</em>.</span>
                    }
                </td></tr>
            }
            else
            {
                foreach (var e in Model)
                {
                    <tr>
                        @if (isStorage)
                        {
                            <td><span class="badge bg-light text-dark border">@e.ParentCode</span></td>
                        }
                        <td><code>@e.Code</code></td>
                        <td>@e.Description</td>
                        <td>
                            @if (e.IsActive)
                            {
                                <span class="badge bg-success-subtle text-success-emphasis">Yes</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary-subtle text-secondary-emphasis">No</span>
                            }
                        </td>
                        <td class="text-muted small">
                            @e.UpdatedAt.ToLocalTime().ToString("yyyy-MM-dd")
                            @if (!string.IsNullOrWhiteSpace(e.UpdatedBy)) { <span>· @e.UpdatedBy</span> }
                        </td>
                        <td class="text-end text-nowrap">
                            <button type="button" class="btn btn-sm btn-outline-secondary"
                                    data-bs-toggle="modal" data-bs-target="#cdModal"
                                    data-mode="edit"
                                    data-id="@e.CodeDescId"
                                    data-parent="@e.ParentCode"
                                    data-code="@e.Code"
                                    data-description="@e.Description"
                                    data-sort="@e.SortOrder"
                                    data-active="@(e.IsActive ? "true" : "false")"
                                    title="Edit">
                                <i class="bi bi-pencil"></i>
                            </button>
                            <form asp-action="DeleteCodeDescription" method="post" class="d-inline"
                                  data-confirm="Remove the description for '@e.Code'? The lists will fall back to the built-in name, or the code itself."
                                  data-confirm-danger data-confirm-ok="Remove">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="codeDescId" value="@e.CodeDescId" />
                                <input type="hidden" name="domain" value="@domain" />
                                <button type="submit" class="btn btn-sm btn-outline-danger" title="Remove">
                                    <i class="bi bi-trash"></i>
                                </button>
                            </form>
                        </td>
                    </tr>
                }
            }
            </tbody>
        </table>
    </div>
</div>

<div class="modal fade" id="cdModal" tabindex="-1">
    <div class="modal-dialog">
        <form asp-action="SaveCodeDescription" method="post" class="modal-content">
            @Html.AntiForgeryToken()
            <input type="hidden" name="codeDescId" id="cd-id" value="0" />
            <input type="hidden" name="domain" value="@domain" />
            <div class="modal-header">
                <h5 class="modal-title" id="cd-title">Add description</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="row g-3">
                    @if (isStorage)
                    {
                        <div class="col-12">
                            <label class="form-label">Plant</label>
                            <select name="parentCode" id="cd-parent" class="form-select" required>
                                <option value="">— pick the owning plant —</option>
                                @foreach (var p in plantCodes)
                                {
                                    <option value="@p">@Codes.PlantLabel(p)</option>
                                }
                            </select>
                            <div class="form-text">The same storage-location code exists under several plants, so it needs one.</div>
                        </div>
                    }
                    <div class="col-6">
                        <label class="form-label">SAP code</label>
                        <input type="text" name="code" id="cd-code" class="form-control" maxlength="10" required
                               autocomplete="off" />
                    </div>
                    <div class="col-6">
                        <label class="form-label">Sort order</label>
                        <input type="number" name="sortOrder" id="cd-sort" class="form-control" value="500" />
                    </div>
                    <div class="col-12">
                        <label class="form-label">Description</label>
                        <input type="text" name="description" id="cd-description" class="form-control" maxlength="80" required
                               placeholder="e.g. Air Shipment" autocomplete="off" />
                    </div>
                    <div class="col-12">
                        <div class="form-check form-switch">
                            <input class="form-check-input" type="checkbox" name="isActive" id="cd-active" value="true" checked />
                            <input type="hidden" name="isActive" value="false" />
                            <label class="form-check-label" for="cd-active">Active</label>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="submit" class="btn btn-primary">Save</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
<script>
    // Same show.bs.modal data-* handoff the other Parameters pages use.
    document.getElementById('cdModal')?.addEventListener('show.bs.modal', function (ev) {
        var b = ev.relatedTarget; if (!b) return;
        var edit = b.getAttribute('data-mode') === 'edit';
        document.getElementById('cd-title').textContent = edit ? 'Edit description' : 'Add description';
        document.getElementById('cd-id').value          = edit ? b.getAttribute('data-id') : '0';
        document.getElementById('cd-code').value        = edit ? b.getAttribute('data-code') : '';
        document.getElementById('cd-description').value = edit ? b.getAttribute('data-description') : '';
        document.getElementById('cd-sort').value        = edit ? b.getAttribute('data-sort') : '500';
        document.getElementById('cd-active').checked    = edit ? b.getAttribute('data-active') === 'true' : true;
        var parent = document.getElementById('cd-parent');
        if (parent) parent.value = edit ? (b.getAttribute('data-parent') || '') : '';
    });
</script>
}
