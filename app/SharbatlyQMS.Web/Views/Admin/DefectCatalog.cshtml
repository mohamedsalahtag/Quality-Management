@using SharbatlyQMS.Web.Models
@using SharbatlyQMS.Web.Services
@model IReadOnlyList<DefectCatalogEntry>
@{
    ViewData["Title"] = "Defect Catalog";
    var categories  = ViewBag.Categories as IReadOnlyList<DefectCategory> ?? new List<DefectCategory>();
    var catColor    = categories.ToDictionary(c => c.CategoryName, c => c.ColorHex, StringComparer.OrdinalIgnoreCase);
    var valueTypes  = new[] { "Number", "Decimal" };
    var groups      = ViewBag.Groups      as IReadOnlyList<MaraGroup> ?? new List<MaraGroup>();
    var filterGroup = ViewBag.FilterGroup as string;
    var maraEmpty   = (bool?)ViewBag.MaraEmpty ?? false;
    string GroupLabel(MaraGroup g) => string.IsNullOrWhiteSpace(g.Name) ? g.Code : $"{g.Code} — {g.Name}";
}

<div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
    <h1 class="h3 mb-0">
        <i class="bi bi-list-check me-1"></i>Defect Catalog
        <small class="text-muted fs-6 fw-normal ms-2">Defects per material group; the Category drives the Major/Minor split.</small>
    </h1>
    <div class="d-flex gap-2">
        <form method="get" asp-action="DefectCatalog" class="d-flex gap-2">
            <select name="materialGroup" class="form-select form-select-sm" onchange="this.form.submit()">
                <option value="">All material groups</option>
                @foreach (var g in groups)
                {
                    <option value="@g.Code" selected="@(g.Code == filterGroup)">@GroupLabel(g)</option>
                }
            </select>
            @if (!string.IsNullOrEmpty(filterGroup))
            {
                <a asp-action="DefectCatalog" class="btn btn-sm btn-outline-secondary">Clear</a>
            }
        </form>
        <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#defectModal" data-mode="create"
                data-default-group="@(filterGroup ?? "")">
            <i class="bi bi-plus-circle me-1"></i>Add defect
            @if (!string.IsNullOrEmpty(filterGroup))
            {
                <span class="badge bg-light text-dark ms-1" title="The new defect will land in this group (matches the filter above).">to <code class="text-primary">@filterGroup</code></span>
            }
        </button>
    </div>
</div>

<div class="card">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0" data-tablekit data-page-size="50">
            <thead class="table-light">
                <tr>
                    <th style="width:1%" data-sort="num" title="Sort order">#</th>
                    <th data-sort>Group</th>
                    <th data-sort>Code</th>
                    <th data-sort>Name</th>
                    <th data-sort>Category</th>
                    <th data-sort>Value type</th>
                    <th data-sort>Active</th>
                    <th class="text-end" style="width: 120px">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var d in Model)
                {
                    <tr>
                        <td class="text-muted small">@d.SortOrder</td>
                        <td><code>@d.MaterialGroup</code></td>
                        <td><code>@d.DefectCode</code></td>
                        <td>@d.DefectName</td>
                        <td><span class="badge" style="background:@(catColor.GetValueOrDefault(d.DefectCategory) ?? "#6c757d");color:#fff">@d.DefectCategory</span></td>
                        <td>@d.ValueType</td>
                        <td>@(d.IsActive ? "Yes" : "No")</td>
                        <td class="text-end text-nowrap">
                            <button type="button" class="btn btn-sm btn-outline-secondary"
                                    data-bs-toggle="modal" data-bs-target="#defectModal"
                                    data-mode="edit"
                                    data-id="@d.DefectId" data-group="@d.MaterialGroup"
                                    data-code="@d.DefectCode" data-name="@d.DefectName"
                                    data-cat="@d.DefectCategory" data-vtype="@d.ValueType"
                                    data-active="@d.IsActive.ToString().ToLower()"
                                    data-sort="@d.SortOrder"
                                    title="Edit">
                                <i class="bi bi-pencil"></i>
                            </button>
                            @if (d.IsInUse)
                            {
                                <button type="button" class="btn btn-sm btn-outline-secondary"
                                        disabled
                                        title="Used by at least one Quality Order sample — cannot delete. Mark inactive instead.">
                                    <i class="bi bi-trash"></i>
                                </button>
                            }
                            else
                            {
                                <form asp-action="DeleteDefect" method="post" class="d-inline"
                                      data-confirm="Delete defect @d.DefectCode (@d.DefectName)? This cannot be undone." data-confirm-danger data-confirm-ok="Delete">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="defectId" value="@d.DefectId" />
                                    <input type="hidden" name="materialGroup" value="@filterGroup" />
                                    <button type="submit" class="btn btn-sm btn-outline-danger" title="Delete">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </form>
                            }
                        </td>
                    </tr>
                }
                @if (Model.Count == 0)
                {
                    <tr><td colspan="8" class="text-center text-muted small py-3">No defects @(string.IsNullOrEmpty(filterGroup) ? "yet." : "for " + filterGroup + ".")</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>

<div class="modal fade" id="defectModal" tabindex="-1">
    <div class="modal-dialog">
        <form asp-action="SaveDefect" method="post" class="modal-content">
            @Html.AntiForgeryToken()
            <input type="hidden" name="defectId" id="d-id" value="0" />
            <div class="modal-header"><h5 class="modal-title" id="d-title">Add defect</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button></div>
            <div class="modal-body">
                <div class="row g-2">
                    <div class="col-md-6"><label class="form-label">Material group *</label>
                        @* Sourced from the SAP MARA cache so defects can only
                           target a group that actually exists in SAP. *@
                        @* If the page filter is active, the matching option is
                           server-side selected so the modal opens with that
                           value baked in -- no dependence on the JS handler. *@
                        <select name="materialGroup" id="d-group" class="form-select" required>
                            <option value="" disabled selected="@(string.IsNullOrEmpty(filterGroup))">-- choose a material group --</option>
                            @foreach (var g in groups)
                            {
                                <option value="@g.Code" selected="@(g.Code == filterGroup)">@GroupLabel(g)</option>
                            }
                        </select>
                        @if (maraEmpty)
                        {
                            <small class="text-warning"><i class="bi bi-exclamation-triangle me-1"></i>SAP MARA cache is empty — run a Material Master Sync from <a asp-action="Settings">Site Configuration</a> to populate this list.</small>
                        }
                    </div>
                    <div class="col-md-6"><label class="form-label">Sort order</label>
                        <input name="sortOrder" id="d-sort" type="number" class="form-control" value="500" /></div>
                    <div class="col-md-6"><label class="form-label">Code *</label>
                        <input name="defectCode" id="d-code" class="form-control" required /></div>
                    <div class="col-md-6"><label class="form-label">Name *</label>
                        <input name="defectName" id="d-name" class="form-control" required /></div>
                    <div class="col-md-6"><label class="form-label">Category *</label>
                        <select name="defectCategory" id="d-cat" class="form-select" required>
                            @foreach (var c in categories) { <option value="@c.CategoryName">@c.CategoryName</option> }
                        </select>
                        <small class="text-muted">Manage the list on <a asp-action="DefectCategories">Defect Categories</a>.</small></div>
                    <div class="col-md-6"><label class="form-label">Value type *</label>
                        <select name="valueType" id="d-vtype" class="form-select" required>
                            @foreach (var v in valueTypes) { <option>@v</option> }
                        </select></div>
                    <div class="col-12"><div class="form-check form-switch">
                        <input class="form-check-input" type="checkbox" name="isActive" id="d-active" value="true" checked />
                        <label class="form-check-label" for="d-active">Active</label>
                    </div></div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="submit" class="btn btn-primary">Save</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
<script>
    document.getElementById('defectModal').addEventListener('show.bs.modal', function (e) {
        var b = e.relatedTarget;
        if (b.dataset.mode === 'edit') {
            document.getElementById('d-title').textContent = 'Edit defect';
            document.getElementById('d-id').value     = b.dataset.id;
            document.getElementById('d-group').value  = b.dataset.group;
            document.getElementById('d-code').value   = b.dataset.code;
            document.getElementById('d-name').value   = b.dataset.name;
            document.getElementById('d-cat').value    = b.dataset.cat;
            document.getElementById('d-vtype').value  = b.dataset.vtype || 'Number';
            document.getElementById('d-sort').value   = b.dataset.sort;
            document.getElementById('d-active').checked = b.dataset.active === 'true';
        } else {
            document.getElementById('d-title').textContent = 'Add defect';
            document.getElementById('d-id').value = 0;
            ['d-code','d-name','d-sort'].forEach(id => {
                var el = document.getElementById(id);
                if (el) el.value = '';
            });
            var def = b.dataset.defaultGroup || '';
            document.getElementById('d-group').value = def;
            document.getElementById('d-cat').selectedIndex = 0;
            document.getElementById('d-vtype').value = 'Number';
            document.getElementById('d-sort').value  = '500';
            document.getElementById('d-active').checked = true;
        }
    });
</script>
}
