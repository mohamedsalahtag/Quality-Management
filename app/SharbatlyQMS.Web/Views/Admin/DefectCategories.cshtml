@using SharbatlyQMS.Web.Models
@model IReadOnlyList<DefectCategory>
@{
    ViewData["Title"] = Loc["Defect Categories"];
    var groups      = ViewBag.Groups      as IReadOnlyList<SharbatlyQMS.Web.Services.MaraGroup> ?? new List<SharbatlyQMS.Web.Services.MaraGroup>();
    var filterGroup = ViewBag.FilterGroup as string;
    var tolerances  = ViewBag.Tolerances  as IReadOnlyDictionary<int, decimal?> ?? new Dictionary<int, decimal?>();
    string GroupLabel(SharbatlyQMS.Web.Services.MaraGroup g) => string.IsNullOrWhiteSpace(g.Name) ? g.Code : $"{g.Code} — {g.Name}";
}

<div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
    <h1 class="h3 mb-0">
        <i class="bi bi-palette me-1"></i>Defect Categories
        <small class="text-muted fs-6 fw-normal ms-2">@Loc["Major, Minor, Critical, … with display order and colour."]</small>
    </h1>
    <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#dcModal"
            data-mode="create">
        <i class="bi bi-plus-circle me-1"></i>@Loc["Add category"]
    </button>
</div>

<div class="card">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0" data-tablekit data-page-size="50">
            <thead class="table-light">
                <tr>
                    <th style="width:1%">@Loc["Order"]</th>
                    <th>@Loc["Name"]</th>
                    <th>@Loc["Colour"]</th>
                    <th>@Loc["Active"]</th>
                    <th class="text-end" style="width: 120px">@Loc["Actions"]</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var c in Model)
                {
                    <tr>
                        <td class="text-muted small">@c.SortOrder</td>
                        <td>@c.CategoryName</td>
                        <td>
                            <span class="d-inline-block border rounded" style="width:1.2rem;height:1.2rem;vertical-align:middle;background:@(c.ColorHex ?? "#6c757d")"></span>
                            <code class="ms-1">@(c.ColorHex ?? "—")</code>
                        </td>
                        <td>@(c.IsActive ? "Yes" : "No")</td>
                        <td class="text-end text-nowrap">
                            <button type="button" class="btn btn-sm btn-outline-secondary"
                                    data-bs-toggle="modal" data-bs-target="#dcModal"
                                    data-mode="edit"
                                    data-id="@c.CategoryId"
                                    data-name="@c.CategoryName"
                                    data-sort="@c.SortOrder"
                                    data-color="@c.ColorHex"
                                    data-active="@c.IsActive.ToString().ToLower()"
                                    title="Edit">
                                <i class="bi bi-pencil"></i>
                            </button>
                            @if (c.IsInUse)
                            {
                                <button type="button" class="btn btn-sm btn-outline-danger" disabled
                                        title="In use by one or more defects — reassign or deactivate instead">
                                    <i class="bi bi-trash"></i>
                                </button>
                            }
                            else
                            {
                                <form asp-action="DeleteDefectCategory" method="post" class="d-inline"
                                      data-confirm="Delete category @c.CategoryName? This cannot be undone." data-confirm-danger data-confirm-ok="Delete">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="categoryId" value="@c.CategoryId" />
                                    <button type="submit" class="btn btn-sm btn-outline-danger" title="Delete">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </form>
                            }
                        </td>
                    </tr>
                }
                @if (Model.Count == 0)
                {
                    <tr><td colspan="5" class="text-center text-muted small py-3">No categories yet. Click <strong>@Loc["Add category"]</strong> to create one.</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>

@* ---- Tolerance per category, per material group (M39). A category is shared
       by every fruit but its agreed limit is not, so the values are edited one
       material group at a time. A category's TOTAL % at or above its tolerance
       prints in red on the QC summary and the report. ---- *@
<div class="card mt-4" id="tolerances">
    <div class="card-header d-flex justify-content-between align-items-center flex-wrap gap-2">
        <div>
            <strong><i class="bi bi-rulers me-1"></i>@Loc["Category tolerance by material group"]</strong>
            <div class="small text-muted">@Loc["Compared with the category's total percentage. At or above it, the total prints in red."]</div>
        </div>
        <div class="d-flex gap-2">
            <form method="get" asp-action="DefectCategories" asp-fragment="tolerances" class="d-flex gap-2">
                <select name="materialGroup" class="form-select form-select-sm" onchange="this.form.submit()">
                    <option value="">@Loc["Choose a material group…"]</option>
                    @foreach (var g in groups)
                    {
                        <option value="@g.Code" selected="@(g.Code == filterGroup)">@GroupLabel(g)</option>
                    }
                </select>
            </form>
            <a class="btn btn-sm btn-outline-success"
               asp-action="DefectCategoryTolerancesExcel" asp-route-materialGroup="@filterGroup"
               title="@Loc["Export category tolerances to Excel"]">
                <i class="bi bi-file-earmark-excel me-1"></i>@Loc["Export"]
            </a>
            <button type="button" class="btn btn-sm btn-outline-primary"
                    data-bs-toggle="modal" data-bs-target="#tolImportModal"
                    title="@Loc["Upload the exported file after editing its tolerances"]">
                <i class="bi bi-upload me-1"></i>@Loc["Import tolerances"]
            </button>
        </div>
    </div>
    @if (string.IsNullOrEmpty(filterGroup))
    {
        <div class="card-body text-muted small">
            @Loc["Choose a material group to set its category tolerances, or use Export to fill them in for every group at once."]
        </div>
    }
    else
    {
        <form asp-action="SaveCategoryTolerances" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" name="materialGroup" value="@filterGroup" />
            <div class="table-responsive">
                <table class="table align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>@Loc["Category"]</th>
                            <th style="width: 220px">@Loc["Tolerance (%)"]</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var c in Model.Where(x => x.IsActive))
                        {
                            tolerances.TryGetValue(c.CategoryId, out var tol);
                            <tr>
                                <td>
                                    <span class="d-inline-block border rounded me-1" style="width:.9rem;height:.9rem;vertical-align:middle;background:@(c.ColorHex ?? "#6c757d")"></span>
                                    @c.CategoryName
                                    <input type="hidden" name="categoryId" value="@c.CategoryId" />
                                </td>
                                <td>
                                    <input name="tolerance" type="number" min="0" step="@DefectTolerance.Step" inputmode="decimal"
                                           class="form-control form-control-sm"
                                           value="@(tol?.ToString(DefectTolerance.Format, System.Globalization.CultureInfo.InvariantCulture))"
                                           placeholder="@Loc["none agreed"]" />
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <div class="card-footer d-flex justify-content-between align-items-center">
                <small class="text-muted">@Loc["Leave empty when no tolerance has been agreed — that is not the same as 0."]</small>
                <button type="submit" class="btn btn-primary btn-sm">@Loc["Save tolerances"]</button>
            </div>
        </form>
    }
</div>

<div class="modal fade" id="tolImportModal" tabindex="-1">
    <div class="modal-dialog">
        <form asp-action="DefectCategoryTolerancesImport" method="post" enctype="multipart/form-data" class="modal-content">
            @Html.AntiForgeryToken()
            <input type="hidden" name="materialGroup" value="@filterGroup" />
            <div class="modal-header">
                <h5 class="modal-title"><i class="bi bi-upload me-1"></i>@Loc["Import tolerances"]</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <p class="small text-muted">
                    @Loc["Export the category tolerances, fill in the Tolerance column, and upload the same file here."]
                </p>
                <div class="mb-3">
                    <label class="form-label" for="tol-imp-file">@Loc["Excel file (.xlsx)"]</label>
                    <input type="file" name="file" id="tol-imp-file" accept=".xlsx" class="form-control" required />
                </div>
                <ul class="small text-muted mb-0 ps-3">
                    <li>@Loc["Only the Tolerance column is read; rows are matched on Category ID and Material group."]</li>
                    <li>@Loc["An empty Tolerance clears it, which means no tolerance agreed — not zero."]</li>
                    <li>@Loc["If any row cannot be read, nothing at all is imported."]</li>
                </ul>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">@Loc["Cancel"]</button>
                <button type="submit" class="btn btn-primary"><i class="bi bi-upload me-1"></i>@Loc["Import"]</button>
            </div>
        </form>
    </div>
</div>

<div class="modal fade" id="dcModal" tabindex="-1">
    <div class="modal-dialog">
        <form asp-action="SaveDefectCategory" method="post" class="modal-content">
            @Html.AntiForgeryToken()
            <input type="hidden" name="categoryId" id="dc-id" value="0" />
            <div class="modal-header"><h5 class="modal-title" id="dc-title">@Loc["Add category"]</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button></div>
            <div class="modal-body">
                <div class="row g-2">
                    <div class="col-md-8"><label class="form-label">@Loc["Name *"]</label>
                        <input name="categoryName" id="dc-name" class="form-control" required maxlength="20" />
                        <small class="text-muted">@Loc["e.g. Major, Minor, Critical, Progressive."]</small>
                    </div>
                    <div class="col-md-4"><label class="form-label">@Loc["Sort order"]</label>
                        <input name="sortOrder" id="dc-sort" type="number" class="form-control" value="500" /></div>
                    <div class="col-md-6"><label class="form-label">@Loc["Colour"]</label>
                        <div class="d-flex gap-2 align-items-center">
                            <input type="color" id="dc-color-picker" class="form-control form-control-color" value="#6c757d" title="Section colour" />
                            <input name="colorHex" id="dc-color" class="form-control" placeholder='@Loc["#RRGGBB"]'
                                   pattern="#[0-9A-Fa-f]{6}" title="Hex colour like #b02a37" />
                        </div>
                        <small class="text-muted">@Loc["Used for the section banner in the form and PDF."]</small>
                    </div>
                    <div class="col-12"><div class="form-check form-switch">
                        <input class="form-check-input" type="checkbox" name="isActive" id="dc-active" value="true" checked />
                        <label class="form-check-label" for="dc-active">@Loc["Active"]</label>
                    </div></div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">@Loc["Cancel"]</button>
                <button type="submit" class="btn btn-primary">@Loc["Save"]</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
<script>
    // Keep the colour picker and the hex text input in sync (both ways).
    document.getElementById('dc-color-picker').addEventListener('input', function () {
        document.getElementById('dc-color').value = this.value;
    });
    document.getElementById('dc-color').addEventListener('input', function () {
        if (/^#[0-9A-Fa-f]{6}$/.test(this.value)) document.getElementById('dc-color-picker').value = this.value;
    });

    document.getElementById('dcModal').addEventListener('show.bs.modal', function (e) {
        var b = e.relatedTarget;
        if (b.dataset.mode === 'edit') {
            document.getElementById('dc-title').textContent = 'Edit category';
            document.getElementById('dc-id').value   = b.dataset.id;
            document.getElementById('dc-name').value  = b.dataset.name;
            document.getElementById('dc-sort').value  = b.dataset.sort;
            document.getElementById('dc-color').value = b.dataset.color || '';
            document.getElementById('dc-color-picker').value = /^#[0-9A-Fa-f]{6}$/.test(b.dataset.color) ? b.dataset.color : '#6c757d';
            document.getElementById('dc-active').checked = b.dataset.active === 'true';
        } else {
            document.getElementById('dc-title').textContent = 'Add category';
            document.getElementById('dc-id').value = 0;
            document.getElementById('dc-name').value = '';
            document.getElementById('dc-sort').value = '500';
            document.getElementById('dc-color').value = '';
            document.getElementById('dc-color-picker').value = '#6c757d';
            document.getElementById('dc-active').checked = true;
        }
    });
</script>
}
