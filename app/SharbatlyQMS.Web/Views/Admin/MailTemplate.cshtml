@using SharbatlyQMS.Web.Services
@model QoMailTemplate
@{
    ViewData["Title"] = "Mail Template";

    // The one and only substitution list — ReportsController.PrepareSendQualityReport.
    // Keep this table in step with that method; a token that is not in the
    // Substitute() chain there is sent to the supplier as literal text.
    var tokens = new (string Token, string Means, string Example)[]
    {
        ("{QO_NO}",     "Quality Order number",                     "QO-2026-000399"),
        ("{CONTAINER}", "Container number from the arrival",        "MNBU3969264"),
        ("{BOL}",       "Bill of Lading number",                    "065-49966700"),
        ("{PO}",        "SAP purchase order (EBELN)",               "5300003964"),
        ("{SUPPLIER}",  "Supplier name, as SAP spells it",          "SQ FLORA B.V."),
        ("{TODAY}",     "Date the e-mail is prepared (yyyy-MM-dd)", "2026-08-20"),
    };
}

<h1 class="h3 mb-3">
    <i class="bi bi-envelope-paper me-1"></i>Mail Template &mdash; Quality Order Report
    <small class="text-muted fs-6 fw-normal ms-2">Subject and body used when sending the QO report to suppliers.</small>
</h1>

<div class="row g-3">
    <div class="col-lg-7">
        <form asp-action="SaveMailTemplate" method="post" class="card h-100">
            @Html.AntiForgeryToken()
            <div class="card-body">
                <div class="form-check form-switch mb-3">
                    <input class="form-check-input" type="checkbox" name="Enabled" id="m-enabled" value="true" checked="@Model.Enabled" />
                    <label class="form-check-label" for="m-enabled">Show <strong>Send report to supplier</strong> button on the Claims page</label>
                </div>

                <div class="mb-3">
                    <label class="form-label" for="m-subject">Subject *</label>
                    <input name="Subject" id="m-subject" class="form-control" value="@Model.Subject" required data-token-target />
                </div>
                <div class="mb-3">
                    <label class="form-label" for="m-body">Body *</label>
                    <textarea name="Body" id="m-body" class="form-control" rows="12" required data-token-target>@Model.Body</textarea>
                    <div class="form-text">Plain text. Newlines preserved. HTML is not rendered to the supplier.</div>
                </div>
            </div>
            <div class="card-footer text-end">
                <button type="submit" class="btn btn-primary"><i class="bi bi-save me-1"></i>Save template</button>
            </div>
        </form>
    </div>

    <div class="col-lg-5">
        <div class="card h-100">
            <div class="card-header">
                <i class="bi bi-braces me-1"></i>Placeholders
            </div>
            <div class="card-body">
                <p class="small text-muted">
                    Type a placeholder anywhere in the subject or body and it is replaced with
                    the order's real value when the send dialog opens. Click one to insert it
                    where your cursor is.
                </p>
                <div class="table-responsive">
                    <table class="table table-sm align-middle mb-0">
                        <thead class="table-light">
                            <tr><th>Placeholder</th><th>Becomes</th><th>Example</th></tr>
                        </thead>
                        <tbody>
                            @foreach (var t in tokens)
                            {
                                <tr>
                                    <td>
                                        <button type="button" class="btn btn-sm btn-outline-secondary font-monospace py-0 px-1"
                                                data-token="@t.Token" title="Insert @t.Token">@t.Token</button>
                                    </td>
                                    <td class="small">@t.Means</td>
                                    <td class="small text-muted font-monospace">@t.Example</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <div class="alert alert-warning small mt-3 mb-0">
                    <i class="bi bi-exclamation-triangle me-1"></i>
                    <strong>Spelling matters.</strong> Placeholders are case-sensitive and must
                    include both braces. Anything that is not on this list &mdash; a typo like
                    <code>{QO NO}</code> or an invented one like <code>{VESSEL}</code> &mdash; is
                    <em>not</em> replaced: the supplier receives it as literal text.
                </div>
                <div class="alert alert-info small mt-2 mb-0">
                    <i class="bi bi-info-circle me-1"></i>
                    Substitution happens once, when the send dialog opens. If you edit the
                    subject or body inside that dialog and type a placeholder there, it is sent
                    as-is &mdash; the replacement has already run.
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
    // Insert a placeholder at the caret of whichever template field was last
    // focused (body by default), rather than always appending to the end.
    (function () {
        let last = document.getElementById('m-body');
        document.querySelectorAll('[data-token-target]').forEach(function (el) {
            el.addEventListener('focus', function () { last = el; });
        });
        document.querySelectorAll('[data-token]').forEach(function (btn) {
            btn.addEventListener('click', function () {
                const token = btn.getAttribute('data-token');
                const el = last || document.getElementById('m-body');
                if (!el) return;
                const start = el.selectionStart ?? el.value.length;
                const end   = el.selectionEnd   ?? el.value.length;
                el.value = el.value.slice(0, start) + token + el.value.slice(end);
                el.focus();
                const caret = start + token.length;
                el.setSelectionRange(caret, caret);
            });
        });
    })();
</script>
}
