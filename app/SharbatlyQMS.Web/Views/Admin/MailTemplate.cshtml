@using SharbatlyQMS.Web.Services
@model QoMailTemplate
@{
    ViewData["Title"] = Loc["Mail Template"];

    // The one and only substitution list — ReportsController.PrepareSendQualityReport.
    // Keep this table in step with that method; a token that is not in the
    // Substitute() chain there is sent to the supplier as literal text.
    var tokens = new (string Token, string Means, string Example)[]
    {
        ("{QO_NO}",     "Quality Order number, in full",            "QO-2026-000399"),
        ("{QC_NO}",     "Short QC number — no prefix, no zeros",    "399"),
        ("{CONTAINER}", "Container number from the arrival",        "MNBU3969264"),
        ("{BOL}",       "Bill of Lading number",                    "065-49966700"),
        ("{PO}",        "SAP purchase order (EBELN)",               "5300003964"),
        ("{SUPPLIER}",  "Supplier name, as SAP spells it",          "SQ FLORA B.V."),
        ("{VENDOR}",    "Same as {SUPPLIER}",                       "SQ FLORA B.V."),
        ("{ARRIVAL_NO}","Arrival number the order was raised from", "ARR-2026-001364"),
        ("{TODAY}",     "Date the e-mail is prepared (yyyy-MM-dd)", "2026-08-20"),
    };
}

<h1 class="h3 mb-3">
    <i class="bi bi-envelope-paper me-1"></i>Mail Template &mdash; Quality Order Report
    <small class="text-muted fs-6 fw-normal ms-2">@Loc["Subject and body used when sending the QO report to suppliers."]</small>
</h1>

<div class="row g-3">
    <div class="col-lg-7">
        <form asp-action="SaveMailTemplate" method="post" class="card h-100" id="mail-template-form">
            @Html.AntiForgeryToken()
            <div class="card-body">
                <div class="mb-3">
                    <label class="form-label" for="m-subject">@Loc["Subject *"]</label>
                    <input name="Subject" id="m-subject" class="form-control" value="@Model.Subject" required data-token-target />
                </div>
                <div class="mb-3">
                    <label class="form-label" for="m-cc">@Loc["Always CC"]</label>
                    <input name="Cc" id="m-cc" class="form-control" value="@Model.Cc"
                           placeholder="quality@sharbatlyfruit.com, manager@sharbatlyfruit.com" />
                    <div class="form-text">
                        Copied on <strong>@Loc["every"]</strong> report sent to a supplier, on top of any CC
                        the sender adds. Comma- or semicolon-separated; leave blank for none.
                        The sender can see these in the send dialog but cannot remove them.
                    </div>
                </div>
                <div class="mb-3">
                    <label class="form-label" for="m-body">@Loc["Body *"]</label>
                    <textarea name="Body" id="m-body" class="form-control" rows="12" required data-token-target>@Model.Body</textarea>
                    <div class="form-text">@Loc["Plain text. Newlines preserved. HTML is not rendered to the supplier."]</div>
                </div>
            </div>
            <div class="card-footer text-end">
                <button type="submit" class="btn btn-primary"><i class="bi bi-save me-1"></i>@Loc["Save template"]</button>
            </div>
        </form>
    </div>

    <div class="col-lg-5">
        <div class="card h-100">
            <div class="card-header">
                <i class="bi bi-braces me-1"></i>@Loc["Placeholders"]
            </div>
            <div class="card-body">
                <p class="small text-muted">
                    Type a placeholder anywhere in the subject or body and it is replaced with
                    the order's real value when the send dialog opens. Click one to insert it
                    where your cursor is.
                </p>
                <div class="table-responsive">
                    <table class="table table-sm align-middle mb-0">
                        <thead class="table-light">
                            <tr><th>@Loc["Placeholder"]</th><th>@Loc["Becomes"]</th><th>@Loc["Example"]</th></tr>
                        </thead>
                        <tbody>
                            @foreach (var t in tokens)
                            {
                                <tr>
                                    <td>
                                        <button type="button" class="btn btn-sm btn-outline-secondary font-monospace py-0 px-1"
                                                data-token="@t.Token" title="Insert @t.Token">@t.Token</button>
                                    </td>
                                    <td class="small">@t.Means</td>
                                    <td class="small text-muted font-monospace">@t.Example</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <div class="alert alert-warning small mt-3 mb-0">
                    <i class="bi bi-exclamation-triangle me-1"></i>
                    <strong>@Loc["Spelling matters."]</strong> Placeholders are case-sensitive and must
                    include both braces. Anything that is not on this list &mdash; a typo like
                    <code>{QO NO}</code> or an invented one like <code>{VESSEL}</code> &mdash; is
                    <em>@Loc["not"]</em> replaced: the supplier receives it as literal text.
                </div>
                <div class="alert alert-info small mt-2 mb-0">
                    <i class="bi bi-info-circle me-1"></i>
                    Substitution happens once, when the send dialog opens. If you edit the
                    subject or body inside that dialog and type a placeholder there, it is sent
                    as-is &mdash; the replacement has already run.
                </div>
            </div>
        </div>
    </div>
</div>

@* ---- The internal finish notification. A separate mail from the supplier
   report above: different recipients, different purpose, and its own subject.
   Placed in its own card with its own heading so nobody edits one thinking
   they are editing the other. ---- *@
<div class="card mt-3">
    <div class="card-header bg-primary text-white">
        <i class="bi bi-bell me-1"></i>@Loc["Notification mail subject"]
    </div>
    <div class="card-body">
        <p class="text-muted small">
            @Loc["Sent to the people chosen on Parameters → Notifications when a quality order is finished. This is NOT the mail the supplier receives — that one is above."]
        </p>

        <form asp-action="SaveNotifySubject" method="post" class="row g-3">
            @Html.AntiForgeryToken()
            <div class="col-12">
                <label class="form-label" for="n-subject">@Loc["Subject"]</label>
                <input name="notifySubject" id="n-subject" class="form-control"
                       value="@Model.NotifySubject" maxlength="150"
                       placeholder="@ViewBag.AutomaticSubjectExample" />
                <div class="form-text">
                    @Loc["Leave it empty for the automatic subject, which is what is sent today:"]
                    <code>@ViewBag.AutomaticSubjectExample</code>
                </div>
            </div>

            <div class="col-12">
                <div class="d-flex flex-wrap gap-1 align-items-center">
                    <span class="small text-muted me-1">@Loc["Insert:"]</span>
                    @foreach (var t in SharbatlyQMS.Web.Services.QcSubjectLine.Tokens)
                    {
                        <button type="button" class="btn btn-sm btn-outline-secondary font-monospace py-0 px-1"
                                data-notify-token="@t.Token" title="@t.Means">@t.Token</button>
                    }
                </div>
            </div>

            <div class="col-12">
                <div class="alert alert-light border small mb-0">
                    <i class="bi bi-info-circle me-1"></i>
                    @Loc["A placeholder with nothing behind it is removed rather than printed, and the leftover separator goes with it. The subject is trimmed to 150 characters, because mail clients cut it off long before that."]
                </div>
            </div>

            <div class="col-12 text-end">
                <button type="submit" class="btn btn-primary">
                    <i class="bi bi-save me-1"></i>@Loc["Save notification subject"]
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
<script>
    // Insert a placeholder at the caret of whichever template field was last
    // focused (body by default), rather than always appending to the end.
    (function () {
        let last = document.getElementById('m-body');
        document.querySelectorAll('[data-token-target]').forEach(function (el) {
            el.addEventListener('focus', function () { last = el; });
        });
        // The notification subject has its own single field and its own
        // buttons: sharing the inserter above would drop a token into whichever
        // supplier-template field happened to be focused last.
        document.querySelectorAll('[data-notify-token]').forEach(function (btn) {
            btn.addEventListener('click', function () {
                const el = document.getElementById('n-subject');
                if (!el) return;
                const token = btn.getAttribute('data-notify-token');
                const start = el.selectionStart ?? el.value.length;
                const end   = el.selectionEnd   ?? el.value.length;
                el.value = el.value.slice(0, start) + token + el.value.slice(end);
                el.focus();
                const caret = start + token.length;
                el.setSelectionRange(caret, caret);
            });
        });

        document.querySelectorAll('[data-token]').forEach(function (btn) {
            btn.addEventListener('click', function () {
                const token = btn.getAttribute('data-token');
                const el = last || document.getElementById('m-body');
                if (!el) return;
                const start = el.selectionStart ?? el.value.length;
                const end   = el.selectionEnd   ?? el.value.length;
                el.value = el.value.slice(0, start) + token + el.value.slice(end);
                el.focus();
                const caret = start + token.length;
                el.setSelectionRange(caret, caret);
            });
        });
    })();
</script>
}
