@using SharbatlyQMS.Web.Models
@model List<(ArrivalFieldDef Def, ArrivalFieldPolicy Policy)>
@{
    ViewData["Title"] = Loc["Arrival Field Rules"];
    var canEdit = Perms.Can(Perm.Parameters.ArrivalFieldRulesEdit);
    var byForm  = Model.GroupBy(x => x.Def.Form);
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0"><i class="bi bi-sliders me-1"></i>@Loc["Arrival Field Rules"]</h1>
</div>

<p class="text-muted">
    For each editable arrival field, choose whether it is <strong>@Loc["Mandatory"]</strong>
    (the arrival can't be Completed while it's empty) and whether it stays
    <strong>@Loc["Editable when closed"]</strong> (can be changed after the arrival is
    Completed). Fields sourced from SAP are read-only and not listed here.
</p>

<form asp-action="SaveArrivalFieldRules" method="post">
    @Html.AntiForgeryToken()
    @foreach (var grp in byForm)
    {
        <div class="card mb-3">
            <div class="card-header bg-primary text-white">
                <i class="bi bi-@(grp.Key == ArrivalFieldRegistry.Shipment ? "truck" : "clipboard-check") me-1"></i>@grp.Key
            </div>
            <div class="table-responsive">
                <table class="table table-sm table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>@Loc["Field"]</th>
                            <th class="text-center" style="width:9rem">@Loc["Mandatory"]</th>
                            <th class="text-center" style="width:11rem">@Loc["Editable when closed"]</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var (def, pol) in grp)
                        {
                            <tr>
                                <td>@def.Display <span class="text-muted small">(@def.Kind)</span></td>
                                <td class="text-center">
                                    <input type="checkbox" class="form-check-input" name="mandatory"
                                           value="@def.Key" checked="@pol.IsMandatory" disabled="@(!canEdit)" />
                                </td>
                                <td class="text-center">
                                    <input type="checkbox" class="form-check-input" name="editableWhenClosed"
                                           value="@def.Key" checked="@pol.EditableWhenClosed" disabled="@(!canEdit)" />
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }

    <div class="card mb-3">
        <div class="card-header bg-primary text-white">
            <i class="bi bi-calendar-check me-1"></i>@Loc["Shipment date checks"]
        </div>
        <div class="card-body">
            <label class="form-label fw-semibold" for="dischargeBeforeLoadingDays">
                @Loc["Days a discharge date may be before the loading date"]
            </label>
            <input type="number" min="0" max="7" step="1" required class="form-control" style="max-width:7rem"
                   id="dischargeBeforeLoadingDays" name="dischargeBeforeLoadingDays"
                   value="@ViewBag.DischargeBeforeLoadingDays" disabled="@(!canEdit)" />
            <div class="form-text">
                @Loc["A vessel cannot discharge a container before it was loaded, so an earlier date is normally a typing mistake. But the loading date comes from SAP (Sailing Date), it can run a day or more behind the real date, and inspectors cannot correct it. This sets how far before the loading date a Vessel Discharge Date is still accepted when saving an arrival; anything earlier is refused."]
            </div>
            <ul class="form-text mb-0">
                <li>@Loc["0 — never before the loading date (strictest)."]</li>
                <li>@Loc["1 — one day before is accepted (default). Allowed range: 0 to 7."]</li>
                <li>@Loc["Accepted dates still print 0 transit days, because transit is never shown as negative."]</li>
                <li>@Loc["Applies only when the date is entered or changed; dates already saved are not rechecked."]</li>
            </ul>
        </div>
    </div>

    @if (canEdit)
    {
        <button type="submit" class="btn btn-primary">
            <i class="bi bi-save me-1"></i>@Loc["Save rules"]
        </button>
    }
</form>
