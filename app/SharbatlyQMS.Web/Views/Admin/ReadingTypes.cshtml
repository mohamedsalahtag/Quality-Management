@using SharbatlyQMS.Web.Models
@using SharbatlyQMS.Web.Services
@model IReadOnlyList<ReadingTypeEntry>
@{
    ViewData["Title"] = "Reading Types";
    var groups      = ViewBag.Groups      as IReadOnlyList<MaraGroup> ?? new List<MaraGroup>();
    var filterGroup = ViewBag.FilterGroup as string;
    var maraEmpty   = (bool?)ViewBag.MaraEmpty ?? false;
    string GroupLabel(MaraGroup g) => string.IsNullOrWhiteSpace(g.Name) ? g.Code : $"{g.Code} — {g.Name}";

    // How the Quality Order PDF grouped-summary block aggregates each
    // reading. Mirrored verbatim by the modal dropdown + the
    // BuildGroupSummariesAsync renderer on the server. Keep the labels
    // short so the row fits comfortably alongside Kind / Unit / etc.
    string DisplayModeLabel(string m) => m switch {
        "text"          => "Text join",
        "count"         => "Count",
        "sum"           => "Sum",
        "avg"           => "Average",
        "sum_over_size" => "% of Σ size",
        "formula"       => "Formula",
        _               => m
    };
}

<div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
    <h1 class="h3 mb-0">
        <i class="bi bi-rulers me-1"></i>Reading Types
        <small class="text-muted fs-6 fw-normal ms-2">Measurements captured per sample (Brix, Firmness, Net Weight, …).</small>
    </h1>
    <div class="d-flex gap-2">
        <form method="get" asp-action="ReadingTypes" class="d-flex gap-2">
            <select name="materialGroup" class="form-select form-select-sm" onchange="this.form.submit()">
                <option value="">All material groups</option>
                @foreach (var g in groups)
                {
                    <option value="@g.Code" selected="@(g.Code == filterGroup)">@GroupLabel(g)</option>
                }
            </select>
            @if (!string.IsNullOrEmpty(filterGroup))
            {
                <a asp-action="ReadingTypes" class="btn btn-sm btn-outline-secondary">Clear</a>
            }
        </form>
        <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#rtModal"
                data-mode="create" data-default-group="@(filterGroup ?? "")">
            <i class="bi bi-plus-circle me-1"></i>Add reading type
            @if (!string.IsNullOrEmpty(filterGroup))
            {
                <span class="badge bg-light text-dark ms-1" title="The new reading type will land in this group (matches the filter above).">to <code class="text-primary">@filterGroup</code></span>
            }
        </button>
    </div>
</div>
<div class="card">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0" data-tablekit data-page-size="50">
            <thead class="table-light">
                <tr>
                    <th style="width:1%"></th>
                    <th>Group</th>
                    <th>Code</th>
                    <th>Name</th>
                    <th>Kind</th>
                    <th>Unit</th>
                    <th title="How this reading is aggregated in the Quality Order PDF grouped summary">PDF summary</th>
                    <th>Mandatory</th>
                    <th>Active</th>
                    <th class="text-end" style="width: 120px">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var r in Model)
                {
                    <tr>
                        <td class="text-muted small">@r.SortOrder</td>
                        <td>
                            @if (string.IsNullOrEmpty(r.MaterialGroup))
                            {
                                <span class="badge bg-info text-dark" title="Applies to every material group">Global</span>
                            }
                            else
                            {
                                <code>@r.MaterialGroup</code>
                            }
                        </td>
                        <td><code>@r.ReadingTypeCode</code></td>
                        <td>@r.ReadingName</td>
                        <td>@r.ValueKind</td>
                        <td>@r.DefaultUnit</td>
                        <td><span class="badge bg-light text-dark border">@DisplayModeLabel(r.DisplayMode)</span></td>
                        <td>
                            @if (r.IsMandatory)
                            {
                                <span class="badge bg-danger"><i class="bi bi-exclamation-circle me-1"></i>Required</span>
                            }
                            else
                            {
                                <span class="text-muted small">Optional</span>
                            }
                        </td>
                        <td>@(r.IsActive ? "Yes" : "No")</td>
                        <td class="text-end text-nowrap">
                            <button type="button" class="btn btn-sm btn-outline-secondary"
                                    data-bs-toggle="modal" data-bs-target="#rtModal"
                                    data-mode="edit"
                                    data-id="@r.ReadingTypeId" data-group="@r.MaterialGroup"
                                    data-code="@r.ReadingTypeCode" data-name="@r.ReadingName"
                                    data-kind="@r.ValueKind" data-unit="@r.DefaultUnit"
                                    data-active="@r.IsActive.ToString().ToLower()"
                                    data-mandatory="@r.IsMandatory.ToString().ToLower()"
                                    data-sort="@r.SortOrder"
                                    data-display="@r.DisplayMode"
                                    title="Edit">
                                <i class="bi bi-pencil"></i>
                            </button>
                            @if (r.IsInUse)
                            {
                                <button type="button" class="btn btn-sm btn-outline-secondary"
                                        disabled
                                        title="Used by at least one Quality Order sample — cannot delete. Mark inactive instead.">
                                    <i class="bi bi-trash"></i>
                                </button>
                            }
                            else
                            {
                                <form asp-action="DeleteReadingType" method="post" class="d-inline"
                                      data-confirm="Delete reading type @r.ReadingTypeCode (@r.ReadingName)? This cannot be undone." data-confirm-danger data-confirm-ok="Delete">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="readingTypeId" value="@r.ReadingTypeId" />
                                    <input type="hidden" name="materialGroup" value="@filterGroup" />
                                    <button type="submit" class="btn btn-sm btn-outline-danger" title="Delete">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </form>
                            }
                        </td>
                    </tr>
                }
                @if (Model.Count == 0)
                {
                    <tr><td colspan="10" class="text-center text-muted small py-3">No reading types @(string.IsNullOrEmpty(filterGroup) ? "yet." : "for " + filterGroup + ".")</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>

<div class="modal fade" id="rtModal" tabindex="-1">
    <div class="modal-dialog">
        <form asp-action="SaveReadingType" method="post" class="modal-content">
            @Html.AntiForgeryToken()
            <input type="hidden" name="readingTypeId" id="r-id" value="0" />
            <div class="modal-header"><h5 class="modal-title" id="r-title">Add reading type</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button></div>
            <div class="modal-body">
                <div class="row g-2">
                    <div class="col-md-6"><label class="form-label">Material group *</label>
                        @* "Global" maps to NULL material_group at the DB layer.
                           Sourced from the SAP MARA cache otherwise. If the page
                           filter is active, the matching option is server-side
                           selected so a new reading type lands in the same group. *@
                        <select name="materialGroup" id="r-group" class="form-select">
                            <option value="" selected="@(string.IsNullOrEmpty(filterGroup))">🌐 Global — applies to every material group</option>
                            @foreach (var g in groups)
                            {
                                <option value="@g.Code" selected="@(g.Code == filterGroup)">@GroupLabel(g)</option>
                            }
                        </select>
                        @if (maraEmpty)
                        {
                            <small class="text-warning"><i class="bi bi-exclamation-triangle me-1"></i>SAP MARA cache is empty — run a Material Master Sync from <a asp-action="Settings">Site Configuration</a> to populate this list.</small>
                        }
                    </div>
                    <div class="col-md-6"><label class="form-label">Sort order</label>
                        <input name="sortOrder" id="r-sort" type="number" class="form-control" value="500" /></div>
                    <div class="col-md-6"><label class="form-label">Code *</label>
                        <input name="readingTypeCode" id="r-code" class="form-control" required /></div>
                    <div class="col-md-6"><label class="form-label">Name *</label>
                        <input name="readingName" id="r-name" class="form-control" required /></div>
                    <div class="col-md-6"><label class="form-label">Value kind *</label>
                        <select name="valueKind" id="r-kind" class="form-select" required>
                            <option value="Numeric">Numeric</option>
                            <option value="Text">Text</option>
                        </select></div>
                    <div class="col-md-6"><label class="form-label">Default unit</label>
                        <input name="defaultUnit" id="r-unit" class="form-control" /></div>
                    <div class="col-md-6"><label class="form-label">PDF summary mode</label>
                        <select name="displayMode" id="r-display" class="form-select">
                            <option value="text">Text join — distinct values, comma-separated</option>
                            <option value="count">Count — number of samples with a value</option>
                            <option value="sum">Sum — total of numeric values</option>
                            <option value="avg">Average — Σ value ÷ sample count (e.g. Gross / Net weight)</option>
                            <option value="sum_over_size">% of Σ size — (Σ value ÷ Σ sample size) × 100</option>
                            <option value="formula">Formula — placeholder, renders as “—” for now</option>
                        </select>
                        <small class="text-muted">Controls how the Quality Order PDF grouped summary renders this reading.</small>
                    </div>
                    <div class="col-12"><div class="form-check form-switch">
                        <input class="form-check-input" type="checkbox" name="isActive" id="r-active" value="true" checked />
                        <label class="form-check-label" for="r-active">Active</label>
                    </div></div>
                    <div class="col-12"><div class="form-check form-switch">
                        <input class="form-check-input" type="checkbox" name="isMandatory" id="r-mandatory" value="true" />
                        <label class="form-check-label" for="r-mandatory">
                            Mandatory <span class="text-muted small">— sample cannot be saved unless this reading has a value</span>
                        </label>
                    </div></div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="submit" class="btn btn-primary">Save</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
<script>
    document.getElementById('rtModal').addEventListener('show.bs.modal', function (e) {
        var b = e.relatedTarget;
        if (b.dataset.mode === 'edit') {
            document.getElementById('r-title').textContent = 'Edit reading type';
            document.getElementById('r-id').value     = b.dataset.id;
            document.getElementById('r-group').value  = b.dataset.group;
            document.getElementById('r-code').value   = b.dataset.code;
            document.getElementById('r-name').value   = b.dataset.name;
            document.getElementById('r-kind').value   = b.dataset.kind;
            document.getElementById('r-unit').value   = b.dataset.unit;
            document.getElementById('r-sort').value   = b.dataset.sort;
            document.getElementById('r-active').checked    = b.dataset.active === 'true';
            document.getElementById('r-mandatory').checked = b.dataset.mandatory === 'true';
            document.getElementById('r-display').value     = b.dataset.display || 'sum';
        } else {
            document.getElementById('r-title').textContent = 'Add reading type';
            document.getElementById('r-id').value = 0;
            ['r-code','r-name','r-unit','r-sort'].forEach(id => {
                var el = document.getElementById(id);
                if (el) el.value = '';
            });
            document.getElementById('r-group').value = b.dataset.defaultGroup || '';
            document.getElementById('r-kind').value  = 'Numeric';
            document.getElementById('r-sort').value  = '500';
            document.getElementById('r-active').checked    = true;
            document.getElementById('r-mandatory').checked = false;
            // Default the new-reading display_mode to 'sum' to match the
            // Numeric kind default; the user can switch to 'text' when they
            // pick the Text kind below.
            document.getElementById('r-display').value = 'sum';
        }
        // Keep display_mode aligned with value_kind by default: switching kind
        // to Text auto-picks 'text', switching back to Numeric auto-picks 'sum'.
        // Users can still override afterwards -- this is a hint, not a lock.
        var kindEl = document.getElementById('r-kind');
        if (kindEl && !kindEl._displaySyncHooked) {
            kindEl._displaySyncHooked = true;
            kindEl.addEventListener('change', function () {
                var d = document.getElementById('r-display');
                if (!d) return;
                d.value = this.value === 'Text' ? 'text' : 'sum';
            });
        }
    });
</script>
}
