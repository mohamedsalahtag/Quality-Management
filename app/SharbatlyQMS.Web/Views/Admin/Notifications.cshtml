@using SharbatlyQMS.Web.Services
@{
    ViewData["Title"] = "Notifications";
    var people   = ViewBag.Candidates as IReadOnlyList<NotifyCandidate> ?? new List<NotifyCandidate>();
    var scope    = ViewBag.ScopeOptions as NotifyScopeOptions ?? new NotifyScopeOptions();
    var canEdit  = Perms.Can(Perm.Parameters.NotificationsEdit);
    var selected = people.Count(p => p.Selected);
    var mailable = people.Where(p => p.IsActive && p.CanBeMailed).ToList();
    var noEmail  = people.Where(p => p.IsActive && !p.CanBeMailed).ToList();
    var inactive = people.Where(p => !p.IsActive && p.Selected).ToList();
}

<style>
    /* Toggle chips for the per-recipient scope. Sized down from the default
       button so seven plants sit on one or two lines inside a table cell. */
    .scope-chips        { display: flex; flex-wrap: wrap; gap: .2rem; }
    .scope-chips .btn   { --bs-btn-padding-y: .1rem; --bs-btn-padding-x: .4rem;
                          --bs-btn-font-size: .72rem; }
    .scope-foot         { display: flex; justify-content: space-between; align-items: baseline;
                          gap: .5rem; margin-top: .2rem; font-size: .7rem; }
    .scope-hint         { color: var(--bs-secondary-color); }
    /* "All" on an untouched cell is the current behaviour, not a warning -- but
       it is worth reading, so it stays legible rather than fading out. */
    .scope-hint.is-all  { font-style: italic; }
    .scope-links a      { text-decoration: none; }
    .scope-links        { white-space: nowrap; }
</style>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">
        <i class="bi bi-bell me-1 text-primary"></i>Notifications
        <small class="text-muted fs-6 fw-normal ms-2">Who is emailed when a quality order is finished</small>
    </h1>
</div>

<div class="alert alert-light border d-flex gap-2 align-items-start">
    <i class="bi bi-info-circle mt-1 text-primary"></i>
    <div class="small">
        The moment an order is finished, everyone ticked below receives a mail with the
        shipment's basic details and the QC summary &mdash; samples inspected and the
        defect breakdown per material group.
        <strong>Nobody ticked means nobody is mailed</strong>, which is how the notification
        is switched off.
        <div class="mt-1">
            Each person can be narrowed to certain plants and procurement types.
            <strong>Leaving a box empty means everything</strong>, so a recipient you never
            narrow keeps receiving every order.
        </div>
        <div class="text-muted mt-1">
            Addresses come from each person's profile, so a changed address follows them
            automatically and a deactivated account stops receiving mail on its own.
        </div>
    </div>
</div>

<form method="post" asp-action="SaveNotifications">
    @Html.AntiForgeryToken()

    <div class="card mb-3">
        <div class="card-header py-2 d-flex justify-content-between align-items-center">
            <span>
                <i class="bi bi-people me-1"></i>Recipients
                <span class="badge text-bg-@(selected > 0 ? "primary" : "secondary") ms-1">@selected selected</span>
            </span>
            @if (canEdit && mailable.Count > 0)
            {
                <span class="small">
                    <a href="#" class="text-decoration-none" data-select-all>Select all</a>
                    <span class="text-muted mx-1">&middot;</span>
                    <a href="#" class="text-decoration-none" data-select-none>Clear</a>
                </span>
            }
        </div>

        @if (mailable.Count == 0)
        {
            <div class="card-body text-muted">
                No active user has an email address on their profile, so there is nobody to
                notify yet. Add addresses on <a asp-action="Users">Users</a> first.
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0 qms-index-table">
                    <thead class="table-light">
                        <tr>
                            <th style="width:3rem"></th>
                            <th style="width:14rem">Name</th>
                            <th style="width:15rem">Email</th>
                            <th>
                                Plants <span class="text-muted fw-normal">(none ticked = all)</span>
                                @if (canEdit)
                                {
                                    <span class="scope-links fw-normal ms-1">
                                        &mdash; every row:
                                        <a href="#" data-col-all="plant">All</a><span class="mx-1">/</span><a href="#" data-col-none="plant">None</a>
                                    </span>
                                }
                            </th>
                            <th>
                                Procurement types <span class="text-muted fw-normal">(none ticked = all)</span>
                                @if (canEdit)
                                {
                                    <span class="scope-links fw-normal ms-1">
                                        &mdash; every row:
                                        <a href="#" data-col-all="procurement type">All</a><span class="mx-1">/</span><a href="#" data-col-none="procurement type">None</a>
                                    </span>
                                }
                            </th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var p in mailable)
                        {
                            <tr>
                                <td>
                                    <input class="form-check-input" type="checkbox" name="userIds"
                                           value="@p.UserId" id="nu-@p.UserId"
                                           checked="@p.Selected" disabled="@(!canEdit)" />
                                </td>
                                <td>
                                    <label class="mb-0 d-block" for="nu-@p.UserId">@p.FullName</label>
                                    <span class="text-muted" style="font-size:.72rem">@p.RoleName</span>
                                </td>
                                <td class="text-muted">@p.Email</td>
                                @* Toggle chips rather than a multi-select: a
                                   multi-select needs ctrl-click to add and loses
                                   the lot on a stray click, which is a poor way to
                                   set something that decides who gets told. *@
                                <td>
                                    <div class="scope-cell" data-scope data-scope-kind="plant">
                                        <div class="scope-chips">
                                            @foreach (var (code, label) in scope.Plants)
                                            {
                                                var cid = $"pl-{p.UserId}-{code}";
                                                <input type="checkbox" class="btn-check" name="plants_@p.UserId"
                                                       value="@code" id="@cid" autocomplete="off"
                                                       checked="@p.Plants.Contains(code, StringComparer.OrdinalIgnoreCase)"
                                                       disabled="@(!canEdit)" />
                                                <label class="btn btn-sm btn-outline-primary" for="@cid" title="@code">@label</label>
                                            }
                                        </div>
                                        <div class="scope-foot">
                                            <span class="scope-hint" data-scope-hint></span>
                                            @if (canEdit)
                                            {
                                                <span class="scope-links">
                                                    <a href="#" data-scope-all>All</a><span class="mx-1">/</span><a href="#" data-scope-none>None</a>
                                                </span>
                                            }
                                        </div>
                                    </div>
                                </td>
                                <td>
                                    <div class="scope-cell" data-scope data-scope-kind="procurement type">
                                        <div class="scope-chips">
                                            @foreach (var (code, label) in scope.PoTypes)
                                            {
                                                var cid = $"pt-{p.UserId}-{code}";
                                                <input type="checkbox" class="btn-check" name="poTypes_@p.UserId"
                                                       value="@code" id="@cid" autocomplete="off"
                                                       checked="@p.PoTypes.Contains(code, StringComparer.OrdinalIgnoreCase)"
                                                       disabled="@(!canEdit)" />
                                                <label class="btn btn-sm btn-outline-secondary" for="@cid" title="@code">@label</label>
                                            }
                                        </div>
                                        <div class="scope-foot">
                                            <span class="scope-hint" data-scope-hint></span>
                                            @if (canEdit)
                                            {
                                                <span class="scope-links">
                                                    <a href="#" data-scope-all>All</a><span class="mx-1">/</span><a href="#" data-scope-none>None</a>
                                                </span>
                                            }
                                        </div>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>

    @* People who cannot be reached are listed rather than silently omitted -- an
       admin who ticks nobody because a colleague is missing should be able to see
       why they are missing. *@
    @if (noEmail.Count > 0)
    {
        <div class="alert alert-warning small">
            <i class="bi bi-exclamation-triangle me-1"></i>
            @noEmail.Count active user(s) have no email address and cannot be notified:
            <strong>@string.Join(", ", noEmail.Select(p => p.FullName))</strong>.
            Add an address on the <a asp-action="Users">Users</a> screen to make them selectable.
        </div>
    }
    @if (inactive.Count > 0)
    {
        <div class="alert alert-secondary small">
            <i class="bi bi-person-dash me-1"></i>
            @inactive.Count selected recipient(s) are deactivated and are being skipped:
            <strong>@string.Join(", ", inactive.Select(p => p.FullName))</strong>.
            Saving this page removes them from the list.
        </div>
    }

    @if (canEdit)
    {
        <button type="submit" class="btn btn-primary">
            <i class="bi bi-save me-1"></i>Save recipients
        </button>
    }
</form>

@section Scripts {
    <script>
        (function () {
            // ---- per-recipient scope chips ----
            function boxes(cell) {
                return Array.prototype.slice.call(cell.querySelectorAll('input.btn-check'));
            }
            function refresh(cell) {
                var all  = boxes(cell);
                var on   = all.filter(function (b) { return b.checked; });
                var hint = cell.querySelector('[data-scope-hint]');
                var kind = cell.getAttribute('data-scope-kind') || 'item';
                if (!hint) return;
                // Nothing ticked is not "empty", it is "everything" -- say so, or
                // an admin reads a blank cell as nobody being notified.
                if (on.length === 0) {
                    hint.textContent = 'All ' + kind + 's';
                    hint.classList.add('is-all');
                } else {
                    hint.textContent = on.length + ' of ' + all.length;
                    hint.classList.remove('is-all');
                }
            }
            function setCell(cell, on) {
                boxes(cell).forEach(function (b) { if (!b.disabled) b.checked = on; });
                refresh(cell);
            }

            document.querySelectorAll('[data-scope]').forEach(function (cell) {
                refresh(cell);
                cell.addEventListener('change', function () { refresh(cell); });
                cell.querySelector('[data-scope-all]')?.addEventListener('click', function (e) {
                    e.preventDefault(); setCell(cell, true);
                });
                cell.querySelector('[data-scope-none]')?.addEventListener('click', function (e) {
                    e.preventDefault(); setCell(cell, false);
                });
            });

            // Column-wide helpers: with fifty users, setting one plant on each by
            // hand is the sort of chore people give up on halfway.
            function eachCell(kind, fn) {
                document.querySelectorAll('[data-scope][data-scope-kind="' + kind + '"]').forEach(fn);
            }
            document.querySelectorAll('[data-col-all]').forEach(function (a) {
                a.addEventListener('click', function (e) {
                    e.preventDefault();
                    eachCell(a.getAttribute('data-col-all'), function (c) { setCell(c, true); });
                });
            });
            document.querySelectorAll('[data-col-none]').forEach(function (a) {
                a.addEventListener('click', function (e) {
                    e.preventDefault();
                    eachCell(a.getAttribute('data-col-none'), function (c) { setCell(c, false); });
                });
            });

            function setAll(on) {
                document.querySelectorAll('input[name="userIds"]:not([disabled])')
                        .forEach(function (c) { c.checked = on; });
            }
            document.querySelector('[data-select-all]')?.addEventListener('click', function (e) {
                e.preventDefault(); setAll(true);
            });
            document.querySelector('[data-select-none]')?.addEventListener('click', function (e) {
                e.preventDefault(); setAll(false);
            });
        })();
    </script>
}
