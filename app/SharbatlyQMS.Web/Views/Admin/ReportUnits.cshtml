@using SharbatlyQMS.Web.Models
@using SharbatlyQMS.Web.ViewModels
@model IReadOnlyList<ReportUnitRow>
@{
    ViewData["Title"] = "Report Units";
    var configuredCount = Model.Count(r => r.IsConfigured);
}

<div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
    <h1 class="h3 mb-0">
        <i class="bi bi-tags me-1"></i>Report Units
        <small class="text-muted fs-6 fw-normal ms-2">
            What one unit of sample size is called, per material group, on the Quality Order report.
        </small>
    </h1>
    @if (configuredCount > 0)
    {
        <span class="badge bg-info text-dark align-self-center">@configuredCount customised</span>
    }
</div>

<div class="alert alert-light border small">
    <i class="bi bi-info-circle me-1"></i>
    The unit replaces the word <strong>@ReportUnit.DefaultLabel</strong> in two places on the Quality Order PDF:
    <strong>Sample Size</strong> in the material-group summary, and the <strong>count column header</strong>
    above every defect list — both in the page-1 summary and on each individual sample.
    Leave a group at <em>@ReportUnit.DefaultLabel</em> to keep the default.
    Percentages and totals are unaffected; this is a label only.
</div>

<form asp-action="SaveReportUnits" method="post">
    @Html.AntiForgeryToken()
    <div class="card">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0" data-tablekit data-page-size="50">
                <thead class="table-light">
                    <tr>
                        <th data-sort>Material group</th>
                        <th data-sort>Description</th>
                        <th style="width: 220px">Unit on report</th>
                        <th data-sort style="width: 120px">Status</th>
                    </tr>
                </thead>
                <tbody>
                @if (Model.Count == 0)
                {
                    <tr><td colspan="4" class="text-center text-muted py-4">
                        No material groups found. They appear here once the SAP material master has been synced.
                    </td></tr>
                }
                else
                {
                    foreach (var r in Model)
                    {
                        <tr>
                            <td>
                                <span class="badge bg-info text-dark">@r.MaterialGroup</span>
                                <input type="hidden" name="materialGroup" value="@r.MaterialGroup" />
                            </td>
                            <td class="text-muted small">@(string.IsNullOrWhiteSpace(r.GroupName) ? "—" : r.GroupName)</td>
                            <td>
                                @* maxlength matches unit_label NVARCHAR(20). *@
                                <input type="text" name="unitLabel" value="@r.UnitLabel" maxlength="20"
                                       class="form-control form-control-sm"
                                       placeholder="@ReportUnit.DefaultLabel"
                                       list="report-unit-suggestions" autocomplete="off" />
                            </td>
                            <td>
                                @if (r.IsConfigured)
                                {
                                    <span class="badge bg-success-subtle text-success-emphasis">Customised</span>
                                }
                                else
                                {
                                    <span class="text-muted small">Default</span>
                                }
                            </td>
                        </tr>
                    }
                }
                </tbody>
            </table>
        </div>
    </div>

    @* Suggestions only -- any wording is accepted. *@
    <datalist id="report-unit-suggestions">
        <option value="Pieces"></option>
        <option value="Boxes"></option>
        <option value="Cartons"></option>
        <option value="Bags"></option>
        <option value="Bunches"></option>
        <option value="Punnets"></option>
        <option value="Kg"></option>
    </datalist>

    <div class="mt-3">
        <button type="submit" class="btn btn-primary">
            <i class="bi bi-save me-1"></i>Save units
        </button>
        <span class="text-muted small ms-2">Takes effect on the next report you generate.</span>
    </div>
</form>
