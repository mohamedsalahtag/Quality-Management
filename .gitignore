# .NET build output
bin/
obj/

# Publish output — regenerated by deploy/Republish.ps1. The deployment SCRIPTS
# directly under deploy/ stay tracked; only the compiled bundle is ignored.
deploy/SharbatlyQMS/

# Runtime data store (uploaded photos + documents, several GB) — production
# data that lives on disk, never in git.
/data/

# Data-protection keys (sensitive — auth cookies break if leaked)
keys/

# Visual Studio / VS Code user-specific cruft
.vs/
.vscode/
*.user
*.suo

# OS / editor noise
.DS_Store
Thumbs.db
*.swp

# Runtime / smoke artefacts (already tracked items not retroactively ignored)
runtime.log
smoketest.log

# Per-environment app settings carry real connection strings + secrets and
# must not be committed. The shared appsettings.json keeps a placeholder.
# Use `git rm --cached <file>` once to stop tracking already-committed copies.
**/appsettings.Development.json
**/appsettings.Production.json
**/appsettings.Local.json
**/appsettings.*.local.json
# Backups of the above still carry the same secrets — never commit them.
**/appsettings.*.pre-*
*.pre-mis-backup

# Help docs -- generated bundles. Source hubs + screenshots stay tracked.
docs/help/output/
docs/help/_capture_details.py
docs/help/_verify_xlsx.py
docs/help/_verify*.xlsx
